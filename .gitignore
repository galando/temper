# Temper - Files that change per-project (don't commit to template)
# These are generated when Temper runs in a project

# Per-project specs and plans
.temper/specs/
.temper/reviews/
.temper/archive/

# Pipeline runtime state — written/resumed/deleted across /temper runs (never commit)
.temper/build-state.json
.temper/feedback-loops.json
.temper/observability.json

# Project-specific index (regenerated on each plan)
.temper/index/

# These should be committed to track metrics over time
# .temper/metrics.json
# .temper/review-memory.json

# Dependencies (never commit)
node_modules/
package-lock.json

# Build outputs (generated during build)
dist/

# Python cache (evals/fixtures/*/test runs, etc.)
__pycache__/
*.pyc
.pytest_cache/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/

# Temporary files
*.tmp
*.temp

# Claude session logs
.claude/interactions.log
.claude/session.log
