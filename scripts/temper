#!/usr/bin/env bash
#
# temper — the deterministic spine of the Temper plugin.
#
# Everything in the /temper pipeline that has exactly one correct output lives here,
# not in a prompt. State transitions, evidence bookkeeping, and gate verdicts are
# computed by this script; the orchestrator prompts call it and act on its exit code.
# No network calls. python3 stdlib only (json parsing) — no external dependencies.
#
# Subcommands:
#   temper init                                  scaffold .temper/ in the current project
#   temper state <get|set|advance|loop|archive|clear> ..  read/write .temper/build-state.json;
#                                                 archive writes gate-ledger.json in the spec folder
#   temper evidence <add|run|list|resolve|accept|clear> ...  append/execute-and-record/read/mark-fixed/clear the ledger
#   temper gate <stage> [--spec-path P]           compute PASS/FAIL for a stage, record verdict
#   temper model <stage> | --all                  resolve a stage's model (config override > frontmatter)
#   temper override <stage> --reason "..."        record a human override of a FAIL gate
#   temper report [--json]                        render the current run's gate ledger
#   temper status [--json] [--spec-path P]        per-criterion passed/open view; writes .temper/status.json
#   temper bands [--json]                         deterministic control-band drift check
#                                                 over .temper/metrics.json history
#   temper metrics append <series> <value>        append a numeric point to <series>_history
#   temper config get <dot.path> [default]        read temper.config (for hook and CI scripts)
#
# DEGRADATION CONTRACT (same spirit as Temper's guardrail scripts):
#   - A stage with no evidence recorded FAILS closed (nothing to verify => not verified).
#   - Missing python3 => every subcommand exits 1 with a clear message (JSON needs it).
#   - Malformed state/config => treated as absent (defaults apply), never a crash.
#   - A symlink on a path this CLI writes or reads as run state (.temper, its evidence, specs
#     and archive folders, the fixed state and evidence files, the active run's spec folder
#     and its gate-ledger.json) => every subcommand except config, model and help exits 3
#     with a one-line reason on stderr, so no write can follow a link out of the project.
#     Any other link inside a spec folder is not run state and changes nothing.
#   - Run from the home folder => every subcommand except config, model and help exits 1:
#     the home folder holds Claude Code's own files and is never a project.
set -uo pipefail
# An exported CDPATH makes `cd` print the folder it enters, which would double every
# folder this script works out with "$(cd ... && pwd)". It is never used here.
unset CDPATH

REPO_ROOT="$(pwd)"
# Where the plugin itself lives (this script). Used only to read the stage briefs'
# frontmatter (`temper model`), to load acceptance.py and to refuse a project folder
# inside the plugin folder, never to locate project state. It comes from this file's
# own location alone, never from an environment variable: when the CLI is reached
# through a symlink (a link in a bin folder, or a chain of links), each link is followed
# to the real file first. The plugin folder is that file's folder (resolved, so a link
# to the folder itself is followed too) with the literal suffix /scripts removed.
_self="${BASH_SOURCE[0]}"
_hops=0
while [[ -L "$_self" && $_hops -lt 40 ]]; do
  _link_dir="$(cd -P "$(dirname "$_self")" 2>/dev/null && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" == /* ]] || _self="$_link_dir/$_self"
  _hops=$((_hops + 1))
done
SCRIPTS_DIR="$(cd -P "$(dirname "$_self")" 2>/dev/null && pwd)"
PLUGIN_ROOT="${SCRIPTS_DIR%/scripts}"
unset _self _hops _link_dir
ACCEPTANCE_PY="$PLUGIN_ROOT/scripts/acceptance.py"
# Run state always lives in this project's .temper folder: no environment variable moves
# it, so every write and delete below stays inside the project.
TEMPER_DIR="$REPO_ROOT/.temper"
# TEMPER_CONFIG may name another config file to READ (the guard scripts pass the project's
# own); nothing in this script ever writes to it.
CONFIG_FILE="${TEMPER_CONFIG:-$REPO_ROOT/.claude/temper.config}"
STATE_FILE="$TEMPER_DIR/build-state.json"
LOOPS_FILE="$TEMPER_DIR/feedback-loops.json"
GATES_FILE="$TEMPER_DIR/gates.json"
STATUS_FILE="$TEMPER_DIR/status.json"
OVERRIDES_FILE="$TEMPER_DIR/overrides.json"
EVIDENCE_DIR="$TEMPER_DIR/evidence"
METRICS_FILE="$TEMPER_DIR/metrics.json"
BANDS_FILE="$TEMPER_DIR/bands.json"

STAGES="intent plan design build review check commit"

# Stages that run as an Agent subprocess and therefore have a model to resolve.
# `commit` is not one — it's the orchestrator running `temper gate commit`.
# rca/fix are /temper:fix's subprocess stages: model stages (the rca and fix briefs'
# frontmatter) but never gate stages — Fix evidence gates as `build`.
AGENT_STAGES="intent plan design build review check rca fix"

# The only stage names an evidence ledger file can carry: every gate stage plus the two
# /temper:fix subprocess stages. A stage name is checked against this list before any
# path is built from it (see _stage_ok and _evidence_file).
EVIDENCE_STAGES="intent plan design build review check commit rca fix"

_stage_ok() { # _stage_ok <stage> -> 0 only for a name on the fixed EVIDENCE_STAGES list
  case "$1" in
    intent|plan|design|build|review|check|commit|rca|fix) return 0 ;;
  esac
  return 1
}

_stage_refuse() { # _stage_refuse <stage> -> prints the usage failure for a stage not on the list
  echo "FAIL: unknown stage '$1' (one of: $EVIDENCE_STAGES)" >&2
  return 1
}

_slug_ok() { # _slug_ok <slug> -> 0 for a spec slug: letters (either case), digits, '.', '_', '-'
             # starting with a letter or digit, never containing '/' or '..' (so never a path).
             # Either case: a ticket key prefix such as PROJ-123-login is a valid slug.
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && ! [[ "$1" =~ [.][.] ]]
}

_spec_slug() { # _spec_slug <spec_path> -> the slug of a spec path of the form .temper/specs/<slug>,
               # or "" for any other value (the only shape `state init` ever records)
  local sp="${1%/}" slug
  slug="${sp#.temper/specs/}"
  if [[ "$slug" != "$sp" ]] && _slug_ok "$slug"; then echo "$slug"; else echo ""; fi
}

# Per-command state.stage sequences (bookkeeping for resume — see
# reference/orchestrator-patterns.md "Build State Schema"). Distinct from $STAGES
# above, which is the `temper gate <stage>` vocabulary: /temper:fix's state.stage
# uses rca/fix in place of plan/build, but "rca"/"fix" are never valid gate stages.
STAGE_SEQ_TEMPER="intent plan design build review check"
STAGE_SEQ_FIX="rca fix review check"

_count_lines_matching() { # _count_lines_matching <pattern> <file>  (grep -c exits 1 on zero matches
                           # but still prints "0" — never pair it with "|| echo 0", that double-prints)
  local n
  n=$(grep -c "$1" "$2" 2>/dev/null)
  echo "${n:-0}"
}

_git_toplevel_is() { # _git_toplevel_is <folder> -> 0 when <folder> is a git work tree whose top
                      # level is <folder> itself. Every GIT_* variable is dropped first, so a
                      # GIT_DIR or GIT_WORK_TREE set by a caller (a git hook sets some) cannot
                      # answer for another repository.
  local top
  top="$(
    while IFS= read -r v; do unset "$v"; done < <(compgen -e | grep '^GIT_')
    git -C "$1" rev-parse --show-toplevel 2>/dev/null
  )" || return 1
  [[ -n "$top" && "$top" -ef "$1" ]]
}

_under_folder() { # _under_folder <path> <folder> -> 0 when <path> is <folder> or lies inside it.
                  # Decided by identity, not by text: <path> is resolved (links followed) and
                  # each of its ancestors is compared with <folder> by device and inode
                  # ([[ -ef ]]), so a path typed in another case on a file system that does
                  # not tell case apart, a symlink or a second mount of the same folder is
                  # still seen.
  local d
  d="$(cd -P "$1" 2>/dev/null && pwd)" || return 1
  while [[ -n "$d" ]]; do
    [[ "$d" -ef "$2" ]] && return 0
    [[ "$d" != "/" ]] || return 1
    d="${d%/*}"
    [[ -n "$d" ]] || d="/"
  done
  return 1
}

_inside_plugin_refuse() { # -> 1 (with a message) when the current folder is the plugin folder or
                          # lies inside it. Run state lives in the current folder's .temper, and
                          # nothing this CLI runs may write into the plugin folder. The one
                          # exception is developing Temper on its own repository: the plugin
                          # folder is a project only when it is a git work tree whose top level
                          # is that folder. An installed copy (no .git) is refused like any
                          # folder inside it (one of its own subfolders, or a second checkout
                          # placed in it).
  [[ "$PLUGIN_ROOT" != "$SCRIPTS_DIR" ]] || return 0   # not laid out as a plugin: no folder to guard
  local plugin cwd
  plugin="$(cd -P "$PLUGIN_ROOT" 2>/dev/null && pwd)" || return 0
  [[ -n "$plugin" && "$plugin" != "/" ]] || return 0
  cwd="$(pwd -P)"
  if [[ "$cwd" -ef "$plugin" ]]; then
    _git_toplevel_is "$plugin" && return 0
    echo "FAIL: run temper from a project folder, not from the plugin folder: this copy is not its own git repository" >&2
    echo "      (plugin folder: $plugin). The plugin folder is a project only when it is a git work tree whose top level is that folder." >&2
    return 1
  fi
  if _under_folder "$cwd" "$plugin"; then
    echo "FAIL: run temper from a project folder, not from a folder inside the plugin folder" >&2
    echo "      (plugin folder: $plugin; current folder: $cwd). The plugin folder itself is a project only when it is its own git repository." >&2
    return 1
  fi
  return 0
}

_home_refuse() { # -> 1 (with a message) when the current folder is the home folder. The home
                 # folder holds Claude Code's own files and is never a project, so no run state
                 # is read or written there. Decided by identity (device and inode), so a
                 # symlink or another spelling of the home folder is still seen.
  [[ -n "${HOME:-}" && "$REPO_ROOT" -ef "$HOME" ]] || return 0
  echo "FAIL: run temper from a project folder, not from the home folder ($HOME). The home folder is never a project." >&2
  return 1
}

_unsafe_temper_refuse() { # -> 3 (with a one-line reason) when a path this CLI writes or reads as
                          # run state is a symlink: the .temper folder, its evidence, specs and
                          # archive folders, the fixed state files, the evidence files, the
                          # active run's spec folder and its gate-ledger.json. A link there (a
                          # cloned repository can carry one) could send a write out of the
                          # project, into the plugin folder or anywhere else. Any other link
                          # inside a spec folder is not run state: the CLI never writes through
                          # it, so it changes nothing. Each folder is checked before any path
                          # inside it, so no check here looks through a link.
  [[ -e .temper || -L .temper ]] || return 0
  local p slug link="" paths=".temper .temper/.lock .temper/evidence .temper/specs .temper/archive"
  for p in build-state gates overrides status metrics bands feedback-loops; do
    paths="$paths .temper/$p.json"
  done
  for p in $EVIDENCE_STAGES; do
    paths="$paths .temper/evidence/$p.json"
  done
  for p in $paths; do
    [[ -L "$p" ]] && { link="$p"; break; }
  done
  if [[ -z "$link" && -f "$STATE_FILE" ]]; then
    # The active run's spec folder: only the shape `state init` records names one.
    slug="$(_spec_slug "$(_json_get_path "$STATE_FILE" spec_path "")")"
    if [[ -n "$slug" ]]; then
      for p in ".temper/specs/$slug" ".temper/specs/$slug/gate-ledger.json"; do
        [[ -L "$p" ]] && { link="$p"; break; }
      done
    fi
  fi
  if [[ -n "$link" ]]; then
    echo "FAIL: unsafe .temper: '$link' is a symlink, and no write may follow a link out of the project (replace it with a plain file or folder)" >&2
    return 3
  fi
  return 0
}

_require_python() {
  command -v python3 >/dev/null 2>&1 || { echo "FAIL: python3 is required but not found in PATH" >&2; exit 1; }
}

_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

_ensure_dirs() { mkdir -p .temper/evidence; }   # the project's .temper and its evidence folder

# ---------------------------------------------------------------------------
# Minimal JSON helpers (python3 stdlib only — no jq / pyyaml dependency)
# ---------------------------------------------------------------------------

_json_read() { # _json_read <file> <default-json>
  local file="$1" default="$2"
  if [[ -f "$file" ]]; then
    python3 -c "
import json, sys
try:
    json.load(open(sys.argv[1]))
    print(open(sys.argv[1]).read())
except Exception:
    print(sys.argv[2])
" "$file" "$default"
  else
    echo "$default"
  fi
}

_json_get_path() { # _json_get_path <file> <dot.path> [default]
  local file="$1" path="$2" default="${3:-}"
  python3 -c "
import json, sys
path, default = sys.argv[2], sys.argv[3]
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print(default); sys.exit(0)
cur = d
for k in path.split('.'):
    if isinstance(cur, dict) and k in cur:
        cur = cur[k]
    else:
        print(default); sys.exit(0)
if isinstance(cur, (dict, list)):
    print(json.dumps(cur))
elif isinstance(cur, bool):
    print('true' if cur else 'false')  # bash compares lowercase — never emit Python's True/False
else:
    print(cur if cur is not None else default)
" "$file" "$path" "$default" 2>/dev/null || echo "$default"
}

# Write lock for the shared run files under .temper/. A mkdir lock (portable: macOS has no flock):
# `mkdir` either creates the folder or fails, atomically. A lock older than 30 s belongs to a crashed
# holder and is broken; a lock still held after TEMPER_LOCK_WAIT_S (default 10) seconds is written
# past with a WARN (fail open), so a stuck holder never wedges a run. A lock this call did not take
# is never released. Held only around a file write, never while a test runs.
_LOCK_DIR=".temper/.lock"
_LOCK_HELD=0
_lock_acquire() {
  [[ "$_LOCK_HELD" == "1" ]] && return 0       # already held by this call chain: no self-deadlock
  [[ -d .temper ]] || return 0                 # nothing to lock before a run has a folder
  local i=0 max=$(( ${TEMPER_LOCK_WAIT_S:-10} * 50 ))
  while :; do
    if mkdir "$_LOCK_DIR" 2>/dev/null; then _LOCK_HELD=1; return 0; fi
    if (( i % 50 == 0 )) && python3 -c "
import os, sys, time
try:
    sys.exit(0 if time.time() - os.path.getmtime(sys.argv[1]) > 30 else 1)
except OSError:
    sys.exit(0)" "$_LOCK_DIR" 2>/dev/null; then
      rmdir "$_LOCK_DIR" 2>/dev/null || true   # stale: its holder is gone
      i=$(( i + 1 ))
      continue
    fi
    if (( i >= max )); then
      echo "WARN: could not take $_LOCK_DIR within ${TEMPER_LOCK_WAIT_S:-10}s; writing without the lock" >&2
      return 0
    fi
    python3 -c "import time; time.sleep(0.02)"
    i=$(( i + 1 ))
  done
}
_lock_release() {
  [[ "$_LOCK_HELD" == "1" ]] || return 0
  rmdir "$_LOCK_DIR" 2>/dev/null || true
  _LOCK_HELD=0
}

# Every JSON write below goes through a temp file in the same folder and os.replace, so a reader
# never sees a truncated file even when a writer is killed half way.
_json_set_path() { # _json_set_path <file> <dot.path> <value> <default-json>
  local file="$1" path="$2" value="$3" default="$4" rc
  _lock_acquire
  python3 -c "
import json, os, sys
path, value, default = sys.argv[2], sys.argv[3], sys.argv[4]
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = json.loads(default)
# auto-typing: true/false/int/float pass through, else string
if value in ('true', 'false'):
    v = (value == 'true')
else:
    try:
        v = int(value)
    except ValueError:
        try:
            v = float(value)
        except ValueError:
            v = value
cur = d
keys = path.split('.')
for k in keys[:-1]:
    cur = cur.setdefault(k, {})
cur[keys[-1]] = v
tmp = '%s.tmp.%d' % (sys.argv[1], os.getpid())
with open(tmp, 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\n')
os.replace(tmp, sys.argv[1])
" "$file" "$path" "$value" "$default"
  rc=$?
  _lock_release
  return $rc
}

_json_append() { # _json_append <file> <entry-json>  (file holds a JSON array)
  local file="$1" entry="$2" rc
  _lock_acquire
  python3 -c "
import json, os, sys
try:
    d = json.load(open(sys.argv[1]))
    if not isinstance(d, list):
        d = []
except Exception:
    d = []
d.append(json.loads(sys.argv[2]))
tmp = '%s.tmp.%d' % (sys.argv[1], os.getpid())
with open(tmp, 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\n')
os.replace(tmp, sys.argv[1])
" "$file" "$entry"
  rc=$?
  _lock_release
  return $rc
}

# ---------------------------------------------------------------------------
# Config (a small YAML subset — indentation-nested maps/lists, flow lists).
# The v7 config is ~25 lines; this parser is intentionally not general-purpose YAML.
# ---------------------------------------------------------------------------

_cfg_get() { # _cfg_get <dot.path> [default]
  local path="$1" default="${2:-}"
  [[ -f "$CONFIG_FILE" ]] || { echo "$default"; return; }
  python3 -c "
import sys

# A deliberately small YAML subset: nested maps by indentation, scalars, and
# INLINE flow lists ([a, b, c]) only — the v7 config never needs block-style
# '- item' lists, so that form is intentionally not supported here.
def parse_yaml_subset(text):
    root = {}
    stack = [(-1, root)]
    for raw in text.splitlines():
        line = raw.split(' #', 1)[0].rstrip()
        if not line.strip() or line.strip().startswith('#'):
            continue
        indent = len(line) - len(line.lstrip(' '))
        stripped = line.strip()
        while len(stack) > 1 and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1]
        if ':' not in stripped:
            continue
        key, _, val = stripped.partition(':')
        key, val = key.strip(), val.strip()
        if val == '':
            container = {}
            parent[key] = container
            stack.append((indent, container))
        elif val.startswith('[') and val.endswith(']'):
            items = [i.strip().strip('\"\\'') for i in val[1:-1].split(',') if i.strip()]
            parent[key] = items
        elif val in ('true', 'false'):
            parent[key] = (val == 'true')
        else:
            try:
                parent[key] = int(val)
            except ValueError:
                try:
                    parent[key] = float(val)
                except ValueError:
                    # One pair of matching quotes around the whole value is taken off; a
                    # quote that ends a value ('fmt \"{file}\"') is part of it.
                    if len(val) >= 2 and val[0] == val[-1] and val[0] in '\"\\'':
                        val = val[1:-1]
                    parent[key] = val
    return root

text = open(sys.argv[1]).read()
d = parse_yaml_subset(text)
path, default = sys.argv[2], sys.argv[3]
cur = d
for k in path.split('.'):
    if isinstance(cur, dict) and k in cur:
        cur = cur[k]
    else:
        print(default); sys.exit(0)
if isinstance(cur, list):
    print('\x1f'.join(str(i) for i in cur))
elif isinstance(cur, bool):
    print('true' if cur else 'false')  # bash compares lowercase — never emit Python's True/False
else:
    print(cur if cur != '' else default)
" "$CONFIG_FILE" "$path" "$default" 2>/dev/null || echo "$default"
}

# ---------------------------------------------------------------------------
# model — resolve which model a stage runs on.
#
# v7 replaced the v6 `models.routing`/`models.tiers` config with fixed `model:`
# frontmatter in each stage brief (see _agent_file), because the old block was a *resolution algorithm* a
# prompt had to execute correctly on every run. That diagnosis still holds; what it cost
# was the ability to change a model without editing plugin-owned files, which matters
# every time a new model generation ships.
#
# So: the frontmatter stays the source of truth for defaults (no table to drift out of
# sync with it), an optional flat `models.{stage}` config key overrides it, and the
# lookup lives here — one deterministic call, no algorithm in prose.
# ---------------------------------------------------------------------------

_agent_file() { # <stage> -> its brief, each path written out in full (an unknown stage has none)
  case "$1" in
    intent) echo "$PLUGIN_ROOT/agents/intent.md" ;;
    plan)   echo "$PLUGIN_ROOT/agents/plan.md" ;;
    design) echo "$PLUGIN_ROOT/agents/design.md" ;;
    build)  echo "$PLUGIN_ROOT/agents/build.md" ;;
    review) echo "$PLUGIN_ROOT/agents/review.md" ;;
    check)  echo "$PLUGIN_ROOT/agents/check.md" ;;
    rca)    echo "$PLUGIN_ROOT/agents/rca.md" ;;
    fix)    echo "$PLUGIN_ROOT/agents/fix.md" ;;
    *)      echo "" ;;
  esac
}

_agent_default_model() { # <stage> -> the `model:` line in that stage brief's frontmatter
  local f; f="$(_agent_file "$1")"
  [[ -n "$f" && -f "$f" ]] || { echo ""; return; }
  awk '
    /^---[[:space:]]*$/ { n++; if (n == 2) exit; next }
    n == 1 && /^model:/ { sub(/^model:[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
  ' "$f" 2>/dev/null
}

_resolve_model() { # <stage> -> config override, else frontmatter default, else ""
  local override; override="$(_cfg_get "models.${1}" "")"
  [[ -n "$override" ]] && { echo "$override"; return; }
  _agent_default_model "$1"
}

_grouped_on() { # build.mode: grouped turns grouped Build on; absent, per-task or anything else is off
  [[ "$(_cfg_get build.mode "")" == "grouped" ]]
}

_resolve_task_model() { # grouped task agent: config, else agents/build-task.md frontmatter, else the constant
  local m; m="$(_cfg_get build.grouped.task-model "")"
  [[ -n "$m" ]] && { echo "$m"; return; }
  local f="$PLUGIN_ROOT/agents/build-task.md"
  [[ -f "$f" ]] && m="$(awk '
    /^---[[:space:]]*$/ { n++; if (n == 2) exit; next }
    n == 1 && /^model:/ { sub(/^model:[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
  ' "$f" 2>/dev/null)"
  echo "${m:-claude-haiku-5-5}"
}

_resolve_task_escalation_model() {
  local m; m="$(_cfg_get build.grouped.escalation-model "")"
  echo "${m:-sonnet}"
}

cmd_model() {
  local stage="${1:-}"
  if [[ -z "$stage" || "$stage" == "--all" ]]; then
    local s m rc=0
    for s in $AGENT_STAGES; do
      m="$(_resolve_model "$s")"
      [[ -n "$m" ]] || { echo "FAIL: no model resolved for stage '$s' (is its brief in the plugin's agents folder?)" >&2; rc=1; continue; }
      echo "${s}=${m}"
    done
    if _grouped_on; then
      echo "task=$(_resolve_task_model)"
      echo "task-escalation=$(_resolve_task_escalation_model)"
    fi
    return $rc
  fi

  case "$stage" in
    task) _resolve_task_model; return 0 ;;
    task-escalation) _resolve_task_escalation_model; return 0 ;;
  esac

  case " $AGENT_STAGES " in
    *" $stage "*) ;;
    *) echo "FAIL: unknown stage '$stage' (one of: $AGENT_STAGES, or --all)" >&2; return 1 ;;
  esac

  local m; m="$(_resolve_model "$stage")"
  # Fail loudly rather than printing an empty string the orchestrator would paste into
  # an Agent launch. That is only reachable if the plugin's files are incomplete.
  [[ -n "$m" ]] || { echo "FAIL: no model resolved for stage '$stage' (is its brief in the plugin's agents folder?)" >&2; return 1; }
  echo "$m"
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  _ensure_dirs
  [[ -f "$GATES_FILE" ]] || echo '{}' > "$GATES_FILE"
  [[ -f "$OVERRIDES_FILE" ]] || echo '[]' > "$OVERRIDES_FILE"
  [[ -f "$LOOPS_FILE" ]] || echo '{"version":1,"active_loops":[],"history":[]}' > "$LOOPS_FILE"
  echo "OK: .temper/ scaffolded at $TEMPER_DIR"
}

# ---------------------------------------------------------------------------
# state
# ---------------------------------------------------------------------------

cmd_state_init() { # temper state init <slug> [--command temper|fix] [--branch NAME]
  local slug="${1:-}"; shift || true
  # The slug becomes the spec folder .temper/specs/<slug>, which `state archive` later
  # writes into, so it is a plain name and never a path.
  if ! _slug_ok "$slug"; then
    echo "FAIL: usage: temper state init <slug> [--command temper|fix] [--branch NAME]" >&2
    echo "      (the slug is letters of either case, digits, '.', '_' or '-', starts with a letter or digit, and has no '/' or '..'; got '$slug')" >&2
    return 1
  fi
  _ensure_dirs
  local command="temper" branch=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --command) command="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  # A new run must not inherit the previous run's overrides or gate verdicts — an
  # old override once satisfied a gate the new run never earned. Same discipline
  # as `state clear`: archive first, then remove runtime state. specs/ untouched.
  if [[ -f "$STATE_FILE" ]]; then
    local archived rc; archived="$(_archive_ledger)"; rc=$?
    [[ -n "$archived" ]] && echo "OK: prior run's gate ledger archived to $archived"
    [[ $rc -eq 2 ]] && echo "OK: the prior run's gate ledger was NOT archived (see the warning above); starting the new run"
  else
    # No prior run — but a non-empty overrides/gates file still carries a fact
    # worth keeping (an override records a human approver). Copy, don't delete.
    local ts name f stripped
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$TEMPER_DIR/archive"
    for name in overrides gates; do
      f="$TEMPER_DIR/$name.json"
      if [[ -f "$f" ]]; then
        stripped="$(tr -d '[:space:]' < "$f")"
        if [[ -n "$stripped" && "$stripped" != "[]" && "$stripped" != "{}" ]]; then
          cp "$f" "$TEMPER_DIR/archive/pre-init-${ts}-${name}.json"
          echo "OK: pre-init archive: $name.json -> .temper/archive/pre-init-${ts}-${name}.json"
        fi
      fi
    done
  fi
  # Each target is written out in full, relative to the project (REPO_ROOT is the cwd).
  rm -f .temper/build-state.json .temper/feedback-loops.json .temper/gates.json .temper/overrides.json
  rm -rf .temper/evidence
  _ensure_dirs
  # Re-scaffold the ledger files empty (same as `temper init`): a cleared run has
  # no overrides/verdicts/loops, not missing files.
  [[ -f "$GATES_FILE" ]] || echo '{}' > "$GATES_FILE"
  [[ -f "$OVERRIDES_FILE" ]] || echo '[]' > "$OVERRIDES_FILE"
  [[ -f "$LOOPS_FILE" ]] || echo '{"version":1,"active_loops":[],"history":[]}' > "$LOOPS_FILE"
  [[ -n "$branch" ]] || branch="feature/$slug"
  [[ "$command" == "fix" ]] && [[ "$branch" == "feature/$slug" ]] && branch="fix/$slug"
  python3 -c "
import json, sys
d = {
    'stage': 'started',
    'spec': sys.argv[1],
    'spec_path': f'.temper/specs/{sys.argv[1]}',
    'branch': sys.argv[2],
    'command': sys.argv[3],
    'next_stage': 'intent' if sys.argv[3] == 'temper' else 'rca',
    'run_mode': 'interactive',
    'artifacts': ['intent.md', 'tasks.md'] if sys.argv[3] == 'temper' else ['rca.md'],
    'updated': sys.argv[4],
}
json.dump(d, open(sys.argv[5], 'w'), indent=2)
" "$slug" "$branch" "$command" "$(_now)" "$STATE_FILE"
  echo "OK: state initialized for '$slug' ($command, branch $branch)"
}

_state_migrate_legacy() { # idempotent; called before any state read/write and by cmd_gate.
                           # Heals a v7.0.x build-state.json left with next_stage/stage
                           # pointing at the removed eval stage. Write-through (not
                           # read-only): scripts/guards/verify-tests-ran.sh (L1) reads
                           # build-state.json directly and cannot call this CLI, so a
                           # stale on-disk value would block every future `git commit`.
  [[ -f "$STATE_FILE" ]] || return 0
  grep -q '"eval' "$STATE_FILE" 2>/dev/null || return 0   # fast path — no python3 spawn
  python3 - "$STATE_FILE" <<'PY'
import json, os, sys, tempfile
p = sys.argv[1]
try:
    d = json.load(open(p))
except Exception:
    sys.exit(0)                     # malformed state == absent; never crash (spine contract)
changed = False
if d.get("next_stage") == "eval":       d["next_stage"] = "commit";        changed = True
if d.get("stage") == "eval_complete":   d["stage"] = "check_complete";     changed = True
if not changed:
    sys.exit(0)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p) or ".")
with os.fdopen(fd, "w") as f:
    json.dump(d, f, indent=2); f.write("\n")
os.replace(tmp, p)                  # atomic: a truncated migration would LOSE state
PY
}

cmd_state_get() {
  _state_migrate_legacy
  [[ -f "$STATE_FILE" ]] || { echo ""; return 0; }
  if [[ -z "${1:-}" ]]; then
    _json_read "$STATE_FILE" '{}'
    return 0
  fi
  _json_get_path "$STATE_FILE" "$1" "${2:-}"
}

cmd_state_set() {
  [[ $# -ge 2 ]] || { echo "FAIL: usage: temper state set <dot.path> <value>" >&2; return 1; }
  # spec_path names the folder `state archive` writes into: only the shape `state init`
  # records (.temper/specs/<slug>) is accepted, so it can never point anywhere else.
  if [[ "$1" == "spec_path" && -z "$(_spec_slug "$2")" ]]; then
    echo "FAIL: spec_path must be .temper/specs/<slug> (slug: letters of either case, digits, '.', '_' or '-', no '/' or '..'); got '$2'" >&2
    return 1
  fi
  [[ -f "$STATE_FILE" ]] || { echo '{}' > "$STATE_FILE"; }
  _json_set_path "$STATE_FILE" "$1" "$2" '{}'
  _json_set_path "$STATE_FILE" "updated" "$(_now)" '{}'
  echo "OK: $1 = $2"
}

cmd_state_advance() { # temper state advance <stage_complete> <next_stage>
  _state_migrate_legacy
  [[ -f "$STATE_FILE" ]] || { echo "FAIL: no active state — run 'temper state init' first" >&2; return 1; }
  [[ $# -ge 2 ]] || { echo "FAIL: usage: temper state advance <stage_complete> <next_stage>" >&2; return 1; }
  local stage="$1" next="$2"
  # state.stage is bookkeeping for resume, not a `temper gate` name — each command has
  # its own sequence (see reference/orchestrator-patterns.md "Build State Schema"), so
  # validate against the sequence for the command this run actually belongs to, not a
  # flat union of every command's vocabulary.
  local command; command="$(_json_get_path "$STATE_FILE" command temper)"
  local valid_stages="$STAGE_SEQ_TEMPER"
  [[ "$command" == "fix" ]] && valid_stages="$STAGE_SEQ_FIX"
  local known=false
  for s in $valid_stages; do
    [[ "$stage" == "${s}_complete" ]] && known=true
  done
  if [[ "$known" != "true" && "$stage" != "started" ]]; then
    echo "FAIL: unknown stage '$stage' for command '$command' (expected one of: $(for s in $valid_stages; do printf '%s_complete ' "$s"; done))" >&2
    return 1
  fi
  _json_set_path "$STATE_FILE" "stage" "$stage" '{}'
  _json_set_path "$STATE_FILE" "next_stage" "$next" '{}'
  _json_set_path "$STATE_FILE" "updated" "$(_now)" '{}'
  echo "OK: advanced to $stage (next: $next)"
}

cmd_state_loop() { # temper state loop <from> <to> --reason "..."
  local from="$1" to="$2"; shift 2 || true
  local reason=""
  while [[ $# -gt 0 ]]; do case "$1" in --reason) reason="$2"; shift 2 ;; *) shift ;; esac; done
  [[ -f "$LOOPS_FILE" ]] || echo '{"version":1,"active_loops":[],"history":[]}' > "$LOOPS_FILE"
  local max_per_type
  max_per_type="$(_cfg_get loops.max-per-type 2)"
  # fix.max-loops bounds the check->fix/build pair only when the key is set (Decision 5);
  # every other pair, and an install without the key, keep loops.max-per-type.
  if [[ "$from" == "check" && ( "$to" == "fix" || "$to" == "build" ) ]]; then
    max_per_type="$(_cfg_get fix.max-loops "$max_per_type")"
  fi
  local result
  result=$(python3 -c "
import json, sys
f, frm, to, reason, max_per_type, ts = sys.argv[1:7]
max_per_type = int(max_per_type)
d = json.load(open(f))
active = d.get('active_loops', [])
loop = next((l for l in active if l['from_stage'] == frm and l['to_stage'] == to), None)
if loop is None:
    loop = {'id': f'loop-{len(active) + len(d.get(\"history\", [])) + 1}', 'from_stage': frm,
             'to_stage': to, 'reason': reason, 'iteration': 0, 'max_iterations': max_per_type,
             'started': ts}
    active.append(loop)
if loop['iteration'] >= max_per_type:
    print('BLOCKED: max iterations (%d) reached for %s->%s' % (max_per_type, frm, to))
    d['active_loops'] = active
    json.dump(d, open(f, 'w'), indent=2)
    sys.exit(1)
loop['iteration'] += 1
loop['reason'] = reason or loop['reason']
d['active_loops'] = active
json.dump(d, open(f, 'w'), indent=2)
print('OK: loop %s->%s iteration %d/%d' % (frm, to, loop['iteration'], max_per_type))
" "$LOOPS_FILE" "$from" "$to" "$reason" "$max_per_type" "$(_now)")
  local rc=$?
  echo "$result"
  # A loop means "we are going backwards" — evidence is append-only, so a stale row
  # from a stage that's being redone (or, in the parallel-Review+Check window, an
  # abandoned background Check run) must not survive to inflate the next gate's count.
  # Belt-and-suspenders with the orchestrator's kill-before-clear ordering, not a
  # substitute for it: this is the backstop for standalone CLI users with no
  # orchestrator to do the kill.
  [[ $rc -eq 0 ]] && _clear_evidence_downstream "$to"
  return $rc
}

_spec_dir_ok() { # _spec_dir_ok <slug> -> 0 when .temper/specs/<slug> is a plain folder of this
                 # project's own .temper/specs: no symlink on the way (.temper, specs, the
                 # slug folder, the ledger file), and the folder's parent is, by identity
                 # (device and inode), the specs folder in the project's .temper.
  local d=".temper/specs/$1" real
  [[ -d "$d" && ! -L .temper && ! -L .temper/specs && ! -L "$d" && ! -L "$d/gate-ledger.json" ]] || return 1
  real="$(cd -P "$d" 2>/dev/null && pwd)" || return 1
  [[ -n "$real" && "${real%/*}" -ef "$REPO_ROOT/.temper/specs" ]]
}

_archive_ledger() { # writes gate-ledger.json into the run's spec folder from the live run state.
  # The run's decision record (verdicts, overrides with approver, evidence counts) must
  # not evaporate with the runtime state — it is the audit trail the committed artifact
  # chain exists for. Called by `state archive` (before the commit, so the ledger rides
  # it) and by `state clear` (the safety net for flows that never archived). Idempotent.
  # The target is .temper/specs/<slug>/gate-ledger.json with the slug checked by
  # _spec_slug: a spec_path of any other shape (a hand-edited state file) archives nothing,
  # and says so on stderr (returning 2) so `state archive`, `state clear` and `state init`
  # never drop the ledger without a word. The same goes for a spec folder that does not
  # resolve to a plain folder of the project's own .temper/specs (_spec_dir_ok): the
  # ledger is never written through a symlink.
  local spec_path slug out
  spec_path="$(cmd_state_get spec_path "")"
  [[ -n "$spec_path" ]] || return 0
  slug="$(_spec_slug "$spec_path")"
  if [[ -z "$slug" ]]; then
    echo "WARN: gate ledger NOT archived: spec_path '$spec_path' is not .temper/specs/<slug>" >&2
    return 2
  fi
  out=".temper/specs/$slug/gate-ledger.json"
  if [[ -d ".temper/specs/$slug" && -f "$GATES_FILE" ]] && ! _spec_dir_ok "$slug"; then
    echo "WARN: gate ledger NOT archived: .temper/specs/$slug is not a plain folder of this project's .temper/specs (a symlink is on the way)" >&2
    return 2
  fi
  if [[ -d ".temper/specs/$slug" && -f "$GATES_FILE" ]]; then
    # One (stage, ledger file) pair per name on the fixed list: no other file is read.
    local ev_pairs=() s
    for s in $EVIDENCE_STAGES; do ev_pairs+=("$s" "$(_evidence_file "$s")"); done
    python3 - "$GATES_FILE" "$OVERRIDES_FILE" "$out" "$(_now)" "${ev_pairs[@]}" <<'PY'
import json, sys
gates_f, overrides_f, out_f, ts = sys.argv[1:5]
pairs = sys.argv[5:]
def load(p, default):
    try:
        return json.load(open(p))
    except Exception:
        return default
gates = load(gates_f, {})
overrides = load(overrides_f, [])
evidence = {}
for stage, ledger in sorted(zip(pairs[0::2], pairs[1::2])):
    rows = load(ledger, [])
    if rows:
        evidence[stage] = {'rows': len(rows),
                           'labels': {l: sum(1 for e in rows if e.get('label') == l)
                                      for l in {e.get('label') for e in rows if e.get('label')}}}
with open(out_f, 'w') as fh:
    json.dump({'gates': gates, 'overrides': overrides, 'evidence': evidence,
               'archived': ts}, fh, indent=2)
    fh.write('\n')
PY
    [[ -f "$out" ]] && { echo "$out"; return 0; }
  fi
  return 0
}

cmd_state_archive() { # temper state archive — write the ledger WITHOUT touching state.
                       # Run before `git commit` so the archived record rides the commit
                       # while the live state stays intact for the pre-commit gate.
  local out rc; out="$(_archive_ledger)"; rc=$?
  if [[ -n "$out" ]]; then
    echo "OK: gate ledger archived to $out"
  elif [[ $rc -eq 2 ]]; then
    echo "OK: run state untouched; the gate ledger was NOT archived (see the warning above)"
  else
    echo "OK: nothing to archive (no gates recorded, or no spec dir)"
  fi
}

cmd_state_clear() {
  local archived_note=""
  local out rc; out="$(_archive_ledger)"; rc=$?
  [[ -n "$out" ]] && archived_note=" — gate ledger archived to $out"
  [[ $rc -eq 2 ]] && archived_note="; the gate ledger was NOT archived, see the warning above"
  # Each target is written out in full, relative to the project (REPO_ROOT is the cwd).
  rm -f .temper/build-state.json .temper/feedback-loops.json .temper/gates.json .temper/overrides.json
  rm -rf .temper/evidence
  echo "OK: run state cleared (spec artifacts under .temper/specs/ are untouched${archived_note})"
}

cmd_state() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    init) cmd_state_init "$@" ;;
    get) cmd_state_get "$@" ;;
    set) cmd_state_set "$@" ;;
    advance) cmd_state_advance "$@" ;;
    loop) cmd_state_loop "$@" ;;
    archive) cmd_state_archive "$@" ;;
    clear) cmd_state_clear "$@" ;;
    *) echo "FAIL: usage: temper state <init|get|set|advance|loop|archive|clear> ..." >&2; return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# evidence
# ---------------------------------------------------------------------------

cmd_evidence_add() {
  local stage="" claim="" cmd="" exit_code="" artifact="" value="" severity="" label="HEURISTIC" phase="" scenario="" criterion=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --claim) claim="$2"; shift 2 ;;
      --cmd) cmd="$2"; shift 2 ;;
      --exit) exit_code="$2"; shift 2 ;;
      --artifact) artifact="$2"; shift 2 ;;
      --value) value="$2"; shift 2 ;;
      --severity) severity="$2"; shift 2 ;;
      --label) label="$2"; shift 2 ;;
      --phase) phase="$2"; shift 2 ;;
      --scenario) scenario="$2"; shift 2 ;;
      --criterion) criterion="$2"; shift 2 ;;
      *) echo "FAIL: unknown flag $1" >&2; return 1 ;;
    esac
  done
  [[ -n "$stage" && -n "$claim" ]] || { echo "FAIL: --stage and --claim are required" >&2; return 1; }
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs

  # A row claimed PROVEN is mechanically re-checked here — never taken on faith.
  # An artifact that doesn't exist, or a nonzero exit paired with PROVEN, is downgraded.
  if [[ "$label" == "PROVEN" ]]; then
    if [[ -n "$artifact" && ! -f "$artifact" ]]; then
      label="HEURISTIC"
      echo "WARN: --label PROVEN downgraded to HEURISTIC — artifact '$artifact' does not exist" >&2
    elif [[ -n "$exit_code" && "$exit_code" != "0" && -z "$severity" ]]; then
      label="HEURISTIC"
      echo "WARN: --label PROVEN downgraded to HEURISTIC — exit code $exit_code is nonzero" >&2
    fi
  fi

  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || (set -C; echo '[]' > "$file") 2>/dev/null || true
  local artifact_hash=""
  if [[ -n "$artifact" && -f "$artifact" ]]; then
    artifact_hash="$(python3 -c "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())" "$artifact" 2>/dev/null || echo "")"
  fi
  local entry
  entry=$(python3 -c "
import json, sys
claim, cmd, exit_code, artifact, artifact_hash, value, severity, label, phase, scenario, criterion, ts = sys.argv[1:]
e = {'claim': claim, 'cmd': cmd or None,
     'exit_code': int(exit_code) if exit_code != '' else None,
     'artifact': artifact or None, 'sha256': artifact_hash or None,
     'value': (float(value) if value != '' else None),
     'severity': severity or None, 'phase': phase or None, 'scenario': scenario or None,
     'criterion': criterion or None, 'label': label, 'ts': ts}
print(json.dumps(e))
" "$claim" "$cmd" "$exit_code" "$artifact" "$artifact_hash" "$value" "$severity" "$label" "$phase" "$scenario" "$criterion" "$(_now)")
  _json_append "$file" "$entry"
  echo "OK: [$label] $stage: $claim"
}

cmd_evidence_list() {
  local stage="" as_json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --json) as_json=true; shift ;;
      *) shift ;;
    esac
  done
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo "[]"; return 0; }
  if [[ "$as_json" == "true" ]]; then
    cat "$file"
  else
    python3 -c "
import json, sys
for i, e in enumerate(json.load(open(sys.argv[1])), 1):
    mark = 'OK ' if (e.get('exit_code') in (0, None)) else 'ERR'
    line = f\"#{i} [{e.get('label')}] {mark} {e.get('claim')}\"
    if e.get('severity'):
        line += f\" (severity: {e.get('severity')})\"
    if e.get('resolved'):
        line += f\" [resolved: {e['resolved'].get('fixed_by')}]\"
    if e.get('accepted'):
        line += f\" [accepted: {e['accepted'].get('reason')}]\"
    if e.get('cmd'):
        line += f\" (cmd: {e.get('cmd')}, exit {e.get('exit_code')})\"
    if e.get('scenario'):
        line += f\" [scenario: {e.get('scenario')}]\"
    print(line)
" "$file"
  fi
}

cmd_evidence_resolve() { # temper evidence resolve --stage <s> --id <n> --fixed-by "<commit or note>"
  # Marks one recorded finding as fixed in THIS run. The row is kept — the ledger must
  # still show what was found — but the gate no longer counts it. The alternative was
  # deleting evidence to go green, which QUALITY-GATES forbids (woningscout #984).
  local stage="" id="" fixed_by=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --fixed-by) fixed_by="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$stage" && -n "$id" && -n "$fixed_by" ]] || { echo "FAIL: usage: temper evidence resolve --stage <s> --id <n> --fixed-by \"<commit or note>\" (ids from 'temper evidence list --stage <s>')" >&2; return 1; }
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo "FAIL: no evidence recorded for stage '$stage'" >&2; return 1; }
  python3 - "$file" "$id" "$fixed_by" "$(_now)" <<'PY'
import json, sys
f, id_s, fixed_by, ts = sys.argv[1:5]
entries = json.load(open(f))
try:
    idx = int(id_s)
except ValueError:
    sys.exit("FAIL: --id must be the 1-based number shown by 'temper evidence list'")
if idx < 1 or idx > len(entries):
    sys.exit("FAIL: no finding #%s in this stage (it has %d entries)" % (id_s, len(entries)))
e = entries[idx - 1]
if not e.get('severity'):
    sys.exit("FAIL: finding #%s carries no severity, so it never counted against a gate" % id_s)
if e.get('resolved'):
    sys.exit("FAIL: finding #%s is already resolved (%s)" % (id_s, e['resolved'].get('fixed_by')))
if e.get('accepted'):
    sys.exit("FAIL: finding #%s is already accepted (%s)" % (id_s, e['accepted'].get('reason')))
e['resolved'] = {'fixed_by': fixed_by, 'ts': ts}
json.dump(entries, open(f, 'w'), indent=2)
print("OK: %s finding #%s resolved — %s" % (e.get('severity'), id_s, fixed_by))
PY
}

cmd_evidence_accept() { # temper evidence accept --stage <s> --id <n> --reason "<why>"
  # A person decides a finding stays as it is. Like resolve, the row is kept — the ledger
  # still shows what was found — but the gate stops counting it, and the decision carries
  # a reason, an author (git identity, as override does) and a time.
  local stage="" id="" reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$stage" && -n "$id" && -n "${reason//[[:space:]]/}" ]] || { echo "FAIL: usage: temper evidence accept --stage <s> --id <n> --reason \"<why>\" (a non-empty reason is required; ids from 'temper evidence list --stage <s>')" >&2; return 1; }
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo "FAIL: no evidence recorded for stage '$stage'" >&2; return 1; }
  local by name email
  name="$(git config user.name 2>/dev/null || true)"
  email="$(git config user.email 2>/dev/null || true)"
  by="$name"
  [[ -n "$email" ]] && by="${by:+$by }<$email>"
  [[ -n "$by" ]] || by="${USER:-unknown}"
  python3 - "$file" "$id" "$reason" "$by" "$(_now)" <<'PY'
import json, sys
f, id_s, reason, by, ts = sys.argv[1:6]
entries = json.load(open(f))
try:
    idx = int(id_s)
except ValueError:
    sys.exit("FAIL: --id must be the 1-based number shown by 'temper evidence list'")
if idx < 1 or idx > len(entries):
    sys.exit("FAIL: no finding #%s in this stage (it has %d entries)" % (id_s, len(entries)))
e = entries[idx - 1]
if not e.get('severity'):
    sys.exit("FAIL: finding #%s carries no severity, so it never counted against a gate" % id_s)
if e.get('resolved'):
    sys.exit("FAIL: finding #%s is already resolved (%s)" % (id_s, e['resolved'].get('fixed_by')))
if e.get('accepted'):
    sys.exit("FAIL: finding #%s is already accepted (%s)" % (id_s, e['accepted'].get('reason')))
e['accepted'] = {'reason': reason, 'author': by, 'ts': ts}
json.dump(entries, open(f, 'w'), indent=2)
print("OK: %s finding #%s accepted by %s — %s" % (e.get('severity'), id_s, by, reason))
PY
}

cmd_evidence_run() { # temper evidence run --stage s --claim c [--phase p] [--scenario x]
                      # [--severity s] [--label L] -- <cmd...>
  # The CLI executes the command ITSELF and records the exit code it observed — so a
  # PROVEN label here means machine-observed, not agent-reported. Deliberately skips
  # cmd_evidence_add's nonzero-exit downgrade: a RED run (exit 1) recorded by the
  # process that ran it is exactly as proven as a green one. Always returns 0 — the
  # record is the product; pass/fail is the gate's business (the printed line and the
  # ledger carry the exit code).
  local stage="" claim="" phase="" scenario="" severity="" label="PROVEN" criterion=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --claim) claim="$2"; shift 2 ;;
      --phase) phase="$2"; shift 2 ;;
      --scenario) scenario="$2"; shift 2 ;;
      --severity) severity="$2"; shift 2 ;;
      --label) label="$2"; shift 2 ;;
      --criterion) criterion="$2"; shift 2 ;;
      --) shift; break ;;
      *) echo "FAIL: unknown flag $1 (command goes after --)" >&2; return 1 ;;
    esac
  done
  [[ -n "$stage" && -n "$claim" && $# -gt 0 ]] || { echo "FAIL: usage: temper evidence run --stage <s> --claim <c> -- <cmd...>" >&2; return 1; }
  # Checked before the command runs: an unknown stage records nothing and runs nothing.
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs
  "$@"
  local exit_code=$?
  local cmd_str="$*"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || (set -C; echo '[]' > "$file") 2>/dev/null || true
  local entry
  entry=$(python3 -c "
import json, sys
claim, cmd, exit_code, severity, label, phase, scenario, criterion, ts = sys.argv[1:]
e = {'claim': claim, 'cmd': cmd, 'exit_code': int(exit_code), 'artifact': None,
     'sha256': None, 'value': None, 'severity': severity or None,
     'phase': phase or None, 'scenario': scenario or None, 'criterion': criterion or None,
     'label': label, 'executed_by': 'cli', 'ts': ts}
print(json.dumps(e))
" "$claim" "$cmd_str" "$exit_code" "$severity" "$label" "$phase" "$scenario" "$criterion" "$(_now)")
  _json_append "$file" "$entry"
  echo "OK: [$label] $stage: $claim (cli-executed, exit $exit_code)"
  return 0
}

cmd_evidence_clear() { # temper evidence clear --stage <s> — truncate that stage's ledger file to []
  local stage=""
  while [[ $# -gt 0 ]]; do
    case "$1" in --stage) stage="$2"; shift 2 ;; *) shift ;; esac
  done
  [[ -n "$stage" ]] || { echo "FAIL: usage: temper evidence clear --stage <s>" >&2; return 1; }
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs
  echo '[]' > "$(_evidence_file "$stage")"
  echo "OK: evidence cleared for '$stage'"
}

cmd_evidence() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    add) cmd_evidence_add "$@" ;;
    run) cmd_evidence_run "$@" ;;
    list) cmd_evidence_list "$@" ;;
    resolve) cmd_evidence_resolve "$@" ;;
    accept) cmd_evidence_accept "$@" ;;
    clear) cmd_evidence_clear "$@" ;;
    *) echo "FAIL: usage: temper evidence <add|run|list|resolve|accept|clear> ..." >&2; return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# config — scriptable read access to .claude/temper.config (the same parser
# every gate uses, exposed so hook scripts and CI steps never re-implement it).
# ---------------------------------------------------------------------------

cmd_config() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    get) [[ -n "${1:-}" ]] || { echo "FAIL: usage: temper config get <dot.path> [default]" >&2; return 1; }
         if [[ "$1" == "fix.max-loops" ]]; then _cfg_get "$1" "${2:-3}"; else _cfg_get "$1" "${2:-}"; fi ;;
    *) echo "FAIL: usage: temper config get <dot.path> [default]" >&2; return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# gate — the whole point. Deterministic PASS/FAIL, evidence-backed.
# ---------------------------------------------------------------------------

_gate_write_verdict() { # _gate_write_verdict <stage> <verdict> <requirements-json-array>
  local stage="$1" verdict="$2" reqs="$3"
  [[ -f "$GATES_FILE" ]] || echo '{}' > "$GATES_FILE"
  python3 -c "
import json, sys
f, stage, verdict, reqs, ts = sys.argv[1:6]
d = json.load(open(f))
d[stage] = {'verdict': verdict, 'requirements': json.loads(reqs), 'ts': ts}
json.dump(d, open(f, 'w'), indent=2)
" "$GATES_FILE" "$stage" "$verdict" "$reqs" "$(_now)"
}

_spec_path() {
  local override="$1"
  if [[ -n "$override" ]]; then echo "$override"; return; fi
  cmd_state_get spec_path ""
}

_evidence_file() { # <stage> -> its ledger file, each path written out in full relative to the
                   # project (an unknown stage has none; callers check _stage_ok first)
  case "$1" in
    intent) echo ".temper/evidence/intent.json" ;;
    plan)   echo ".temper/evidence/plan.json" ;;
    design) echo ".temper/evidence/design.json" ;;
    build)  echo ".temper/evidence/build.json" ;;
    review) echo ".temper/evidence/review.json" ;;
    check)  echo ".temper/evidence/check.json" ;;
    commit) echo ".temper/evidence/commit.json" ;;
    rca)    echo ".temper/evidence/rca.json" ;;
    fix)    echo ".temper/evidence/fix.json" ;;
    *)      echo "" ;;
  esac
}

_clear_evidence_downstream() { # _clear_evidence_downstream <to> — truncates evidence for
                                # <to> and every gate stage after it in the run's own sequence
  local to="$1" seen=false s
  _ensure_dirs
  # A /temper:fix run records its RED/GREEN under the `build` gate and has no plan or
  # design evidence, so its gate sequence is build -> review -> check and a loop back to
  # `rca` or `fix` must clear from `build`. Walking STAGE_SEQ_TEMPER here cleared nothing
  # for a fix run, which left a self-fixed review finding inflating the gate for ever
  # (woningscout #984).
  local seq="$STAGE_SEQ_TEMPER" command="temper"
  [[ -f "$STATE_FILE" ]] && command="$(_json_get_path "$STATE_FILE" command temper)"
  if [[ "$command" == "fix" ]]; then
    seq="build review check"
    case "$to" in rca|fix) to="build" ;; esac
  fi
  for s in $seq; do
    [[ "$s" == "$to" ]] && seen=true
    [[ "$seen" == "true" ]] && echo '[]' > "$(_evidence_file "$s")"
  done
}

# Purpose-built evidence queries — every value crosses the shell/python boundary as an
# argv element, never interpolated into python source, so no claim/detail text can ever
# be misparsed as code.

_ev_count_matching() { # _ev_count_matching <stage> <keyword-regex|""> <phase|""> <exit:any|0|nonzero>
  local stage="$1" keyword="$2" phase="$3" exitfilter="$4"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  python3 -c "
import json, sys, re
file, keyword, phase, exitfilter = sys.argv[1:5]
entries = json.load(open(file))
n = 0
for e in entries:
    if keyword and not re.search(keyword, e.get('claim') or '', re.I):
        continue
    if phase and e.get('phase') != phase:
        continue
    if exitfilter == '0' and e.get('exit_code') != 0:
        continue
    if exitfilter == 'nonzero' and e.get('exit_code') in (0, None):
        continue
    n += 1
print(n)
" "$file" "$keyword" "$phase" "$exitfilter"
}

_ev_last_value() { # _ev_last_value <stage> <keyword-regex|""> -> last matching entry's numeric value, or ""
  local stage="$1" keyword="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo ""; return; }
  python3 -c "
import json, sys, re
file, keyword = sys.argv[1:3]
entries = json.load(open(file))
vals = [e.get('value') for e in entries
        if (not keyword or re.search(keyword, e.get('claim') or '', re.I)) and e.get('value') is not None]
print(vals[-1] if vals else '')
" "$file" "$keyword"
}

_ev_count_severity_in() { # _ev_count_severity_in <stage> <comma-separated severities>
  local stage="$1" sev_csv="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  # A finding marked resolved (temper evidence resolve) stays in the ledger as the record
  # of what was found and fixed, but no longer counts against the gate (woningscout #984).
  python3 -c "
import json, sys
file, sev_csv = sys.argv[1:3]
sevs = set(s for s in sev_csv.split(',') if s)
entries = json.load(open(file))
print(sum(1 for e in entries if e.get('severity') in sevs and not e.get('resolved') and not e.get('accepted')))
" "$file" "$sev_csv"
}

_ev_count_resolved_in() { # _ev_count_resolved_in <stage> <comma-separated severities>
  local stage="$1" sev_csv="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  python3 -c "
import json, sys
file, sev_csv = sys.argv[1:3]
sevs = set(s for s in sev_csv.split(',') if s)
entries = json.load(open(file))
print(sum(1 for e in entries if e.get('severity') in sevs and e.get('resolved')))
" "$file" "$sev_csv"
}

_ev_count_accepted_in() { # _ev_count_accepted_in <stage> <comma-separated severities>
  local stage="$1" sev_csv="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  python3 -c "
import json, sys
file, sev_csv = sys.argv[1:3]
sevs = set(s for s in sev_csv.split(',') if s)
entries = json.load(open(file))
print(sum(1 for e in entries if e.get('severity') in sevs and e.get('accepted')))
" "$file" "$sev_csv"
}

_ev_scenarios_covered() { # _ev_scenarios_covered <stage> -> count of DISTINCT scenarios
                           # recorded with exit_code 0 (an agent traces each Gherkin
                           # scenario to a test via --scenario "<name>" --exit <code>)
  local stage="$1"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  python3 -c "
import json, sys
entries = json.load(open(sys.argv[1]))
covered = {e['scenario'] for e in entries if e.get('scenario') and e.get('exit_code') == 0}
print(len(covered))
" "$file"
}

_intent_uncovered_scenarios() { # _intent_uncovered_scenarios <intent.md> <stage>
                                 # -> \x1f-joined scenario names present in intent.md but
                                 # not recorded as covered (exit_code 0) in the ledger
  local intent="$1" stage="$2"
  local file; file="$(_evidence_file "$stage")"
  python3 -c "
import json, re, sys
intent_path, ev_path = sys.argv[1:3]
names = []
for line in open(intent_path):
    m = re.match(r'^\s*Scenario:\s*(.+?)\s*$', line)
    if m:
        names.append(m.group(1))
covered = set()
try:
    entries = json.load(open(ev_path))
    covered = {e['scenario'] for e in entries if e.get('scenario') and e.get('exit_code') == 0}
except Exception:
    pass
missing = [n for n in names if n not in covered]
print('\x1f'.join(missing))
" "$intent" "$file"
}

_req() { # _req <label> <bool 0|1> <detail> -> emits one requirement json line to stdout, and echoes pass/fail
  local label="$1" ok="$2" detail="$3"
  python3 -c "
import json, sys
print(json.dumps({'name': sys.argv[1], 'pass': sys.argv[2] == '1', 'detail': sys.argv[3]}))
" "$label" "$ok" "$detail"
}

# Draft-intent requirements. Ten checks that apply to **Status:** draft intents
# only — a recorded acceptance is never revisited, so an accepted/completed
# intent records a PASS-with-skip-detail for each instead. Emits one JSON object
# per line (same shape _req produces); intent.md parsing is shared with
# scripts/acceptance.py so the gate and the acceptance checker can never drift.
_intent_draft_reqs() { # _intent_draft_reqs <intent.md>
  # acceptance.py is loaded from its one full path, never by adding a folder to sys.path.
  python3 - "$ACCEPTANCE_PY" "$1" <<'PY'
import importlib.util, json, os, re, sys
_spec = importlib.util.spec_from_file_location('acceptance', sys.argv[1])
A = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(A)

lines = open(sys.argv[2]).read().splitlines()
reqs = []
def add(name, ok, detail):
    reqs.append({'name': name, 'pass': ok, 'detail': detail})

m = re.search(r'^\*\*Status:\*\*\s*(draft|accepted|completed)\s*$', "\n".join(lines), re.I | re.M)
status = m.group(1).lower() if m else None   # None: missing or unknown Status header
if status != 'draft':
    d = ("skipped — intent is %s; this check applies to drafts only "
         "(a recorded acceptance is never revisited)") % status
    if status is None:
        # A missing or unknown Status header is reported by the gate's own status header
        # row; these rows say why they skipped instead of printing Python's None.
        d = ("skipped: no recognized Status header (draft, accepted or completed); this check "
             "applies to drafts only, and the status header requirement reports the missing header")
    for name in ('task context recorded', 'criteria why', 'target users action chain',
                 'criteria ids', 'criteria priority', 'criteria validate',
                 'open questions labeled', 'no duplicate question', 'header fields',
                 'no scenarios in draft', 'no soft words'):
        add(name, True, d)
    print("\n".join(json.dumps(r) for r in reqs))
    sys.exit(0)

def sec(name):
    return A.section_lines(lines, name)

def bullets_with_blocks(sec_lines):
    """Real (non-placeholder) bullets with their continuation blocks."""
    out, cur = [], None
    for l in sec_lines:
        if A.BULLET_RE.match(l):
            if cur: out.append(cur)
            content = A.strip_checkbox(l)
            cur = {'first': content, 'block': [l], 'placeholder': content.startswith('{')}
        elif cur is not None:
            cur['block'].append(l)
    if cur: out.append(cur)
    return [b for b in out if not b['placeholder']]

# --- task context recorded -------------------------------------------------
ctx = sec('Source Traceability')
ctx_lines = [l for l in ctx if re.match(r'^\s*-\s*(consulted|unavailable|none):', l, re.I)]
unaccounted = []
if ctx_lines:
    ctx_text = "\n".join(ctx_lines)
    tk = re.search(r'^\*\*Ticket:\*\*\s*(.+?)\s*$', "\n".join(lines), re.I | re.M)
    raw = A.blank_placeholders(tk.group(1)).strip() if tk else ''
    keys = re.findall(r'[A-Z][A-Z0-9]+-[0-9]+|#[0-9]+|![0-9]+', raw) if raw else []
    for k in keys:
        # whole-token match: no alnum may sit immediately before or after the
        # key — a recorded PROJ-12 must not satisfy a linked PROJ-1.
        if not re.search(r'(?<![A-Za-z0-9])' + re.escape(k) + r'(?![A-Za-z0-9])', ctx_text):
            unaccounted.append(k)
if not ctx_lines or unaccounted:
    if not ctx_lines:
        add('task context recorded', False,
            'no consulted/unavailable/none line under ## Source Traceability — record every linked source')
    else:
        add('task context recorded', False,
            'ticket key(s) never accounted for on a consulted/unavailable line: ' + ' | '.join(unaccounted))
else:
    add('task context recorded', True, '%d source line(s) recorded under Source Traceability' % len(ctx_lines))

# --- criteria family -------------------------------------------------------
crits = [c for c in A.parse_criteria(sec('Success Criteria')) if not c.get('placeholder')]

no_id = [c['first_line'][:40] for c in crits if not c.get('id')]
seen, dups = set(), []
for c in crits:
    if c.get('id') and c['id'] in seen and c['id'] not in dups:
        dups.append(c['id'])
    elif c.get('id'):
        seen.add(c['id'])
if no_id or dups:
    parts = (['duplicate id: ' + d for d in dups] + ['no AC-NN id: ' + s for s in no_id])
    add('criteria ids', False, ' | '.join(parts))
elif not crits:
    add('criteria ids', False, 'no real criteria found')
else:
    add('criteria ids', True, '%d criterion id(s), all unique' % len(crits))

def label(c):
    return c.get('id') or c['first_line'][:40]

no_prio = [label(c) for c in crits if not c.get('priority')]
add('criteria priority', not no_prio,
    'every criterion carries [required]/[optional]' if not no_prio
    else 'no [required]/[optional] on first line of: ' + ' | '.join(no_prio))

bad_v = [label(c) for c in crits if not c['has_validate'] or c['vtype'] not in A.VALIDATE_TYPES]
add('criteria validate', not bad_v,
    'every criterion has a Validate: type' if not bad_v
    else 'missing/unknown Validate: type on: ' + ' | '.join(bad_v))

no_why = [label(c) for c in crits if not c['why']]
add('criteria why', not no_why,
    'every criterion states the outcome or risk it serves' if not no_why
    else 'no Why: line with real text on: ' + ' | '.join(no_why))

# --- target users action chain --------------------------------------------
tusers = bullets_with_blocks(sec('Target Users'))
bad_u = [' '.join(b['block'])[:60] for b in tusers
         if not any(('→' in l or '->' in l) for l in b['block'])]
add('target users action chain', not bad_u,
    'every Target Users bullet is an action chain (user: does -> next)' if not bad_u
    else 'no action chain (→ or ->) on: ' + ' | '.join(bad_u))

# --- open questions --------------------------------------------------------
def norm_q(text):
    t = A.BULLET_RE.sub('', text)
    t = re.sub(r'^\s*\|', '', t)
    t = re.sub(r'^\s*(\[[^\]]*\]|Blocking:|Deferred:)', '', t, flags=re.I)
    t = t.replace('**', '').lower()
    t = re.sub(r'[^a-z0-9 ]', ' ', t)
    return [w for w in t.split()][:8]

oq = bullets_with_blocks(sec('Open Questions'))
unlabeled = [b['first'][:50] for b in oq
             if not re.search(r'\b(blocking|deferred)\b', ' '.join(b['block']), re.I)]
add('open questions labeled', not unlabeled,
    'every open question is labeled Blocking or Deferred' if not unlabeled
    else 'neither blocking nor deferred on: ' + ' | '.join(unlabeled))

dup_q = []
if oq:
    topics = []
    for l in sec('Decisions'):
        d = A.BULLET_RE.sub('', l)
        if '->' in d:
            topics.append(norm_q(d.split('->', 1)[0]))
    for b in oq:
        q = norm_q(b['first'])
        for t in topics:
            if not q or not t:
                continue
            shorter, longer = (q, t) if len(q) <= len(t) else (t, q)
            if len(shorter) >= 4 and longer[:len(shorter)] == shorter:
                dup_q.append(b['first'][:50])
                break
add('no duplicate question', not dup_q,
    'no open question re-asks something already decided' if not dup_q
    else 'already answered in ### Decisions: ' + ' | '.join(dup_q))

# --- header fields ---------------------------------------------------------
missing_h = []
for f in ('Author', 'Created', 'Reviewer'):
    hm = re.search(r'^\*\*' + f + r':\*\*\s*(.+?)\s*$', "\n".join(lines), re.I | re.M)
    val = A.blank_placeholders(hm.group(1)).strip() if hm else ''
    if not val:
        missing_h.append(f)
add('header fields', not missing_h,
    'Author, Created, Reviewer all present' if not missing_h
    else 'missing, empty, or placeholder: ' + ' | '.join(missing_h))

# --- no scenarios in draft -------------------------------------------------
scen = A.scenario_lines(lines)
add('no scenarios in draft', not scen,
    'no Scenario: lines — Plan writes the scenarios' if not scen
    else 'Scenario: line(s) at ' + ' | '.join(str(n) for _, n in scen))

# --- no soft words ---------------------------------------------------------
# A criterion or constraint states what is required. should/may/might/possibly leave
# the reader to guess. A statement that carries a (source: ...) marker is exempt: the
# hedge word belongs to the originator, and ### Decisions records what it means.
SOFT_RE = re.compile(r'\b(should|may|might|possibly)\b', re.I)
META_RE = re.compile(r'^\s*(Why|Validate|Deferred|Blocking):', re.I)

def statements(sec_lines):
    """(label, statement text) per real bullet. The statement is the bullet line plus
    its wrapped continuation lines, up to the first Why:/Validate:/Deferred: line."""
    out, cur = [], None
    in_fence = False
    for l in sec_lines:
        if re.match(r'^\s*(`{3,}|~{3,})', l):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        if A.BULLET_RE.match(l):
            if cur: out.append(cur)
            content = A.strip_checkbox(l)
            if content.startswith('{'):
                cur = None
                continue
            m = re.match(r'^(AC-\d+)\b', content)
            cur = {'label': m.group(1) if m else '"%s"' % content[:30], 'text': [content], 'open': True}
        elif cur is not None and cur['open']:
            if META_RE.match(l):
                cur['open'] = False
            elif l.strip():
                cur['text'].append(l.strip())
    if cur: out.append(cur)
    return [(c['label'], ' '.join(c['text'])) for c in out]

soft = []
for kind, sname in (('criterion', 'Success Criteria'), ('constraint', 'Constraints')):
    for lab, text in statements(sec(sname)):
        if re.search(r'\(source:', text, re.I):
            continue
        body = re.sub(r'`[^`]*`', ' ', text)
        words = []
        for w in SOFT_RE.findall(body):
            if w.lower() not in words:
                words.append(w.lower())
        if words:
            soft.append('%s %s uses %s' % (kind, lab, ', '.join(words)))
add('no soft words', not soft,
    'no should/may/might/possibly in a criterion or constraint without a (source: ...) marker' if not soft
    else 'soft word in: ' + ' | '.join(soft))

print("\n".join(json.dumps(r) for r in reqs))
PY
}

_intent_closure_reqs() { # _intent_closure_reqs <intent.md> -> JSON rows: "out of scope stated"
                         # and "open questions resolved" (both apply to drafts only; the second is informational)
  python3 - "$ACCEPTANCE_PY" "$1" <<'PY'
import importlib.util, json, re, sys
_spec = importlib.util.spec_from_file_location('acceptance', sys.argv[1])
A = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(A)

lines = open(sys.argv[2]).read().splitlines()
reqs = []
def add(name, ok, detail):
    reqs.append({'name': name, 'pass': ok, 'detail': detail})

m = re.search(r'^\*\*Status:\*\*\s*(draft|accepted|completed)\s*$', "\n".join(lines), re.I | re.M)
status = m.group(1).lower() if m else None   # None: missing or unknown Status header

# Both requirements apply only while the intent is a draft: a recorded acceptance is never
# revisited, so an accepted or completed intent skips them with a PASS.
SKIP = ('skipped \u2014 intent is %s; this check applies to drafts only (a recorded acceptance is never revisited)' % status
        if status else
        'skipped: no recognized Status header (draft, accepted or completed); this check applies to drafts only, and the status header requirement reports the missing header')

# --- out of scope stated: a '- Out of scope:' bullet with non-placeholder text ----------
scope = A.section_lines(lines, 'Scope and Non-goals') or A.section_lines(lines, 'Scope')
found = False
for l in scope:
    om = re.match(r'^\s*-\s*Out of scope:\s*(.*?)\s*$', l, re.I)
    if om and re.search(r'[A-Za-z0-9]', A.blank_placeholders(om.group(1))):
        found = True
        break
if status != 'draft':   # explicitly draft only
    add('out of scope stated', True, SKIP)
else:
    add('out of scope stated', found,
        'Scope states what is out of scope' if found
        else 'no "- Out of scope:" bullet with real text under ### Scope and Non-goals')

# --- open questions resolved: a draft reports its Blocking questions (informational) -------
# Drafts legitimately carry Blocking questions (the shipped example does), so this never fails
# a draft; it names what is still open so the person answers it before accepting.
if status != 'draft':
    add('open questions resolved', True, SKIP)
else:
    blocking = []
    cur = None
    for l in A.section_lines(lines, 'Open Questions'):
        if A.BULLET_RE.match(l):
            cur = [l]
            blocking.append(cur)
        elif cur is not None:
            cur.append(l)
    blocking = [' '.join(b).strip()[:60] for b in blocking
                if not A.strip_checkbox(b[0]).startswith('{')
                and re.match(r'^\W*blocking\b', A.strip_checkbox(b[0]), re.I)]
    add('open questions resolved', True,
        'no Blocking question remains' if not blocking
        else '%d Blocking question(s) still open on the draft; answer them into ### Decisions before accepting: %s' % (len(blocking), ' | '.join(blocking)))
print("\n".join(json.dumps(r) for r in reqs))
PY
}

gate_intent() {
  # The fail-fast gate: intent is the artifact everything downstream is derived from,
  # so a wrong intent multiplies into wrong scenarios, a wrong plan, and a wrong
  # build — tokens spent for nothing. This gate makes the human review the CHEAP
  # artifact before the expensive stages run. Mechanically checkable floor: a Problem
  # section with real content (not template placeholders), at least one success
  # criterion, and a Status header. intent.md absent => the run took the trivial path
  # (no artifacts) => PASS; the commit gate requires an intent verdict exactly when
  # the artifact exists, so a skipped gate on a real intent cannot reach commit.
  local spec_path="$1"
  local reqs=() all_pass=1
  if [[ ! -f "$spec_path/intent.md" ]]; then
    reqs+=("$(_req "intent artifact" 1 "intent.md absent — trivial path, no artifacts")")
  else
    local problem_lines criteria status_line
    # A placeholder starts a line with '{' and runs to the line that closes it with '}',
    # so the second line of a placeholder spanning two lines is not content either.
    problem_lines=$(awk '
      function depth(s,   t, o, c) { t = s; o = gsub(/\{/, "", t); t = s; c = gsub(/\}/, "", t); return o - c }
      /^#+[[:space:]]*Problem/ { f=1; open_ph=0; next }
      f && /^#+[[:space:]]/ { f=0 }
      !f { next }
      open_ph > 0 { open_ph += depth($0); next }
      /^[[:space:]]*\{/ { open_ph = depth($0); if (open_ph < 0) open_ph = 0; next }
      NF { c++ }
      END { print c+0 }
    ' "$spec_path/intent.md")
    if [[ "$problem_lines" -gt 0 ]]; then
      reqs+=("$(_req "problem stated" 1 "Problem section has $problem_lines line(s) of content")")
    else
      reqs+=("$(_req "problem stated" 0 "Problem section is missing, empty, or still template placeholders")")
      all_pass=0
    fi
    # A criterion is a '- ' line whose CONTENT isn't a template placeholder: strip the
    # optional checkbox and the 'AC-NN [required]: ' prefix, then reject anything still
    # starting with '{' — the template's own '{criterion}' bullets must not count.
    criteria=$(awk '
      /^#+[[:space:]]*Success Criteria/ { f=1; next }
      f && /^#+[[:space:]]/ { f=0 }
      f && /^- / { t=$0; sub(/^- \[[ xX]\] */,"",t); sub(/^- */,"",t); sub(/^AC-[0-9]+[ \t]*\[(required|optional)\]:[ \t]*/,"",t); if (t !~ /^\{/) c++ }
      END { print c+0 }
    ' "$spec_path/intent.md")
    if [[ "$criteria" -gt 0 ]]; then
      reqs+=("$(_req "success criteria" 1 "$criteria criterion/criteria listed")")
    else
      reqs+=("$(_req "success criteria" 0 "no real success criteria (template placeholders don't count) — nothing downstream can be validated against")")
      all_pass=0
    fi
    # The Status value must be an actual lifecycle state, not the template's
    # '{draft | accepted | completed}' placeholder.
    if grep -qiE '^\*\*Status:\*\*[[:space:]]*(draft|accepted|completed)[[:space:]]*$' "$spec_path/intent.md"; then
      status_line="$(grep -m1 -iE '^\*\*Status:\*\*[[:space:]]*(draft|accepted|completed)[[:space:]]*$' "$spec_path/intent.md")"
      reqs+=("$(_req "status header" 1 "$status_line")")
    else
      reqs+=("$(_req "status header" 0 "no **Status:** draft|accepted|completed header (a placeholder doesn't count) — the lifecycle has nowhere to live")")
      all_pass=0
    fi
    # Draft-stage requirements (skipped with a PASS row on accepted/completed).
    local draft_line
    while IFS= read -r draft_line; do
      [[ -z "$draft_line" ]] && continue
      reqs+=("$draft_line")
      grep -q '"pass": false' <<<"$draft_line" && all_pass=0
    done < <(_intent_draft_reqs "$spec_path/intent.md")
    while IFS= read -r draft_line; do
      [[ -z "$draft_line" ]] && continue
      reqs+=("$draft_line")
      grep -q '"pass": false' <<<"$draft_line" && all_pass=0
    done < <(_intent_closure_reqs "$spec_path/intent.md")
  fi
  local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

_unfenced_scenarios() { # _unfenced_scenarios <intent.md> -> \x1f-joined "lineno: text" for
                        # every Scenario: line not protected by a ```gherkin fence
  python3 - "$1" <<'PY'
import re, sys
bad = []
fence = None   # info string of the currently open fence, else None
for i, l in enumerate(open(sys.argv[1]).read().splitlines(), 1):
    m = re.match(r'^\s*(`{3,}|~{3,})\s*(\S*)', l)
    if m:
        fence = (m.group(2) or '') if fence is None else None
        continue
    if fence != 'gherkin' and re.match(r'^\s*Scenario:', l):
        bad.append('%d: %s' % (i, l.strip()[:40]))
print('\x1f'.join(bad))
PY
}

_cross_repo_recorded() { # _cross_repo_recorded <plan.md> -> "ok" or a FAIL detail
  python3 - "$1" <<'PY'
import re, sys
lines = open(sys.argv[1]).read().splitlines()
sec, active = [], False
for l in lines:
    h = re.match(r'^(#{1,6})\s', l)
    if h:
        if active:
            break
        if re.search(r'cross.?repo search', l, re.I):
            active = True
            continue
    if active:
        sec.append(l)
if not active:
    print('no heading matching "Cross-Repo Search" in plan.md')
    sys.exit(0)
for l in sec:
    m = re.match(r'^\s*-\s*(used|not available):\s*(.+?)\s*$', l, re.I)
    if m and re.search(r'[A-Za-z0-9]', re.sub(r'\{[^{}]*\}', '', m.group(2))):
        print('ok')
        sys.exit(0)
print('Cross-Repo Search section has no "- used:" / "- not available:" line with real text')
PY
}

gate_plan() {
  local spec_path="$1"
  local reqs=() all_pass=1
  if [[ -f "$spec_path/intent.md" && -f "$spec_path/tasks.md" ]]; then
    reqs+=("$(_req "artifacts exist" 1 "intent.md + tasks.md present")")
  else
    reqs+=("$(_req "artifacts exist" 0 "intent.md and/or tasks.md missing under $spec_path")")
    all_pass=0
  fi
  if [[ -f "$spec_path/intent.md" ]]; then
    local criteria scenarios
    # Section parsing: a heading at any level opens, the next heading of any level
    # closes — so `### Constraints` bullets after `### Success Criteria` never count.
    criteria=$(awk 'tolower($0) ~ /^#+[ \t]*success criteria/ {f=1; next} f && /^#/ {f=0} f && /^- /{c++} END{print c+0}' "$spec_path/intent.md")
    scenarios=$(_count_lines_matching '^[[:space:]]*Scenario:' "$spec_path/intent.md")
    if [[ "$criteria" -gt 0 && "$scenarios" -ge "$criteria" ]]; then
      reqs+=("$(_req "criteria -> scenarios" 1 "$scenarios scenario(s) for $criteria success criterion/criteria")")
    else
      reqs+=("$(_req "criteria -> scenarios" 0 "$scenarios scenario(s) for $criteria success criterion/criteria — need >=1 scenario per criterion")")
      all_pass=0
    fi
    # Every criterion is explicitly tied to the scenario/evidence that proves it.
    local acc_out acc_rc
    acc_out="$(python3 "$ACCEPTANCE_PY" plan "$spec_path/intent.md" "$(_evidence_file plan)" 2>&1)"; acc_rc=$?
    if [[ "$acc_rc" -eq 0 ]]; then
      reqs+=("$(_req "criteria -> validation" 1 "$acc_out")")
    else
      reqs+=("$(_req "criteria -> validation" 0 "$acc_out")")
      all_pass=0
    fi
    # Each scenario is one fenced ```gherkin block — bare indented steps render as
    # one run-on paragraph in every markdown surface.
    local scen_total unfenced_raw unfenced_arr unfenced="" u
    scen_total=$(_count_lines_matching '^[[:space:]]*Scenario:' "$spec_path/intent.md")
    if [[ "$scen_total" -eq 0 ]]; then
      reqs+=("$(_req "scenarios in gherkin blocks" 1 "no scenarios — nothing to fence")")
    else
      unfenced_raw="$(_unfenced_scenarios "$spec_path/intent.md")"
      if [[ -n "$unfenced_raw" ]]; then
        IFS=$'\x1f' read -r -a unfenced_arr <<< "$unfenced_raw"
        for u in "${unfenced_arr[@]}"; do
          [[ -n "$u" ]] || continue
          [[ -n "$unfenced" ]] && unfenced+=" | "
          unfenced+="$u"
        done
      fi
      if [[ -z "$unfenced" ]]; then
        reqs+=("$(_req "scenarios in gherkin blocks" 1 "$scen_total scenario(s), all inside gherkin fences")")
      else
        reqs+=("$(_req "scenarios in gherkin blocks" 0 "Scenario: not inside a gherkin fence — $unfenced")")
        all_pass=0
      fi
    fi
  fi
  # Cross-repo code search: absence of the tool never fails; a missing record does.
  if [[ ! -f "$spec_path/plan.md" ]]; then
    reqs+=("$(_req "cross-repo search recorded" 1 "no plan.md — nothing to record yet")")
  else
    local cr_out; cr_out="$(_cross_repo_recorded "$spec_path/plan.md")"
    if [[ "$cr_out" == "ok" ]]; then
      reqs+=("$(_req "cross-repo search recorded" 1 "plan.md records the cross-repo search (or why none ran)")")
    else
      reqs+=("$(_req "cross-repo search recorded" 0 "$cr_out")")
      all_pass=0
    fi
  fi
  local complexity; complexity="$(cmd_state_get complexity "")"
  if [[ "$complexity" == "medium" || "$complexity" == "complex" ]]; then
    if [[ -f "$spec_path/plan.md" ]] && grep -qiE '^#+ .*blast radius' "$spec_path/plan.md"; then
      reqs+=("$(_req "blast radius documented" 1 "plan.md has a Blast Radius section ($complexity change)")")
    else
      reqs+=("$(_req "blast radius documented" 0 "plan.md missing a Blast Radius section — required for $complexity complexity")")
      all_pass=0
    fi
  fi
  local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

gate_build() {
  local spec_path="$1"
  local reqs=() all_pass=1
  local red_n green_n
  red_n=$(_ev_count_matching build test red nonzero)
  green_n=$(_ev_count_matching build test green 0)
  if [[ "$red_n" -gt 0 && "$green_n" -gt 0 ]]; then
    reqs+=("$(_req "RED then GREEN" 1 "$red_n failing-first run(s), $green_n passing run(s) recorded")")
  else
    reqs+=("$(_req "RED then GREEN" 0 "need >=1 failing test run (RED) and >=1 passing run (GREEN); have red=$red_n green=$green_n")")
    all_pass=0
  fi
  if [[ -f "$spec_path/tasks.md" ]]; then
    local unchecked
    unchecked=$(_count_lines_matching '^[[:space:]]*- \[ \]' "$spec_path/tasks.md")
    if [[ "$unchecked" -eq 0 ]]; then
      reqs+=("$(_req "all tasks complete" 1 "no unchecked tasks in tasks.md")")
    else
      reqs+=("$(_req "all tasks complete" 0 "$unchecked unchecked task(s) remain in tasks.md")")
      all_pass=0
    fi
  fi
  # Checkpoint feedback: every `feedback #N` row the orchestrator recorded must be
  # answered by a `feedback-resolved` row — applied (detail optional) or declined
  # with a reason. A decline with no reason is not an answer.
  local fb_answered fb_detail
  fb_detail="$(python3 - "$(_evidence_file build)" <<'PY'
import json, re, sys, os
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    rows = []
fb = {m.group(1) for r in rows if r.get('phase') == 'feedback'
      for m in [re.search(r'feedback #(\d+)', r.get('claim') or '')] if m}
res = {m.group(1): r for r in rows if r.get('phase') == 'feedback-resolved'
       for m in [re.search(r'feedback #(\d+)', r.get('claim') or '')] if m}
if not fb:
    print('SKIP')
else:
    unanswered = []
    for n in sorted(fb, key=int):
        r = res.get(n)
        if r is None:
            unanswered.append('feedback #%s' % n)
        else:
            c = r.get('claim') or ''
            m = re.search(r'declined\s*[—-]\s*(.*)', c)
            if 'declined' in c and (not m or not m.group(1).strip()):
                unanswered.append('feedback #%s (declined with no reason)' % n)
    print(' | '.join(unanswered) if unanswered else 'OK')
PY
)"
  if [[ "$fb_detail" == "SKIP" ]]; then
    reqs+=("$(_req "checkpoint feedback answered" 1 "no feedback rows — nothing to answer")")
  elif [[ "$fb_detail" == "OK" ]]; then
    reqs+=("$(_req "checkpoint feedback answered" 1 "every feedback row answered (applied or declined with reason)")")
  else
    reqs+=("$(_req "checkpoint feedback answered" 0 "unanswered: $fb_detail")")
    all_pass=0
  fi
  local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

gate_design() {
  # v8.1: no longer vacuous. Design is still an optional stage with no
  # single-correct-output *quality* requirement — but when it RAN (design.md exists),
  # the one thing reference/design.md makes non-negotiable is checkable: an Areas of
  # Concern section, present even when it says none was flagged. A policy conflict
  # silently unflagged is exactly what an unattended design->build crossing must not
  # let through. design.md absent => stage was legitimately skipped => PASS.
  local spec_path="$1"
  local reqs=() all_pass=1
  if [[ ! -f "$spec_path/design.md" ]]; then
    reqs+=("$(_req "design artifact" 1 "design.md absent — stage skipped (trivial/simple, or phases.design: false)")")
  elif grep -qiE '^#+ .*areas of concern' "$spec_path/design.md"; then
    reqs+=("$(_req "concerns flagged" 1 "design.md has an Areas of Concern section ('None flagged — why' counts)")")
  else
    reqs+=("$(_req "concerns flagged" 0 "design.md has no Areas of Concern section — flag conflicts, or state 'None flagged — {why}'")")
    all_pass=0
  fi
  local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

_ev_open_findings() { # _ev_open_findings <stage> <comma-separated severities>
                      # -> \x1f-joined claims of unresolved findings at those severities
  local stage="$1" sev_csv="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo ""; return; }
  python3 -c "
import json, sys
file, sev_csv = sys.argv[1:3]
sevs = set(s for s in sev_csv.split(',') if s)
entries = json.load(open(file))
claims = [e.get('claim') or '(no claim)' for e in entries
          if e.get('severity') in sevs and not e.get('resolved') and not e.get('accepted')]
print('\x1f'.join(claims))
" "$file" "$sev_csv"
}

_ev_latest_claim_exit() { # _ev_latest_claim_exit <stage> <keyword-regex>
                          # -> "<exit_code>|<claim>" of the LAST row matching, or ""
  local stage="$1" keyword="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo ""; return; }
  python3 -c "
import json, sys, re
file, keyword = sys.argv[1:3]
entries = json.load(open(file))
hits = [e for e in entries if re.search(keyword, e.get('claim') or '', re.I)]
print(('%s|%s' % (hits[-1].get('exit_code'), hits[-1].get('claim') or '')) if hits else '')
" "$file" "$keyword"
}

gate_review() {
  local block_on sev_csv
  block_on="$(_cfg_get review.block-on critical)"
  sev_csv="$(printf '%s' "$block_on" | tr $'\x1f' ',')"
  local n; n=$(_ev_count_severity_in review "$sev_csv")
  local resolved; resolved=$(_ev_count_resolved_in review "$sev_csv")
  local resolved_note=""
  [[ "$resolved" -gt 0 ]] && resolved_note=", $resolved resolved in this run"
  local accepted; accepted=$(_ev_count_accepted_in review "$sev_csv")
  [[ "$accepted" -gt 0 ]] && resolved_note+=", $accepted accepted"
  local all_pass=1 reqs=()
  if [[ "$n" -eq 0 ]]; then
    reqs+=("$(_req "no blocking findings" 1 "0 open findings at severity [$sev_csv]$resolved_note")")
  else
    # Name every open blocking finding — a count tells the reader nothing.
    local open_raw open_arr open_names="" name
    open_raw="$(_ev_open_findings review "$sev_csv")"
    IFS=$'\x1f' read -r -a open_arr <<< "$open_raw"
    for name in "${open_arr[@]}"; do
      [[ -n "$name" ]] || continue
      [[ -n "$open_names" ]] && open_names+=" | "
      open_names+="$name"
    done
    reqs+=("$(_req "no blocking findings" 0 "$n open finding(s) at severity [$sev_csv]$resolved_note — $open_names")")
    all_pass=0
  fi
  # The Review brief records a completion row even when there are no findings —
  # otherwise an empty ledger is indistinguishable from a review that never ran.
  local completion; completion="$(_ev_latest_claim_exit review 'review completed')"
  if [[ -n "$completion" && "${completion%%|*}" == "0" ]]; then
    reqs+=("$(_req "review completed" 1 "${completion#*|}")")
  else
    reqs+=("$(_req "review completed" 0 "no review completion evidence — an empty findings ledger is not a review")")
    all_pass=0
  fi
  local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

gate_check() {
  local spec_path="$1"
  local threshold; threshold="$(_cfg_get check.coverage-threshold 80)"
  local reqs=() all_pass=1
  local tests_n; tests_n=$(_ev_count_matching check test "" 0)
  if [[ "$tests_n" -gt 0 ]]; then
    reqs+=("$(_req "tests pass" 1 "$tests_n green test run(s) recorded")")
  else
    reqs+=("$(_req "tests pass" 0 "no passing test-run evidence recorded")")
    all_pass=0
  fi
  if [[ -f "$spec_path/intent.md" ]]; then
    local scenario_total scenario_covered
    scenario_total=$(_count_lines_matching '^[[:space:]]*Scenario:' "$spec_path/intent.md")
    scenario_covered=$(_ev_scenarios_covered check)
    if [[ "$scenario_total" -eq 0 ]]; then
      : # no scenarios in intent.md (e.g. no spec for this run) — nothing to require
    elif [[ "$scenario_covered" -ge "$scenario_total" ]]; then
      reqs+=("$(_req "scenarios traced to tests" 1 "$scenario_covered/$scenario_total scenario(s) covered")")
    else
      # Join with ' | ', not ',' — a scenario name may itself contain a comma, which
      # would make a comma-joined list ambiguous about where one name ends. IFS-based
      # array joining ("${arr[*]}") only honors IFS's FIRST character, not the whole
      # string, so a real multi-char separator needs an explicit loop.
      local missing_raw missing_arr missing="" name
      missing_raw="$(_intent_uncovered_scenarios "$spec_path/intent.md" check)"
      IFS=$'\x1f' read -r -a missing_arr <<< "$missing_raw"
      for name in "${missing_arr[@]}"; do
        [[ -n "$missing" ]] && missing+=" | "
        missing+="$name"
      done
      reqs+=("$(_req "scenarios traced to tests" 0 "$scenario_covered/$scenario_total covered — missing: $missing")")
      all_pass=0
    fi
  fi
  local cov_val; cov_val=$(_ev_last_value check coverage)
  # Both values cross as argv, never as Python source: the threshold comes from the
  # project config and the value from the ledger. A value that is not a number FAILs.
  if [[ -n "$cov_val" ]] && python3 -c "import sys; sys.exit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)" "$cov_val" "$threshold" 2>/dev/null; then
    reqs+=("$(_req "coverage >= threshold" 1 "$cov_val% >= $threshold% threshold")")
  else
    reqs+=("$(_req "coverage >= threshold" 0 "recorded coverage '${cov_val:-none}' vs threshold $threshold%")")
    all_pass=0
  fi
  if [[ -f "$spec_path/intent.md" ]]; then
    # Every criterion has explicit, SUPPORTED passing evidence — the same checker
    # gate plan used on the artifact's internal links, now against the ledger.
    local acc_out acc_rc
    acc_out="$(python3 "$ACCEPTANCE_PY" check "$spec_path/intent.md" "$(_evidence_file check)" 2>&1)"; acc_rc=$?
    if [[ "$acc_rc" -eq 0 ]]; then
      reqs+=("$(_req "acceptance evidence" 1 "$acc_out")")
    else
      reqs+=("$(_req "acceptance evidence" 0 "$acc_out")")
      all_pass=0
    fi
  fi
  local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

_stage_satisfied() { # _stage_satisfied <stage> -> 0 when gates.json says PASS or a human
                     # override covers the stage (the same standard the full loop applies)
  local verdict; verdict="$(_json_get_path "$GATES_FILE" "$1.verdict" "MISSING")"
  [[ "$verdict" == "PASS" ]] && return 0
  python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = []
sys.exit(0 if any(o.get('stage') == sys.argv[2] for o in d) else 1)
" "$OVERRIDES_FILE" "$1" 2>/dev/null
}

_glob_touch_match() { # _glob_touch_match <file> <pattern>  (a project pattern from autonomy.park-on-touch)
  # Proper pattern match, not a substring test: a pattern naming the auth folder at any
  # depth matches the `auth` path SEGMENT, never `auth` inside `oauth` or
  # `authenticator`; a star inside a segment (any .sql file in a migrations folder) is
  # honored. file + pattern cross as argv, never source.
  local file="$1" pattern="$2"
  python3 - "$file" "$pattern" <<'PY'
import re, sys
target, pat = sys.argv[1].lstrip("./"), sys.argv[2]
out, i, n = [], 0, len(pat)
while i < n:
    if pat[i:i+3] == "**/": out.append("(?:.*/)?"); i += 3
    elif pat[i:i+3] == "/**": out.append("(?:/.*)?"); i += 3
    elif pat[i:i+2] == "**": out.append(".*"); i += 2
    elif pat[i] == "*": out.append("[^/]*"); i += 1
    elif pat[i] == "?": out.append("[^/]"); i += 1
    else: out.append(re.escape(pat[i])); i += 1
sys.exit(0 if re.match("^" + "".join(out) + "$", target) else 1)
PY
}

gate_commit() {
  local reqs=() all_pass=1
  local run_mode; run_mode="$(cmd_state_get run_mode interactive)"

  # Artifact-only carve-out: a commit whose ENTIRE staged set lives under
  # .temper/specs/ is the committed-artifact chain doing its job — capturing an
  # intent draft, accepting a plan at its gate — and blocking it until build/review/
  # check have verdicts would make mid-run artifact commits impossible. Code commits
  # are untouched: one staged file outside .temper/specs/ and every gate below applies.
  local staged_all staged_specs
  staged_all=$(git -C "$REPO_ROOT" diff --cached --name-only 2>/dev/null | grep -c .)
  staged_specs=$(git -C "$REPO_ROOT" diff --cached --name-only 2>/dev/null | grep -c '^\.temper/specs/')
  if [[ "${staged_all:-0}" -gt 0 && "$staged_all" -eq "${staged_specs:-0}" ]]; then
    reqs+=("$(_req "artifact-only commit" 1 "$staged_all staged file(s), all under .temper/specs/ — the artifact chain passes the fence; code commits still need every gate")")
    local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
    echo "$reqs_json" 1
    return
  fi

  # Degrade open with no active run: the docs say it, the trivial path relies on
  # it, and the pre-commit hook runs this gate on EVERY commit — demanding stage
  # verdicts from a repo that simply has a .temper/ directory blocked every
  # out-of-run commit.
  if [[ ! -f "$STATE_FILE" ]]; then
    reqs+=("$(_req "active run" 1 "no active run — nothing to gate")")
    local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
    echo "$reqs_json" 1
    return
  fi

  # Build-checkpoint carve-out (docs/decisions/0009): a per-task checkpoint
  # commit lands while next_stage is still build, when the full commit gate
  # would demand review/check verdicts that cannot exist yet. Only when the run
  # is a temper run on its own branch with every upstream gate Build owes
  # satisfied, and the last build test run is GREEN. The final completion commit
  # still faces every gate (next_stage has moved on by then).
  local ck_command ck_next ck_branch cur_branch
  ck_command="$(cmd_state_get command temper)"
  ck_next="$(cmd_state_get next_stage "")"
  ck_branch="$(cmd_state_get branch "")"
  cur_branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
  if [[ "$ck_next" == "build" && "$ck_command" == "temper" && -n "$ck_branch" \
        && "$cur_branch" == "$ck_branch" ]]; then
    local upstream_ok=true sp
    sp="$(cmd_state_get spec_path "")"
    _stage_satisfied plan || upstream_ok=false
    if [[ -n "$sp" && -f "$sp/intent.md" ]]; then _stage_satisfied intent || upstream_ok=false; fi
    if [[ -n "$sp" && -f "$sp/design.md" ]]; then _stage_satisfied design || upstream_ok=false; fi
    if [[ "$upstream_ok" == "true" ]]; then
      local last_green; last_green="$(python3 - "$(_evidence_file build)" <<'PY'
import json, sys
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    rows = []
hits = [r for r in rows if r.get('phase') == 'green' and 'test' in (r.get('claim') or '').lower()]
if hits:
    print('%s|%s' % (hits[-1].get('exit_code'), hits[-1].get('claim') or ''))
PY
)"
      if [[ -n "$last_green" && "${last_green%%|*}" == "0" ]]; then
        reqs+=("$(_req "build checkpoint commit" 1 "per-task checkpoint on $cur_branch; last GREEN test run: ${last_green#*|}")")
        local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
        echo "$reqs_json" 1
        return
      fi
      if [[ -n "$last_green" && "${last_green%%|*}" != "0" ]]; then
        reqs+=("$(_req "build checkpoint commit" 0 "last test run is RED (exit ${last_green%%|*}): ${last_green#*|}")")
        local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
        echo "$reqs_json" 0
        return 1
      fi
      # no test rows yet — fall through to the full commit gate
    fi
  fi

  # /temper:fix has no plan stage — RCA and Fix aren't gated through 'plan', so requiring
  # that verdict would permanently FAIL every fix commit (never computed). A stale "eval"
  # key from a pre-upgrade .temper/gates.json is simply never visited: this loop only
  # ever iterates stages_to_check below, which no longer names eval.
  local command stages_to_check
  command="$(cmd_state_get command temper)"
  if [[ "$command" == "fix" ]]; then
    stages_to_check="build review check"
  else
    stages_to_check="plan build review check"
    # Intent and design are artifact-conditional: each stage's gate must have run
    # (any verdict) exactly when its artifact exists. An intent nobody gated, or an
    # unflagged design.md, must not slide through the commit gate — while a trivial
    # run that produced neither artifact owes neither verdict.
    local spec_path_cond; spec_path_cond="$(cmd_state_get spec_path "")"
    if [[ -n "$spec_path_cond" ]]; then
      [[ -f "$spec_path_cond/intent.md" ]] && stages_to_check="intent $stages_to_check"
      [[ -f "$spec_path_cond/design.md" ]] && stages_to_check="${stages_to_check/plan build/plan design build}"
    fi
  fi
  for s in $stages_to_check; do
    local verdict; verdict="$(_json_get_path "$GATES_FILE" "$s.verdict" "MISSING")"
    if [[ "$verdict" == "PASS" ]]; then
      reqs+=("$(_req "$s gate" 1 "PASS")")
      continue
    fi
    local override; override="$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = []
print('yes' if any(o.get('stage') == sys.argv[2] for o in d) else 'no')
" "$OVERRIDES_FILE" "$s" 2>/dev/null || echo no)"
    if [[ "$override" == "yes" ]]; then
      reqs+=("$(_req "$s gate" 1 "$verdict, overridden by human")")
    else
      reqs+=("$(_req "$s gate" 0 "$verdict, no override recorded")")
      all_pass=0
    fi
  done
  if [[ "$run_mode" == "autonomous" ]]; then
    local max_blast; max_blast="$(_cfg_get autonomy.max-blast-radius 15)"
    # Checkpoint commits land before Review/Check run, so a plain status diff
    # returns nothing. When the run recorded a base_sha, the changed set is
    # base_sha..HEAD plus still-uncommitted paths; without one, the working tree.
    local base_sha changed_n
    base_sha="$(cmd_state_get base_sha "")"
    if [[ -n "$base_sha" ]] && git -C "$REPO_ROOT" cat-file -e "$base_sha" 2>/dev/null; then
      changed_n=$( { git -C "$REPO_ROOT" diff --name-only "$base_sha" 2>/dev/null
                     git -C "$REPO_ROOT" status --porcelain 2>/dev/null | awk '{print $NF}'
                   } | sort -u | grep -c . )
    else
      changed_n=$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    fi
    if [[ "$changed_n" -le "$max_blast" ]]; then
      reqs+=("$(_req "blast radius" 1 "$changed_n file(s) <= $max_blast")")
    else
      reqs+=("$(_req "blast radius" 0 "$changed_n file(s) exceeds autonomy.max-blast-radius=$max_blast")")
      all_pass=0
    fi
    local patterns; patterns="$(_cfg_get autonomy.park-on-touch "")"
    local touched=""
    if [[ -n "$patterns" ]]; then
      local pats=()
      IFS=$'\x1f' read -r -a pats <<< "$patterns"
      while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        for p in "${pats[@]}"; do
          if _glob_touch_match "$f" "$p"; then touched="$f matches $p"; fi
        done
      done < <(git -C "$REPO_ROOT" status --porcelain 2>/dev/null | awk '{print $2}')
    fi
    if [[ -z "$touched" ]]; then
      reqs+=("$(_req "park-on-touch paths" 1 "no changed file matches a park-on-touch pattern")")
    else
      reqs+=("$(_req "park-on-touch paths" 0 "$touched")")
      all_pass=0
    fi
  fi
  local reqs_json; reqs_json=$(python3 -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

cmd_gate() {
  _state_migrate_legacy
  local stage="${1:-}"; shift || true
  local spec_path_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in --spec-path) spec_path_override="$2"; shift 2 ;; *) shift ;; esac
  done
  _ensure_dirs
  local ok=false
  for s in $STAGES; do [[ "$stage" == "$s" ]] && ok=true; done
  [[ "$ok" == "true" ]] || { echo "FAIL: usage: temper gate <intent|plan|design|build|review|check|commit>" >&2; return 1; }

  local spec_path; spec_path="$(_spec_path "$spec_path_override")"
  # intent and design treat an ABSENT artifact as a legitimate skip — which makes an
  # EMPTY spec path poisonous for them: with no state and no --spec-path, the gate
  # would test -f "/intent.md", find nothing, and record a vacuous PASS that never
  # looked at the real draft (and would silently pay a stage-marker debt). Refuse to
  # guess: no target => usage error, no verdict written.
  if [[ -z "$spec_path" && ( "$stage" == "intent" || "$stage" == "design" ) ]]; then
    echo "FAIL: no spec path — pass --spec-path <dir> or run 'temper state init' first" >&2
    echo "      (gate $stage treats a missing artifact as a legitimate skip, so it refuses to guess where to look)" >&2
    return 1
  fi
  local out reqs_json all_pass
  case "$stage" in
    intent) out=$(gate_intent "$spec_path") ;;
    plan) out=$(gate_plan "$spec_path") ;;
    design) out=$(gate_design "$spec_path") ;;
    build) out=$(gate_build "$spec_path") ;;
    review) out=$(gate_review) ;;
    check) out=$(gate_check "$spec_path") ;;
    commit) out=$(gate_commit) ;;
  esac
  if [[ -n "${out:-}" ]]; then
    reqs_json="${out% *}"
    all_pass="${out##* }"
  fi

  local verdict="FAIL"
  [[ "$all_pass" == "1" ]] && verdict="PASS"
  _gate_write_verdict "$stage" "$verdict" "$reqs_json"
  # Per-criterion status for the live view. Fail open: never changes the verdict.
  _status_write "$spec_path" >/dev/null 2>&1 || true

  echo "temper gate $stage -> $verdict"
  python3 -c "
import json, sys
for r in json.loads(sys.argv[1]):
    mark = 'v' if r['pass'] else 'x'
    print(f\"  [{mark}] {r['name']} — {r['detail']}\")
" "$reqs_json"

  [[ "$verdict" == "PASS" ]] && return 0 || return 1
}

# ---------------------------------------------------------------------------
# status — per-criterion pass/open view of intent.md against the evidence ledger,
# written to .temper/status.json after every gate (the mods UI reads it; nothing
# here is a verdict — gates.json owns those).
# ---------------------------------------------------------------------------

_status_write() { # _status_write <spec-path> -> writes .temper/status.json, prints it
  local spec_path="$1" out
  [[ -n "$spec_path" && -f "$spec_path/intent.md" ]] || return 1
  out="$(python3 "$ACCEPTANCE_PY" status "$spec_path/intent.md" "$EVIDENCE_DIR")" || return 1
  printf '%s\n' "$out" > "$STATUS_FILE" || return 1
  printf '%s\n' "$out"
}

cmd_status() { # temper status [--json] [--spec-path P]
  _state_migrate_legacy
  local as_json=false spec_path_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) as_json=true; shift ;;
      --spec-path) spec_path_override="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  _ensure_dirs
  local spec_path; spec_path="$(_spec_path "$spec_path_override")"
  if [[ -z "$spec_path" || ! -f "$spec_path/intent.md" ]]; then
    echo "FAIL: no intent.md to report on — pass --spec-path <dir> or run 'temper state init' first" >&2
    return 1
  fi
  local out
  out="$(python3 "$ACCEPTANCE_PY" status "$spec_path/intent.md" "$EVIDENCE_DIR")" || { echo "FAIL: could not compute criteria status" >&2; return 1; }
  printf '%s\n' "$out" > "$STATUS_FILE" 2>/dev/null || true
  if [[ "$as_json" == "true" ]]; then
    printf '%s\n' "$out"
  else
    python3 -c "
import json, sys
for c in json.loads(sys.argv[1])['criteria']:
    ev = '; '.join(c['evidence']) if c['evidence'] else 'no evidence'
    print('  [%s] %s (%s) — %s' % ('v' if c['status'] == 'passed' else ' ', c['id'], c['priority'], ev))
" "$out"
  fi
}

# ---------------------------------------------------------------------------
# override
# ---------------------------------------------------------------------------

cmd_override() {
  local stage="${1:-}"; shift || true
  local reason=""
  while [[ $# -gt 0 ]]; do case "$1" in --reason) reason="$2"; shift 2 ;; *) shift ;; esac; done
  [[ -n "$stage" && -n "$reason" ]] || { echo "FAIL: usage: temper override <stage> --reason \"...\"" >&2; return 1; }
  _ensure_dirs
  [[ -f "$OVERRIDES_FILE" ]] || echo '[]' > "$OVERRIDES_FILE"
  # An override is a human decision — record WHO, not just why. git identity is the
  # best deterministic proxy available here; the confirm-override hook (guardrails pack)
  # additionally puts a human permission prompt between an agent and this command.
  local by name email
  name="$(git config user.name 2>/dev/null || true)"
  email="$(git config user.email 2>/dev/null || true)"
  by="$name"
  [[ -n "$email" ]] && by="${by:+$by }<$email>"
  [[ -n "$by" ]] || by="${USER:-unknown}"
  local entry
  entry=$(python3 -c "
import json, sys
print(json.dumps({'stage': sys.argv[1], 'reason': sys.argv[2], 'by': sys.argv[3], 'ts': sys.argv[4]}))
" "$stage" "$reason" "$by" "$(_now)")
  _json_append "$OVERRIDES_FILE" "$entry"
  echo "OK: override recorded for '$stage' by $by: $reason"
}

# ---------------------------------------------------------------------------
# report
# ---------------------------------------------------------------------------

cmd_report() {
  local as_json=false
  [[ "${1:-}" == "--json" ]] && as_json=true
  [[ -f "$GATES_FILE" ]] || echo '{}' > "$GATES_FILE"
  if [[ "$as_json" == "true" ]]; then
    cat "$GATES_FILE"
    return
  fi
  # The two file paths cross as argv, never as Python source: the project path may hold a quote.
  python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
try:
    overrides = json.load(open(sys.argv[2]))
except Exception:
    overrides = []
overridden = {o['stage'] for o in overrides}
print('Stage    Verdict  Evidence')
print('-------  -------  --------')
for stage in ['intent', 'plan', 'design', 'build', 'review', 'check', 'commit']:
    g = d.get(stage)
    if not g:
        continue
    tag = g['verdict'] + (' (overridden)' if stage in overridden and g['verdict'] == 'FAIL' else '')
    print(f\"{stage:<8} {tag}\")
    for r in g.get('requirements', []):
        mark = 'v' if r['pass'] else 'x'
        print(f\"           [{mark}] {r['name']} — {r['detail']}\")
if overridden:
    print()
    print(f'{len(overridden)} gate(s) overridden by a human — see .temper/overrides.json')
" "$GATES_FILE" "$OVERRIDES_FILE"
}

# ---------------------------------------------------------------------------
# metrics — deterministic metric ingestion for the bands monitor.
#
# `temper metrics append <series> <value>` appends one numeric point to
# <series>_history in .temper/metrics.json (creating file and array as needed) —
# the same CLI-owned bookkeeping discipline as `temper evidence add`, so the
# bands monitor reads a ledger the spine wrote, not prose-maintained state. Any
# appended series is band-able by name (`bands.metrics: [coverage, my_series]`).
# External sources (CI failure rate, post-deploy 5xx) enter the loop the same
# way: a pipeline step calls append, the scheduled bands check does the rest.
# ---------------------------------------------------------------------------

cmd_metrics() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    append)
      local series="${1:-}" value="${2:-}"
      [[ -n "$series" && -n "$value" ]] || { echo "FAIL: usage: temper metrics append <series> <value>" >&2; return 1; }
      [[ "$series" =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "FAIL: series must match [a-z][a-z0-9_-]* (got '$series')" >&2; return 1; }
      _ensure_dirs
      [[ -f "$METRICS_FILE" ]] || echo '{}' > "$METRICS_FILE"
      # value crosses the boundary as an argv element and is parsed by float() INSIDE
      # python — never interpolated into source (a metric value can be attacker-influenced:
      # a CI failure rate, a 5xx count fed from a pipeline step). A non-numeric value is a
      # clean exit 1, not code that runs.
      local out rc
      out=$(python3 - "$METRICS_FILE" "$series" "$value" <<'PY'
import json, sys
path, series, value = sys.argv[1:4]
try:
    v = float(value)
except ValueError:
    sys.stderr.write(f"FAIL: value must be numeric (got '{value}')\n")
    sys.exit(1)
try:
    d = json.load(open(path))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
# Same alias map `temper bands` uses (kept in sync): appending the friendly name
# `tests` must land in the SAME array bands reads for it (test_count_history), or a
# recorded point would never be banded. Any other name -> <name>_history.
ALIASES = {'coverage': 'coverage_history', 'tests': 'test_count_history'}
key = ALIASES.get(series) or (series if series.endswith('_history') else f"{series}_history")
arr = d.get(key)
if not isinstance(arr, list):
    arr = []
arr.append(int(v) if v.is_integer() else v)
d[key] = arr
with open(path, 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\n')
print(f"OK: {key} += {value} ({len(arr)} point(s))")
PY
)
      rc=$?
      echo "$out"
      return $rc
      ;;
    *) echo "FAIL: usage: temper metrics append <series> <value>" >&2; return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# bands — closing the loop (deterministic drift detection, no model).
#
# Watches the history arrays in .temper/metrics.json against control bands
# (rolling mean ± k·sigma over a window, plus a same-side-run drift rule).
# Detection is entirely deterministic — this subcommand never invokes a model,
# reads the network, or edits code. What a breach *triggers* is tiered in
# config (`bands:` in .claude/temper.config — log / diagnose / propose) and
# always lands in the normal pipeline: /temper:status renders the verdict, and
# a `propose`-tier breach is drafted into a `.temper/specs/<slug>/intent.md`
# for /temper to run — through every ordinary gate, never around them.
#
# Verdict: OK (nothing at 2sigma+), BREACH (>=1 metric at 2sigma+, exit 1),
# INSUFFICIENT-DATA (no metric has enough recorded points yet). A flat
# baseline (sigma = 0) treats any deviation as 3sigma — a perfectly stable
# series moving at all is out of band by definition. History points may be
# bare numbers or objects carrying a numeric `value`/`coverage`/`count`/`pct`.
# ---------------------------------------------------------------------------

cmd_bands() {
  _ensure_dirs
  local as_json=false
  [[ "${1:-}" == "--json" ]] && as_json=true
  local window min_points drift_run metrics t1 t2 t3
  window="$(_cfg_get bands.window 10)"
  min_points="$(_cfg_get bands.min-points 4)"
  drift_run="$(_cfg_get bands.drift-run 6)"
  metrics="$(_cfg_get bands.metrics "")"
  [[ -n "$metrics" ]] || metrics="coverage"$'\x1f'"tests"
  t1="$(_cfg_get bands.tiers.1sigma log)"
  t2="$(_cfg_get bands.tiers.2sigma diagnose)"
  t3="$(_cfg_get bands.tiers.3sigma propose)"
  local out rc
  out=$(python3 - "$METRICS_FILE" "$BANDS_FILE" "$window" "$min_points" "$drift_run" "$metrics" "$t1" "$t2" "$t3" "$(_now)" <<'PY'
import json, math, sys
metrics_path, out_path, window, min_points, drift_run, metrics_sep, t1, t2, t3, ts = sys.argv[1:11]
# Clamp config to sane floors, never crash on it (spine degradation contract): a
# non-integer or out-of-range window/min-points/drift-run falls back to its default
# rather than raising. window>=2 and min-points>=2 keep the baseline slice and the
# variance non-empty; drift-run>=2 keeps the run rule meaningful.
def _cfg_int(raw, default, floor):
    try:
        n = int(float(raw))
    except (ValueError, TypeError):
        return default
    return n if n >= floor else floor
window = _cfg_int(window, 10, 2)
min_points = _cfg_int(min_points, 4, 2)
drift_run = _cfg_int(drift_run, 6, 2)
# Two friendly aliases; beyond them, ANY <name>_history array in metrics.json is
# band-able by name — `temper metrics append <name> <value>` is how a series
# (including external ones: CI failure rate, 5xx counts) gets points.
ALIASES = {'coverage': 'coverage_history', 'tests': 'test_count_history'}
try:
    m = json.load(open(metrics_path))
    if not isinstance(m, dict):
        m = {}
except Exception:
    m = {}   # malformed metrics == absent; never a crash, never a breach (spine contract)

def numeric(v):
    if isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, dict):
        for k in ('value', 'coverage', 'count', 'pct'):
            if isinstance(v.get(k), (int, float)) and not isinstance(v.get(k), bool):
                return float(v[k])
    return None

tier_names = {0: 'ok', 1: '1sigma', 2: '2sigma', 3: '3sigma'}
actions = {'1sigma': t1, '2sigma': t2, '3sigma': t3}
results, lines, worst, any_data = {}, [], 0, False
for name in [s for s in metrics_sep.split('\x1f') if s]:
    key = ALIASES.get(name)
    if key is None:
        candidate = name if name.endswith('_history') else f"{name}_history"
        if isinstance(m.get(candidate), list):
            key = candidate
    if key is None:
        known = sorted(set(ALIASES) | {k[:-len('_history')] for k in m if k.endswith('_history') and isinstance(m.get(k), list)})
        lines.append(f"  [--] {name} — unknown metric (known: {', '.join(known)}); skipped")
        results[name] = {'tier': 'unknown-metric'}
        continue
    raw = m.get(key, [])
    series = [x for x in (numeric(v) for v in (raw if isinstance(raw, list) else [])) if x is not None]
    if len(series) < min_points:
        lines.append(f"  [--] {name} — insufficient data ({len(series)} point(s) recorded, need {min_points})")
        results[name] = {'tier': 'insufficient-data', 'points': len(series)}
        continue
    any_data = True
    latest = series[-1]
    base = series[max(0, len(series) - 1 - window):-1]
    mean = sum(base) / len(base)
    sigma = math.sqrt(sum((x - mean) ** 2 for x in base) / len(base))
    if sigma == 0:
        z = 0.0 if latest == mean else (3.0 if latest > mean else -3.0)
    else:
        z = (latest - mean) / sigma
    level = 3 if abs(z) >= 3 else 2 if abs(z) >= 2 else 1 if abs(z) >= 1 else 0
    run = series[-drift_run:]
    drift = len(run) >= drift_run and (all(p > mean for p in run) or all(p < mean for p in run))
    if drift and level < 2:
        level = 2
    tier = tier_names[level]
    action = actions.get(tier)
    worst = max(worst, level)
    line = (f"  [{tier if level else 'ok'}] {name} — latest {latest:g} vs baseline "
            f"{mean:.2f} ±{sigma:.2f} (z={z:+.2f}, window {len(base)})")
    if drift:
        line += f" [drift: {drift_run} consecutive same-side point(s)]"
    if level >= 1:
        line += f": action={action}"
    lines.append(line)
    results[name] = {'latest': latest, 'mean': round(mean, 4), 'sigma': round(sigma, 4),
                     'z': round(z, 4), 'tier': tier, 'drift': drift,
                     'action': action if level >= 1 else None, 'window': len(base)}
verdict = 'BREACH' if worst >= 2 else ('OK' if any_data else 'INSUFFICIENT-DATA')
with open(out_path, 'w') as f:
    json.dump({'verdict': verdict, 'metrics': results, 'ts': ts}, f, indent=2)
    f.write('\n')
print(f"temper bands -> {verdict}")
for l in lines:
    print(l)
if worst >= 2:
    print("A 2sigma+ breach is a closing-the-loop trigger: /temper:status renders it; a "
          "propose-tier breach is drafted as .temper/specs/<slug>/intent.md for /temper to run.")
sys.exit(1 if worst >= 2 else 0)
PY
)
  rc=$?
  if [[ "$as_json" == "true" ]]; then
    cat "$BANDS_FILE" 2>/dev/null || echo '{}'
  else
    echo "$out"
  fi
  return $rc
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

main() {
  _require_python
  local sub="${1:-}"; shift || true
  # Every subcommand that reads or writes the project's .temper folder is refused in a
  # folder inside the plugin folder, and in the plugin folder itself unless it is its own
  # git repository (developing Temper). `config` and `model` only read a config file and the
  # stage briefs, and the help text reads nothing, so the guard scripts that call them
  # keep working wherever they run.
  # The home folder is refused first (exit 1): it is never a project. A symlink on a path
  # the CLI writes or reads as run state is refused too (exit 3), for the same reason.
  case "$sub" in
    config|model|""|-h|--help) ;;
    *) _home_refuse || return 1
       _inside_plugin_refuse || return 1
       _unsafe_temper_refuse || return 3 ;;
  esac
  case "$sub" in
    init) cmd_init "$@" ;;
    state) cmd_state "$@" ;;
    evidence) cmd_evidence "$@" ;;
    gate) cmd_gate "$@" ;;
    model) cmd_model "$@" ;;
    override) cmd_override "$@" ;;
    report) cmd_report "$@" ;;
    status) cmd_status "$@" ;;
    bands) cmd_bands "$@" ;;
    metrics) cmd_metrics "$@" ;;
    config) cmd_config "$@" ;;
    ""|-h|--help)
      cat <<'EOF'
temper — the deterministic spine of the Temper plugin

Usage:
  temper init
  temper state <init|get|set|advance|loop|archive|clear> ...
  temper evidence <add|run|list|resolve|accept|clear> ...
  temper gate <intent|plan|design|build|review|check|commit> [--spec-path P]
  temper model <intent|plan|design|build|review|check|rca|fix> | --all
  temper override <stage> --reason "..."
  temper report [--json]
  temper status [--json] [--spec-path P]
  temper bands [--json]
  temper metrics append <series> <value>
  temper config get <dot.path> [default]
EOF
      ;;
    *) echo "FAIL: unknown subcommand '$sub' (temper --help)" >&2; return 1 ;;
  esac
}

main "$@"
