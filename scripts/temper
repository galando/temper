#!/usr/bin/env bash
#
# temper — the deterministic spine of the Temper plugin.
#
# Everything in the /temper pipeline that has exactly one correct output lives here,
# not in a prompt. State transitions, evidence bookkeeping, and gate verdicts are
# computed by this script; the orchestrator prompts call it and act on its exit code.
# No network calls. python3 stdlib only (json parsing) — no external dependencies.
#
# Subcommands:
#   temper init [--foreground-agents [status]]   scaffold .temper/; or keep agents in the foreground here
#   temper state <get|set|advance|loop|archive|clear> ..  read/write .temper/build-state.json;
#                                                 archive writes gate-ledger.json in the spec folder
#   temper evidence <add|run|list|resolve|accept|clear> ...  append/execute-and-record/read/mark-fixed/clear the ledger
#   temper gate <stage> [--spec-path P]           compute PASS/FAIL for a stage, record verdict
#   temper model <stage> | --all                  resolve a stage's model (config override > frontmatter)
#   temper override <stage> --reason "..."        record a human override of a FAIL gate
#   temper report [--json]                        render the current run's gate ledger
#   temper status [--json] [--spec-path P]        per-criterion passed/open view; writes .temper/status.json
#   temper bands [--json]                         deterministic control-band drift check
#                                                 over .temper/metrics.json history
#   temper metrics append <series> <value>        append a numeric point to <series>_history
#   temper config get <dot.path> [default]        read temper.config (for hook and CI scripts)
# Build, in groups of small tasks:
#   temper schedule [--json]                      the launchable tasks, one JSON line each
#   temper group <start|gate|reopen|continue> G<n> | report [--json]   worktree, group verdict, Change, Continue, report
#   temper task <start|show|test|gate> N          one task's lifecycle (test runs the declared command)
#   temper integrate                              merge the passed groups, run the suite, check Interfaces
#   temper model <task|task-escalation>           the task agent's model and its escalation model
#   temper usage add --stage S [--model M] [--tokens T] [--ms D] [--task N] [--group G]
#                                                 one agent launch's usage (any stage);
#                                                 report and state archive show it; missing values are null
#
# DEGRADATION CONTRACT (same spirit as Temper's guardrail scripts):
#   - A stage with no evidence recorded FAILS closed (nothing to verify => not verified).
#   - Missing python3 => every subcommand exits 1 with a clear message (JSON needs it).
#   - Malformed state/config => treated as absent (defaults apply), never a crash.
#   - A symlink on a path this CLI writes or reads as run state (.temper, its evidence, specs
#     and archive folders, the fixed state and evidence files, the active run's spec folder
#     and its gate-ledger.json) => every subcommand except config, model and help exits 3
#     with a one-line reason on stderr, so no write can follow a link out of the project.
#     Any other link inside a spec folder is not run state and changes nothing.
#   - Run from the home folder => every subcommand except config, model and help exits 1:
#     the home folder holds Claude Code's own files and is never a project.
set -uo pipefail
# An exported CDPATH makes `cd` print the folder it enters, which would double every
# folder this script works out with "$(cd ... && pwd)". It is never used here.
unset CDPATH

REPO_ROOT="$(pwd)"
# Where the plugin itself lives (this script). Used only to read the stage briefs'
# frontmatter (`temper model`), to load acceptance.py and to refuse a project folder
# inside the plugin folder, never to locate project state. It comes from this file's
# own location alone, never from an environment variable: when the CLI is reached
# through a symlink (a link in a bin folder, or a chain of links), each link is followed
# to the real file first. The plugin folder is that file's folder (resolved, so a link
# to the folder itself is followed too) with the literal suffix /scripts removed.
_self="${BASH_SOURCE[0]}"
_hops=0
while [[ -L "$_self" && $_hops -lt 40 ]]; do
  _link_dir="$(cd -P "$(dirname "$_self")" 2>/dev/null && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" == /* ]] || _self="$_link_dir/$_self"
  _hops=$((_hops + 1))
done
SCRIPTS_DIR="$(cd -P "$(dirname "$_self")" 2>/dev/null && pwd)"
PLUGIN_ROOT="${SCRIPTS_DIR%/scripts}"
unset _self _hops _link_dir
ACCEPTANCE_PY="$PLUGIN_ROOT/scripts/acceptance.py"
# Run state always lives in this project's .temper folder: no environment variable moves
# it, so every write and delete below stays inside the project.
TEMPER_DIR="$REPO_ROOT/.temper"
# TEMPER_CONFIG may name another config file to READ (the guard scripts pass the project's
# own); nothing in this script ever writes to it.
CONFIG_FILE="${TEMPER_CONFIG:-$REPO_ROOT/.claude/temper.config}"
STATE_FILE="$TEMPER_DIR/build-state.json"
LOOPS_FILE="$TEMPER_DIR/feedback-loops.json"
GATES_FILE="$TEMPER_DIR/gates.json"
STATUS_FILE="$TEMPER_DIR/status.json"
OVERRIDES_FILE="$TEMPER_DIR/overrides.json"
EVIDENCE_DIR="$TEMPER_DIR/evidence"
METRICS_FILE="$TEMPER_DIR/metrics.json"
BANDS_FILE="$TEMPER_DIR/bands.json"

STAGES="intent plan design build review check commit"
# Grouped Build (9.7.0) byte budgets: the slim task brief, a group's Context block, one task block.
TASK_BRIEF_MAX_BYTES=6144
GROUP_CONTEXT_MAX_BYTES=4096
TASK_BLOCK_MAX_BYTES=2048
USAGE_FILE=".temper/usage.json"     # whole-flow usage rows (D-07): CLI-owned, every write holds the lock
GROUPS_FILE=".temper/groups.json"   # grouped run state: CLI-owned, every write holds the lock

# Stages that run as an Agent subprocess and therefore have a model to resolve.
# `commit` is not one — it's the orchestrator running `temper gate commit`.
# rca/fix are /temper:fix's subprocess stages: model stages (the rca and fix briefs'
# frontmatter) but never gate stages — Fix evidence gates as `build`.
AGENT_STAGES="intent plan design build review check rca fix"

# The only stage names an evidence ledger file can carry: every gate stage plus the two
# /temper:fix subprocess stages. A stage name is checked against this list before any
# path is built from it (see _stage_ok and _evidence_file).
EVIDENCE_STAGES="intent plan design build review check commit rca fix"

_stage_ok() { # _stage_ok <stage> -> 0 only for a name on the fixed EVIDENCE_STAGES list
  case "$1" in
    intent|plan|design|build|review|check|commit|rca|fix) return 0 ;;
  esac
  return 1
}

_stage_refuse() { # _stage_refuse <stage> -> prints the usage failure for a stage not on the list
  echo "FAIL: unknown stage '$1' (one of: $EVIDENCE_STAGES)" >&2
  return 1
}

_slug_ok() { # _slug_ok <slug> -> 0 for a spec slug: letters (either case), digits, '.', '_', '-'
             # starting with a letter or digit, never containing '/' or '..' (so never a path).
             # Either case: a ticket key prefix such as PROJ-123-login is a valid slug.
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && ! [[ "$1" =~ [.][.] ]]
}

_spec_slug() { # _spec_slug <spec_path> -> the slug of a spec path of the form .temper/specs/<slug>,
               # or "" for any other value (the only shape `state init` ever records)
  local sp="${1%/}" slug
  slug="${sp#.temper/specs/}"
  if [[ "$slug" != "$sp" ]] && _slug_ok "$slug"; then echo "$slug"; else echo ""; fi
}

# Per-command state.stage sequences (bookkeeping for resume — see
# reference/orchestrator-patterns.md "Build State Schema"). Distinct from $STAGES
# above, which is the `temper gate <stage>` vocabulary: /temper:fix's state.stage
# uses rca/fix in place of plan/build, but "rca"/"fix" are never valid gate stages.
STAGE_SEQ_TEMPER="intent plan design build review check"
STAGE_SEQ_FIX="rca fix review check"

_count_lines_matching() { # _count_lines_matching <pattern> <file>  (grep -c exits 1 on zero matches
                           # but still prints "0" — never pair it with "|| echo 0", that double-prints)
  local n
  n=$(grep -c "$1" "$2" 2>/dev/null)
  echo "${n:-0}"
}

_git_toplevel_is() { # _git_toplevel_is <folder> -> 0 when <folder> is a git work tree whose top
                      # level is <folder> itself. Every GIT_* variable is dropped first, so a
                      # GIT_DIR or GIT_WORK_TREE set by a caller (a git hook sets some) cannot
                      # answer for another repository.
  local top
  top="$(
    while IFS= read -r v; do unset "$v"; done < <(compgen -e | grep '^GIT_')
    git -C "$1" rev-parse --show-toplevel 2>/dev/null
  )" || return 1
  [[ -n "$top" && "$top" -ef "$1" ]]
}

_under_folder() { # _under_folder <path> <folder> -> 0 when <path> is <folder> or lies inside it.
                  # Decided by identity, not by text: <path> is resolved (links followed) and
                  # each of its ancestors is compared with <folder> by device and inode
                  # ([[ -ef ]]), so a path typed in another case on a file system that does
                  # not tell case apart, a symlink or a second mount of the same folder is
                  # still seen.
  local d
  d="$(cd -P "$1" 2>/dev/null && pwd)" || return 1
  while [[ -n "$d" ]]; do
    [[ "$d" -ef "$2" ]] && return 0
    [[ "$d" != "/" ]] || return 1
    d="${d%/*}"
    [[ -n "$d" ]] || d="/"
  done
  return 1
}

_inside_plugin_refuse() { # -> 1 (with a message) when the current folder is the plugin folder or
                          # lies inside it. Run state lives in the current folder's .temper, and
                          # nothing this CLI runs may write into the plugin folder. The one
                          # exception is developing Temper on its own repository: the plugin
                          # folder is a project only when it is a git work tree whose top level
                          # is that folder. An installed copy (no .git) is refused like any
                          # folder inside it (one of its own subfolders, or a second checkout
                          # placed in it).
  [[ "$PLUGIN_ROOT" != "$SCRIPTS_DIR" ]] || return 0   # not laid out as a plugin: no folder to guard
  local plugin cwd
  plugin="$(cd -P "$PLUGIN_ROOT" 2>/dev/null && pwd)" || return 0
  [[ -n "$plugin" && "$plugin" != "/" ]] || return 0
  cwd="$(pwd -P)"
  if [[ "$cwd" -ef "$plugin" ]]; then
    _git_toplevel_is "$plugin" && return 0
    echo "FAIL: run temper from a project folder, not from the plugin folder: this copy is not its own git repository" >&2
    echo "      (plugin folder: $plugin). The plugin folder is a project only when it is a git work tree whose top level is that folder." >&2
    return 1
  fi
  if _under_folder "$cwd" "$plugin"; then
    echo "FAIL: run temper from a project folder, not from a folder inside the plugin folder" >&2
    echo "      (plugin folder: $plugin; current folder: $cwd). The plugin folder itself is a project only when it is its own git repository." >&2
    return 1
  fi
  return 0
}

_home_refuse() { # -> 1 (with a message) when the current folder is the home folder. The home
                 # folder holds Claude Code's own files and is never a project, so no run state
                 # is read or written there. Decided by identity (device and inode), so a
                 # symlink or another spelling of the home folder is still seen.
  [[ -n "${HOME:-}" && "$REPO_ROOT" -ef "$HOME" ]] || return 0
  echo "FAIL: run temper from a project folder, not from the home folder ($HOME). The home folder is never a project." >&2
  return 1
}

_unsafe_temper_refuse() { # -> 3 (with a one-line reason) when a path this CLI writes or reads as
                          # run state is a symlink: the .temper folder, its evidence, specs and
                          # archive folders, the fixed state files, the evidence files, the
                          # active run's spec folder and its gate-ledger.json. A link there (a
                          # cloned repository can carry one) could send a write out of the
                          # project, into the plugin folder or anywhere else. Any other link
                          # inside a spec folder is not run state: the CLI never writes through
                          # it, so it changes nothing. Each folder is checked before any path
                          # inside it, so no check here looks through a link.
  [[ -e .temper || -L .temper ]] || return 0
  local p slug link="" paths=".temper .temper/.lock .temper/evidence .temper/specs .temper/archive"
  for p in build-state gates overrides status metrics bands feedback-loops groups usage; do
    paths="$paths .temper/$p.json"
  done
  for p in $EVIDENCE_STAGES; do
    paths="$paths .temper/evidence/$p.json"
  done
  for p in $paths; do
    [[ -L "$p" ]] && { link="$p"; break; }
  done
  if [[ -z "$link" && -f "$STATE_FILE" ]]; then
    # The active run's spec folder: only the shape `state init` records names one.
    slug="$(_spec_slug "$(_json_get_path "$STATE_FILE" spec_path "")")"
    if [[ -n "$slug" ]]; then
      for p in ".temper/specs/$slug" ".temper/specs/$slug/gate-ledger.json"; do
        [[ -L "$p" ]] && { link="$p"; break; }
      done
    fi
  fi
  if [[ -n "$link" ]]; then
    echo "FAIL: unsafe .temper: '$link' is a symlink, and no write may follow a link out of the project (replace it with a plain file or folder)" >&2
    return 3
  fi
  return 0
}

_require_python() {
  command -v python3 >/dev/null 2>&1 || { echo "FAIL: python3 is required but not found in PATH" >&2; exit 1; }
}

_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

_ensure_dirs() { mkdir -p .temper/evidence; }   # the project's .temper and its evidence folder

# ---------------------------------------------------------------------------
# Minimal JSON helpers (python3 stdlib only — no jq / pyyaml dependency)
# ---------------------------------------------------------------------------

_json_read() { # _json_read <file> <default-json>
  local file="$1" default="$2"
  if [[ -f "$file" ]]; then
    python3 -I -c "
import json, sys
try:
    json.load(open(sys.argv[1]))
    print(open(sys.argv[1]).read())
except Exception:
    print(sys.argv[2])
" "$file" "$default"
  else
    echo "$default"
  fi
}

_json_get_path() { # _json_get_path <file> <dot.path> [default]
  local file="$1" path="$2" default="${3:-}"
  python3 -I -c "
import json, sys
path, default = sys.argv[2], sys.argv[3]
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print(default); sys.exit(0)
cur = d
for k in path.split('.'):
    if isinstance(cur, dict) and k in cur:
        cur = cur[k]
    else:
        print(default); sys.exit(0)
if isinstance(cur, (dict, list)):
    print(json.dumps(cur))
elif isinstance(cur, bool):
    print('true' if cur else 'false')  # bash compares lowercase — never emit Python's True/False
else:
    print(cur if cur is not None else default)
" "$file" "$path" "$default" 2>/dev/null || echo "$default"
}

# Write lock for the shared run files under .temper/. A mkdir lock (portable: macOS has no flock):
# `mkdir` either creates the folder or fails, atomically. The holder writes an owner token inside it and a
# release removes the folder only when the token is still its own, so a lock that was broken and re-taken
# by someone else is never released by the old holder. A lock older than 30 s belongs to a crashed holder
# and is broken under a second short-lived lock (.lock.break), re-checked there, so two waiters never both
# break it. The break moves the folder aside under a name only that process uses and deletes it; nothing is
# ever put back, so a waiter's mkdir at any moment simply wins the lock and no orphan folder is made. The age
# check and the rename run in one process, so the window in which a lock that was released and re-taken
# between the two could still be moved aside is narrowed to a few microseconds, not closed (a directory rename
# cannot be made conditional on its age); it needs a holder that was past 30 s and released at that very moment.
# A lock still held after TEMPER_LOCK_WAIT_S (default 10)
# seconds is written past with a WARN (fail open), so a stuck holder never wedges a run. A lock this call
# did not take is never released. Calls nest (a depth count: only the outermost release frees the folder),
# and a trap frees a held lock on EXIT/INT/TERM/HUP. Held around a file write, or a short git commit plus
# the writes that record it, never while a test runs.
_LOCK_DIR=".temper/.lock"
_LOCK_DEPTH=0
_LOCK_OWNED=0
_LOCK_TOKEN=""
_lock_older_than_30s() { # _lock_older_than_30s <path>: 0 only when it exists and is older than 30 s
  python3 -I -c "
import os, sys, time
try:
    sys.exit(0 if time.time() - os.path.getmtime(sys.argv[1]) > 30 else 1)
except OSError:
    sys.exit(1)   # gone between the mkdir and here: not stale, retry the mkdir" "$1" 2>/dev/null
}
_lock_break_stale() {
  local br="$_LOCK_DIR.break"
  if ! mkdir "$br" 2>/dev/null; then
    _lock_older_than_30s "$br" && rmdir "$br" 2>/dev/null   # a breaker that died is cleared once old
    return 0
  fi
  # the age check and the rename happen in ONE process, a few microseconds apart (a shell check followed by a
  # separate mv left a window of milliseconds)
  local dead="$_LOCK_DIR.dead.$$"
  rm -rf "$dead" 2>/dev/null
  python3 -I -c "
import os, sys, time
try:
    if time.time() - os.path.getmtime(sys.argv[1]) > 30:   # re-checked while no other waiter can break it
        os.rename(sys.argv[1], sys.argv[2])
except OSError:
    pass" "$_LOCK_DIR" "$dead" 2>/dev/null
  rm -rf "$dead" 2>/dev/null
  rmdir "$br" 2>/dev/null || true
}
_lock_cleanup() { # free the lock this process still owns (EXIT/INT/TERM/HUP)
  if [[ "$_LOCK_OWNED" == "1" && -f "$_LOCK_DIR/owner" && "$(cat "$_LOCK_DIR/owner" 2>/dev/null)" == "$_LOCK_TOKEN" ]]; then
    rm -f "$_LOCK_DIR/owner" 2>/dev/null
    rmdir "$_LOCK_DIR" 2>/dev/null || true
  fi
  _LOCK_OWNED=0
}
_lock_acquire() {
  if (( _LOCK_DEPTH > 0 )); then _LOCK_DEPTH=$(( _LOCK_DEPTH + 1 )); return 0; fi   # nested: no self-deadlock
  _LOCK_DEPTH=1
  [[ -d .temper ]] || return 0                 # nothing to lock before a run has a folder
  local i=0 deadline=$(( $(date +%s) + ${TEMPER_LOCK_WAIT_S:-10} ))   # wall clock, not loop counts
  while :; do
    if mkdir "$_LOCK_DIR" 2>/dev/null; then
      _LOCK_TOKEN="$$.$RANDOM$RANDOM$(date +%s)"
      printf '%s' "$_LOCK_TOKEN" > "$_LOCK_DIR/owner" 2>/dev/null || true
      _LOCK_OWNED=1
      trap '_lock_cleanup' EXIT
      trap '_lock_cleanup; exit 130' INT
      trap '_lock_cleanup; exit 143' TERM
      trap '_lock_cleanup; exit 129' HUP
      return 0
    fi
    if (( i % 50 == 0 )) && _lock_older_than_30s "$_LOCK_DIR"; then
      _lock_break_stale
      i=$(( i + 1 ))
      continue
    fi
    if (( $(date +%s) >= deadline )); then
      echo "WARN: could not take $_LOCK_DIR within ${TEMPER_LOCK_WAIT_S:-10}s; writing without the lock" >&2
      return 0
    fi
    python3 -I -c "import time; time.sleep(0.02)"
    i=$(( i + 1 ))
  done
}
_lock_release() {
  (( _LOCK_DEPTH > 0 )) || return 0
  _LOCK_DEPTH=$(( _LOCK_DEPTH - 1 ))
  (( _LOCK_DEPTH == 0 )) || return 0
  if [[ "$_LOCK_OWNED" == "1" ]]; then
    _lock_cleanup
    trap - EXIT INT TERM HUP
  fi
}

# Every JSON write below goes through a temp file in the same folder and os.replace, so a reader
# never sees a truncated file even when a writer is killed half way.
_json_set_path() { # _json_set_path <file> <dot.path> <value> <default-json>
  local file="$1" path="$2" value="$3" default="$4" rc
  _lock_acquire
  python3 -I -c "
import json, os, sys
path, value, default = sys.argv[2], sys.argv[3], sys.argv[4]
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = json.loads(default)
# auto-typing: true/false/int/float pass through, else string
if value in ('true', 'false'):
    v = (value == 'true')
else:
    try:
        v = int(value)
    except ValueError:
        try:
            v = float(value)
        except ValueError:
            v = value
cur = d
keys = path.split('.')
for k in keys[:-1]:
    cur = cur.setdefault(k, {})
cur[keys[-1]] = v
tmp = '%s.tmp.%d' % (sys.argv[1], os.getpid())
with open(tmp, 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\n')
os.replace(tmp, sys.argv[1])
" "$file" "$path" "$value" "$default"
  rc=$?
  _lock_release
  return $rc
}

_json_append() { # _json_append <file> <entry-json>  (file holds a JSON array)
  local file="$1" entry="$2" rc
  _lock_acquire
  python3 -I -c "
import json, os, sys
try:
    d = json.load(open(sys.argv[1]))
    if not isinstance(d, list):
        d = []
except Exception:
    d = []
d.append(json.loads(sys.argv[2]))
tmp = '%s.tmp.%d' % (sys.argv[1], os.getpid())
with open(tmp, 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\n')
os.replace(tmp, sys.argv[1])
" "$file" "$entry"
  rc=$?
  _lock_release
  return $rc
}

# ---------------------------------------------------------------------------
# Config (a small YAML subset — indentation-nested maps/lists, flow lists).
# The v7 config is ~25 lines; this parser is intentionally not general-purpose YAML.
# ---------------------------------------------------------------------------

_cfg_get() { # _cfg_get <dot.path> [default]
  local path="$1" default="${2:-}"
  [[ -f "$CONFIG_FILE" ]] || { echo "$default"; return; }
  python3 "$SCRIPTS_DIR/config_yaml.py" "$CONFIG_FILE" "$path" "$default" 2>/dev/null || echo "$default"
}

# ---------------------------------------------------------------------------
# model — resolve which model a stage runs on.
#
# v7 replaced the v6 `models.routing`/`models.tiers` config with fixed `model:`
# frontmatter in each stage brief (see _agent_file), because the old block was a *resolution algorithm* a
# prompt had to execute correctly on every run. That diagnosis still holds; what it cost
# was the ability to change a model without editing plugin-owned files, which matters
# every time a new model generation ships.
#
# So: the frontmatter stays the source of truth for defaults (no table to drift out of
# sync with it), an optional flat `models.{stage}` config key overrides it, and the
# lookup lives here — one deterministic call, no algorithm in prose.
# ---------------------------------------------------------------------------

_agent_file() { # <stage> -> its brief, each path written out in full (an unknown stage has none)
  case "$1" in
    intent) echo "$PLUGIN_ROOT/agents/intent.md" ;;
    plan)   echo "$PLUGIN_ROOT/agents/plan.md" ;;
    design) echo "$PLUGIN_ROOT/agents/design.md" ;;
    build)  echo "$PLUGIN_ROOT/agents/build.md" ;;
    review) echo "$PLUGIN_ROOT/agents/review.md" ;;
    check)  echo "$PLUGIN_ROOT/agents/check.md" ;;
    rca)    echo "$PLUGIN_ROOT/agents/rca.md" ;;
    fix)    echo "$PLUGIN_ROOT/agents/fix.md" ;;
    *)      echo "" ;;
  esac
}

_agent_default_model() { # <stage> -> the `model:` line in that stage brief's frontmatter
  local f; f="$(_agent_file "$1")"
  [[ -n "$f" && -f "$f" ]] || { echo ""; return; }
  awk '
    /^---[[:space:]]*$/ { n++; if (n == 2) exit; next }
    n == 1 && /^model:/ { sub(/^model:[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
  ' "$f" 2>/dev/null
}

_resolve_model() { # <stage> -> config override, else frontmatter default, else ""
  local override; override="$(_cfg_get "models.${1}" "")"
  [[ -n "$override" ]] && { echo "$override"; return; }
  _agent_default_model "$1"
}

_resolve_task_model() { # grouped task agent: config, else agents/build-task.md frontmatter, else the constant
  local m; m="$(_cfg_get build.grouped.task-model "")"
  [[ -n "$m" ]] && { echo "$m"; return; }
  local f="$PLUGIN_ROOT/agents/build-task.md"
  [[ -f "$f" ]] && m="$(awk '
    /^---[[:space:]]*$/ { n++; if (n == 2) exit; next }
    n == 1 && /^model:/ { sub(/^model:[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
  ' "$f" 2>/dev/null)"
  echo "${m:-claude-haiku-5-5}"
}

_resolve_task_escalation_model() {
  local m; m="$(_cfg_get build.grouped.escalation-model "")"
  echo "${m:-sonnet}"
}

cmd_model() {
  local stage="${1:-}"
  if [[ -z "$stage" || "$stage" == "--all" ]]; then
    local s m rc=0
    for s in $AGENT_STAGES; do
      m="$(_resolve_model "$s")"
      [[ -n "$m" ]] || { echo "FAIL: no model resolved for stage '$s' (is its brief in the plugin's agents folder?)" >&2; rc=1; continue; }
      echo "${s}=${m}"
    done
    echo "task=$(_resolve_task_model)"
    echo "task-escalation=$(_resolve_task_escalation_model)"
    return $rc
  fi

  case "$stage" in
    task) _resolve_task_model; return 0 ;;
    task-escalation) _resolve_task_escalation_model; return 0 ;;
  esac

  case " $AGENT_STAGES " in
    *" $stage "*) ;;
    *) echo "FAIL: unknown stage '$stage' (one of: $AGENT_STAGES, or --all)" >&2; return 1 ;;
  esac

  local m; m="$(_resolve_model "$stage")"
  # Fail loudly rather than printing an empty string the orchestrator would paste into
  # an Agent launch. That is only reachable if the plugin's files are incomplete.
  [[ -n "$m" ]] || { echo "FAIL: no model resolved for stage '$stage' (is its brief in the plugin's agents folder?)" >&2; return 1; }
  echo "$m"
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

_foreground_agents() { # _foreground_agents [status]: Claude Code runs a stage agent in the background (v2.1.198; with fork mode
                       # always), and the run goes on only in the turn its completion starts. CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1
                       # keeps agents in the foreground; a plugin cannot set it, so this writes it into the project's
                       # .claude/settings.json "env" (the person's choice, at /temper:init). status: on, set, or off.
  python3 -I - "${1:-}" "${CLAUDE_CODE_DISABLE_BACKGROUND_TASKS:-}" <<'PY'
import json, os, sys
mode, live = sys.argv[1], sys.argv[2]
KEY, p = 'CLAUDE_CODE_DISABLE_BACKGROUND_TASKS', os.path.join('.claude', 'settings.json')
on = live.strip().lower() in ('1', 'true')
if os.path.islink(p) or os.path.islink('.claude'):
    print('FAIL: .claude/settings.json (or .claude) is a symlink; nothing was written'); sys.exit(3)
d = {}
if os.path.exists(p):
    try:
        d = json.load(open(p, encoding='utf-8'))
    except (ValueError, OSError) as e:
        print('FAIL: .claude/settings.json is not valid JSON (%s); nothing was written' % str(e)[:120]); sys.exit(1)
    if not isinstance(d, dict) or not isinstance(d.get('env', {}), dict):
        print('FAIL: .claude/settings.json is not a JSON object with an env object; nothing was written'); sys.exit(1)
written = str((d.get('env') or {}).get(KEY, '')).strip().lower() in ('1', 'true')
if mode == 'status':
    print('on' if on else 'set' if written else 'off'); sys.exit(0)
if written:
    print('OK: .claude/settings.json already sets %s=1%s' % (KEY, '' if on else '; start Claude Code again for it to take effect'))
    sys.exit(0)
d.setdefault('env', {})[KEY] = '1'
os.makedirs('.claude', exist_ok=True)
tmp = '%s.tmp.%d' % (p, os.getpid())
with open(tmp, 'w', encoding='utf-8') as f:
    json.dump(d, f, indent=2); f.write('\n')
os.replace(tmp, p)
print('OK: %s=1 added to .claude/settings.json: Claude Code runs agents in the foreground in this project once it starts '
      'again (it also turns off background Bash commands and Ctrl+B here)' % KEY)
PY
}

# The CLI's run files under .temper/, which init lists in the clone's info/exclude (one list, so the setup check sees an
# older project that lacks a newer one)
_RUN_FILES="build-state.json feedback-loops.json observability.json gates.json overrides.json status.json \
stage-gate.log pending-stage.json groups.json usage.json autonomy.lock autonomy-report.md coverage.json coverage/ \
security-map.json test-gap-report.json view.json evidence/ index/ reviews/ archive/ .lock/"

_excludes_current() { # 0 when the clone's info/exclude lists every run file init writes (or this is no git repository)
  local ex pre p
  ex="$(git rev-parse --git-common-dir 2>/dev/null)/info/exclude" || return 0
  [[ "$ex" != "/info/exclude" ]] || return 0
  pre="$(_prefix_glob)"
  for p in $_RUN_FILES; do grep -qxF "/${pre}.temper/$p" "$ex" 2>/dev/null || return 1; done
  grep -qxF "/${pre}.claude/worktrees/" "$ex" 2>/dev/null
}

cmd_init() {
  if [[ "${1:-}" == "--foreground-agents" ]]; then
    _foreground_agents "${2:-}"
    return $?
  fi
  _ensure_dirs
  [[ -f "$GATES_FILE" ]] || echo '{}' > "$GATES_FILE"
  [[ -f "$OVERRIDES_FILE" ]] || echo '[]' > "$OVERRIDES_FILE"
  [[ -f "$LOOPS_FILE" ]] || echo '{"version":1,"active_loops":[],"history":[]}' > "$LOOPS_FILE"
  # The CLI's runtime files are local run state, never committed: list them in this clone's info/exclude (never
  # .gitignore), so a fresh project's working tree stays clean (autonomy refuses a dirty tree)
  local ex p pre
  # the patterns are anchored at the top of the repository: a project below it (a package of a monorepo) has its prefix
  pre="$(_prefix_glob)"
  if ex="$(git rev-parse --git-common-dir 2>/dev/null)/info/exclude" && [[ "$ex" != "/info/exclude" ]]; then
    mkdir -p "$(dirname "$ex")" 2>/dev/null
    for p in $_RUN_FILES; do
      grep -qxF "/${pre}.temper/$p" "$ex" 2>/dev/null || printf '/%s.temper/%s\n' "$pre" "$p" >> "$ex" 2>/dev/null || true
    done
    grep -qxF "/${pre}.claude/worktrees/" "$ex" 2>/dev/null || printf '/%s.claude/worktrees/\n' "$pre" >> "$ex" 2>/dev/null || true
  fi
  echo "OK: .temper/ scaffolded at $TEMPER_DIR"
}

# While a run is active, every verdict and move of it reads the project's own config: TEMPER_CONFIG (which the guard
# scripts set for `config get`) is not followed by any other subcommand, so another file never changes the run's checks.
_config_pin() {
  [[ -n "${TEMPER_CONFIG:-}" && -f "$STATE_FILE" ]] || return 0
  local own="$REPO_ROOT/.claude/temper.config"
  _same_file "$CONFIG_FILE" "$own" && return 0
  echo "WARN: TEMPER_CONFIG is not followed while a run is active; the project's .claude/temper.config applies" >&2
  CONFIG_FILE="$own"
}

_same_file() { # _same_file <a> <b> -> 0 when both name the same path once every link and '..' is resolved
  python3 -I -c "import os, sys; sys.exit(0 if os.path.realpath(sys.argv[1]) == os.path.realpath(sys.argv[2]) else 1)" "$1" "$2"
}

# ---------------------------------------------------------------------------
# state
# ---------------------------------------------------------------------------

cmd_state_init() { # temper state init <slug> [--command temper|fix] [--branch NAME]
  local slug="${1:-}"; shift || true
  # The slug becomes the spec folder .temper/specs/<slug>, which `state archive` later
  # writes into, so it is a plain name and never a path.
  if ! _slug_ok "$slug"; then
    echo "FAIL: usage: temper state init <slug> [--command temper|fix] [--branch NAME]" >&2
    echo "      (the slug is letters of either case, digits, '.', '_' or '-', starts with a letter or digit, and has no '/' or '..'; got '$slug')" >&2
    return 1
  fi
  _ensure_dirs
  local command="temper" branch="" feature="" enter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --command) command="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --feature) feature="${2:-}"; shift 2 ;;
      --enter) enter="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done
  # ADR 0013: a door into a later stage starts its run there; the stages before it are checked and asked, not run again
  case "$enter" in
    ""|intent|plan|design|build|review|check) ;;
    *) echo "FAIL: --enter takes a stage of a /temper run (plan, design, build, review or check); got '$enter'" >&2; return 1 ;;
  esac
  # A new run must not inherit the previous run's overrides or gate verdicts — an
  # old override once satisfied a gate the new run never earned. Same discipline
  # as `state clear`: archive first, then remove runtime state. specs/ untouched.
  if [[ -f "$STATE_FILE" ]]; then
    local archived rc; archived="$(_archive_ledger)"; rc=$?
    [[ -n "$archived" ]] && echo "OK: prior run's gate ledger archived to $archived"
    [[ $rc -eq 2 ]] && echo "OK: the prior run's gate ledger was NOT archived (see the warning above); starting the new run"
  else
    # No prior run — but a non-empty overrides/gates file still carries a fact
    # worth keeping (an override records a human approver). Copy, don't delete.
    local ts name f stripped
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$TEMPER_DIR/archive"
    for name in overrides gates; do
      f="$TEMPER_DIR/$name.json"
      if [[ -f "$f" ]]; then
        stripped="$(tr -d '[:space:]' < "$f")"
        if [[ -n "$stripped" && "$stripped" != "[]" && "$stripped" != "{}" ]]; then
          cp "$f" "$TEMPER_DIR/archive/pre-init-${ts}-${name}.json"
          echo "OK: pre-init archive: $name.json -> .temper/archive/pre-init-${ts}-${name}.json"
        fi
      fi
    done
  fi
  # Each target is written out in full, relative to the project (REPO_ROOT is the cwd).
  rm -f .temper/build-state.json .temper/feedback-loops.json .temper/gates.json .temper/overrides.json .temper/groups.json .temper/usage.json
  rm -rf .temper/evidence
  _ensure_dirs
  # Re-scaffold the ledger files empty (same as `temper init`): a cleared run has
  # no overrides/verdicts/loops, not missing files.
  [[ -f "$GATES_FILE" ]] || echo '{}' > "$GATES_FILE"
  [[ -f "$OVERRIDES_FILE" ]] || echo '[]' > "$OVERRIDES_FILE"
  [[ -f "$LOOPS_FILE" ]] || echo '{"version":1,"active_loops":[],"history":[]}' > "$LOOPS_FILE"
  [[ -n "$branch" ]] || branch="feature/$slug"
  [[ "$command" == "fix" ]] && [[ "$branch" == "feature/$slug" ]] && branch="fix/$slug"
  python3 -I -c "
import json, os, sys, uuid
d = {
    'stage': 'started',
    'spec': sys.argv[1],
    'spec_path': f'.temper/specs/{sys.argv[1]}',
    'branch': sys.argv[2],
    'command': sys.argv[3],
    'next_stage': 'intent' if sys.argv[3] == 'temper' else 'rca',
    'run_mode': 'interactive',
    'artifacts': ['intent.md', 'tasks.md'] if sys.argv[3] == 'temper' else ['rca.md'],
    'updated': sys.argv[4],
    # ADR 0012: the run and the step a decision of the person belongs to. step counts every change of next_stage.
    'run_id': uuid.uuid4().hex[:16],
    'step': 0,
    'started': sys.argv[4],
}
# ADR 0013: the feature as the person gave it (the Intent brief's input), and a door's stage
if sys.argv[6]: d['feature'] = sys.argv[6]
if sys.argv[7] and sys.argv[3] == 'temper':
    d['enter'] = sys.argv[7]
    # A door's run takes the tier Plan recorded: plan.md's Complexity line, else intent.md's (Intent's first guess)
    import re
    for name in ('plan.md', 'intent.md'):
        try:
            text = open(os.path.join(d['spec_path'], name), encoding='utf-8', errors='replace').read()
        except OSError:
            continue
        m = re.search(r'^\s*(?:\*\*Complexity:\*\*|#{1,6}\s*Complexity:)[\s*]*(trivial|simple|medium|complex)\b', text, re.I | re.M)
        if m:
            d['complexity'] = m.group(1).lower()
            break
json.dump(d, open(sys.argv[5], 'w'), indent=2)
" "$slug" "$branch" "$command" "$(_now)" "$STATE_FILE" "$feature" "$enter"
  echo "OK: state initialized for '$slug' ($command, branch $branch)"
}

_state_migrate_legacy() { # idempotent; called before any state read/write and by cmd_gate.
                           # Heals a v7.0.x build-state.json left with next_stage/stage
                           # pointing at the removed eval stage. Write-through (not
                           # read-only): scripts/guards/verify-tests-ran.sh (L1) reads
                           # build-state.json directly and cannot call this CLI, so a
                           # stale on-disk value would block every future `git commit`.
  [[ -f "$STATE_FILE" ]] || return 0
  # fast path, no python3 spawn: nothing of eval left, and the run id of ADR 0012 is there
  if ! grep -q '"eval' "$STATE_FILE" 2>/dev/null && grep -q '"run_id"' "$STATE_FILE" 2>/dev/null; then return 0; fi
  python3 -I - "$STATE_FILE" <<'PY'
import json, os, sys, tempfile
p = sys.argv[1]
try:
    d = json.load(open(p))
except Exception:
    sys.exit(0)                     # malformed state == absent; never crash (spine contract)
changed = False
if not isinstance(d, dict):
    sys.exit(0)
if d.get("next_stage") == "eval":       d["next_stage"] = "commit";        changed = True
if d.get("stage") == "eval_complete":   d["stage"] = "check_complete";     changed = True
# ADR 0012: a run state written before the run id; its step count starts here
if "run_id" not in d:
    import uuid
    d["run_id"] = uuid.uuid4().hex[:16];  changed = True
if not isinstance(d.get("step"), int):
    d["step"] = 0;                        changed = True
if not changed:
    sys.exit(0)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p) or ".")
with os.fdopen(fd, "w") as f:
    json.dump(d, f, indent=2); f.write("\n")
os.replace(tmp, p)                  # atomic: a truncated migration would LOSE state
PY
}

cmd_state_get() {
  _state_migrate_legacy
  [[ -f "$STATE_FILE" ]] || { echo ""; return 0; }
  if [[ -z "${1:-}" ]]; then
    _json_read "$STATE_FILE" '{}'
    return 0
  fi
  _json_get_path "$STATE_FILE" "$1" "${2:-}"
}

cmd_state_set() {
  _state_migrate_legacy
  [[ $# -ge 2 ]] || { echo "FAIL: usage: temper state set <dot.path> <value>" >&2; return 1; }
  # spec_path names the folder `state archive` writes into: only the shape `state init`
  # records (.temper/specs/<slug>) is accepted, so it can never point anywhere else.
  if [[ "$1" == "spec_path" && -z "$(_spec_slug "$2")" ]]; then
    echo "FAIL: spec_path must be .temper/specs/<slug> (slug: letters of either case, digits, '.', '_' or '-', no '/' or '..'); got '$2'" >&2
    return 1
  fi
  # ADR 0012: the run id and the step count are the CLI's own; only state init and a move of next_stage write them.
  if [[ "$1" == "run_id" || "$1" == "step" ]]; then
    echo "FAIL: $1 is kept by the CLI (state init writes run_id; every change of next_stage counts a step)" >&2
    return 1
  fi
  # ADR 0013: the files the person approved, and the digest of the tasks they approved, are recorded when the run
  # leaves Plan, and Build is held to them.
  if [[ "$1" == "approved_files" || "$1" == "plan_hash" ]]; then
    echo "FAIL: $1 is kept by the CLI (state advance plan_complete records the plan's files and its digest as the person approved them)" >&2
    return 1
  fi
  if [[ "$1" == "archived" ]]; then
    echo "FAIL: archived is kept by the CLI (state archive records it when it writes the ledger the commit carries)" >&2
    return 1
  fi
  if [[ "$1" == "enter" || "$1" == "built_before" || "$1" == "review_snapshot" ]]; then
    echo "FAIL: $1 is kept by the CLI (a door's stage, what an earlier run built and the code as Review starts are its records)" >&2
    return 1
  fi
  # The commit the run's diff is read against is recorded once (state advance plan_complete): a later one would hide
  # what the run changed from Review and from the commit gate.
  if [[ "$1" == "base_sha" && -f "$STATE_FILE" && -n "$(_json_get_path "$STATE_FILE" base_sha "")" ]]; then
    echo "FAIL: base_sha is recorded already ($(_json_get_path "$STATE_FILE" base_sha "" | cut -c1-12)); the run's diff is read against it" >&2
    return 1
  fi
  [[ -f "$STATE_FILE" ]] || { echo '{}' > "$STATE_FILE"; }
  if [[ "$1" == "next_stage" ]]; then
    # The stage the run is already at changes nothing. A stage earlier in the run's sequence redoes the stages from it,
    # as a loop does.
    local cur s known=0; cur="$(_json_get_path "$STATE_FILE" next_stage "")"
    for s in $(_run_seq); do [[ "$s" == "$2" ]] && known=1; done
    if [[ $known -eq 0 ]]; then
      echo "FAIL: next_stage must be a stage of this run ($(_run_seq)); got '$2'" >&2
      return 1
    fi
    if [[ "$2" == "$cur" ]]; then
      echo "OK: next_stage = $2 (unchanged)"
      return 0
    fi
    if _stage_before "$cur" "$2"; then
      # ADR 0013: a run leaves a stage only by state advance, which records what leaving it means (the accepted
      # intent, the approved files, base_sha) and needs the person's answer for Intent and Plan.
      echo "FAIL: next_stage moves forward only by state advance ${cur}_complete $2 (the CLI's own step)" >&2
      return 1
    fi
    _stage_before "$2" "$cur" && _redo_from "$2"
    _state_next "$2" >/dev/null || return 1
    echo "OK: $1 = $2"
    return 0
  fi
  _json_set_path "$STATE_FILE" "$1" "$2" '{}'
  _json_set_path "$STATE_FILE" "updated" "$(_now)" '{}'
  echo "OK: $1 = $2"
  # The tier is recorded where a later door reads it: the Complexity line of intent.md and of plan.md, when they have one.
  if [[ "$1" == "complexity" ]]; then
    local sp; sp="$(_spec_path "")"
    [[ -n "$sp" ]] && _tier_lines "$sp" write "$2"
  fi
  return 0
}

# _tier_lines <spec_path> check <tier> | write <tier>: the Complexity lines of intent.md and plan.md, read as
# `state init --enter` reads them. check prints each file whose line names another tier ("intent.md says simple");
# write sets each such line to the tier (a tier outside the four is not written) and prints what it changed.
_tier_lines() {
  python3 -I -c "
import os, re, sys
sp, mode, tier = sys.argv[1], sys.argv[2], sys.argv[3].strip().lower()
rx = re.compile(r'^(\s*(?:\*\*Complexity:\*\*|#{1,6}\s*Complexity:)[\s*]*)(trivial|simple|medium|complex)\b', re.I | re.M)
if tier not in ('trivial', 'simple', 'medium', 'complex'):
    sys.exit(0)
for name in ('intent.md', 'plan.md'):
    p = os.path.join(sp, name)
    try:
        text = open(p, encoding='utf-8', errors='surrogateescape').read()
    except OSError:
        continue
    said = [m.group(2).lower() for m in rx.finditer(text)]
    other = [s for s in said if s != tier]
    if not other:
        continue
    if mode == 'check':
        print('%s says %s' % (name, other[0]))
        continue
    new = rx.sub(lambda m: m.group(1) + tier, text)
    tmp = '%s.tmp.%d' % (p, os.getpid())
    with open(tmp, 'w', encoding='utf-8', errors='surrogateescape') as f:
        f.write(new)
    os.replace(tmp, p)
    print('OK: %s now says Complexity %s (it said %s)' % (name, tier, other[0]))
" "$1" "$2" "${3:-}"
}

_run_seq() { # the run's own stage sequence, with the commit stage last (a fix run has its own)
  local command="temper"
  [[ -f "$STATE_FILE" ]] && command="$(_json_get_path "$STATE_FILE" command temper)"
  if [[ "$command" == "fix" ]]; then echo "$STAGE_SEQ_FIX commit"; else echo "$STAGE_SEQ_TEMPER commit"; fi
}

_stage_before() { # _stage_before <a> <b>: 0 when stage a comes before stage b in the run's own sequence
  local a="$1" b="$2" s ia=-1 ib=-1 i=0
  for s in $(_run_seq); do
    [[ "$s" == "$a" ]] && ia=$i
    [[ "$s" == "$b" ]] && ib=$i
    i=$((i + 1))
  done
  [[ $ia -ge 0 && $ib -ge 0 && $ia -lt $ib ]]
}

_state_next() { # _state_next <next_stage>: sets next_stage; a change counts one step (ADR 0012). Prints moved or same.
  local next="$1" rc
  _lock_acquire
  python3 -I - "$STATE_FILE" "$next" "$(_now)" <<'PY'
import json, os, sys
p, nxt, ts = sys.argv[1:4]
try:
    d = json.load(open(p))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
same = d.get('next_stage') == nxt
if not same:
    d['next_stage'] = nxt
    d.pop('parked', None)   # a park ends when the run moves on
    try:
        d['step'] = int(d.get('step') or 0) + 1
    except (TypeError, ValueError):
        d['step'] = 1
d['updated'] = ts
tmp = '%s.tmp.%d' % (p, os.getpid())
with open(tmp, 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\n')
os.replace(tmp, p)
print('same' if same else 'moved')
PY
  rc=$?
  _lock_release
  # the project's code as Review starts, so the Review check sees a change a Review agent left
  [[ $rc -eq 0 && "$next" == "review" ]] && _review_code save
  return $rc
}

_redo_from() { # _redo_from <stage>: the run goes back to <stage>, so <stage> and every later stage is redone (ADR 0012).
               # Their verdicts leave gates.json, and their skips move from overrides.json to
               # .temper/archive/overrides-redone.json: a skip never outlives the loop that redoes its stage.
               # A fix run's gates are build, review and check: going back to rca or fix redoes all three.
  local to="$1" rc
  local seq; seq="$(_run_seq)"
  local command="temper"
  [[ -f "$STATE_FILE" ]] && command="$(_json_get_path "$STATE_FILE" command temper)"
  if [[ "$command" == "fix" ]]; then
    seq="build review check commit"
    case "$to" in rca|fix) to="build" ;; esac
  fi
  _ensure_dirs
  mkdir -p "$TEMPER_DIR/archive"
  _lock_acquire
  python3 -I - "$GATES_FILE" "$OVERRIDES_FILE" "$TEMPER_DIR/archive/overrides-redone.json" "$to" "$(_now)" $seq <<'PY'
import json, os, sys
gates_p, over_p, redone_p, to, ts = sys.argv[1:6]
seq = sys.argv[6:]
if to not in seq:
    sys.exit(0)
redo = set(seq[seq.index(to):])

def load(p, default):
    try:
        d = json.load(open(p))
        return d if isinstance(d, type(default)) else default
    except Exception:
        return default

def save(p, d):
    tmp = '%s.tmp.%d' % (p, os.getpid())
    with open(tmp, 'w') as f:
        json.dump(d, f, indent=2)
        f.write('\n')
    os.replace(tmp, p)

gates = load(gates_p, {})
if any(k in gates for k in redo):
    save(gates_p, {k: v for k, v in gates.items() if k not in redo})
over = load(over_p, [])
keep = [o for o in over if not (isinstance(o, dict) and o.get('stage') in redo)]
gone = [o for o in over if isinstance(o, dict) and o.get('stage') in redo]
if gone:
    old = load(redone_p, [])
    save(redone_p, old + [dict(o, redone_at=ts, redone_from=to) for o in gone])
    save(over_p, keep)
PY
  rc=$?
  _lock_release
  return $rc
}

_door_base() { # _door_base <slug>: where the work of a run that entered at Review or Check started: the parent of the
               # commit that added the spec's intent.md, else where HEAD left main or master; nothing when neither is known
  local slug="$1" first b mb cur
  first="$(git log --format=%H --no-renames --diff-filter=A -- ".temper/specs/$slug/intent.md" 2>/dev/null | tail -1)"
  if [[ -n "$first" ]] && git rev-parse --verify -q "${first}^" >/dev/null 2>&1; then
    git rev-parse "${first}^"
    return 0
  fi
  cur="$(git branch --show-current 2>/dev/null || true)"
  for b in main master; do
    [[ "$cur" == "$b" ]] && continue
    git rev-parse --verify -q "refs/heads/$b" >/dev/null 2>&1 || continue
    mb="$(git merge-base HEAD "refs/heads/$b" 2>/dev/null || true)"
    [[ -n "$mb" ]] && { echo "$mb"; return 0; }
  done
  return 0
}

cmd_state_advance() { # temper state advance <stage_complete> <next_stage>
  _state_migrate_legacy
  [[ -f "$STATE_FILE" ]] || { echo "FAIL: no active state — run 'temper state init' first" >&2; return 1; }
  [[ $# -ge 2 ]] || { echo "FAIL: usage: temper state advance <stage_complete> <next_stage>" >&2; return 1; }
  local stage="$1" next="$2"
  # state.stage is bookkeeping for resume, not a `temper gate` name — each command has
  # its own sequence (see reference/orchestrator-patterns.md "Build State Schema"), so
  # validate against the sequence for the command this run actually belongs to, not a
  # flat union of every command's vocabulary.
  local command; command="$(_json_get_path "$STATE_FILE" command temper)"
  local valid_stages="$STAGE_SEQ_TEMPER"
  [[ "$command" == "fix" ]] && valid_stages="$STAGE_SEQ_FIX"
  local known=false
  for s in $valid_stages; do
    [[ "$stage" == "${s}_complete" ]] && known=true
  done
  if [[ "$known" != "true" ]]; then
    echo "FAIL: unknown stage '$stage' for command '$command' (expected one of: $(for s in $valid_stages; do printf '%s_complete ' "$s"; done))" >&2
    return 1
  fi
  # ADR 0013: the run leaves the stage it is at, to its next stage, once the check passed or the person skipped it
  local why; why="$(python3 "$SCRIPTS_DIR/flow.py" advance-ok "$stage" "$next")" || {
    echo "FAIL: $why" >&2; return 1; }
  if [[ "$stage" == "plan_complete" ]]; then
    # The commit the diff is read against, the files the person approved and the digest of the tasks they approved:
    # Build is held to these, so a plan.md or tasks.md edited after the plan gate does not change what Build runs
    local spec files digest=""
    spec="$(_json_get_path "$STATE_FILE" spec_path "")"
    files="$(python3 "$SCRIPTS_DIR/flow.py" plan-files "$spec" 2>/dev/null || echo '[]')"
    [[ -n "$spec" && -f "$spec/tasks.md" ]] && digest="$(_plan_digest "$(_grouped_parse "$spec/tasks.md")" 2>/dev/null)"
    _lock_acquire
    python3 -I -c "
import json, os, sys
p = sys.argv[1]
d = json.load(open(p))
try:
    files = json.loads(sys.argv[2])
except ValueError:
    files = []
d['approved_files'] = files if isinstance(files, list) else []
if sys.argv[3]:
    d['plan_hash'] = sys.argv[3]
else:
    d.pop('plan_hash', None)
tmp = '%s.tmp.%d' % (p, os.getpid())
with open(tmp, 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\\n')
os.replace(tmp, p)
" "$STATE_FILE" "$files" "$digest"
    _lock_release
    if [[ -z "$(_json_get_path "$STATE_FILE" base_sha "")" ]]; then
      local head; head="$(git rev-parse HEAD 2>/dev/null || true)"
      # A run that entered at Review or Check reviews work already made, often committed already: its diff starts where
      # the feature started, not at HEAD, or Review would read an empty diff.
      case "$(_json_get_path "$STATE_FILE" enter "")" in
        review|check) local db; db="$(_door_base "$(_json_get_path "$STATE_FILE" spec "")")"; [[ -n "$db" ]] && head="$db" ;;
      esac
      [[ -n "$head" ]] && _json_set_path "$STATE_FILE" "base_sha" "$head" '{}' >/dev/null
    fi
  fi
  # Leaving Design with open areas of concern is the person's acceptance of them (their Continue, or their skip):
  # design.md records it on each, so Build, Review and the report read what was decided
  if [[ "$stage" == "design_complete" ]]; then
    local dmd; dmd="$(_spec_path "")/design.md"
    [[ -f "$dmd" && ! -L "$dmd" ]] && python3 "$SCRIPTS_DIR/flow.py" design-accept "$dmd" "$(date -u +%Y-%m-%d)"
  fi
  _json_set_path "$STATE_FILE" "stage" "$stage" '{}'
  # A commit verdict written before the run reached Commit (the hook of a spec commit) is not the commit gate's: the
  # run enters Commit with no commit verdict and no commit skip, so the commit gate runs for it.
  [[ "$next" == "commit" ]] && _redo_from commit
  _state_next "$next" >/dev/null || return 1
  echo "OK: advanced to $stage (next: $next)"
}

cmd_state_loop() { # temper state loop <from> <to> --reason "..."
  _state_migrate_legacy
  local from="$1" to="$2"; shift 2 || true
  _stage_ok "$to" || { _stage_refuse "$to"; return 1; }
  # A loop goes back, never forward past a gate: its stage is not after the one the run is at.
  local cur; cur="$(_json_get_path "$STATE_FILE" next_stage "")"
  if [[ -n "$cur" ]] && _stage_before "$cur" "$to"; then
    echo "FAIL: a loop goes back; $to comes after $cur, the stage the run is at (leave a stage with state advance)" >&2
    return 1
  fi
  local reason=""
  while [[ $# -gt 0 ]]; do case "$1" in --reason) reason="$2"; shift 2 ;; *) shift ;; esac; done
  [[ -f "$LOOPS_FILE" ]] || echo '{"version":1,"active_loops":[],"history":[]}' > "$LOOPS_FILE"
  local max_per_type
  max_per_type="$(_cfg_get loops.max-per-type 2)"
  # fix.max-loops bounds the check->fix/build pair only when the key is set (Decision 5);
  # every other pair, and an install without the key, keep loops.max-per-type.
  if [[ "$from" == "check" && ( "$to" == "fix" || "$to" == "build" ) ]]; then
    max_per_type="$(_cfg_get fix.max-loops "$max_per_type")"
  fi
  local result
  result=$(python3 -I -c "
import json, sys
f, frm, to, reason, max_per_type, ts = sys.argv[1:7]
max_per_type = int(max_per_type)
d = json.load(open(f))
active = d.get('active_loops', [])
loop = next((l for l in active if l['from_stage'] == frm and l['to_stage'] == to), None)
if loop is None:
    loop = {'id': f'loop-{len(active) + len(d.get(\"history\", [])) + 1}', 'from_stage': frm,
             'to_stage': to, 'reason': reason, 'iteration': 0, 'max_iterations': max_per_type,
             'started': ts}
    active.append(loop)
if loop['iteration'] >= max_per_type:
    print('BLOCKED: max iterations (%d) reached for %s->%s' % (max_per_type, frm, to))
    d['active_loops'] = active
    json.dump(d, open(f, 'w'), indent=2)
    sys.exit(1)
loop['iteration'] += 1
loop['reason'] = reason or loop['reason']
# What the stage left open goes with the loop, since the loop clears that stage's ledger: Review's open findings, Check's
# failed runs. The fix pass reads them (temper next names them in its prompt).
try:
    rows = json.load(open(sys.argv[7])) if len(sys.argv) > 7 and sys.argv[7] else []
except Exception:
    rows = []
def open_row(e):
    if not isinstance(e, dict) or e.get('resolved') or e.get('accepted'):
        return False
    if frm == 'review':
        return bool(e.get('severity'))
    return isinstance(e.get('exit_code'), int) and e.get('exit_code') != 0
left = [('[%s] ' % e['severity'] if e.get('severity') else '') + str(e.get('claim', ''))[:300] for e in rows if open_row(e)]
if left:
    loop['findings'] = left[:20]
else:
    loop.pop('findings', None)
d['active_loops'] = active
json.dump(d, open(f, 'w'), indent=2)
print('OK: loop %s->%s iteration %d/%d' % (frm, to, loop['iteration'], max_per_type))
" "$LOOPS_FILE" "$from" "$to" "$reason" "$max_per_type" "$(_now)" "$(_evidence_file "$from" 2>/dev/null)")
  local rc=$?
  echo "$result"
  # A loop means "we are going backwards" — evidence is append-only, so a stale row
  # from a stage that's being redone (or, in the parallel-Review+Check window, an
  # abandoned background Check run) must not survive to inflate the next gate's count.
  # Belt-and-suspenders with the orchestrator's kill-before-clear ordering, not a
  # substitute for it: this is the backstop for standalone CLI users with no
  # orchestrator to do the kill.
  [[ $rc -eq 0 ]] && _clear_evidence_downstream "$to"
  # F2: going back before Build re-plans the tasks, so the grouped run starts over
  if [[ $rc -eq 0 && -f "$GROUPS_FILE" ]] && [[ "$to" == "intent" || "$to" == "plan" || "$to" == "design" ]]; then
    _groups_reset
  fi
  # and the code an earlier run built no longer stands for the plan: Build builds the plan, not a fix pass of it
  if [[ $rc -eq 0 && -f "$STATE_FILE" ]] && [[ "$to" == "intent" || "$to" == "plan" || "$to" == "design" ]] \
     && [[ -n "$(cmd_state_get built_before "")" ]]; then
    _json_set_path "$STATE_FILE" built_before "" '{}' >/dev/null
  fi
  # P1: the run goes back to the loop's target stage, so the build-checkpoint commit carve-out applies to it
  if [[ $rc -eq 0 && -f "$STATE_FILE" ]]; then
    _redo_from "$to"
    _state_next "$to" >/dev/null
    # A run a door started at a later stage runs the stage it loops back to, and every stage after it
    local enter; enter="$(_json_get_path "$STATE_FILE" enter "")"
    if [[ -n "$enter" ]] && _stage_before "$to" "$enter"; then _json_set_path "$STATE_FILE" enter "$to" '{}' >/dev/null; fi
  fi
  return $rc
}

_groups_reset() { # F2: a loop back before Build ends the grouped run: groups.json goes to .temper/archive/, a clean
                  # group or task worktree is removed and its branch renamed to temper/{slug}/replan-{ts}/{G} (its commits are
                  # kept); a worktree with uncommitted work is left where it is and named, so nothing is lost
  local ts; ts="$(date -u +%Y%m%dT%H%M%SZ)"
  local g wt branch slug
  while IFS=$'\t' read -r slug g wt branch; do
    [[ -n "$g" ]] || continue
    if [[ -n "$wt" && -d "$wt" ]]; then
      local pre; pre="$(_prefix_re)"
      if [[ -n "$(git -C "$wt" status --porcelain=v1 2>/dev/null | cut -c4- | grep -v -e "^${pre}\.temper/" -e "^${pre}\.claude/worktrees/" -e '^\.temper/' -e '^\.claude/worktrees/')" ]]; then
        echo "WARN: $wt has uncommitted work; kept. Move it away (or remove it) before the re-planned run starts $g" >&2
        continue
      fi
      git worktree remove --force "$wt" >/dev/null 2>&1 || { echo "WARN: could not remove $wt; kept" >&2; continue; }
    fi
    if [[ -n "$branch" ]] && git show-ref --verify --quiet "refs/heads/$branch"; then
      git branch -m "$branch" "temper/$slug/replan-$ts/$g" >/dev/null 2>&1 \
        || echo "WARN: could not rename $branch; delete it before the re-planned run starts $g" >&2
    fi
  done < <(python3 -I -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
for g, e in sorted((d.get('groups') or {}).items()):
    print('\t'.join([d.get('slug') or '', g, e.get('worktree') or '', e.get('branch') or '']))
for n, e in sorted((d.get('tasks') or {}).items()):   # a task's own worktree, kept by a park or still running
    if e.get('worktree') or e.get('branch'):
        print('\t'.join([d.get('slug') or '', 'T' + n, e.get('worktree') or '', e.get('branch') or '']))" "$GROUPS_FILE")
  mkdir -p .temper/archive
  mv "$GROUPS_FILE" ".temper/archive/groups-$ts.json" && echo "OK: grouped run reset for the re-plan (groups.json -> .temper/archive/groups-$ts.json)"
}

_spec_dir_ok() { # _spec_dir_ok <slug> -> 0 when .temper/specs/<slug> is a plain folder of this
                 # project's own .temper/specs: no symlink on the way (.temper, specs, the
                 # slug folder, the ledger file), and the folder's parent is, by identity
                 # (device and inode), the specs folder in the project's .temper.
  local d=".temper/specs/$1" real
  [[ -d "$d" && ! -L .temper && ! -L .temper/specs && ! -L "$d" && ! -L "$d/gate-ledger.json" ]] || return 1
  real="$(cd -P "$d" 2>/dev/null && pwd)" || return 1
  [[ -n "$real" && "${real%/*}" -ef "$REPO_ROOT/.temper/specs" ]]
}

_archive_ledger() { # writes gate-ledger.json into the run's spec folder from the live run state.
  # The run's decision record (verdicts, overrides with approver, evidence counts) must
  # not evaporate with the runtime state — it is the audit trail the committed artifact
  # chain exists for. Called by `state archive` (before the commit, so the ledger rides
  # it) and by `state clear` (the safety net for flows that never archived). Idempotent.
  # The target is .temper/specs/<slug>/gate-ledger.json with the slug checked by
  # _spec_slug: a spec_path of any other shape (a hand-edited state file) archives nothing,
  # and says so on stderr (returning 2) so `state archive`, `state clear` and `state init`
  # never drop the ledger without a word. The same goes for a spec folder that does not
  # resolve to a plain folder of the project's own .temper/specs (_spec_dir_ok): the
  # ledger is never written through a symlink.
  local spec_path slug out
  spec_path="$(cmd_state_get spec_path "")"
  [[ -n "$spec_path" ]] || return 0
  slug="$(_spec_slug "$spec_path")"
  if [[ -z "$slug" ]]; then
    echo "WARN: gate ledger NOT archived: spec_path '$spec_path' is not .temper/specs/<slug>" >&2
    return 2
  fi
  out=".temper/specs/$slug/gate-ledger.json"
  if [[ -d ".temper/specs/$slug" && -f "$GATES_FILE" ]] && ! _spec_dir_ok "$slug"; then
    echo "WARN: gate ledger NOT archived: .temper/specs/$slug is not a plain folder of this project's .temper/specs (a symlink is on the way)" >&2
    return 2
  fi
  if [[ -d ".temper/specs/$slug" && -f "$GATES_FILE" ]]; then
    # One (stage, ledger file) pair per name on the fixed list: no other file is read.
    local ev_pairs=() s
    for s in $EVIDENCE_STAGES; do ev_pairs+=("$s" "$(_evidence_file "$s")"); done
    local grouped_json=""
    if [[ -f "$GROUPS_FILE" ]]; then
      grouped_json="$(_group_report_json)"
      grouped_json="$(python3 -I -c "
import json, sys
d = json.loads(sys.argv[1]); d['task_model'] = sys.argv[2]; d['escalation_model'] = sys.argv[3]
print(json.dumps(d))" "$grouped_json" "$(_resolve_task_model)" "$(_resolve_task_escalation_model)")"
    fi
    local usage_json; usage_json="$(_usage_json)"
    python3 -I - "$GATES_FILE" "$OVERRIDES_FILE" "$out" "$(_now)" "$grouped_json" "$usage_json" "${ev_pairs[@]}" <<'PY'
import json, sys
gates_f, overrides_f, out_f, ts, grouped, usage = sys.argv[1:7]
pairs = sys.argv[7:]
def load(p, default):
    try:
        return json.load(open(p))
    except Exception:
        return default
gates = load(gates_f, {})
overrides = load(overrides_f, [])
evidence = {}
for stage, ledger in sorted(zip(pairs[0::2], pairs[1::2])):
    rows = load(ledger, [])
    if rows:
        evidence[stage] = {'rows': len(rows),
                           'labels': {l: sum(1 for e in rows if e.get('label') == l)
                                      for l in sorted({e.get('label') for e in rows if e.get('label')})}}
doc = {'gates': gates, 'overrides': overrides, 'evidence': evidence, 'archived': ts}
if grouped:
    doc['grouped'] = json.loads(grouped)
if usage:
    doc['usage'] = json.loads(usage)
# The same record but for its times (state clear after the commit archives again): the committed file stays as it is,
# so the commit does not leave the spec folder changed.
def bare(o):
    if isinstance(o, dict):
        return {k: bare(v) for k, v in o.items() if k not in ('archived', 'ts')}
    if isinstance(o, list):
        return [bare(v) for v in o]
    return o
if bare(load(out_f, None)) != bare(doc):
    with open(out_f, 'w') as fh:
        json.dump(doc, fh, indent=2)
        fh.write('\n')
PY
    [[ -f "$out" ]] && { echo "$out"; return 0; }
  fi
  return 0
}

cmd_state_archive() { # temper state archive — write the ledger WITHOUT touching state.
                       # Run before `git commit` so the archived record rides the commit
                       # while the live state stays intact for the pre-commit gate.
  local out rc; out="$(_archive_ledger)"; rc=$?
  if [[ -n "$out" ]]; then
    # The record the commit carries: state clear after the commit keeps it, since the commit's own hook records the
    # spec only commit's verdict over the run's commit verdict.
    [[ -f "$STATE_FILE" ]] && _json_set_path "$STATE_FILE" archived "$(_now)" '{}' >/dev/null 2>&1
    echo "OK: gate ledger archived to $out"
  elif [[ $rc -eq 2 ]]; then
    echo "OK: run state untouched; the gate ledger was NOT archived (see the warning above)"
  else
    echo "OK: nothing to archive (no gates recorded, or no spec dir)"
  fi
}

cmd_state_clear() {
  local archived_note="" out="" rc=0 kept slug
  kept="$(cmd_state_get archived "")"
  slug="$(_spec_slug "$(cmd_state_get spec_path "")")"
  if [[ -n "$kept" && -n "$slug" && -f ".temper/specs/$slug/gate-ledger.json" ]]; then
    # state archive wrote the record the commit carries; it stays as committed
    archived_note=" — the gate ledger archived at $kept is kept"
  else
    out="$(_archive_ledger)"; rc=$?
  fi
  [[ -n "$out" ]] && archived_note=" — gate ledger archived to $out"
  [[ $rc -eq 2 ]] && archived_note="; the gate ledger was NOT archived, see the warning above"
  # Each target is written out in full, relative to the project (REPO_ROOT is the cwd).
  rm -f .temper/build-state.json .temper/feedback-loops.json .temper/gates.json .temper/overrides.json .temper/groups.json .temper/usage.json
  rm -rf .temper/evidence
  echo "OK: run state cleared (spec artifacts under .temper/specs/ are untouched${archived_note})"
}

cmd_state_redo() { # temper state redo <stage> [--reason "..."]: "Run Build again" (or Fix): the stage's
                   # verdict goes, and the reason is what the fix pass mends (ADR 0013). The run stays where it is.
  _state_migrate_legacy
  local stage="${1:-}" reason=""; shift || true
  while [[ $# -gt 0 ]]; do case "$1" in --reason) reason="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [[ -f "$STATE_FILE" ]] || { echo "FAIL: no active state" >&2; return 1; }
  local cur; cur="$(_json_get_path "$STATE_FILE" next_stage "")"
  if [[ -z "$stage" || "$stage" != "$cur" ]]; then
    echo "FAIL: the run is at $cur; only the stage it is at runs again" >&2
    return 1
  fi
  _redo_from "$stage" || return 1
  [[ "$stage" == "review" ]] && _review_code save
  # A run a door started at a later stage checks the stages before it instead of running them: one run again is run,
  # and so is every stage after it (the door's entry moves to it).
  local enter; enter="$(_json_get_path "$STATE_FILE" enter "")"
  [[ -n "$enter" ]] && ! _stage_before "$stage" "$enter" && enter=""
  python3 -I - "$STATE_FILE" "$stage" "$reason" "$(_now)" "$enter" <<'PY' || return 1
import json, os, sys
p, stage, reason, ts, enter = sys.argv[1:6]
d = json.load(open(p))
if enter:
    d['enter'] = stage
d['redo'] = {'stage': stage, 'reason': reason, 'ts': ts}
tmp = '%s.tmp.%d' % (p, os.getpid())
with open(tmp, 'w') as f:
    json.dump(d, f, indent=2); f.write('\n')
os.replace(tmp, p)
PY
  echo "OK: $stage runs again${reason:+ ($reason)}"
}

cmd_state() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    redo) cmd_state_redo "$@" ;;
    init) cmd_state_init "$@" ;;
    get) cmd_state_get "$@" ;;
    set) cmd_state_set "$@" ;;
    advance) cmd_state_advance "$@" ;;
    loop) cmd_state_loop "$@" ;;
    archive) cmd_state_archive "$@" ;;
    clear) cmd_state_clear "$@" ;;
    *) echo "FAIL: usage: temper state <init|get|set|advance|loop|archive|clear> ..." >&2; return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# evidence
# ---------------------------------------------------------------------------

cmd_evidence_add() {
  local stage="" claim="" cmd="" exit_code="" artifact="" value="" severity="" label="HEURISTIC" phase="" scenario="" criterion="" confidence=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --claim) claim="$2"; shift 2 ;;
      --confidence) confidence="$2"; shift 2 ;;
      --cmd) cmd="$2"; shift 2 ;;
      --exit) exit_code="$2"; shift 2 ;;
      --artifact) artifact="$2"; shift 2 ;;
      --value) value="$2"; shift 2 ;;
      --severity) severity="$2"; shift 2 ;;
      --label) label="$2"; shift 2 ;;
      --phase) phase="$2"; shift 2 ;;
      --scenario) scenario="$2"; shift 2 ;;
      --criterion) criterion="$2"; shift 2 ;;
      *) echo "FAIL: unknown flag $1" >&2; return 1 ;;
    esac
  done
  [[ -n "$stage" && -n "$claim" ]] || { echo "FAIL: --stage and --claim are required" >&2; return 1; }
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  # A review finding's confidence (reference/review.md): a number from 0 to 1.
  if [[ -n "$confidence" ]] && ! [[ "$confidence" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]]; then
    echo "FAIL: --confidence takes a number from 0 to 1 (0.85), got '$confidence'" >&2; return 1
  fi
  _ensure_dirs

  # A row claimed PROVEN is mechanically re-checked here — never taken on faith.
  # An artifact that doesn't exist, or a nonzero exit paired with PROVEN, is downgraded.
  if [[ "$label" == "PROVEN" ]]; then
    if [[ -n "$artifact" && ! -f "$artifact" ]]; then
      label="HEURISTIC"
      echo "WARN: --label PROVEN downgraded to HEURISTIC — artifact '$artifact' does not exist" >&2
    elif [[ -n "$exit_code" && "$exit_code" != "0" && -z "$severity" ]]; then
      label="HEURISTIC"
      echo "WARN: --label PROVEN downgraded to HEURISTIC — exit code $exit_code is nonzero" >&2
    fi
  fi

  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || (set -C; echo '[]' > "$file") 2>/dev/null || true
  local artifact_hash=""
  if [[ -n "$artifact" && -f "$artifact" ]]; then
    artifact_hash="$(python3 -I -c "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())" "$artifact" 2>/dev/null || echo "")"
  fi
  local entry
  entry=$(python3 -I -c "
import json, sys
claim, cmd, exit_code, artifact, artifact_hash, value, severity, label, phase, scenario, criterion, confidence, ts = sys.argv[1:]
e = {'claim': claim, 'cmd': cmd or None,
     'exit_code': int(exit_code) if exit_code != '' else None,
     'artifact': artifact or None, 'sha256': artifact_hash or None,
     'value': (float(value) if value != '' else None),
     'severity': severity or None, 'phase': phase or None, 'scenario': scenario or None,
     'criterion': criterion or None, 'label': label, 'ts': ts}
if confidence != '':
    e['confidence'] = float(confidence)
print(json.dumps(e))
" "$claim" "$cmd" "$exit_code" "$artifact" "$artifact_hash" "$value" "$severity" "$label" "$phase" "$scenario" "$criterion" "$confidence" "$(_now)")
  _json_append "$file" "$entry"
  echo "OK: [$label] $stage: $claim"
}

cmd_evidence_list() {
  local stage="" as_json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --json) as_json=true; shift ;;
      *) shift ;;
    esac
  done
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo "[]"; return 0; }
  if [[ "$as_json" == "true" ]]; then
    cat "$file"
  else
    python3 -I -c "
import json, sys
for i, e in enumerate(json.load(open(sys.argv[1])), 1):
    mark = 'OK ' if (e.get('exit_code') in (0, None)) else 'ERR'
    line = f\"#{i} [{e.get('label')}] {mark} {e.get('claim')}\"
    if e.get('severity'):
        line += f\" (severity: {e.get('severity')})\"
    if e.get('resolved'):
        line += f\" [resolved: {e['resolved'].get('fixed_by')}]\"
    if e.get('accepted'):
        line += f\" [accepted: {e['accepted'].get('reason')}]\"
    if e.get('cmd'):
        line += f\" (cmd: {e.get('cmd')}, exit {e.get('exit_code')})\"
    if e.get('scenario'):
        line += f\" [scenario: {e.get('scenario')}]\"
    print(line)
" "$file"
  fi
}

cmd_evidence_resolve() { # temper evidence resolve --stage <s> --id <n> --fixed-by "<commit or note>"
  # Marks one recorded finding as fixed in THIS run. The row is kept — the ledger must
  # still show what was found — but the gate no longer counts it. The alternative was
  # deleting evidence to go green, which QUALITY-GATES forbids (woningscout #984).
  local stage="" id="" fixed_by=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --fixed-by) fixed_by="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$stage" && -n "$id" && -n "$fixed_by" ]] || { echo "FAIL: usage: temper evidence resolve --stage <s> --id <n> --fixed-by \"<commit or note>\" (ids from 'temper evidence list --stage <s>')" >&2; return 1; }
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo "FAIL: no evidence recorded for stage '$stage'" >&2; return 1; }
  _lock_acquire
  python3 -I - "$file" "$id" "$fixed_by" "$(_now)" <<'PY'
import json, os, sys
f, id_s, fixed_by, ts = sys.argv[1:5]
entries = json.load(open(f))
try:
    idx = int(id_s)
except ValueError:
    sys.exit("FAIL: --id must be the 1-based number shown by 'temper evidence list'")
if idx < 1 or idx > len(entries):
    sys.exit("FAIL: no finding #%s in this stage (it has %d entries)" % (id_s, len(entries)))
e = entries[idx - 1]
if not e.get('severity'):
    sys.exit("FAIL: finding #%s carries no severity, so it never counted against a gate" % id_s)
if e.get('resolved'):
    sys.exit("FAIL: finding #%s is already resolved (%s)" % (id_s, e['resolved'].get('fixed_by')))
if e.get('accepted'):
    sys.exit("FAIL: finding #%s is already accepted (%s)" % (id_s, e['accepted'].get('reason')))
e['resolved'] = {'fixed_by': fixed_by, 'ts': ts}
tmp = '%s.tmp.%d' % (f, os.getpid())
with open(tmp, 'w') as fh:
    json.dump(entries, fh, indent=2)
os.replace(tmp, f)
print("OK: %s finding #%s resolved — %s" % (e.get('severity'), id_s, fixed_by))
PY
  local rc=$?
  _lock_release
  return $rc
}

cmd_evidence_accept() { # temper evidence accept --stage <s> --id <n> --reason "<why>"
  # A person decides a finding stays as it is. Like resolve, the row is kept — the ledger
  # still shows what was found — but the gate stops counting it, and the decision carries
  # a reason, an author (git identity, as override does) and a time.
  local stage="" id="" reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$stage" && -n "$id" && -n "${reason//[[:space:]]/}" ]] || { echo "FAIL: usage: temper evidence accept --stage <s> --id <n> --reason \"<why>\" (a non-empty reason is required; ids from 'temper evidence list --stage <s>')" >&2; return 1; }
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo "FAIL: no evidence recorded for stage '$stage'" >&2; return 1; }
  local by name email
  name="$(git config user.name 2>/dev/null || true)"
  email="$(git config user.email 2>/dev/null || true)"
  by="$name"
  [[ -n "$email" ]] && by="${by:+$by }<$email>"
  [[ -n "$by" ]] || by="${USER:-unknown}"
  _lock_acquire
  python3 -I - "$file" "$id" "$reason" "$by" "$(_now)" <<'PY'
import json, os, sys
f, id_s, reason, by, ts = sys.argv[1:6]
entries = json.load(open(f))
try:
    idx = int(id_s)
except ValueError:
    sys.exit("FAIL: --id must be the 1-based number shown by 'temper evidence list'")
if idx < 1 or idx > len(entries):
    sys.exit("FAIL: no finding #%s in this stage (it has %d entries)" % (id_s, len(entries)))
e = entries[idx - 1]
if not e.get('severity'):
    sys.exit("FAIL: finding #%s carries no severity, so it never counted against a gate" % id_s)
if e.get('resolved'):
    sys.exit("FAIL: finding #%s is already resolved (%s)" % (id_s, e['resolved'].get('fixed_by')))
if e.get('accepted'):
    sys.exit("FAIL: finding #%s is already accepted (%s)" % (id_s, e['accepted'].get('reason')))
e['accepted'] = {'reason': reason, 'author': by, 'ts': ts}
tmp = '%s.tmp.%d' % (f, os.getpid())
with open(tmp, 'w') as fh:
    json.dump(entries, fh, indent=2)
os.replace(tmp, f)
print("OK: %s finding #%s accepted by %s — %s" % (e.get('severity'), id_s, by, reason))
PY
  local rc=$?
  _lock_release
  return $rc
}

cmd_evidence_run() { # temper evidence run --stage s --claim c [--phase p] [--scenario x]
                      # [--severity s] [--label L] -- <cmd...>
  # The CLI executes the command ITSELF and records the exit code it observed — so a
  # PROVEN label here means machine-observed, not agent-reported. Deliberately skips
  # cmd_evidence_add's nonzero-exit downgrade: a RED run (exit 1) recorded by the
  # process that ran it is exactly as proven as a green one. Always returns 0 — the
  # record is the product; pass/fail is the gate's business (the printed line and the
  # ledger carry the exit code).
  local stage="" claim="" phase="" scenario="" severity="" label="PROVEN" criterion=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="$2"; shift 2 ;;
      --claim) claim="$2"; shift 2 ;;
      --phase) phase="$2"; shift 2 ;;
      --scenario) scenario="$2"; shift 2 ;;
      --severity) severity="$2"; shift 2 ;;
      --label) label="$2"; shift 2 ;;
      --criterion) criterion="$2"; shift 2 ;;
      --) shift; break ;;
      *) echo "FAIL: unknown flag $1 (command goes after --)" >&2; return 1 ;;
    esac
  done
  [[ -n "$stage" && -n "$claim" && $# -gt 0 ]] || { echo "FAIL: usage: temper evidence run --stage <s> --claim <c> -- <cmd...>" >&2; return 1; }
  # Checked before the command runs: an unknown stage records nothing and runs nothing.
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs
  "$@"
  local exit_code=$?
  local cmd_str="$*"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || (set -C; echo '[]' > "$file") 2>/dev/null || true
  local entry
  entry=$(python3 -I -c "
import json, sys
claim, cmd, exit_code, severity, label, phase, scenario, criterion, ts = sys.argv[1:]
e = {'claim': claim, 'cmd': cmd, 'exit_code': int(exit_code), 'artifact': None,
     'sha256': None, 'value': None, 'severity': severity or None,
     'phase': phase or None, 'scenario': scenario or None, 'criterion': criterion or None,
     'label': label, 'executed_by': 'cli', 'ts': ts}
print(json.dumps(e))
" "$claim" "$cmd_str" "$exit_code" "$severity" "$label" "$phase" "$scenario" "$criterion" "$(_now)")
  _json_append "$file" "$entry"
  echo "OK: [$label] $stage: $claim (cli-executed, exit $exit_code)"
  return 0
}

cmd_evidence_clear() { # temper evidence clear --stage <s> — truncate that stage's ledger file to []
  local stage=""
  while [[ $# -gt 0 ]]; do
    case "$1" in --stage) stage="$2"; shift 2 ;; *) shift ;; esac
  done
  [[ -n "$stage" ]] || { echo "FAIL: usage: temper evidence clear --stage <s>" >&2; return 1; }
  _stage_ok "$stage" || { _stage_refuse "$stage"; return 1; }
  _ensure_dirs
  echo '[]' > "$(_evidence_file "$stage")"
  echo "OK: evidence cleared for '$stage'"
}

cmd_evidence() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    add) cmd_evidence_add "$@" ;;
    run) cmd_evidence_run "$@" ;;
    list) cmd_evidence_list "$@" ;;
    resolve) cmd_evidence_resolve "$@" ;;
    accept) cmd_evidence_accept "$@" ;;
    clear) cmd_evidence_clear "$@" ;;
    *) echo "FAIL: usage: temper evidence <add|run|list|resolve|accept|clear> ..." >&2; return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# config — scriptable read access to .claude/temper.config (the same parser
# every gate uses, exposed so hook scripts and CI steps never re-implement it).
# ---------------------------------------------------------------------------

cmd_config() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    get) [[ -n "${1:-}" ]] || { echo "FAIL: usage: temper config get <dot.path> [default]" >&2; return 1; }
         # fix.max-loops prints the limit `state loop check fix` keeps: the key, else loops.max-per-type, else 2
         if [[ "$1" == "fix.max-loops" ]]; then _cfg_get "$1" "${2:-$(_cfg_get loops.max-per-type 2)}"; else _cfg_get "$1" "${2:-}"; fi ;;
    *) echo "FAIL: usage: temper config get <dot.path> [default]" >&2; return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# gate — the whole point. Deterministic PASS/FAIL, evidence-backed.
# ---------------------------------------------------------------------------

_gate_write_verdict() { # _gate_write_verdict <stage> <verdict> <requirements-json-array>
  local stage="$1" verdict="$2" reqs="$3" rc
  _lock_acquire
  [[ -f "$GATES_FILE" ]] || echo '{}' > "$GATES_FILE"
  python3 -I -c "
import json, os, sys
f, stage, verdict, reqs, ts = sys.argv[1:6]
d = json.load(open(f))
d[stage] = {'verdict': verdict, 'requirements': json.loads(reqs), 'ts': ts}
tmp = '%s.tmp.%d' % (f, os.getpid())
with open(tmp, 'w') as fh:
    json.dump(d, fh, indent=2)
os.replace(tmp, f)
" "$GATES_FILE" "$stage" "$verdict" "$reqs" "$(_now)"
  rc=$?
  _lock_release
  return $rc
}

_spec_path() {
  local override="$1"
  if [[ -n "$override" ]]; then echo "$override"; return; fi
  cmd_state_get spec_path ""
}

_evidence_file() { # <stage> -> its ledger file, each path written out in full relative to the
                   # project (an unknown stage has none; callers check _stage_ok first)
  case "$1" in
    intent) echo ".temper/evidence/intent.json" ;;
    plan)   echo ".temper/evidence/plan.json" ;;
    design) echo ".temper/evidence/design.json" ;;
    build)  echo ".temper/evidence/build.json" ;;
    review) echo ".temper/evidence/review.json" ;;
    check)  echo ".temper/evidence/check.json" ;;
    commit) echo ".temper/evidence/commit.json" ;;
    rca)    echo ".temper/evidence/rca.json" ;;
    fix)    echo ".temper/evidence/fix.json" ;;
    *)      echo "" ;;
  esac
}

_clear_evidence_downstream() { # _clear_evidence_downstream <to> — truncates evidence for
                                # <to> and every gate stage after it in the run's own sequence
  local to="$1" seen=false s
  _ensure_dirs
  # A /temper:fix run records its RED/GREEN under the `build` gate and has no plan or
  # design evidence, so its gate sequence is build -> review -> check and a loop back to
  # `rca` or `fix` must clear from `build`. Walking STAGE_SEQ_TEMPER here cleared nothing
  # for a fix run, which left a self-fixed review finding inflating the gate for ever
  # (woningscout #984).
  local seq="$STAGE_SEQ_TEMPER" command="temper"
  [[ -f "$STATE_FILE" ]] && command="$(_json_get_path "$STATE_FILE" command temper)"
  if [[ "$command" == "fix" ]]; then
    seq="build review check"
    case "$to" in rca|fix) to="build" ;; esac
  fi
  for s in $seq; do
    [[ "$s" == "$to" ]] && seen=true
    [[ "$seen" == "true" ]] && echo '[]' > "$(_evidence_file "$s")"
  done
}

# Purpose-built evidence queries — every value crosses the shell/python boundary as an
# argv element, never interpolated into python source, so no claim/detail text can ever
# be misparsed as code.

_ev_count_matching() { # _ev_count_matching <stage> <keyword-regex|""> <phase|""> <exit:any|0|nonzero>
  local stage="$1" keyword="$2" phase="$3" exitfilter="$4"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  python3 -I -c "
import json, sys, re
file, keyword, phase, exitfilter = sys.argv[1:5]
entries = json.load(open(file))
n = 0
for e in entries:
    if keyword and not re.search(keyword, e.get('claim') or '', re.I):
        continue
    if phase and e.get('phase') != phase:
        continue
    if exitfilter == '0' and e.get('exit_code') != 0:
        continue
    if exitfilter == 'nonzero' and e.get('exit_code') in (0, None):
        continue
    n += 1
print(n)
" "$file" "$keyword" "$phase" "$exitfilter"
}

_ev_last_value() { # _ev_last_value <stage> <keyword-regex|""> -> last matching entry's numeric value, or ""
  local stage="$1" keyword="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo ""; return; }
  python3 -I -c "
import json, sys, re
file, keyword = sys.argv[1:3]
entries = json.load(open(file))
vals = [e.get('value') for e in entries
        if (not keyword or re.search(keyword, e.get('claim') or '', re.I)) and e.get('value') is not None]
print(vals[-1] if vals else '')
" "$file" "$keyword"
}

_ev_count_severity_in() { # _ev_count_severity_in <stage> <comma-separated severities>
  local stage="$1" sev_csv="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  # A finding marked resolved (temper evidence resolve) stays in the ledger as the record
  # of what was found and fixed, but no longer counts against the gate (woningscout #984).
  python3 -I -c "
import json, sys
file, sev_csv = sys.argv[1:3]
sevs = set(s for s in sev_csv.split(',') if s)
entries = json.load(open(file))
print(sum(1 for e in entries if e.get('severity') in sevs and not e.get('resolved') and not e.get('accepted')))
" "$file" "$sev_csv"
}

_ev_count_resolved_in() { # _ev_count_resolved_in <stage> <comma-separated severities>
  local stage="$1" sev_csv="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  python3 -I -c "
import json, sys
file, sev_csv = sys.argv[1:3]
sevs = set(s for s in sev_csv.split(',') if s)
entries = json.load(open(file))
print(sum(1 for e in entries if e.get('severity') in sevs and e.get('resolved')))
" "$file" "$sev_csv"
}

_ev_count_accepted_in() { # _ev_count_accepted_in <stage> <comma-separated severities>
  local stage="$1" sev_csv="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  python3 -I -c "
import json, sys
file, sev_csv = sys.argv[1:3]
sevs = set(s for s in sev_csv.split(',') if s)
entries = json.load(open(file))
print(sum(1 for e in entries if e.get('severity') in sevs and e.get('accepted')))
" "$file" "$sev_csv"
}

_ev_scenarios_covered() { # _ev_scenarios_covered <stage> -> count of DISTINCT scenarios
                           # recorded with exit_code 0 (an agent traces each Gherkin
                           # scenario to a test via --scenario "<name>" --exit <code>)
  local stage="$1"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo 0; return; }
  python3 -I -c "
import json, sys
entries = json.load(open(sys.argv[1]))
covered = {e['scenario'] for e in entries if e.get('scenario') and e.get('exit_code') == 0}
print(len(covered))
" "$file"
}

_intent_uncovered_scenarios() { # _intent_uncovered_scenarios <intent.md> <stage>
                                 # -> \x1f-joined scenario names present in intent.md but
                                 # not recorded as covered (exit_code 0) in the ledger
  local intent="$1" stage="$2"
  local file; file="$(_evidence_file "$stage")"
  python3 -I -c "
import json, re, sys
intent_path, ev_path = sys.argv[1:3]
names = []
for line in open(intent_path):
    m = re.match(r'^\s*Scenario:\s*(.+?)\s*$', line)
    if m:
        names.append(m.group(1))
covered = set()
try:
    entries = json.load(open(ev_path))
    covered = {e['scenario'] for e in entries if e.get('scenario') and e.get('exit_code') == 0}
except Exception:
    pass
missing = [n for n in names if n not in covered]
print('\x1f'.join(missing))
" "$intent" "$file"
}

_req() { # _req <label> <bool 0|1> <detail> -> emits one requirement json line to stdout, and echoes pass/fail
  local label="$1" ok="$2" detail="$3"
  python3 -I -c "
import json, sys
print(json.dumps({'name': sys.argv[1], 'pass': sys.argv[2] == '1', 'detail': sys.argv[3]}))
" "$label" "$ok" "$detail"
}

# Draft-intent requirements. Ten checks that apply to **Status:** draft intents
# only — a recorded acceptance is never revisited, so an accepted/completed
# intent records a PASS-with-skip-detail for each instead. Emits one JSON object
# per line (same shape _req produces); intent.md parsing is shared with
# scripts/acceptance.py so the gate and the acceptance checker can never drift.
_intent_draft_reqs() { # _intent_draft_reqs <intent.md>
  # acceptance.py is loaded from its one full path, never by adding a folder to sys.path.
  python3 -I - "$ACCEPTANCE_PY" "$1" <<'PY'
import importlib.util, json, os, re, sys
_spec = importlib.util.spec_from_file_location('acceptance', sys.argv[1])
A = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(A)

lines = open(sys.argv[2]).read().splitlines()
reqs = []
def add(name, ok, detail):
    reqs.append({'name': name, 'pass': ok, 'detail': detail})

m = re.search(r'^\*\*Status:\*\*\s*(draft|accepted|completed)\s*$', "\n".join(lines), re.I | re.M)
status = m.group(1).lower() if m else None   # None: missing or unknown Status header
if status != 'draft':
    d = ("skipped — intent is %s; this check applies to drafts only "
         "(a recorded acceptance is never revisited)") % status
    if status is None:
        # A missing or unknown Status header is reported by the gate's own status header
        # row; these rows say why they skipped instead of printing Python's None.
        d = ("skipped: no recognized Status header (draft, accepted or completed); this check "
             "applies to drafts only, and the status header requirement reports the missing header")
    for name in ('task context recorded', 'criteria why', 'target users action chain',
                 'criteria ids', 'criteria priority', 'criteria validate',
                 'open questions labeled', 'no duplicate question', 'header fields',
                 'no scenarios in draft', 'no soft words'):
        add(name, True, d)
    print("\n".join(json.dumps(r) for r in reqs))
    sys.exit(0)

def sec(name):
    return A.section_lines(lines, name)

def bullets_with_blocks(sec_lines):
    """Real (non-placeholder) bullets with their continuation blocks."""
    out, cur = [], None
    for l in sec_lines:
        if A.BULLET_RE.match(l):
            if cur: out.append(cur)
            content = A.strip_checkbox(l)
            cur = {'first': content, 'block': [l], 'placeholder': content.startswith('{')}
        elif cur is not None:
            cur['block'].append(l)
    if cur: out.append(cur)
    return [b for b in out if not b['placeholder']]

# --- task context recorded -------------------------------------------------
ctx = sec('Source Traceability')
ctx_lines = [l for l in ctx if re.match(r'^\s*-\s*(consulted|unavailable|none):', l, re.I)]
unaccounted = []
if ctx_lines:
    ctx_text = "\n".join(ctx_lines)
    tk = re.search(r'^\*\*Ticket:\*\*\s*(.+?)\s*$', "\n".join(lines), re.I | re.M)
    raw = A.blank_placeholders(tk.group(1)).strip() if tk else ''
    keys = re.findall(r'[A-Z][A-Z0-9]+-[0-9]+|#[0-9]+|![0-9]+', raw) if raw else []
    for k in keys:
        # whole-token match: no alnum may sit immediately before or after the
        # key — a recorded PROJ-12 must not satisfy a linked PROJ-1.
        if not re.search(r'(?<![A-Za-z0-9])' + re.escape(k) + r'(?![A-Za-z0-9])', ctx_text):
            unaccounted.append(k)
if not ctx_lines or unaccounted:
    if not ctx_lines:
        add('task context recorded', False,
            'no consulted/unavailable/none line under ## Source Traceability — record every linked source')
    else:
        add('task context recorded', False,
            'ticket key(s) never accounted for on a consulted/unavailable line: ' + ' | '.join(unaccounted))
else:
    add('task context recorded', True, '%d source line(s) recorded under Source Traceability' % len(ctx_lines))

# --- criteria family -------------------------------------------------------
crits = [c for c in A.parse_criteria(sec('Success Criteria')) if not c.get('placeholder')]

no_id = [c['first_line'][:40] for c in crits if not c.get('id')]
seen, dups = set(), []
for c in crits:
    if c.get('id') and c['id'] in seen and c['id'] not in dups:
        dups.append(c['id'])
    elif c.get('id'):
        seen.add(c['id'])
if no_id or dups:
    parts = (['duplicate id: ' + d for d in dups] + ['no AC-NN id: ' + s for s in no_id])
    add('criteria ids', False, ' | '.join(parts))
elif not crits:
    add('criteria ids', False, 'no real criteria found')
else:
    add('criteria ids', True, '%d criterion id(s), all unique' % len(crits))

def label(c):
    return c.get('id') or c['first_line'][:40]

no_prio = [label(c) for c in crits if not c.get('priority')]
add('criteria priority', not no_prio,
    'every criterion carries [required]/[optional]' if not no_prio
    else 'no [required]/[optional] on first line of: ' + ' | '.join(no_prio))

bad_v = [label(c) for c in crits if not c['has_validate'] or c['vtype'] not in A.VALIDATE_TYPES]
add('criteria validate', not bad_v,
    'every criterion has a Validate: type' if not bad_v
    else 'missing/unknown Validate: type on: ' + ' | '.join(bad_v))

no_why = [label(c) for c in crits if not c['why']]
add('criteria why', not no_why,
    'every criterion states the outcome or risk it serves' if not no_why
    else 'no Why: line with real text on: ' + ' | '.join(no_why))

# --- target users action chain --------------------------------------------
tusers = bullets_with_blocks(sec('Target Users'))
bad_u = [' '.join(b['block'])[:60] for b in tusers
         if not any(('→' in l or '->' in l) for l in b['block'])]
add('target users action chain', not bad_u,
    'every Target Users bullet is an action chain (user: does -> next)' if not bad_u
    else 'no action chain (→ or ->) on: ' + ' | '.join(bad_u))

# --- open questions --------------------------------------------------------
def norm_q(text):
    t = A.BULLET_RE.sub('', text)
    t = re.sub(r'^\s*\|', '', t)
    t = re.sub(r'^\s*(\[[^\]]*\]|Blocking:|Deferred:)', '', t, flags=re.I)
    t = t.replace('**', '').lower()
    t = re.sub(r'[^a-z0-9 ]', ' ', t)
    return [w for w in t.split()][:8]

oq = bullets_with_blocks(sec('Open Questions'))
unlabeled = [b['first'][:50] for b in oq
             if not re.search(r'\b(blocking|deferred)\b', ' '.join(b['block']), re.I)]
add('open questions labeled', not unlabeled,
    'every open question is labeled Blocking or Deferred' if not unlabeled
    else 'neither blocking nor deferred on: ' + ' | '.join(unlabeled))

dup_q = []
if oq:
    topics = []
    for l in sec('Decisions'):
        d = A.BULLET_RE.sub('', l)
        if '->' in d:
            topics.append(norm_q(d.split('->', 1)[0]))
    for b in oq:
        q = norm_q(b['first'])
        for t in topics:
            if not q or not t:
                continue
            shorter, longer = (q, t) if len(q) <= len(t) else (t, q)
            if len(shorter) >= 4 and longer[:len(shorter)] == shorter:
                dup_q.append(b['first'][:50])
                break
add('no duplicate question', not dup_q,
    'no open question re-asks something already decided' if not dup_q
    else 'already answered in ### Decisions: ' + ' | '.join(dup_q))

# --- header fields ---------------------------------------------------------
missing_h = []
for f in ('Author', 'Created', 'Reviewer'):
    hm = re.search(r'^\*\*' + f + r':\*\*\s*(.+?)\s*$', "\n".join(lines), re.I | re.M)
    val = A.blank_placeholders(hm.group(1)).strip() if hm else ''
    if not val:
        missing_h.append(f)
add('header fields', not missing_h,
    'Author, Created, Reviewer all present' if not missing_h
    else 'missing, empty, or placeholder: ' + ' | '.join(missing_h))

# --- no scenarios in draft -------------------------------------------------
scen = A.scenario_lines(lines)
add('no scenarios in draft', not scen,
    'no Scenario: lines — Plan writes the scenarios' if not scen
    else 'Scenario: line(s) at ' + ' | '.join(str(n) for _, n in scen))

# --- no soft words ---------------------------------------------------------
# A criterion or constraint states what is required. should/may/might/possibly leave
# the reader to guess. A statement that carries a (source: ...) marker is exempt: the
# hedge word belongs to the originator, and ### Decisions records what it means.
SOFT_RE = re.compile(r'\b(should|may|might|possibly)\b', re.I)
META_RE = re.compile(r'^\s*(Why|Validate|Deferred|Blocking):', re.I)

def statements(sec_lines):
    """(label, statement text) per real bullet. The statement is the bullet line plus
    its wrapped continuation lines, up to the first Why:/Validate:/Deferred: line."""
    out, cur = [], None
    in_fence = False
    for l in sec_lines:
        if re.match(r'^\s*(`{3,}|~{3,})', l):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        if A.BULLET_RE.match(l):
            if cur: out.append(cur)
            content = A.strip_checkbox(l)
            if content.startswith('{'):
                cur = None
                continue
            m = re.match(r'^(AC-\d+)\b', content)
            cur = {'label': m.group(1) if m else '"%s"' % content[:30], 'text': [content], 'open': True}
        elif cur is not None and cur['open']:
            if META_RE.match(l):
                cur['open'] = False
            elif l.strip():
                cur['text'].append(l.strip())
    if cur: out.append(cur)
    return [(c['label'], ' '.join(c['text'])) for c in out]

soft = []
for kind, sname in (('criterion', 'Success Criteria'), ('constraint', 'Constraints')):
    for lab, text in statements(sec(sname)):
        if re.search(r'\(source:', text, re.I):
            continue
        body = re.sub(r'`[^`]*`', ' ', text)
        words = []
        for w in SOFT_RE.findall(body):
            if w.lower() not in words:
                words.append(w.lower())
        if words:
            soft.append('%s %s uses %s' % (kind, lab, ', '.join(words)))
add('no soft words', not soft,
    'no should/may/might/possibly in a criterion or constraint without a (source: ...) marker' if not soft
    else 'soft word in: ' + ' | '.join(soft))

print("\n".join(json.dumps(r) for r in reqs))
PY
}

_intent_closure_reqs() { # _intent_closure_reqs <intent.md> -> JSON rows: "out of scope stated"
                         # and "open questions resolved" (both apply to drafts only; the second is informational)
  python3 -I - "$ACCEPTANCE_PY" "$1" <<'PY'
import importlib.util, json, re, sys
_spec = importlib.util.spec_from_file_location('acceptance', sys.argv[1])
A = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(A)

lines = open(sys.argv[2]).read().splitlines()
reqs = []
def add(name, ok, detail):
    reqs.append({'name': name, 'pass': ok, 'detail': detail})

m = re.search(r'^\*\*Status:\*\*\s*(draft|accepted|completed)\s*$', "\n".join(lines), re.I | re.M)
status = m.group(1).lower() if m else None   # None: missing or unknown Status header

# Both requirements apply only while the intent is a draft: a recorded acceptance is never
# revisited, so an accepted or completed intent skips them with a PASS.
SKIP = ('skipped \u2014 intent is %s; this check applies to drafts only (a recorded acceptance is never revisited)' % status
        if status else
        'skipped: no recognized Status header (draft, accepted or completed); this check applies to drafts only, and the status header requirement reports the missing header')

# --- out of scope stated: a '- Out of scope:' bullet with non-placeholder text ----------
scope = A.section_lines(lines, 'Scope and Non-goals') or A.section_lines(lines, 'Scope')
found = False
for l in scope:
    om = re.match(r'^\s*-\s*Out of scope:\s*(.*?)\s*$', l, re.I)
    if om and re.search(r'[A-Za-z0-9]', A.blank_placeholders(om.group(1))):
        found = True
        break
if status != 'draft':   # explicitly draft only
    add('out of scope stated', True, SKIP)
else:
    add('out of scope stated', found,
        'Scope states what is out of scope' if found
        else 'no "- Out of scope:" bullet with real text under ### Scope and Non-goals')

# --- open questions resolved: a draft reports its Blocking questions (informational) -------
# Drafts legitimately carry Blocking questions (the shipped example does), so this never fails
# a draft; it names what is still open so the person answers it before accepting.
if status != 'draft':
    add('open questions resolved', True, SKIP)
else:
    blocking = []
    cur = None
    for l in A.section_lines(lines, 'Open Questions'):
        if A.BULLET_RE.match(l):
            cur = [l]
            blocking.append(cur)
        elif cur is not None:
            cur.append(l)
    blocking = [' '.join(b).strip()[:60] for b in blocking
                if not A.strip_checkbox(b[0]).startswith('{')
                and re.match(r'^\W*blocking\b', A.strip_checkbox(b[0]), re.I)]
    add('open questions resolved', True,
        'no Blocking question remains' if not blocking
        else '%d Blocking question(s) still open on the draft; answer them into ### Decisions before accepting: %s' % (len(blocking), ' | '.join(blocking)))
print("\n".join(json.dumps(r) for r in reqs))
PY
}

gate_intent() {
  # The fail-fast gate: intent is the artifact everything downstream is derived from,
  # so a wrong intent multiplies into wrong scenarios, a wrong plan, and a wrong
  # build — tokens spent for nothing. This gate makes the human review the CHEAP
  # artifact before the expensive stages run. Mechanically checkable floor: a Problem
  # section with real content (not template placeholders), at least one success
  # criterion, and a Status header. intent.md absent => the run took the trivial path
  # (no artifacts) => PASS; the commit gate requires an intent verdict exactly when
  # the artifact exists, so a skipped gate on a real intent cannot reach commit.
  local spec_path="$1"
  local reqs=() all_pass=1
  if [[ ! -f "$spec_path/intent.md" ]]; then
    reqs+=("$(_req "intent artifact" 1 "intent.md absent — trivial path, no artifacts")")
  else
    local problem_lines criteria status_line
    # A placeholder starts a line with '{' and runs to the line that closes it with '}',
    # so the second line of a placeholder spanning two lines is not content either.
    problem_lines=$(awk '
      function depth(s,   t, o, c) { t = s; o = gsub(/\{/, "", t); t = s; c = gsub(/\}/, "", t); return o - c }
      /^#+[[:space:]]*Problem/ { f=1; open_ph=0; next }
      f && /^#+[[:space:]]/ { f=0 }
      !f { next }
      open_ph > 0 { open_ph += depth($0); next }
      /^[[:space:]]*\{/ { open_ph = depth($0); if (open_ph < 0) open_ph = 0; next }
      NF { c++ }
      END { print c+0 }
    ' "$spec_path/intent.md")
    if [[ "$problem_lines" -gt 0 ]]; then
      reqs+=("$(_req "problem stated" 1 "Problem section has $problem_lines line(s) of content")")
    else
      reqs+=("$(_req "problem stated" 0 "Problem section is missing, empty, or still template placeholders")")
      all_pass=0
    fi
    # A criterion is a '- ' line whose CONTENT isn't a template placeholder: strip the
    # optional checkbox and the 'AC-NN [required]: ' prefix, then reject anything still
    # starting with '{' — the template's own '{criterion}' bullets must not count.
    criteria=$(awk '
      /^#+[[:space:]]*Success Criteria/ { f=1; next }
      f && /^#+[[:space:]]/ { f=0 }
      f && /^- / { t=$0; sub(/^- \[[ xX]\] */,"",t); sub(/^- */,"",t); sub(/^AC-[0-9]+[ \t]*\[(required|optional)\]:[ \t]*/,"",t); if (t !~ /^\{/) c++ }
      END { print c+0 }
    ' "$spec_path/intent.md")
    if [[ "$criteria" -gt 0 ]]; then
      reqs+=("$(_req "success criteria" 1 "$criteria criterion/criteria listed")")
    else
      reqs+=("$(_req "success criteria" 0 "no real success criteria (template placeholders don't count) — nothing downstream can be validated against")")
      all_pass=0
    fi
    # The Status value must be an actual lifecycle state, not the template's
    # '{draft | accepted | completed}' placeholder.
    if grep -qiE '^\*\*Status:\*\*[[:space:]]*(draft|accepted|completed)[[:space:]]*$' "$spec_path/intent.md"; then
      status_line="$(grep -m1 -iE '^\*\*Status:\*\*[[:space:]]*(draft|accepted|completed)[[:space:]]*$' "$spec_path/intent.md")"
      reqs+=("$(_req "status header" 1 "$status_line")")
    else
      reqs+=("$(_req "status header" 0 "no **Status:** draft|accepted|completed header (a placeholder doesn't count) — the lifecycle has nowhere to live")")
      all_pass=0
    fi
    # Draft-stage requirements (skipped with a PASS row on accepted/completed).
    local draft_line
    while IFS= read -r draft_line; do
      [[ -z "$draft_line" ]] && continue
      reqs+=("$draft_line")
      grep -q '"pass": false' <<<"$draft_line" && all_pass=0
    done < <(_intent_draft_reqs "$spec_path/intent.md")
    while IFS= read -r draft_line; do
      [[ -z "$draft_line" ]] && continue
      reqs+=("$draft_line")
      grep -q '"pass": false' <<<"$draft_line" && all_pass=0
    done < <(_intent_closure_reqs "$spec_path/intent.md")
  fi
  local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

_unfenced_scenarios() { # _unfenced_scenarios <intent.md> -> \x1f-joined "lineno: text" for
                        # every Scenario: line not protected by a ```gherkin fence
  python3 -I - "$1" <<'PY'
import re, sys
bad = []
fence = None   # info string of the currently open fence, else None
for i, l in enumerate(open(sys.argv[1]).read().splitlines(), 1):
    m = re.match(r'^\s*(`{3,}|~{3,})\s*(\S*)', l)
    if m:
        fence = (m.group(2) or '') if fence is None else None
        continue
    if fence != 'gherkin' and re.match(r'^\s*Scenario:', l):
        bad.append('%d: %s' % (i, l.strip()[:40]))
print('\x1f'.join(bad))
PY
}

_cross_repo_recorded() { # _cross_repo_recorded <plan.md> -> "ok" or a FAIL detail
  python3 -I - "$1" <<'PY'
import re, sys
lines = open(sys.argv[1]).read().splitlines()
sec, active = [], False
for l in lines:
    h = re.match(r'^(#{1,6})\s', l)
    if h:
        if active:
            break
        if re.search(r'cross.?repo search', l, re.I):
            active = True
            continue
    if active:
        sec.append(l)
if not active:
    print('no heading matching "Cross-Repo Search" in plan.md')
    sys.exit(0)
for l in sec:
    m = re.match(r'^\s*-\s*(used|not available):\s*(.+?)\s*$', l, re.I)
    if m and re.search(r'[A-Za-z0-9]', re.sub(r'\{[^{}]*\}', '', m.group(2))):
        print('ok')
        sys.exit(0)
print('Cross-Repo Search section has no "- used:" / "- not available:" line with real text')
PY
}

# Grouped Build (9.7.0): the tasks.md parser. One embedded python parser shared by every grouped
# subcommand, JSON out: {groups:[{id,title,depends,validate,interfaces,context,context_bytes,tasks}],
# tasks:[{n,title,group,files,depends,test,block_bytes,block}], integration}.
# File tokens are the backticked paths of the **File:** lines, as tasks_md.py reads them for every caller.
_grouped_parse() { # _grouped_parse <tasks.md>
  python3 "$SCRIPTS_DIR/tasks_md.py" parse "$1"
}

# H3: the approved grouped plan, as a digest. Task blocks (File, Depends, Test), group Validate/Interfaces/Context
# and Integration count; titles, prose and checkbox ticks do not, so the CLI's own tick is no change.
_plan_digest() { # _plan_digest <parsed-plan-json>
  python3 -I -c "
import hashlib, json, sys
m = json.loads(sys.argv[1])
def n(p):
    p = p.strip()
    return p[2:] if p.startswith('./') else p
core = {'tasks': [{'n': t['n'], 'group': t['group'], 'files': [n(f) for f in t['files']], 'depends': t['depends'], 'test': t['test']} for t in m['tasks']],
        'groups': [{'id': g['id'], 'depends': g['depends'], 'validate': g['validate'], 'interfaces': g['interfaces'], 'context': g['context'], 'tasks': g['tasks']} for g in m['groups']],
        'integration': m['integration']}
print(hashlib.sha256(json.dumps(core, sort_keys=True).encode('utf-8')).hexdigest())" "$1"
}

# Refuses (returns 1) when the plan changed since the person approved it: the digest `state advance plan_complete`
# recorded, else the one the first group start recorded (a run that left Plan before the plan gate recorded one). No
# digest recorded yet: nothing to compare.
_plan_fresh() { # _plan_fresh <parsed-plan-json>
  local want have
  want="$(python3 -I -c "
import json, sys
for p in sys.argv[1:]:
    try:
        h = json.load(open(p)).get('plan_hash')
    except Exception:
        h = None
    if h:
        print(h)
        break" "$STATE_FILE" "$GROUPS_FILE")"
  [[ -z "$want" ]] && return 0
  have="$(_plan_digest "$1")"
  [[ "$have" == "$want" ]] && return 0
  echo "FAIL: the approved plan changed since the person approved it at the plan gate (tasks.md **File:**, **Depends:**, **Test:**, group Validate/Interfaces/Context or Integration differ). Restore tasks.md, or loop back to Plan and approve it again." >&2
  return 1
}

# Grouped Build (9.7.0): the ready set. Read-only: it writes nothing, so it needs no lock; only
# `task start` (a later task) changes run state. Prints one JSON line per launchable task, ordered by
# group then task number; with nothing launchable a trailing {"waiting"...} line, or {"done"...}.
cmd_schedule() { # temper schedule [--json]
  local spec_path; spec_path="$(_spec_path "")"
  if [[ -z "$spec_path" || ! -f "$spec_path/tasks.md" ]]; then
    echo "FAIL: no tasks.md for the active run (temper state init, then plan)" >&2
    return 1
  fi
  local max; max="$(_cfg_get build.grouped.max-parallel 4)"
  [[ "$max" =~ ^[1-9][0-9]*$ ]] || max=4
  python3 "$SCRIPTS_DIR/tasks_md.py" schedule "$GROUPS_FILE" "$max" "$(_resolve_task_model)" "$(_resolve_task_escalation_model)" "$PWD" "$spec_path/tasks.md"
}

# Grouped Build (9.7.0): groups.json is CLI-owned run state. Every write goes through here: the lock
# is held around the read-modify-write, the file is replaced atomically, and the python body only
# sees `d` (the whole document) and `a` (the extra arguments). A body that calls sys.exit(n) writes
# nothing and returns n.
_groups_mutate() { # _groups_mutate <python-body> [args...]
  local body="$1" rc; shift
  _lock_acquire
  python3 -I - "$GROUPS_FILE" "$body" "$@" <<'PY'
import json, os, sys
f, body, a = sys.argv[1], sys.argv[2], sys.argv[3:]
try:
    d = json.load(open(f))
except Exception:
    d = {}
if not isinstance(d, dict):
    d = {}
exec(body)
tmp = '%s.tmp.%d' % (f, os.getpid())
with open(tmp, 'w') as fh:
    json.dump(d, fh, indent=2)
    fh.write('\n')
os.replace(tmp, f)
PY
  rc=$?
  _lock_release
  return $rc
}

# The project's folder from the top of its git repository (`packages/app/`), or "" at the top. A group or task worktree
# is a checkout of the whole repository, so the project's files are under this prefix in it.
_prefix() { git rev-parse --show-prefix 2>/dev/null || true; }
# The prefix as text in a gitignore pattern (info/exclude), and in a grep pattern: a folder named `pk[1]` is that name.
_prefix_glob() { _prefix | sed 's/[][\\*?]/\\&/g'; }
_prefix_re() { _prefix | sed 's/[][\\.*^$]/\\&/g'; }
# The project folder inside a worktree: <abs worktree>/<prefix>, without a trailing slash.
_in_wt() { local p; p="$1/$(_prefix)"; echo "${p%/}"; }

# git needs an identity for the merge commits the CLI makes; use the project's own, else a fixed one.
_git_id_args() { # prints "-c user.name=... -c user.email=..." only when the project has none
  if [[ -z "$(git config user.email 2>/dev/null)" ]]; then
    echo "-c user.name=Temper -c user.email=temper@localhost"
  fi
}

_default_branch() { # the remote's default branch when one is recorded, else ""
  local ref; ref="$(git symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null)" || return 0
  echo "${ref#refs/remotes/origin/}"
}

# temper group start G: one worktree per group at .claude/worktrees/temper-{slug}-{G}, branch
# temper/{slug}/{G}, based on the feature branch HEAD with every Depends group's branch merged in.
# Idempotent: a worktree already on the right branch is reused. Exit 3: a protected branch, or a
# folder at the worktree path that is not this group's worktree.
cmd_group_start() {
  local g="${1:-}"
  if [[ ! "$g" =~ ^G[0-9]+$ ]]; then
    echo "FAIL: usage: temper group start G<n>" >&2
    return 1
  fi
  local spec_path slug feature cur
  spec_path="$(_spec_path "")"
  slug="$(_spec_slug "$spec_path")"
  if [[ -z "$slug" || ! -f "$spec_path/tasks.md" ]]; then
    echo "FAIL: no tasks.md for the active run (temper state init, then plan)" >&2
    return 1
  fi
  local deps pplan phash
  pplan="$(_grouped_parse "$spec_path/tasks.md")"
  _plan_fresh "$pplan" || return 1
  phash="$(_plan_digest "$pplan")"
  deps="$(python3 -I - "$g" "$pplan" <<'PY'
import json, sys
plan = json.loads(sys.argv[2])
for grp in plan['groups']:
    if grp['id'] == sys.argv[1]:
        print('ok ' + ' '.join(grp['depends']))
        sys.exit(0)
print('unknown')
PY
)"
  if [[ "$deps" == "unknown" ]]; then
    echo "FAIL: tasks.md has no group $g" >&2
    return 1
  fi
  deps="${deps#ok}"
  feature="$(cmd_state_get branch "")"
  cur="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  local protected="main master $(_default_branch)" b
  for b in $protected; do
    if [[ "$feature" == "$b" || "$cur" == "$b" ]]; then
      if [[ -n "$feature" && "$feature" != "$b" ]]; then
        echo "FAIL: refusing to start a group worktree on the protected branch '$b' (switch to the run's branch '$feature' first)" >&2
      else
        echo "FAIL: refusing to start a group worktree on the protected branch '$b' (use a feature branch)" >&2
      fi
      return 3
    fi
  done
  if [[ -z "$feature" || "$cur" != "$feature" ]]; then
    echo "FAIL: group start runs on the run's feature branch '$feature' (current branch: '${cur:-none}')" >&2
    return 1
  fi
  local d dv
  for d in $deps; do
    # The group it builds on passed its check and the person chose Continue there: a Change at that group reruns work
    # this one would build on.
    dv="$(python3 -I -c "
import json, sys
try:
    g = ((json.load(open(sys.argv[1])).get('groups') or {}).get(sys.argv[2]) or {})
    print((g.get('gate') or {}).get('verdict', '') + ('|confirmed' if g.get('confirmed') else ''))
except Exception:
    print('')" "$GROUPS_FILE" "$d")"
    if [[ "${dv%%|*}" != "PASS" ]]; then
      echo "FAIL: $g depends on $d, whose group gate has not passed" >&2
      return 1
    fi
    if [[ "$dv" != *"|confirmed" ]]; then
      echo "FAIL: $g depends on $d, which the person has not continued yet (the Continue at its group question: temper group continue $d)" >&2
      return 1
    fi
  done

  local wt=".claude/worktrees/temper-$slug-$g" branch="temper/$slug/$g" abs
  abs="$(pwd -P)/$wt"
  local reuse=0
  if git worktree list --porcelain 2>/dev/null | awk -v p="$abs" -v b="refs/heads/$branch" '
      $1 == "worktree" { path = $2 } $1 == "branch" && path == p && $2 == b { found = 1 } END { exit !found }'; then
    reuse=1
  elif [[ -e "$wt" || -L "$wt" ]]; then
    echo "FAIL: $wt exists and is not the worktree of $g; move it away" >&2
    return 3
  fi

  if [[ "$reuse" == "0" ]]; then
    # the worktrees folder is local to this clone: info/exclude, never .gitignore
    local ex; ex="$(git rev-parse --git-common-dir)/info/exclude"
    mkdir -p "$(dirname "$ex")"
    local pre; pre="$(_prefix_glob)"
    grep -qxF "/${pre}.claude/worktrees/" "$ex" 2>/dev/null || printf '/%s.claude/worktrees/\n' "$pre" >> "$ex"
    local wt_out
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      # L4: the group branch outlives its worktree (integrate removes worktrees before its suite runs and
      # keeps the branches on FAIL): attach a worktree to the existing branch, its base already holds the deps.
      # R3: only a branch this run recorded (same name, and its recorded base is still in the branch's history);
      # any other is an abandoned run's and is refused.
      if ! python3 -I - "$GROUPS_FILE" "$g" "$branch" "$slug" <<'PY'
import json, subprocess, sys
try:
    d = json.load(open(sys.argv[1]))
    e = (d.get('groups') or {}).get(sys.argv[2]) or {}
    ok = d.get('slug') == sys.argv[4] and e.get('branch') == sys.argv[3] and bool(e.get('base_sha'))
    if ok:
        ok = subprocess.run(['git', 'merge-base', '--is-ancestor', e['base_sha'], sys.argv[3]],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
except Exception:
    ok = False
sys.exit(0 if ok else 1)
PY
      then
        echo "FAIL: branch $branch already exists and this run did not create it (left by an earlier run); delete it with: git branch -D $branch (git worktree prune first if a worktree still names it), then temper group start $g" >&2
        return 1
      fi
      if ! wt_out="$(git worktree add -q "$wt" "$branch" 2>&1)"; then
        echo "FAIL: git worktree add failed: $(printf '%s' "$wt_out" | head -1)" >&2
        return 1
      fi
      deps=""
    elif ! wt_out="$(git worktree add -q -b "$branch" "$wt" HEAD 2>&1)"; then
      echo "FAIL: git worktree add failed: $(printf '%s' "$wt_out" | head -1)" >&2
      return 1
    fi
    local idargs; idargs="$(_git_id_args)"
    for d in $deps; do
      # shellcheck disable=SC2086
      if ! git -C "$wt" $idargs merge --no-ff -q -m "merge($slug): $d into $g base" "temper/$slug/$d" >/dev/null 2>&1; then
        local files; files="$(git -C "$wt" diff --name-only --diff-filter=U 2>/dev/null | paste -sd, -)"
        git -C "$wt" merge --abort >/dev/null 2>&1 || true
        git worktree remove --force "$wt" >/dev/null 2>&1 || true
        git branch -D "$branch" >/dev/null 2>&1 || true
        echo "FAIL: merge conflict: $d into $g base in ${files:-unknown files}" >&2
        return 1
      fi
    done
  fi

  local base_sha; base_sha="$(git -C "$wt" rev-parse HEAD)"
  _groups_mutate "
d['version'] = 1
d.setdefault('plan_hash', a[7])
d['slug'] = a[0]
d['feature_branch'] = a[1]
d.setdefault('groups', {})
d.setdefault('tasks', {})
e = d['groups'].setdefault(a[2], {})
e['status'] = 'running' if e.get('status') in (None, 'pending') else e['status']
e['worktree'] = a[3]
e['branch'] = a[4]
e.setdefault('base_sha', a[5])
e.setdefault('started_at', a[6])
e.setdefault('finished_at', None)
" "$slug" "$feature" "$g" "$wt" "$branch" "$base_sha" "$(_now)" "$phash" || return 1
  echo "OK: group $g started ($wt on $branch)"
}

# temper group gate G: PASS when every task of G passed and the group's own Validate command, run by the
# CLI in the group worktree, exits 0. Recorded as a build row tagged with the group (phase 'group').
cmd_group_gate() {
  local g="${1:-}"
  if [[ ! "$g" =~ ^G[0-9]+$ ]]; then
    echo "FAIL: usage: temper group gate G<n>" >&2
    return 1
  fi
  local spec_path plan chk validate notpassed wt
  spec_path="$(_spec_path "")"
  if [[ -z "$spec_path" || ! -f "$spec_path/tasks.md" ]]; then
    echo "FAIL: no tasks.md for the active run (temper state init, then plan)" >&2
    return 1
  fi
  plan="$(_grouped_parse "$spec_path/tasks.md")"
  _plan_fresh "$plan" || return 1
  wt="$(python3 -I -c "
import json, sys
try:
    print(((json.load(open(sys.argv[1])).get('groups') or {}).get(sys.argv[2]) or {}).get('worktree', ''))
except Exception:
    print('')" "$GROUPS_FILE" "$g")"
  chk="$(_task_py gatecheck "$plan" "$GROUPS_FILE" "$g" "$(pwd -P)/$wt")" || return 1
  if [[ -z "$wt" ]]; then
    echo "FAIL: group $g is not started (temper group start $g)" >&2
    return 1
  fi
  validate="$(printf '%s\n' "$chk" | sed -n 1p)"; notpassed="$(printf '%s\n' "$chk" | sed -n 2p)"
  local offbranch gstatus
  offbranch="$(printf '%s\n' "$chk" | sed -n 3p)"; gstatus="$(printf '%s\n' "$chk" | sed -n 4p)"
  local reason=""
  if [[ "$gstatus" == "parked" ]]; then
    reason="group $g is parked (its task gate gave the reason); the person chooses how to go on"
  elif [[ -n "$notpassed" ]]; then
    reason="not every task has passed its task gate: $notpassed"
  elif [[ -n "$offbranch" ]]; then
    reason="a passed task's commit is no longer on the group branch: $offbranch (reopen the task)"
  elif [[ -z "$validate" ]]; then
    reason="group $g declares no **Validate:** command"
  fi
  if [[ -z "$reason" ]]; then
    # F4: Validate must run on what integrate merges: an uncommitted change to a tracked file (an agent's edit of
    # a file whose task already passed) is not on the group branch, so the gate refuses it and names the paths
    local dirty
    local pre; pre="$(_prefix_re)"
    dirty="$(git -C "$(pwd -P)/$wt" status --porcelain=v1 --untracked-files=no 2>/dev/null | cut -c4- \
             | grep -v -e "^${pre}\.temper/" -e "^${pre}\.claude/worktrees/" -e '^\.temper/' -e '^\.claude/worktrees/' | head -20 | paste -sd, - | sed 's/,/, /g')"
    [[ -n "$dirty" ]] && reason="uncommitted changes in the group worktree, not on its branch: $dirty (revert them, or reopen the task that owns them)"
  fi
  if [[ -z "$reason" ]]; then
    local rowfile rc
    rowfile="$(mktemp "${TMPDIR:-/tmp}/temper-row.XXXXXX")" || return 1
    _task_py grouprun "$(_in_wt "$(pwd -P)/$wt")" "${TEMPER_TASK_TEST_TIMEOUT_S:-600}" "$rowfile" "$g" -- "$validate"
    rc=$?
    _ensure_dirs
    [[ -s "$rowfile" ]] && _json_append "$(_evidence_file build)" "$(cat "$rowfile")"
    rm -f "$rowfile"
    [[ "$rc" -ne 0 ]] && reason="group $g Validate failed (exit $rc): $validate"
  fi
  if [[ -n "$reason" ]]; then
    _groups_mutate "
g = d.setdefault('groups', {}).setdefault(a[0], {})
g['gate'] = {'verdict': 'FAIL', 'reason': a[1], 'ts': a[2]}
" "$g" "$reason" "$(_now)" || return 1
    echo "FAIL: $reason"
    return 1
  fi
  _groups_mutate "
g = d.setdefault('groups', {}).setdefault(a[0], {})
g['gate'] = {'verdict': 'PASS', 'ts': a[1]}
g['status'] = 'passed'
g['finished_at'] = a[1]
" "$g" "$(_now)" || return 1
  echo "PASS: group $g"
}

# D-08: what a human does about a parked foreign commit; printed by the task gate that parks the group and by a refused reopen.
# The git lines run as written: --autostash keeps the uncommitted work of every task (tracked edits are stashed and put back
# by the rebase itself; untracked files are not touched), so nothing is lost and no stash is left behind. Only commits on the
# branch's first-parent line get a line: a commit an agent merge brought in leaves with the merge.
_park_ways_out() { # _park_ways_out <group> <worktree as printed> <tasks csv> <sha>... (newest first)
  local g="$1" wt="$2" tcsv="${3:-N}" s csv="" targs="" t; shift 3
  for t in ${tcsv//,/ }; do targs="$targs --task $t"; done
  local fp; fp="$(git -C "$wt" rev-list --first-parent HEAD 2>/dev/null)" || fp=""
  local lines=()
  for s in "$@"; do
    csv="${csv:+$csv,}${s:0:7}"
    if [[ -z "$fp" ]] || grep -qx "$s" <<<"$fp"; then lines+=("        git -C $wt rebase --autostash --onto ${s:0:7}~1 ${s:0:7}"); fi
  done
  [[ ${#lines[@]} -gt 0 ]] || for s in "$@"; do lines+=("        git -C $wt rebase --autostash --onto ${s:0:7}~1 ${s:0:7}"); done
  echo "Nothing was changed on the branch or in the task's worktree ($wt). The person chooses one of two ways out (temper next asks them):"
  echo "  (a) remove the commit(s) from its branch, newest first (each line keeps the task's uncommitted work):"
  printf '%s\n' "${lines[@]}"
  echo "      then: temper group reopen $g$targs"
  echo "  (b) or keep them knowingly, with the person's reason: temper group reopen $g$targs --accept-foreign $csv --reason \"<why>\""
}

# temper group reopen G --accept-foreign SHA[,SHA] --reason R, with no task: the person keeps commits that the CLI did
# not make and that `temper integrate` found on the passed group's own branch (no task runs again). Each named sha must
# be one of those commits; each is recorded like an override (foreign-commit:G:sha), so the next integrate takes it.
_group_accept_branch() { # _group_accept_branch <G> <csv> <reason>
  local g="$1" csv="$2" reason="$3" slug unk s full=() n want=()
  slug="$(_spec_slug "$(_spec_path "")")"
  if [[ -z "$slug" || ! -f "$GROUPS_FILE" ]]; then
    echo "FAIL: no grouped run (temper group start first)" >&2
    return 1
  fi
  unk="$(_task_py unknown "$(pwd -P)" "$GROUPS_FILE" "$g" "temper/$slug/$g")"
  IFS=',' read -r -a want <<<"$csv"
  for s in "${want[@]}"; do
    [[ -n "$s" ]] || continue
    n="$(printf '%s\n' "$unk" | grep -c "^$s" || true)"
    if [[ ! "$s" =~ ^[0-9a-f]{7,40}$ || "$n" != "1" ]]; then
      echo "FAIL: $s is not one commit on group $g's branch that the CLI did not make (those are: $(printf '%s\n' "$unk" | cut -c1-7 | paste -sd' ' -))" >&2
      return 1
    fi
    full+=("$(printf '%s\n' "$unk" | grep "^$s")")
  done
  [[ ${#full[@]} -gt 0 ]] || { echo "FAIL: --accept-foreign needs a sha" >&2; return 1; }
  for s in "${full[@]}"; do cmd_override "foreign-commit:$g:$s" --reason "$reason" >/dev/null || return 1; done
  echo "OK: kept $(printf '%.7s ' "${full[@]}")on group $g's branch, by the person's choice: $reason"
}

# temper group reopen G --task N [--task M] [--feedback ID]: the Change choice at a group gate (D-02).
# Only the named tasks re-run: their files go back to the content they had when the task started (one
# revert commit on the group branch, that task's declared paths only), their boxes are unticked, their
# attempts move to attempts_prior, and the group gate is cleared. A parked group runs again.
# The reopen's revert commits are recorded as the CLI's own and as reopen reverts, so a running sibling's
# verdict accepts them and does not count their files as its own undeclared change.
# D-08: a group parked on commits the CLI did not record reopens only when none of them is an ancestor of a kept task
# worktree's branch (or the group branch) any more, or when the human accepts them: --accept-foreign <sha>[,<sha>] --reason "<text>" (an override).
cmd_group_reopen() {
  local rc
  _lock_acquire
  _group_reopen_body "$@"
  rc=$?
  _lock_release
  return $rc
}

_group_reopen_body() {
  local g="${1:-}"; shift || true
  if [[ ! "$g" =~ ^G[0-9]+$ ]]; then
    echo "FAIL: usage: temper group reopen G<n> --task N [--task M] [--feedback ID]" >&2
    return 1
  fi
  local tasks=() feedback="" accept="" areason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task) [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "FAIL: --task needs a task number" >&2; return 1; }
              tasks+=("$2"); shift 2 ;;
      --feedback) feedback="${2:-}"; shift 2 || true ;;
      --accept-foreign) accept="${2:-}"; shift 2 || true ;;
      --reason) areason="${2:-}"; shift 2 || true ;;
      *) echo "FAIL: unknown flag $1" >&2; return 1 ;;
    esac
  done
  if [[ -n "$accept" && -z "$areason" ]]; then
    echo "FAIL: --accept-foreign needs --reason \"<why the agent commit stays>\" (it is recorded like an override)" >&2
    return 1
  fi
  if [[ ${#tasks[@]} -eq 0 && -n "$accept" ]]; then
    _group_accept_branch "$g" "$accept" "$areason"
    return
  fi
  if [[ ${#tasks[@]} -eq 0 ]]; then
    echo "FAIL: usage: temper group reopen $g --task N [--task M] [--feedback ID]" >&2
    return 1
  fi
  local spec_path slug plan wt
  spec_path="$(_spec_path "")"
  slug="$(_spec_slug "$spec_path")"
  if [[ -z "$spec_path" || ! -f "$spec_path/tasks.md" ]]; then
    echo "FAIL: no tasks.md for the active run (temper state init, then plan)" >&2
    return 1
  fi
  plan="$(_grouped_parse "$spec_path/tasks.md")"
  _plan_fresh "$plan" || return 1
  local chk; chk="$(_task_py reopencheck "$plan" "$GROUPS_FILE" "$g" "${tasks[@]}")" || return 1
  wt="$(python3 -I -c "
import json, sys
try:
    print(((json.load(open(sys.argv[1])).get('groups') or {}).get(sys.argv[2]) or {}).get('worktree', ''))
except Exception:
    print('')" "$GROUPS_FILE" "$g")"
  if [[ -z "$wt" ]]; then
    echo "FAIL: group $g is not started (temper group start $g)" >&2
    return 1
  fi
  local missing
  if ! missing="$(_adr0009_upstream_check "$spec_path")"; then
    echo "FAIL: refusing the reopen commit: upstream gate(s) not satisfied: $missing (ADR 0009)" >&2
    return 3
  fi
  local abs; abs="$(_in_wt "$(pwd -P)/$wt")"
  # D-08: a group parked on commits the CLI did not record reopens only when none of them is on its branch any more
  # (the human removed them), or when the human accepts each remaining one with --accept-foreign and a reason
  # M5: and every commit of the group's base..HEAD must be recorded by the CLI or accepted (a commit replayed by a rebase
  # or a merge has a new sha): the check names the first ones it finds and stops
  local left fc accepted=() tcsv
  tcsv="$(IFS=,; echo "${tasks[*]}")"
  left="$(python3 -I -c "
import json, sys
try:
    print(json.dumps(((json.load(open(sys.argv[1])).get('groups') or {}).get(sys.argv[2]) or {}).get('parked_foreign') or []))
except Exception:
    print('[]')" "$GROUPS_FILE" "$g")"
  # the commits a park is about sit in the parked task's own worktree (kept by the park), so every kept worktree of a
  # task of G that is not running is checked, whichever task is named, and the group's own worktree too (a task that
  # is running has its range checked by its own gate)
  local cwts=("$wt") cwt t
  while IFS= read -r t; do [[ -n "$t" && -d "$t" ]] && cwts+=("$t"); done < <(python3 -I -c "
import json, sys
try:
    ts = json.load(open(sys.argv[1])).get('tasks') or {}
except Exception:
    ts = {}
for k in sorted(ts, key=lambda x: int(x) if x.isdigit() else 0):
    v = ts[k]
    if v.get('group') == sys.argv[2] and v.get('status') != 'running' and v.get('worktree'):
        print(v['worktree'])" "$GROUPS_FILE" "$g")
  local kind val acc_all=() bad_all=() fcall=""
  for cwt in "${cwts[@]}"; do
    fc="$(_task_py foreigncheck "$(pwd -P)/$cwt" "$left" "$accept" "$GROUPS_FILE" "$g")" || return 1
    fcall+="$(printf '%s' "$fc" | sed "s|\$| $cwt|")"$'\n'
  done
  # a sha the human names is accepted when any checked worktree holds it, and refused only when none does
  while IFS=' ' read -r kind val cwt; do
    case "$kind" in
      ACCEPT) [[ " ${acc_all[*]-} " == *" $val "* ]] || acc_all+=("$val") ;;
      BAD) bad_all+=("$val") ;;
    esac
  done <<<"$fcall"
  local b a ok
  for b in ${bad_all[@]+"${bad_all[@]}"}; do
    ok=""
    for a in ${acc_all[@]+"${acc_all[@]}"}; do [[ "$a" == "$b"* ]] && ok=1; done
    if [[ -z "$ok" ]]; then
      echo "FAIL: $b is not one of the commits group $g is parked on or holds unrecorded" >&2
      return 1
    fi
  done
  accepted=(${acc_all[@]+"${acc_all[@]}"})
  for cwt in "${cwts[@]}"; do
    local on=() unk=()
    while IFS=' ' read -r kind val t; do
      [[ "$t" == "$cwt" ]] || continue
      [[ " ${acc_all[*]-} " == *" $val "* ]] && continue
      case "$kind" in
        ON) on+=("$val") ;;
        UNK) unk+=("$val") ;;
      esac
    done <<<"$fcall"
    if [[ ${#on[@]} -gt 0 ]]; then
      echo "FAIL: group $g is parked on commit(s) not made by the CLI that are still on the branch of $cwt: $(printf '%.7s ' "${on[@]}")" >&2
      _park_ways_out "$g" "$cwt" "$tcsv" "${on[@]}" >&2
      return 1
    fi
    if [[ ${#unk[@]} -gt 0 ]]; then
      echo "FAIL: group $g holds commit(s) that the CLI did not record and nobody accepted: $(printf '%.7s ' "${unk[@]}")" >&2
      _park_ways_out "$g" "$cwt" "$tcsv" "${unk[@]}" >&2
      return 1
    fi
  done
  local sh
  for sh in ${accepted[@]+"${accepted[@]}"}; do
    cmd_override "foreign-commit:$g:$sh" --reason "$areason" >/dev/null || return 1
  done
  local idargs; idargs="$(_git_id_args)"
  local line n files sha
  while IFS=$'\t' read -r n files sha; do
    [[ -n "$n" ]] || continue
    local paths=() p
    IFS=',' read -r -a paths <<<"$files"
    if [[ -n "$sha" && ${#paths[@]} -gt 0 ]]; then
      local json; json="$(python3 -I -c "import json, sys; print(json.dumps(sys.argv[1:]))" "${paths[@]}")"
      if ! _task_py restore "$abs" "$sha" "$json"; then
        echo "FAIL: could not restore the files of Task $n in $wt (another git process holds a lock there, such as index.lock); run the reopen again" >&2
        return 1
      fi
      # only the declared paths the restore actually changed (a pathspec git has never seen fails the whole add)
      local cpaths=()
      for p in "${paths[@]}"; do
        [[ -n "$(git --literal-pathspecs -C "$abs" status --porcelain -- "$p" 2>/dev/null)" ]] && cpaths+=("$p")
      done
      [[ ${#cpaths[@]} -gt 0 ]] && git --literal-pathspecs -C "$abs" add -A -- "${cpaths[@]}" >/dev/null 2>&1
      if [[ ${#cpaths[@]} -gt 0 ]] && ! git --literal-pathspecs -C "$abs" diff --cached --quiet -- "${cpaths[@]}" 2>/dev/null; then
        # shellcheck disable=SC2086
        if ! git --literal-pathspecs -C "$abs" $idargs commit -q -m "revert($slug): reopen Task $n" -- "${cpaths[@]}" >/dev/null 2>&1; then
          echo "FAIL: could not commit the revert of Task $n in $wt" >&2
          return 1
        fi
        # R2: a reopen revert is the CLI's own commit
        _groups_mutate "
d.setdefault('cli_commits', []).append(a[0])
" "$(git -C "$abs" rev-parse HEAD)" || return 1
      fi
    fi
    _task_box "$spec_path/tasks.md" "$n" " "
    _groups_mutate "
t = d.setdefault('tasks', {}).setdefault(a[0], {})
t.setdefault('attempts_prior', []).extend(t.get('attempts') or [])
t['attempts'] = []
t['status'] = 'pending'
t['attempt'] = 1
for k in ('commit', 'passed_at', 'snapshot', 'start_sha', 'started_at'):
    t.pop(k, None)
t.setdefault('reopened', []).append({'ts': a[1], 'feedback': a[2] or None})
g = d.setdefault('groups', {}).setdefault(a[3], {})
g.pop('parked_foreign', None)   # D-08: off the branch or accepted (checked above); no other group's list is touched
g.pop('gate', None)
g.pop('finished_at', None)
if g.get('status') in ('parked', 'passed'):
    g['status'] = 'running'
    g.pop('parked_reason', None)
" "$n" "$(_now)" "$feedback" "$g" || return 1
  done <<<"$chk"
  echo "OK: reopened ${tasks[*]/#/Task } in group $g"
  # M3: a task that was running when the group parked kept its work; it has no ready line in the schedule, so say how to gate it
  local rn
  for rn in $(python3 -I -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
print(' '.join(sorted((k for k, v in (d.get('tasks') or {}).items() if v.get('group') == sys.argv[2] and v.get('status') == 'running'), key=int)))" "$GROUPS_FILE" "$g"); do
    local ra rmodel
    ra="$(python3 -I -c "import json, sys; print(((json.load(open(sys.argv[1])).get('tasks') or {}).get(sys.argv[2]) or {}).get('attempt') or 1)" "$GROUPS_FILE" "$rn")"
    if [[ "$ra" =~ ^[0-9]+$ && "$ra" -ge 3 ]]; then rmodel="$(_resolve_task_escalation_model)"; else rmodel="$(_resolve_task_model)"; fi
    echo "NEXT: temper task gate $rn --model $rmodel   (Task $rn was running when the group parked; its work is still in its worktree. Run it once its agent has returned)"
  done
}

# Grouped Build (9.7.0): the measurement report (AC-12). Pure read of groups.json and the review
# ledger; `state archive` embeds the same JSON in gate-ledger.json. Wall time per group is its
# started_at (first `group start`) to the group gate PASS (finished_at); the total spans the earliest
# start to the latest finish.
_group_report_json() {
  python3 -I - "$GROUPS_FILE" "$(_evidence_file review)" <<'PY'
import calendar, json, sys, time
def load(p, default):
    try:
        return json.load(open(p))
    except Exception:
        return default
run = load(sys.argv[1], {})
rev = load(sys.argv[2], [])
def secs(s):
    try:
        return calendar.timegm(time.strptime(s, '%Y-%m-%dT%H:%M:%SZ'))
    except Exception:
        return None
tokens, attempts, esc = {}, {}, 0
for n, t in sorted((run.get('tasks') or {}).items(), key=lambda kv: int(kv[0]) if kv[0].isdigit() else 0):
    rows = list(t.get('attempts_prior') or []) + list(t.get('attempts') or [])
    attempts[n] = rows
    for r in rows:
        if isinstance(r.get('tokens'), int):
            tokens[r.get('model') or 'unknown'] = tokens.get(r.get('model') or 'unknown', 0) + r['tokens']
        if isinstance(r.get('n'), int) and r['n'] >= 3:
            esc += 1
groups = run.get('groups') or {}
wall, starts, ends = {}, [], []
for g, v in sorted(groups.items()):
    a, b = secs(v.get('started_at') or ''), secs(v.get('finished_at') or '')
    if a is not None:
        starts.append(a)
    if a is not None and b is not None and (v.get('gate') or {}).get('verdict') == 'PASS':
        wall[g] = (b - a) * 1000
        ends.append(b)
total = (max(ends) - min(starts)) * 1000 if starts and ends else 0
openf = sum(1 for e in rev if isinstance(e, dict) and e.get('severity') and not e.get('resolved') and not e.get('accepted'))
task_groups = {n: (t or {}).get('group') for n, t in (run.get('tasks') or {}).items() if (t or {}).get('group')}
print(json.dumps({'tokens_by_model': tokens, 'attempts': attempts, 'escalations': esc, 'task_groups': task_groups,
                  'parked': sorted(g for g, v in groups.items() if v.get('status') == 'parked'),
                  'wall_ms_by_group': wall, 'build_wall_ms': total, 'review_findings_open': openf},
                 sort_keys=True))
PY
}

cmd_group_report() { # temper group report [--json]
  local j; j="$(_group_report_json)"
  if [[ "${1:-}" == "--json" ]]; then echo "$j"; return 0; fi
  python3 -I - "$j" <<'PY'
import json, sys
r = json.loads(sys.argv[1])
def dur(ms):
    s = int(ms or 0) // 1000
    return '%d min %d s' % (s // 60, s % 60) if s >= 60 else '%d s' % s
def num(n):
    return '{:,}'.format(n)
tasks = sorted(r['attempts'].items(), key=lambda kv: int(kv[0]) if kv[0].isdigit() else 0)
groups = r.get('task_groups') or {}
total = sum(r['tokens_by_model'].values())
print('Grouped Build report')
print('  Tasks: %d, in %d group(s). Build time: %s.' % (len(tasks), len(r['wall_ms_by_group']) or len(set(groups.values())), dur(r['build_wall_ms'])))
print('  Tokens used by the task agents: %s%s' % (num(total), (' (' + ', '.join('%s %s' % (m, num(n)) for m, n in sorted(r['tokens_by_model'].items())) + ')') if r['tokens_by_model'] else ''))
for g, ms in sorted(r['wall_ms_by_group'].items()):
    print('  Group %s: passed its group gate after %s.' % (g, dur(ms)))
print('  Groups stopped for you (parked): %s' % (', '.join(r['parked']) or 'none'))
print('  Tasks that moved to the stronger model after two failed attempts: %d' % r['escalations'])
print('  Open review findings: %d' % r['review_findings_open'])
for n, rows in tasks:
    if not rows:
        print('  Task %s: not run yet' % n)
        continue
    last = rows[-1]
    head = 'passed' if last.get('outcome') == 'PASS' else 'failed'
    print('  Task %s: %s after %d attempt(s)' % (n, head, len(rows)))
    for i, a in enumerate(rows, 1):
        what = 'passed' if a.get('outcome') == 'PASS' else 'failed'
        model = a.get('model') or 'no model given to task gate'
        extra = []
        if isinstance(a.get('tokens'), int):
            extra.append('%s tokens' % num(a['tokens']))
        if isinstance(a.get('ms'), int):
            extra.append(dur(a['ms']))
        line = '    attempt %d: %s (%s%s)' % (i, what, model, ''.join(', ' + x for x in extra))
        reason = (a.get('reason') or '').strip().split('\n')[0]
        if what == 'failed' and reason:
            line += ': ' + (reason if len(reason) <= 160 else reason[:157] + '...')
        print(line)
PY
}

# temper group continue G: the person's Continue at the group question (ADR 0013), recorded so `temper next` knows
# it was given. Only a group whose gate passed is continued.
cmd_group_continue() {
  local g="${1:-}"
  [[ "$g" =~ ^G[0-9]+$ ]] || { echo "FAIL: usage: temper group continue G<n>" >&2; return 1; }
  local v; v="$(python3 -I -c "
import json, sys
try:
    print((((json.load(open(sys.argv[1])).get('groups') or {}).get(sys.argv[2]) or {}).get('gate') or {}).get('verdict', ''))
except Exception:
    print('')" "$GROUPS_FILE" "$g")"
  [[ "$v" == "PASS" ]] || { echo "FAIL: group $g has not passed its gate (temper group gate $g)" >&2; return 1; }
  _groups_mutate "
g = d.setdefault('groups', {}).setdefault(a[0], {})
g['confirmed'] = a[1]
" "$g" "$(_now)" || return 1
  echo "OK: group $g continues"
}

cmd_group() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    continue) cmd_group_continue "$@" ;;
    start) cmd_group_start "$@" ;;
    gate) cmd_group_gate "$@" ;;
    reopen) cmd_group_reopen "$@" ;;
    report) cmd_group_report "$@" ;;
    *) echo "FAIL: usage: temper group <start|gate|reopen|continue|report> ..." >&2; return 1 ;;
  esac
}

# Grouped Build (9.7.0): the task lifecycle. One embedded python program with a mode per job, so the
# snapshot, the changed-file rule and the verdict are computed in one place. Bash only sequences it:
# groups.json writes go through _groups_mutate (the lock), ledger rows through _json_append.
TASK_SHOW_MAX_BYTES=8600
_task_box() { # _task_box <tasks.md> <N> <x|" ">: set the first box of Task N to [x] (ticked) or [ ] (unticked)
  python3 -I - "$1" "$2" "$3" <<'PY'
import os, re, sys
p, n, to = sys.argv[1], sys.argv[2], sys.argv[3]
frm = ' ' if to == 'x' else 'x'
lines = open(p, encoding='utf-8').read().split('\n')
inside = False
for i, l in enumerate(lines):
    m = re.match(r'^###\s+Task\s+(\d+)\s*:', l)
    if m: inside = (m.group(1) == n)
    elif re.match(r'^#{1,2}\s', l): inside = False
    elif inside and re.match(r'^\s*- \[%s\]' % re.escape(frm), l):
        lines[i] = l.replace('- [%s]' % frm, '- [%s]' % to, 1)
        break
tmp = '%s.tmp.%d' % (p, os.getpid())
with open(tmp, 'w', encoding='utf-8') as fh:
    fh.write('\n'.join(lines))
os.replace(tmp, p)
PY
}

_task_py() { # _task_py <mode> [args...]
  TEMPER_GROUPS_FILE="$GROUPS_FILE" TEMPER_PREFIX="$(_prefix)" python3 -I - "$@" <<'PY'
import hashlib, json, os, re, shlex, signal, subprocess, sys, time

# The project's folder from the top of its repository ("" at the top). git status and git diff name a path from the
# top of the worktree; the plan names it from the project folder, so each is read from there (a path outside the
# project reads as ../..., which no task declares).
PREFIX = os.environ.get('TEMPER_PREFIX', '')

def R(p):
    if not PREFIX:
        return p
    if p.startswith(PREFIX):
        return p[len(PREFIX):]
    return os.path.relpath(p, PREFIX.rstrip('/'))

def top_of(wt):
    r = subprocess.run(['git', '-C', wt, 'rev-parse', '--show-toplevel'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return r.stdout.decode('utf-8', 'surrogateescape').strip() or wt

def norm(p):
    p = p.strip()
    return p[2:] if p.startswith('./') else p

def fail(msg):
    print('FAIL: ' + msg, file=sys.stderr)
    sys.exit(1)

_LOCK_DEADLINE = []

def lock_deadline():
    """H1: one wall-clock budget for every retry of the whole process (a few seconds), shared by all git commands of an
    undo or restore: the caller may pass its own deadline (epoch seconds) so the budget spans several processes."""
    if not _LOCK_DEADLINE:
        try:
            _LOCK_DEADLINE.append(float(os.environ.get('TEMPER_GIT_LOCK_DEADLINE') or 0) or time.time() + 5)
        except ValueError:
            _LOCK_DEADLINE.append(time.time() + 5)
    return _LOCK_DEADLINE[0]

def lock_failed(r):
    return r is not None and r.returncode != 0 and b'.lock' in r.stderr

def run_retry(cmd, delay=0.1):
    """Run a git command; a failure that names a .lock file (index.lock, HEAD.lock: another git process holds it,
    briefly) is retried until the shared budget is spent, any other failure is returned at once. Every command runs
    at least once."""
    dl = lock_deadline()
    while True:
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r.returncode == 0 or b'.lock' not in r.stderr or time.time() + delay > dl:
            return r
        time.sleep(delay)

def snap(wt):
    """sha256 of every dirty or untracked path in the worktree ('DELETED' for a path that is gone), each path named from
    the project folder (R)."""
    r = subprocess.run(['git', '--literal-pathspecs', '-C', wt, 'status', '--porcelain=v1', '-z', '-uall'],
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    ents = r.stdout.decode('utf-8', 'surrogateescape').split('\0')
    top = top_of(wt)
    out, i = {}, 0
    while i < len(ents):
        e = ents[i]; i += 1
        if len(e) < 4:
            continue
        xy, path = e[:2], e[3:]
        if xy[0] in 'RC' or xy[1] in 'RC':
            old = ents[i] if i < len(ents) else ''
            i += 1
            if old:
                out[R(old)] = 'DELETED'
        fp = os.path.join(top, path)
        try:
            out[R(path)] = hashlib.sha256(open(fp, 'rb').read()).hexdigest() if os.path.isfile(fp) else 'DELETED'
        except OSError:
            out[R(path)] = 'DELETED'
    return out

def untracked(wt):
    """The untracked paths of the worktree (porcelain '??'), for the byproducts a CLI test run leaves behind."""
    r = subprocess.run(['git', '--literal-pathspecs', '-C', wt, 'status', '--porcelain=v1', '-z', '-uall'],
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return {R(e[3:]) for e in r.stdout.decode('utf-8', 'surrogateescape').split('\0') if e.startswith('?? ')}

def load_run(gfile):
    try:
        d = json.load(open(gfile))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

def run_cmd(wt, timeout, cmd):
    """Run cmd (one string runs through bash -c) in wt with a kill timeout; returns (output bytes, exit)."""
    args = ['bash', '-c', cmd[0]] if len(cmd) == 1 else cmd
    try:
        p = subprocess.Popen(args, cwd=wt, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
        try:
            out, _ = p.communicate(timeout=float(timeout))
            rc = p.returncode if p.returncode >= 0 else 128 - p.returncode
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
            out, _ = p.communicate()
            rc = 124
    except OSError as e:
        out, rc = ('%s\n' % e).encode(), 127
    return out, rc

def show(out, rc, keep=12):
    """Print a suite's output for the orchestrator: a passing run only its last lines (the runner's summary), since the
    whole output of a long suite fills the main conversation for nothing; a failing run all of it, for the failure."""
    lines = out.decode('utf-8', 'replace').splitlines(True)
    if rc == 0 and len(lines) > keep:
        sys.stdout.write('[the first %d lines of the passing output are not shown]\n' % (len(lines) - keep))
        lines = lines[-keep:]
    sys.stdout.write(''.join(lines))
    sys.stdout.flush()

def red_why(r):
    """Why a failing RED run is not evidence ('' when it is): the command never ran the tests."""
    rc, cmd = r.get('exit_code'), r.get('cmd') or ''
    if rc in (126, 127): return 'the command could not run'
    if rc == 124: return 'it timed out'
    if isinstance(rc, int) and rc >= 128: return 'it was killed by a signal'
    if re.search(r'(^|[\s/\'"])pytest\b', cmd) and rc != 1:
        return 'pytest exits 1 when a test fails; %s is a collection, import or usage error' % rc
    return ''

def red_ok(r):
    """A RED run counts when it failed on the tests themselves, not before they ran."""
    return r.get('phase') == 'red' and r.get('exit_code') not in (0, None) and not red_why(r)

def ctx(plan, run, n):
    t = next((x for x in plan['tasks'] if x['n'] == n), None)
    if t is None:
        fail('tasks.md has no Task %d' % n)
    g = next((x for x in plan['groups'] if x['id'] == t['group']), None)
    if g is None:
        fail('Task %d is outside any group' % n)
    rg = (run.get('groups') or {}).get(g['id']) or {}
    rt = (run.get('tasks') or {}).get(str(n)) or {}
    status = rt.get('status', 'pending')
    attempts = rt.get('attempts') or []
    return {'n': n, 'title': t['title'], 'group': g['id'], 'files': t['files'], 'block': t['block'],
            'test': t['test'], 'context': g['context'], 'status': status,
            # one worktree per task: a task works in its own worktree (made by task start from the group branch, removed
            # when its gate passes or fails), never in the group worktree, which only takes merges and the group Validate
            'worktree': rt.get('worktree') or rg.get('worktree', ''), 'gworktree': rg.get('worktree', ''),
            'gbranch': rg.get('branch', ''), 'tbranch': rt.get('branch', ''),
            'attempt': rt.get('attempt', 1) if status == 'running' else len(attempts) + 1,
            'attempts': attempts, 'start_sha': rt.get('start_sha', ''), 'started_at': rt.get('started_at', ''),
            'snapshot': rt.get('snapshot') or {}, 'slug': run.get('slug', ''),
            'gstatus': rg.get('status', ''), 'gparked': rg.get('parked_reason', '')}

PATTERN_MAX_BYTES = 2048
TEST_NAME = re.compile(r'(^|/)(test_[^/]+|[^/]+_test\.[^/.]+|[^/]+\.(test|spec)\.[^/.]+|test[^/]*\.[^/.]+)$')

def pattern_test(wt, test_cmd, files, planned=()):
    """(path, first lines) of the existing test file nearest to the task's own test, or None: same extension, a test by
    its name, tracked in the task's worktree and not empty, declared by no task of the plan (another task may be
    rewriting it); the declared test itself when it exists already (the task extends it). Nearest is the longest
    shared folder prefix, then the name."""
    try:
        parts = shlex.split(test_cmd or '')
    except ValueError:
        parts = []
    own = ''
    for a in parts[1:]:
        if a.startswith('-') or any(ch in a for ch in '$*?[{`'):
            continue
        if '/' in a or os.path.splitext(a)[1]:
            own = norm(a)
            break
    if not own:
        own = next((norm(f) for f in files if TEST_NAME.search(norm(f))), '')
    if not own:
        return None
    ext = os.path.splitext(own)[1]
    declared = {norm(f) for f in files} | {norm(f) for f in planned}
    def has_text(x):
        try:
            return open(os.path.join(wt, x), 'rb').read(4096).strip() != b''
        except OSError:
            return False
    r = subprocess.run(['git', '-C', wt, 'ls-files', '-z'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    tracked = [x for x in r.stdout.decode('utf-8', 'surrogateescape').split('\0') if x]
    if own in tracked and has_text(own):
        pick = own
    else:
        cands = [x for x in tracked if x not in declared and os.path.splitext(x)[1] == ext and TEST_NAME.search(x) and has_text(x)]
        if not cands:
            return None
        def shared(x):
            a, b = os.path.dirname(x).split('/'), os.path.dirname(own).split('/')
            k = 0
            while k < min(len(a), len(b)) and a[k] == b[k]:
                k += 1
            return k
        pick = sorted(cands, key=lambda x: (-shared(x), x))[0]
    try:
        raw = open(os.path.join(wt, pick), 'rb').read(PATTERN_MAX_BYTES + 1)
    except OSError:
        return None
    text = raw[:PATTERN_MAX_BYTES].decode('utf-8', 'ignore')
    if len(raw) > PATTERN_MAX_BYTES:
        text = text[:text.rfind('\n') + 1] + '[the rest of the file is cut]'
    return pick, text.rstrip('\n')

def matches(path, pats):
    return any(path == norm(p) for p in pats)   # H4: exact paths only; the plan gate refuses glob characters

def known_shas(run, g):
    # D-08: the shas the CLI itself recorded (a task's commit, cli_commits) and the ones a human accepted for group g with
    # `group reopen --accept-foreign` (an override). A subject that merely looks like the CLI's proves nothing.
    known = {(v or {}).get('commit') for v in (run.get('tasks') or {}).values()} | set(run.get('cli_commits') or [])
    try:
        for o in json.load(open('.temper/overrides.json')):
            st = str(o.get('stage', '')).split(':', 2)
            if len(st) == 3 and st[0] == 'foreign-commit' and st[1] == g:
                known.add(st[2])
    except Exception:
        pass
    return known

def unknown_commits(cwd, run, g, ref):
    # M5: the commits of group g's base..ref that are neither recorded by the CLI nor accepted, newest first. A group
    # without a recorded base, or a git error, reports none (the checks that follow stay as they were).
    base = ((run.get('groups') or {}).get(g) or {}).get('base_sha')
    if not base:
        return []
    rl = subprocess.run(['git', '-C', cwd, 'rev-list', '--topo-order', '%s..%s' % (base, ref)],
                        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if rl.returncode != 0:
        return []
    kn = known_shas(run, g)
    return [x for x in rl.stdout.decode('utf-8', 'replace').split() if x not in kn]

mode = sys.argv[1]

if mode == 'ctx':
    print(json.dumps(ctx(json.loads(sys.argv[2]), load_run(sys.argv[3]), int(sys.argv[4]))))

elif mode == 'why':
    plan, run, n, max_par = json.loads(sys.argv[2]), load_run(sys.argv[3]), int(sys.argv[4]), int(sys.argv[5])
    c = ctx(plan, run, n)
    t = next(x for x in plan['tasks'] if x['n'] == n)
    rg, rt = run.get('groups') or {}, run.get('tasks') or {}
    def st(m): return (rt.get(str(m)) or {}).get('status', 'pending')
    g = next(x for x in plan['groups'] if x['id'] == c['group'])
    gwait = [d for d in g['depends'] if ((rg.get(d) or {}).get('gate') or {}).get('verdict') != 'PASS']
    unmet = [d for d in t['depends'] if st(d) != 'passed']
    running = [x for x in plan['tasks'] if st(x['n']) == 'running']
    clash = [x['n'] for x in running if {norm(f) for f in x['files']} & {norm(f) for f in t['files']}]
    if (rg.get(c['group']) or {}).get('status') == 'parked': print('group %s is parked' % c['group'])
    elif gwait: print('group %s depends on %s' % (c['group'], ', '.join(gwait)))
    elif unmet: print('depends on %s' % ', '.join('Task %d' % d for d in unmet))
    elif clash: print('files overlap Task %d' % clash[0])
    elif len(running) >= max_par: print('max-parallel %d reached' % max_par)
    else: print('')

elif mode == 'snap':
    print(json.dumps(snap(sys.argv[2])))

elif mode == 'show':
    plan, run, n, project = json.loads(sys.argv[2]), load_run(sys.argv[3]), int(sys.argv[4]), sys.argv[5]
    c = ctx(plan, run, n)
    if not c['worktree']:
        fail('group %s is not started (temper group start %s)' % (c['group'], c['group']))
    head = 'TASK %d (group %s, attempt %d): %s\nWORKTREE: %s\nPROJECT:  %s\nDECLARED FILES: %s\n' % (
        n, c['group'], c['attempt'], c['title'], os.path.join(project, c['worktree'], PREFIX).rstrip('/'), project, ', '.join(c['files']))
    body = head + '--- TASK ---\n' + c['block'] + '\n--- GROUP CONTEXT ---\n' + c['context'] + '\n'
    # an existing test of the project, so the agent copies its style, imports and fixtures instead of guessing them
    pat = pattern_test(os.path.join(project, c['worktree'], PREFIX).rstrip('/'), c['test'], c['files'], [f for t in plan['tasks'] for f in t['files']])
    if pat:
        body += '--- PATTERN TEST (%s: follow its style, imports and fixtures) ---\n%s\n' % pat
    # F1: the human's feedback from a group gate's Change (group reopen --feedback ID) reaches the task agent
    fb_ids = [str(r['feedback']) for r in (((run.get('tasks') or {}).get(str(n)) or {}).get('reopened') or [])
              if r.get('feedback') and not r.get('resolved')]
    if fb_ids:
        try:
            rows = json.load(open(sys.argv[7]))
        except Exception:
            rows = []
        for i in fb_ids:
            text = [r.get('claim') or '' for r in rows if r.get('phase') == 'feedback'
                    and re.match(r'feedback #%s\b' % re.escape(i), r.get('claim') or '')]
            body += '--- FEEDBACK #%s (apply it) ---\n%s\n' % (i, text[-1] if text else '(no text recorded)')
    if c['attempts']:
        last = c['attempts'][-1]
        prev = '--- PREVIOUS ATTEMPT ---\n%s: %s\n%s\n' % (last.get('outcome', 'FAIL'), last.get('reason', ''),
                                                           last.get('output', ''))
        room = int(sys.argv[6]) - len(body.encode('utf-8'))
        pb = prev.encode('utf-8')
        if len(pb) > room:
            note = b'\n[truncated]\n'
            pb = pb[:max(room - len(note), 0)].decode('utf-8', 'ignore').encode('utf-8') + note if room > len(note) else b''
        body += pb.decode('utf-8', 'ignore')
    sys.stdout.write(body)

elif mode == 'testrun':
    wt, timeout, rowfile, n, group, attempt, phase = sys.argv[2:9]
    cmd = sys.argv[10:]   # argv[9] is the '--' separator
    before = untracked(wt)
    out, rc = run_cmd(wt, timeout, cmd)
    # F5: untracked paths that first appear during this CLI run (__pycache__, coverage files, logs) are the test
    # command's byproducts; the task verdict does not count them as undeclared changes
    byproducts = sorted(untracked(wt) - before)
    sys.stdout.write(out.decode('utf-8', 'replace'))
    sys.stdout.flush()
    row = {'claim': 'Task %s unit test %s' % (n, phase), 'cmd': ' '.join(shlex.quote(x) for x in cmd), 'exit_code': rc,
           'artifact': None, 'sha256': None, 'value': None, 'severity': None, 'phase': phase, 'scenario': None,
           'criterion': None, 'label': 'PROVEN' if rc == 0 else 'HEURISTIC', 'task': int(n), 'group': group,
           'attempt': int(attempt), 'executed_by': 'cli', 'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
           'output': out[-4096:].decode('utf-8', 'replace'), 'byproducts': byproducts[:1000]}
    json.dump(row, open(rowfile, 'w'))
    sys.exit(rc)

elif mode == 'grouprun':
    # the group's own Validate command, run by the CLI in the group worktree; the row is tagged with the
    # group and carries phase 'group', so it never counts as a task RED or GREEN run
    wt, timeout, rowfile, group = sys.argv[2:6]
    cmd = sys.argv[7:]    # argv[6] is the '--' separator
    out, rc = run_cmd(wt, timeout, cmd)
    show(out, rc)
    row = {'claim': 'Group %s validate' % group, 'cmd': ' '.join(shlex.quote(x) for x in cmd), 'exit_code': rc,
           'artifact': None, 'sha256': None, 'value': None, 'severity': None, 'phase': 'group', 'scenario': None,
           'criterion': None, 'label': 'PROVEN' if rc == 0 else 'HEURISTIC', 'group': group,
           'executed_by': 'cli', 'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
           'output': out[-4096:].decode('utf-8', 'replace')}
    json.dump(row, open(rowfile, 'w'))
    sys.exit(rc)

elif mode == 'integrun':
    # the full suite, run by the CLI in the project folder after the merges; phase 'integration' keeps it
    # out of the task RED/GREEN counts
    wt, timeout, rowfile = sys.argv[2:5]
    cmd = sys.argv[6:]    # argv[5] is the '--' separator
    out, rc = run_cmd(wt, timeout, cmd)
    show(out, rc)
    row = {'claim': 'Integration suite', 'cmd': ' '.join(shlex.quote(x) for x in cmd), 'exit_code': rc,
           'artifact': None, 'sha256': None, 'value': None, 'severity': None, 'phase': 'integration', 'scenario': None,
           'criterion': None, 'label': 'PROVEN' if rc == 0 else 'HEURISTIC', 'executed_by': 'cli',
           'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'output': out[-4096:].decode('utf-8', 'replace')}
    json.dump(row, open(rowfile, 'w'))
    sys.exit(rc)

elif mode == 'integplan':
    # integplan <plan> <groups.json>: the integration facts as one JSON line: the suite command, the groups whose
    # gate has not passed, the merge order (Depends first, then group number) and the Interfaces entries
    plan, run = json.loads(sys.argv[2]), load_run(sys.argv[3])
    rg = run.get('groups') or {}
    ids = [g['id'] for g in plan['groups']]
    deps = {g['id']: [d for d in g['depends'] if d in ids] for g in plan['groups']}
    order, done = [], set()
    while len(order) < len(ids):
        ready = sorted((i for i in ids if i not in done and all(d in done for d in deps[i])), key=lambda x: int(x[1:]))
        if not ready:
            ready = sorted((i for i in ids if i not in done), key=lambda x: int(x[1:]))
        order.append(ready[0]); done.add(ready[0])
    print(json.dumps({'integration': plan.get('integration') or '',
                      'notpassed': [i for i in order if ((rg.get(i) or {}).get('gate') or {}).get('verdict') != 'PASS'],
                      'order': order,
                      'worktrees': {i: (rg.get(i) or {}).get('worktree', '') for i in order},
                      'interfaces': [x for g in plan['groups'] for x in g['interfaces']]}))

elif mode == 'ifcheck':
    # ifcheck <interfaces-json>: the first Interfaces entry whose literal is not in its file at HEAD
    for x in json.loads(sys.argv[2]):
        r = subprocess.run(['git', 'show', 'HEAD:' + x['path']], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if r.returncode != 0 or x['literal'] not in r.stdout.decode('utf-8', 'replace'):
            print('interface missing: %s in %s' % (x['literal'], x['path']))
            sys.exit(1)

elif mode == 'gatecheck':
    # gatecheck <plan> <groups.json> <G> <abs worktree>: line 1 the group's validate command, line 2 the tasks that have not
    # passed (comma separated), line 3 the passed tasks whose recorded commit is not an ancestor of the worktree HEAD
    # (D-08: "Task N (sha)"), line 4 the group's status
    plan, run, g = json.loads(sys.argv[2]), load_run(sys.argv[3]), sys.argv[4]
    grp = next((x for x in plan['groups'] if x['id'] == g), None)
    if grp is None:
        fail('tasks.md has no group %s' % g)
    rt = run.get('tasks') or {}
    notpassed = ['Task %d' % n for n in grp['tasks'] if (rt.get(str(n)) or {}).get('status', 'pending') != 'passed']
    off = []
    for n in grp['tasks']:
        t = rt.get(str(n)) or {}
        if t.get('status') == 'passed' and t.get('commit'):
            r = subprocess.run(['git', '-C', sys.argv[5], 'merge-base', '--is-ancestor', t['commit'], 'HEAD'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if r.returncode != 0:
                off.append('Task %d (%s)' % (n, t['commit'][:7]))
    print(grp['validate'])
    print(', '.join(notpassed))
    print(', '.join(off))
    print(((run.get('groups') or {}).get(g) or {}).get('status', ''))

elif mode == 'foreigncheck':
    # foreigncheck <abs worktree> <parked-shas-json> <accept-csv> <groups.json> <G>: one line per fact, "ACCEPT <sha>" for a
    # sha the human named (a unique prefix of 4 or more characters of a parked sha or of a commit of the group's base..HEAD
    # that is neither recorded by the CLI nor accepted), "BAD <given>" for one that is neither, "ON <sha>" for a parked sha
    # that is still an ancestor of the worktree HEAD and was not accepted (D-08), and "UNK <sha>" for such an unrecorded,
    # unaccepted commit that is not parked (M5: a replayed commit has a new sha)
    wt, parked = sys.argv[2], json.loads(sys.argv[3])
    run, grp = load_run(sys.argv[5]), sys.argv[6]
    unknown = [u for u in unknown_commits(wt, run, grp, 'HEAD') if u not in parked]
    universe = list(parked) + unknown
    acc = set()
    for a in (x.strip().lower() for x in sys.argv[4].split(',') if x.strip()):
        hit = [p for p in universe if p.startswith(a)] if len(a) >= 4 else []
        if len(hit) == 1:
            acc.add(hit[0])
            print('ACCEPT ' + hit[0])
        else:
            print('BAD ' + a)
    for p in parked:
        if p not in acc and subprocess.run(['git', '-C', wt, 'merge-base', '--is-ancestor', p, 'HEAD'],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            print('ON ' + p)
    for u in unknown:
        if u not in acc:
            print('UNK ' + u)

elif mode == 'unknown':
    # unknown <project root> <groups.json> <G> <ref>: the unrecorded, unaccepted commits of G's base..ref, one per line
    for u in unknown_commits(sys.argv[2], load_run(sys.argv[3]), sys.argv[4], sys.argv[5]):
        print(u)

elif mode == 'reopencheck':
    # reopencheck <plan> <groups.json> <G> <N>...: prints one "N<TAB>declared files, comma separated<TAB>start_sha"
    # line per task, or fails naming the first task that cannot be reopened
    plan, run, g = json.loads(sys.argv[2]), load_run(sys.argv[3]), sys.argv[4]
    grp = next((x for x in plan['groups'] if x['id'] == g), None)
    if grp is None:
        fail('tasks.md has no group %s' % g)
    by_n = {x['n']: x for x in plan['tasks']}
    def ancestors(n, seen=None):  # every task n depends on, directly or not
        seen = set() if seen is None else seen
        for d in (by_n.get(n) or {}).get('depends', []):
            if d not in seen:
                seen.add(d)
                ancestors(d, seen)
        return seen
    wanted = []
    for a in sys.argv[5:]:
        n = int(a)
        t = by_n.get(n)
        if t is None:
            fail('tasks.md has no Task %d' % n)
        if n not in grp['tasks']:
            fail('Task %d is not in group %s' % (n, g))
        st = (run.get('tasks') or {}).get(str(n)) or {}
        if st.get('status', 'pending') == 'running':
            fail('Task %d is running; let it finish or fail first' % n)
        if n not in wanted:
            wanted.append(n)
    # M3: restoring Task N's files to its start_sha would revert a later task's edits to the same file while
    # that task stays passed. A later task (one that depends on N, directly or not) that already ran and shares
    # a file must be reopened with it.
    for n in wanted:
        for m in grp['tasks']:
            if m in wanted or n not in ancestors(m):
                continue
            ms = (run.get('tasks') or {}).get(str(m)) or {}
            shared = sorted(set(by_n[n]['files']) & set(by_n[m]['files']))
            if shared and ms.get('status', 'pending') in ('passed', 'running'):
                fail('Task %d (depends on Task %d) also edits %s; reopen it too (--task %d)' % (m, n, ', '.join(shared), m))
    # dependents first: a later task restores to a start_sha that already holds its ancestors' edits
    wanted.sort(key=lambda n: -len(ancestors(n)))
    for n in wanted:
        st = (run.get('tasks') or {}).get(str(n)) or {}
        print('%d\t%s\t%s' % (n, ','.join(by_n[n]['files']), st.get('start_sha', '')))

elif mode == 'restore':
    # restore <worktree> <sha> <paths-json | @file>: each path goes back to its content at sha (and out of the index),
    # or is removed when sha does not have it. Batched: one ls-tree, then checkout/reset in chunks, never one git
    # process per path. A path behind a symlinked directory is left alone (never written or removed through the link).
    # A git lock that outlasts the shared retry budget ends the restore at once (exit 3).
    import stat
    wt, sha, arg = sys.argv[2], sys.argv[3], sys.argv[4]
    paths = json.loads(open(arg[1:]).read() if arg.startswith('@') else arg)
    lt = subprocess.run(['git', '--literal-pathspecs', '-C', wt, 'ls-tree', '-r', '-z', '--name-only', sha],
                        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    had = set(lt.stdout.split(b'\0'))
    wtb = os.fsencode(wt)
    def link_above(p):
        cp = wtb
        for comp in os.fsencode(p).split(b'/')[:-1]:
            cp = os.path.join(cp, comp)
            try:
                st = os.lstat(cp)
            except OSError:
                return False
            if stat.S_ISLNK(st.st_mode):
                return True
            if not stat.S_ISDIR(st.st_mode):
                return False
        return False
    blocked = {p for p in paths if link_above(p)}
    tracked = [p for p in paths if os.fsencode(p) in had and p not in blocked]
    for p in paths:
        if os.fsencode(p) not in had and p not in blocked:
            try:
                os.remove(os.path.join(wt, p))
            except OSError:
                pass
    def chunked(cmd_head, chunk):
        return run_retry(['git', '--literal-pathspecs', '-C', wt] + cmd_head + ['--'] + chunk)
    for i in range(0, len(tracked), 200):
        chunk = tracked[i:i + 200]
        for head in (['checkout', sha], ['reset', '-q', 'HEAD']):
            r = chunked(head, chunk)
            if lock_failed(r):
                sys.exit(3)
            if r.returncode != 0:
                for p in chunk:   # one path in the chunk could not be restored: the rest still are
                    if lock_failed(chunked(head, [p])):
                        sys.exit(3)

elif mode == 'verdict':
    plan, run, ledger, n, wt = json.loads(sys.argv[2]), load_run(sys.argv[3]), sys.argv[4], int(sys.argv[5]), sys.argv[6]
    c = ctx(plan, run, n)
    try:
        rows = json.load(open(ledger))
    except Exception:
        rows = []
    # M1: only the rows made since this attempt started count; a reopened task numbers its attempts from 1 again, and
    # the rows of its earlier run must not stand in for a RED and a GREEN of this one
    mine = [r for r in rows if r.get('task') == n and r.get('attempt') == c['attempt'] and r.get('executed_by') == 'cli'
            and not (r.get('ts') and c['started_at'] and r['ts'] < c['started_at'])]
    # H1: the verdict reads the LAST run of the attempt: a red run, then a passing green after it, and the
    # attempt's final run must itself be that green (a failing re-run after a green is not forgiven).
    green = None
    for i, r in enumerate(mine):
        if r.get('phase') == 'green' and r.get('exit_code') == 0:
            green = i
    reason = ''
    if green is None:
        reason = 'no green run for this task and attempt'
    elif not any(red_ok(r) for r in mine[:green]):
        bad = [r for r in mine[:green] if r.get('phase') == 'red' and r.get('exit_code') not in (0, None)]
        reason = ('need a failing run before a passing run for this task and attempt' if not bad else
                  'the RED run did not run the tests (exit %s: %s); it must fail on an assertion' % (
                      bad[-1].get('exit_code'), red_why(bad[-1])))
    elif green != len(mine) - 1:
        reason = 'the final run of this attempt is not green'
    # the worktree's own run state (the commit hook writes .temper/gates.json there) is not the task's change
    def internal(p):
        return p.startswith('.temper/') or p.startswith('.claude/worktrees/')
    now = snap(wt)
    old = c['snapshot']
    changed = sorted(p for p in set(now) | set(old) if now.get(p, 'CLEAN') != old.get(p, 'CLEAN') and not internal(p))
    # H2: files changed by commits made in the worktree since the task's start also count
    foreign = []       # newest first, as git log prints them
    committed = []
    if c['start_sha']:
        rl = subprocess.run(['git', '-C', wt, 'log', '--topo-order', '--format=%H', '%s..HEAD' % c['start_sha']],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        # A1/D-08: only shas the CLI itself recorded (a task's commit, cli_commits) or a human accepted with
        # `group reopen --accept-foreign` (an override) are known; a subject that merely looks like the CLI's proves
        # nothing. The task's own worktree holds only this task's work, so any other commit in its range is the agent's.
        known = known_shas(run, c['group'])
        foreign = [x for x in rl.stdout.decode('utf-8', 'replace').split('\n') if x.strip() and x not in known]
        df = subprocess.run(['git', '-C', wt, 'diff', '--name-only', '--no-renames', '-z', c['start_sha'], 'HEAD'],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        committed = sorted(R(p) for p in df.stdout.decode('utf-8', 'surrogateescape').split('\0') if p and not internal(R(p)))
    def commit_files(sha):
        dt = subprocess.run(['git', '-C', wt, 'diff-tree', '--no-commit-id', '--name-only', '-r', '-z', '--no-renames', '-m', '--root', sha],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        return sorted({x for x in dt.stdout.decode('utf-8', 'surrogateescape').split('\0') if x})
    mine_changed = [p for p in changed if matches(p, c['files'])]
    # F5: a path a CLI test run of this attempt created, still untracked and in no commit, is a byproduct
    byproducts = {p for r in mine for p in (r.get('byproducts') or [])} - set(committed)
    # the worktree is this task's alone: every other changed path is an undeclared change of this task
    undeclared = sorted(p for p in set(changed) | set(committed) if not matches(p, c['files']) and p not in byproducts)
    problems = []
    def named(lst, cap=20):   # a verdict with thousands of paths names the first few
        return ', '.join(lst[:cap]) + (' (and %d more)' % (len(lst) - cap) if len(lst) > cap else '')
    if undeclared:
        problems.append('undeclared change: ' + named(undeclared))
    if foreign:   # D-08: each foreign sha with the files it changed
        problems.append('commit not made by the CLI: ' + '; '.join('%s (%s)' % (x[:7], named(commit_files(x), 10)) for x in foreign[:10])
                        + (' (and %d more)' % (len(foreign) - 10) if len(foreign) > 10 else ''))
    if problems and (foreign or not reason):
        reason = '; '.join(([reason] if reason and foreign else []) + problems)
    tail = ''
    if reason:
        last = [r for r in mine if r.get('output')]
        tail = '\n'.join((last[-1]['output'] if last else '').split('\n')[:20]).rstrip('\n')
    print(json.dumps({'verdict': 'FAIL' if reason else 'PASS', 'reason': reason, 'commit_paths': mine_changed,
                      'foreign_shas': foreign,
                      'output': tail, 'attempt': c['attempt'], 'title': c['title'], 'group': c['group'],
                      'slug': c['slug']}))
PY
}

_jget() { # _jget <json> <key> -> the value (lists and objects as JSON); the JSON goes in on stdin, so a large
          # verdict (thousands of paths) never meets the argument size limit
  printf '%s' "$1" | python3 -I -c "
import json, sys
v = json.load(sys.stdin).get(sys.argv[1], '')
s = json.dumps(v) if isinstance(v, (list, dict)) else ('' if v is None else str(v))
sys.stdout.buffer.write((s + '\\n').encode('utf-8', 'surrogateescape'))" "$2"
}

_task_load() { # _task_load <N>: sets _T_SPEC _T_PLAN _T_CTX _T_ABS for task N, or returns 1 with the reason
  local n="${1:-}"
  if [[ ! "$n" =~ ^[0-9]+$ ]]; then
    echo "FAIL: usage: temper task <start|show|test|gate> <N> ..." >&2
    return 1
  fi
  _T_SPEC="$(_spec_path "")"
  if [[ -z "$_T_SPEC" || ! -f "$_T_SPEC/tasks.md" ]]; then
    echo "FAIL: no tasks.md for the active run (temper state init, then plan)" >&2
    return 1
  fi
  _T_PLAN="$(_grouped_parse "$_T_SPEC/tasks.md")"
  _plan_fresh "$_T_PLAN" || return 1
  _T_CTX="$(_task_py ctx "$_T_PLAN" "$GROUPS_FILE" "$n")" || return 1
  local wt; wt="$(_jget "$_T_CTX" worktree)"
  _T_ABS=""
  # the project folder inside the task's worktree (a project below the top of its repository is under its prefix there)
  [[ -n "$wt" ]] && _T_ABS="$(_in_wt "$(pwd -P)/$wt")"
  return 0
}

# ADR 0009 for CLI commits: the native pre-commit hook fails open in a group worktree (no run state
# there), so the CLI checks the upstream gates itself: plan, intent while intent.md exists, design
# while design.md exists. Prints the unsatisfied stages and returns 1.
_adr0009_upstream_check() { # _adr0009_upstream_check <spec_path>
  local sp="$1" missing=""
  _stage_satisfied plan || missing="$missing plan"
  if [[ -f "$sp/intent.md" ]]; then _stage_satisfied intent || missing="$missing intent"; fi
  if [[ -f "$sp/design.md" ]]; then _stage_satisfied design || missing="$missing design"; fi
  [[ -z "$missing" ]] && return 0
  echo "${missing# }"
  return 1
}

# L3: the ready check and the start write happen under one lock, so a start never acts on a stale ready set.
cmd_task_start() {
  local rc
  _lock_acquire
  _task_start_body "$@"
  rc=$?
  _lock_release
  return $rc
}

_task_start_body() {
  _task_load "${1:-}" || return 1
  local n="$1" group wt status
  group="$(_jget "$_T_CTX" group)"; wt="$(_jget "$_T_CTX" gworktree)"; status="$(_jget "$_T_CTX" status)"
  local why=""
  if [[ -z "$wt" ]]; then
    why="group $group is not started (temper group start $group)"
  elif [[ "$status" == "running" || "$status" == "passed" ]]; then
    why="it is already $status"
  else
    local ready max
    ready="$(cmd_schedule 2>/dev/null | python3 -I -c "
import json, sys
n = int(sys.argv[1])
print(1 if any(l.strip().startswith('{') and json.loads(l).get('task') == n for l in sys.stdin) else 0)" "$n")"
    if [[ "$ready" != "1" ]]; then
      max="$(_cfg_get build.grouped.max-parallel 4)"; [[ "$max" =~ ^[1-9][0-9]*$ ]] || max=4
      why="$(_task_py why "$_T_PLAN" "$GROUPS_FILE" "$n" "$max")"
      [[ -n "$why" ]] || why="it is not in the ready set"
    fi
  fi
  if [[ -n "$why" ]]; then
    echo "FAIL: Task $n is not ready: $why" >&2
    return 1
  fi
  # One worktree per task, on its own branch from the group branch. A worktree kept by a park (a commit the CLI did
  # not make, D-08) is reused after the human's reopen: its HEAD is this attempt's start, and since the worktree is
  # this task's alone, every dirty file in it is this task's change (an empty start snapshot), so none is dropped.
  local slug twt tb tabs snap sha
  slug="$(_jget "$_T_CTX" slug)"
  twt=".claude/worktrees/temper-$slug-T$n"; tb="temper/$slug/T$n"; tabs="$(pwd -P)/$twt"
  if git worktree list --porcelain 2>/dev/null | awk -v p="$tabs" -v b="refs/heads/$tb" '
      $1 == "worktree" { path = $2 } $1 == "branch" && path == p && $2 == b { found = 1 } END { exit !found }'; then
    snap='{}'
  else
    if [[ -e "$twt" || -L "$twt" ]]; then
      echo "FAIL: $twt exists and is not the worktree of Task $n; move it away" >&2
      return 3
    fi
    if git show-ref --verify --quiet "refs/heads/$tb"; then
      echo "FAIL: branch $tb already exists (left by an earlier run); delete it with: git branch -D $tb, then temper task start $n" >&2
      return 1
    fi
    local wt_out
    if ! wt_out="$(git worktree add -q -b "$tb" "$twt" "$(_jget "$_T_CTX" gbranch)" 2>&1)"; then
      echo "FAIL: git worktree add failed: $(printf '%s' "$wt_out" | head -1)" >&2
      return 1
    fi
    snap='{}'
  fi
  sha="$(git -C "$tabs" rev-parse HEAD)" || return 1
  _groups_mutate "
t = d.setdefault('tasks', {}).setdefault(a[0], {})
if t.get('status') == 'running':
    print('FAIL: Task %s is already running' % a[0], file=sys.stderr)
    sys.exit(1)
t.setdefault('attempts', [])
t['group'] = a[1]
t['status'] = 'running'
t['attempt'] = len(t['attempts']) + 1
t['start_sha'] = a[2]
t['snapshot'] = json.loads(a[3])
t['started_at'] = a[4]
t['worktree'] = a[5]
t['branch'] = a[6]
" "$n" "$group" "$sha" "$snap" "$(_now)" "$twt" "$tb" || return 1
  echo "OK: Task $n started (group $group, worktree $twt)"
}

# Removes a task's own worktree and branch (a FAIL discards the attempt; a PASS has merged it into the group branch)
# and forgets them in groups.json. Called with the lock held.
_task_wt_discard() { # _task_wt_discard <N> <worktree rel> <branch>
  [[ -n "$2" ]] && git worktree remove --force "$2" >/dev/null 2>&1
  [[ -n "$3" ]] && git branch -D "$3" >/dev/null 2>&1
  _groups_mutate "
t = d.setdefault('tasks', {}).setdefault(a[0], {})
t.pop('worktree', None)
t.pop('branch', None)
" "$1"
}

cmd_task_show() {
  _task_load "${1:-}" || return 1
  if [[ -z "$_T_ABS" ]]; then
    echo "FAIL: group $(_jget "$_T_CTX" group) is not started (temper group start)" >&2
    return 1
  fi
  _task_py show "$_T_PLAN" "$GROUPS_FILE" "$1" "$(pwd -P)" "$TASK_SHOW_MAX_BYTES" "$(_evidence_file build)"
}

cmd_task_test() {
  local n="${1:-}"; shift || true
  local phase=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --phase) phase="${2:-}"; shift 2 || true ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  if [[ ! "$phase" =~ ^(red|green)$ ]]; then
    echo "FAIL: usage: temper task test <N> --phase red|green" >&2
    return 1
  fi
  _task_load "$n" || return 1
  _task_parked_refuse "$n" test || return 1
  if [[ "$(_jget "$_T_CTX" status)" != "running" ]]; then
    echo "FAIL: Task $n is not running (temper task start $n)" >&2
    return 1
  fi
  # The command is the task's own declared **Test:** command (design Resolution 3). An agent-supplied
  # command after -- is accepted only when it IS the declared one; any other is refused, no row.
  local declared; declared="$(_jget "$_T_CTX" test)"
  if [[ -z "$declared" ]]; then
    echo "FAIL: Task $n declares no **Test:** command in tasks.md" >&2
    return 1
  fi
  if [[ $# -gt 0 && "$*" != "$declared" ]]; then
    echo "FAIL: Task $n runs only its declared test command: $declared (not: $*)" >&2
    return 1
  fi
  local rowfile rc
  rowfile="$(mktemp "${TMPDIR:-/tmp}/temper-row.XXXXXX")" || return 1
  _task_py testrun "$_T_ABS" "${TEMPER_TASK_TEST_TIMEOUT_S:-600}" "$rowfile" "$n" "$(_jget "$_T_CTX" group)" \
    "$(_jget "$_T_CTX" attempt)" "$phase" -- "$declared"
  rc=$?
  _ensure_dirs
  [[ -s "$rowfile" ]] && _json_append "$(_evidence_file build)" "$(cat "$rowfile")"
  rm -f "$rowfile"
  return $rc
}

# D-08: while a group is parked, task gate and task test of any of its tasks are refused: no verdict, attempt, restore or
# ledger row, so the tasks still running keep their work until a human resolves the park and reopens the group.
_task_parked_refuse() { # _task_parked_refuse <N> <test|gate>
  [[ "$(_jget "$_T_CTX" gstatus)" == "parked" ]] || return 0
  echo "FAIL: group $(_jget "$_T_CTX" group) is parked ($(_jget "$_T_CTX" gparked)); task $2 of Task $1 is refused and recorded nothing. Resolve the park, then temper group reopen $(_jget "$_T_CTX" group) --task N" >&2
  return 1
}

# M1/A1: the whole gate runs under the lock: the verdict reads the recorded shas, and the task commit, the
# record of its sha and the tasks.md tick happen before any other gate or start can look. A held lock is
# only ever waited on for a git commit and a few small file writes.
cmd_task_gate() {
  local rc
  _lock_acquire
  _task_gate_body "$@"
  rc=$?
  _lock_release
  return $rc
}

_task_gate_body() {
  local n="${1:-}"; shift || true
  local model="" tokens="" ms="" agent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) model="${2:-}"; shift 2 || true ;;
      --tokens) tokens="${2:-}"; shift 2 || true ;;
      --ms) ms="${2:-}"; shift 2 || true ;;
      --agent) agent="${2:-}"; shift 2 || true ;;
      *) echo "FAIL: unknown flag $1" >&2; return 1 ;;
    esac
  done
  # A gate judges the result of the task's own agent, so it comes after that agent returned, with the model it ran on.
  # A gate with no model is one run too early (found live: the attempt was spent before the agent ran): refuse it, record nothing.
  if [[ -z "$model" ]]; then
    echo "FAIL: task gate needs --model, the model the agent of Task $n ran on. Gate a task only after its agent has returned. Nothing was recorded." >&2
    return 1
  fi
  local from; from="$(_usage_from "$agent" "$tokens")" || return 1
  _task_load "$n" || return 1
  _task_parked_refuse "$n" gate || return 1
  local status; status="$(_jget "$_T_CTX" status)"
  if [[ "$status" != "running" ]]; then
    echo "FAIL: Task $n is not running (status: $status)" >&2
    return 1
  fi
  local v verdict reason
  v="$(_task_py verdict "$_T_PLAN" "$GROUPS_FILE" "$(_evidence_file build)" "$n" "$_T_ABS")" || return 1
  verdict="$(_jget "$v" verdict)"; reason="$(_jget "$v" reason)"
  local group slug title; group="$(_jget "$v" group)"; slug="$(_jget "$v" slug)"; title="$(_jget "$v" title)"
  # D-07: this launch's usage, once, whatever the verdict (a failed attempt spent tokens too).
  [[ "$tokens" =~ ^[0-9]+$ ]] || tokens=""
  [[ "$ms" =~ ^[0-9]+$ ]] || ms=""
  _usage_append task "$model" "$tokens" "$ms" "$n" "$group" "$from" || true

  if [[ "$verdict" != "PASS" ]]; then
    local att fshas wtrel park=""
    att="$(_jget "$v" attempt)"; fshas="$(_jget "$v" foreign_shas)"; wtrel="$(_jget "$_T_CTX" worktree)"
    if [[ "$fshas" != "[]" && -n "$fshas" ]]; then
      # D-08: a commit the CLI did not record is not repaired. The task FAILs, the group parks at once (no retry: a
      # rule violation, not a test failure) and the task's worktree is kept as it is for the human. The worktree is
      # this task's alone, so the commit is this task's: no sibling is touched.
      park="Task $n holds commit(s) not made by the CLI"
    else
      # D-03: attempt 1 retries on the task model, attempt 2 escalates once, attempt 3 parks the group. The attempt's
      # worktree is discarded; the next attempt starts a fresh one from the group branch.
      _task_wt_discard "$n" "$wtrel" "$(_jget "$_T_CTX" tbranch)" || return 1
    fi
    _groups_mutate "
t = d['tasks'][a[0]]
def num(x): return int(x) if x.isdigit() else None
t.setdefault('attempts', []).append({'n': int(a[1]), 'model': a[2] or None, 'outcome': 'FAIL', 'reason': a[3],
    'tokens': num(a[4]), 'ms': num(a[5]), 'ts': a[6], 'output': a[7]})
t['status'] = 'failed'
if int(a[1]) >= 3 or a[9]:
    g = d.setdefault('groups', {}).setdefault(a[8], {})
    g.setdefault('parked_foreign', []).extend(x for x in json.loads(a[10] or '[]') if x not in g.get('parked_foreign', []))
    # a group already parked keeps the reason it was parked for and gains this one
    new = a[9] or 'Task %s failed %s attempts' % (a[0], a[1])
    old = g.get('parked_reason') if g.get('status') == 'parked' else ''
    g['parked_reason'] = old + ' -- also: ' + new if old and new not in old else (old or new)
    g['status'] = 'parked'
" "$n" "$att" "$model" "$reason" "$tokens" "$ms" "$(_now)" "$(_jget "$v" output)" "$group" "$park" "${fshas:-[]}" || return 1
    echo "FAIL: $reason"
    if [[ "$fshas" != "[]" && -n "$fshas" ]]; then
      local fl=(); mapfile -t fl < <(python3 -I -c "
import json, sys
print('\n'.join(json.loads(sys.argv[1])))" "$fshas")
      _park_ways_out "$group" "$wtrel" "$n" "${fl[@]}"
      echo "NEXT: park group $group"
    elif [[ -n "$park" ]]; then
      echo "NEXT: park group $group"
    elif [[ "$att" -le 1 ]]; then
      echo "NEXT: retry Task $n on $(_resolve_task_model)"
    elif [[ "$att" -eq 2 ]]; then
      echo "NEXT: escalate Task $n on $(_resolve_task_escalation_model)"
    else
      echo "NEXT: park group $group"
    fi
    return 1
  fi

  # ADR 0009 (design.md "Gate for CLI-made commits"): the CLI checks the upstream gates itself.
  local missing
  if ! missing="$(_adr0009_upstream_check "$_T_SPEC")"; then
    echo "FAIL: refusing the Task $n commit: upstream gate(s) not satisfied: $missing (ADR 0009)" >&2
    return 3
  fi

  local paths=() p sha=""
  while IFS= read -r p; do [[ -n "$p" ]] && paths+=("$p"); done < <(python3 -I -c "
import json, sys
for p in json.loads(sys.argv[1]): print(p)" "$(_jget "$v" commit_paths)")
  if [[ ${#paths[@]} -gt 0 ]]; then
    local idargs; idargs="$(_git_id_args)"
    # shellcheck disable=SC2086
    if ! git --literal-pathspecs -C "$_T_ABS" add -A -- "${paths[@]}" >/dev/null 2>&1 \
       || ! git --literal-pathspecs -C "$_T_ABS" $idargs commit -q -m "feat($slug): Task $n $title [$group]" -- "${paths[@]}" >/dev/null 2>&1; then
      echo "FAIL: could not commit Task $n in $(_jget "$_T_CTX" worktree)" >&2
      return 1
    fi
    sha="$(git -C "$_T_ABS" rev-parse HEAD)"
  fi
  # the task's branch goes into the group branch (a fast-forward when the group branch has not moved, else a merge
  # commit); declared files are disjoint between tasks that run together, so a conflict means the plan was wrong
  local gabs tb mrg=""
  gabs="$(pwd -P)/$(_jget "$_T_CTX" gworktree)"; tb="$(_jget "$_T_CTX" tbranch)"
  # the merge runs whenever the task branch holds commits the group branch lacks: the CLI's commit just made, and
  # also one kept from an earlier attempt or accepted by the human at a reopen when this attempt changed nothing more
  local tip ahead
  tip="$(git -C "$_T_ABS" rev-parse HEAD)" || return 1
  ahead="$(git rev-list --count "$(_jget "$_T_CTX" gbranch)..$tip" 2>/dev/null || echo 0)"
  if [[ "$ahead" =~ ^[1-9] ]]; then
    local idm mout; idm="$(_git_id_args)"
    # shellcheck disable=SC2086
    if ! mout="$(git -C "$gabs" $idm merge -q --no-edit -m "merge($slug): Task $n into $group" "$tb" 2>&1)"; then
      local cf; cf="$(git -C "$gabs" diff --name-only --diff-filter=U 2>/dev/null | paste -sd, -)"
      git -C "$gabs" merge --abort >/dev/null 2>&1 || true
      [[ -n "$cf" ]] || cf="$(printf '%s' "$mout" | grep -v '^[[:space:]]*$' | head -1)"
      reason="Task $n passed but could not be merged into the group branch (${cf:-git merge failed}); its worktree is kept"
      _groups_mutate "
t = d['tasks'][a[0]]
t.setdefault('attempts', []).append({'n': int(a[1]), 'model': a[2] or None, 'outcome': 'FAIL', 'reason': a[3], 'ts': a[4]})
t['status'] = 'failed'
g = d.setdefault('groups', {}).setdefault(a[5], {})
g['status'] = 'parked'
g['parked_reason'] = a[3]
if a[6]:   # the commit the CLI just made on the task branch is its own, so a reopen does not take it for an agent's
    d.setdefault('cli_commits', []).append(a[6])
" "$n" "$(_jget "$v" attempt)" "$model" "$reason" "$(_now)" "$group" "$sha" || return 1
      echo "FAIL: $reason"
      echo "NEXT: park group $group"
      return 1
    fi
    mrg="$(git -C "$gabs" rev-parse HEAD)"; [[ "$mrg" == "$tip" ]] && mrg=""
  else
    tip=""
  fi
  _task_box "$_T_SPEC/tasks.md" "$n" x
  _groups_mutate "
t = d['tasks'][a[0]]
def num(x): return int(x) if x.isdigit() else None
t.setdefault('attempts', []).append({'n': int(a[1]), 'model': a[2] or None, 'outcome': 'PASS', 'reason': '',
    'tokens': num(a[3]), 'ms': num(a[4]), 'ts': a[5]})
t['status'] = 'passed'
t['passed_at'] = a[5]
t['commit'] = a[8] or None
for x in (a[6], a[7]):
    if x:
        d.setdefault('cli_commits', []).append(x)
" "$n" "$(_jget "$v" attempt)" "$model" "$tokens" "$ms" "$(_now)" "$sha" "$mrg" "$tip" || return 1
  _task_wt_discard "$n" "$(_jget "$_T_CTX" worktree)" "$tb" || return 1
  # F1: a task reopened with group-gate feedback answers it by passing: the CLI records the feedback-resolved row
  # that gate build requires, and marks the reopen answered so task show stops printing it
  local fid
  for fid in $(python3 -I -c "
import json, sys
try:
    t = (json.load(open(sys.argv[1])).get('tasks') or {}).get(sys.argv[2]) or {}
except Exception:
    t = {}
print(' '.join(str(r['feedback']) for r in (t.get('reopened') or []) if r.get('feedback') and not r.get('resolved')))" "$GROUPS_FILE" "$n"); do
    _json_append "$(_evidence_file build)" "$(python3 -I -c "
import json, sys, time
print(json.dumps({'claim': 'feedback #%s: applied — Task %s re-ran after group reopen and passed its task gate' % (sys.argv[1], sys.argv[2]),
                  'cmd': None, 'exit_code': 0, 'artifact': None, 'sha256': None, 'value': None, 'severity': None,
                  'phase': 'feedback-resolved', 'scenario': None, 'criterion': None, 'label': 'PROVEN', 'task': int(sys.argv[2]),
                  'executed_by': 'cli', 'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}))" "$fid" "$n")"
  done
  _groups_mutate "
for r in (d['tasks'][a[0]].get('reopened') or []):
    if r.get('feedback'): r['resolved'] = True
" "$n" || return 1
  echo "PASS: Task $n"
  echo "NEXT: schedule"
}

# temper integrate: merge every passed group branch into the feature branch (dependency order, --no-ff),
# remove the group worktrees, run the plan's **Integration:** suite in the project, check each **Interfaces:**
# literal, and on PASS delete the merged branches. A conflict aborts that merge and stops the run before Review
# (the worktrees and branches stay for diagnosis). The verdict lives in groups.json 'integration'; gate build
# reads it. Exit 0 PASS, 1 FAIL, 3 a protected branch or an unsatisfied upstream gate (ADR 0009).
_integ_record() { # _integ_record <verdict> <reason> [group] [files-csv] [foreign-json]
  _groups_mutate "
d['integration'] = {'verdict': a[0], 'reason': a[1], 'group': a[2] or None,
                    'files': [f for f in a[3].split(',') if f], 'ts': a[4]}
if a[5]:
    d['integration']['foreign'] = json.loads(a[5])   # {group: [sha, newest first]}: the person takes them out or keeps them
" "$1" "$2" "${3:-}" "${4:-}" "$(_now)" "${5:-}"
}

cmd_integrate() {
  local spec_path slug feature cur
  spec_path="$(_spec_path "")"
  slug="$(_spec_slug "$spec_path")"
  if [[ -z "$spec_path" || ! -f "$spec_path/tasks.md" || ! -f "$GROUPS_FILE" ]]; then
    echo "FAIL: no grouped run to integrate (temper group start first)" >&2
    return 1
  fi
  if [[ "$(python3 -I -c "
import json, sys
try:
    print((json.load(open(sys.argv[1])).get('integration') or {}).get('verdict', ''))
except Exception:
    print('')" "$GROUPS_FILE")" == "PASS" ]]; then
    echo "OK: already integrated"
    return 0
  fi
  feature="$(cmd_state_get branch "")"
  cur="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  local protected="main master $(_default_branch)" b
  for b in $protected; do
    if [[ "$feature" == "$b" || "$cur" == "$b" ]]; then
      if [[ -n "$feature" && "$feature" != "$b" ]]; then
        echo "FAIL: refusing to integrate on the protected branch '$b' (switch to the run's branch '$feature' first)" >&2
      else
        echo "FAIL: refusing to integrate on the protected branch '$b' (use a feature branch)" >&2
      fi
      return 3
    fi
  done
  if [[ -z "$feature" || "$cur" != "$feature" ]]; then
    echo "FAIL: integrate runs on the run's feature branch '$feature' (current branch: '${cur:-none}')" >&2
    return 1
  fi
  local plan facts notpassed suite
  plan="$(_grouped_parse "$spec_path/tasks.md")"
  _plan_fresh "$plan" || return 1
  facts="$(_task_py integplan "$plan" "$GROUPS_FILE")" || return 1
  notpassed="$(python3 -I -c "import json, sys; print(', '.join(json.loads(sys.argv[1])['notpassed']))" "$facts")"
  suite="$(_jget "$facts" integration)"
  if [[ -n "$notpassed" ]]; then
    _integ_record FAIL "group gate not passed: $notpassed" || true
    echo "FAIL: group gate has not passed for: $notpassed" >&2
    return 1
  fi
  # M5: no group branch may hold a commit that the CLI did not record and nobody accepted
  local ug unk="" ugl ufull foreign="{}"
  for ug in $(python3 -I -c "import json, sys; print(' '.join(json.loads(sys.argv[1])['order']))" "$facts"); do
    ufull="$(_task_py unknown "$(pwd -P)" "$GROUPS_FILE" "$ug" "temper/$slug/$ug")"
    ugl="$(printf '%s\n' "$ufull" | cut -c1-7 | paste -sd' ' -)"
    [[ -z "$ufull" ]] && continue
    unk="${unk:+$unk; }$ug: $ugl"
    foreign="$(python3 -I -c "
import json, sys
d = json.loads(sys.argv[1]); d[sys.argv[2]] = [x for x in sys.argv[3].split() if x]
print(json.dumps(d))" "$foreign" "$ug" "$ufull")"
  done
  if [[ -n "$unk" ]]; then
    _integ_record FAIL "commit(s) not made by the CLI and not accepted: $unk" "" "" "$foreign" || true
    echo "FAIL: commit(s) not made by the CLI and not accepted on a group branch: $unk" >&2
    echo "The person chooses (temper next asks them): take them out of the group's branch, or keep them knowingly with their reason: temper group reopen <G> --accept-foreign <sha> --reason \"<why>\"" >&2
    return 1
  fi
  local missing
  if ! missing="$(_adr0009_upstream_check "$spec_path")"; then
    echo "FAIL: refusing the integration merge: upstream gate(s) not satisfied: $missing (ADR 0009)" >&2
    return 3
  fi
  local idargs; idargs="$(_git_id_args)"
  local order g
  order="$(python3 -I -c "import json, sys; print(' '.join(json.loads(sys.argv[1])['order']))" "$facts")"
  for g in $order; do
    # shellcheck disable=SC2086
    local mout
    if ! mout="$(git $idargs merge --no-ff -q -m "merge($slug): group $g" "temper/$slug/$g" 2>&1)"; then
      local files; files="$(git diff --name-only --diff-filter=U 2>/dev/null | paste -sd, -)"
      git merge --abort >/dev/null 2>&1 || true
      local why="${files:-$(printf '%s' "$mout" | head -1)}"
      _integ_record FAIL "merge conflict: $g in ${why:-unknown files}" "$g" "$files" || true
      echo "FAIL: merge conflict: $g in ${why:-unknown files}" >&2
      return 1
    fi
  done
  # worktrees go before any test run, so no runner sees the copies
  for g in $order; do
    local wt; wt="$(python3 -I -c "import json, sys; print(json.loads(sys.argv[1])['worktrees'].get(sys.argv[2], ''))" "$facts" "$g")"
    [[ -n "$wt" ]] && git worktree remove --force "$wt" >/dev/null 2>&1
  done
  git worktree prune >/dev/null 2>&1 || true
  if [[ -n "$suite" ]]; then
    local rowfile rc
    rowfile="$(mktemp "${TMPDIR:-/tmp}/temper-row.XXXXXX")" || return 1
    _task_py integrun "$(pwd -P)" "${TEMPER_TASK_TEST_TIMEOUT_S:-600}" "$rowfile" -- "$suite"
    rc=$?
    _ensure_dirs
    [[ -s "$rowfile" ]] && _json_append "$(_evidence_file build)" "$(cat "$rowfile")"
    rm -f "$rowfile"
    if [[ "$rc" -ne 0 ]]; then
      _integ_record FAIL "integration suite failed (exit $rc): $suite" || true
      echo "FAIL: integration suite failed (exit $rc): $suite" >&2
      return 1
    fi
  fi
  local ifail
  if ! ifail="$(_task_py ifcheck "$(python3 -I -c "import json, sys; print(json.dumps(json.loads(sys.argv[1])['interfaces']))" "$facts")")"; then
    _integ_record FAIL "$ifail" || true
    echo "FAIL: $ifail" >&2
    return 1
  fi
  for g in $order; do git branch -D "temper/$slug/$g" >/dev/null 2>&1 || true; done
  _integ_record PASS "" || return 1
  echo "PASS: integrated $order into $feature"
}

cmd_task() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    start) cmd_task_start "$@" ;;
    show) cmd_task_show "$@" ;;
    test) cmd_task_test "$@" ;;
    gate) cmd_task_gate "$@" ;;
    *) echo "FAIL: usage: temper task <start|show|test|gate> ..." >&2; return 1 ;;
  esac
}

# Grouped plan-gate rows: one JSON requirement object per line (same shape _req emits).
_grouped_plan_reqs() { # _grouped_plan_reqs <tasks.md> <max-blast-radius>
  local model; model="$(_grouped_parse "$1")"
  python3 -I - "$2" "$GROUP_CONTEXT_MAX_BYTES" "$TASK_BLOCK_MAX_BYTES" "$model" "$PWD" <<'PY'
import json, os, shlex, sys
max_blast, ctx_max, blk_max = int(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3])
m = json.loads(sys.argv[4])
groups, tasks = m['groups'], m['tasks']
def row(name, bad, ok_detail):
    print(json.dumps({'name': name, 'pass': not bad, 'detail': '; '.join(bad) if bad else ok_detail}))
by_n = {}
bad = []
if not groups: bad.append('no "## Group G<n>: title" heading')
for t in tasks:
    if t['n'] in by_n: bad.append('duplicate Task %d' % t['n'])
    by_n.setdefault(t['n'], t)
    if not t['group']: bad.append('Task %d is outside any group' % t['n'])
row('grouped plan', bad, '%d groups: %s' % (len(groups), ', '.join('%s (%d tasks)' % (g['id'], len(g['tasks'])) for g in groups)))
row('declared files', ['Task %d: no declared files' % t['n'] for t in tasks if not t['files']],
    'every task declares its files')
row('exact file paths', ['Task %d: **File:** %s is a glob (declare exact paths)' % (t['n'], f)
                         for t in tasks for f in t['files'] if any(c in f for c in '*?[')],
    'every **File:** is an exact path')
def test_path(cmd):  # the first path-like argument of a test command, else ''
    try: parts = shlex.split(cmd)
    except ValueError: return ''
    for a in parts[1:]:
        if a.startswith('-') or any(c in a for c in '$*?[{`'): continue
        if '/' in a or os.path.splitext(a)[1] in ('.sh', '.py', '.js', '.ts', '.bats', '.rb'): return a
    return ''
def undeclared_test(t):
    p = test_path(t['test'])
    if not p: return None
    q = p[2:] if p.startswith('./') else p
    if q in {f.strip()[2:] if f.strip().startswith('./') else f.strip() for f in t['files']}: return None
    if os.path.exists(os.path.join(sys.argv[5], q)): return None
    return 'Task %d: test path %s is not declared in **File:** and does not exist yet' % (t['n'], q)
row('task test command', ['Task %d: no test command' % t['n'] for t in tasks if not t['test']]
    + [m for m in map(undeclared_test, tasks) if m],
    'every task declares its own scoped test command')
row('task test cases', ['Task %d: %d case(s) under **Cases:** (need 2 or more: the normal result and an edge or error case)' % (t['n'], t['cases'])
                        for t in tasks if t['cases'] < 2],
    'every task lists the concrete cases its test must check')
row('group context', ['%s: no group context' % g['id'] for g in groups if not g['context']],
    'every group has a context block')
row('context budget', ['%s: context %d bytes > %d' % (g['id'], g['context_bytes'], ctx_max)
                       for g in groups if g['context_bytes'] > ctx_max], 'every context within %d bytes' % ctx_max)
row('task block budget', ['Task %d: block %d bytes > %d' % (t['n'], t['block_bytes'], blk_max)
                          for t in tasks if t['block_bytes'] > blk_max], 'every task block within %d bytes' % blk_max)
gids = {g['id'] for g in groups}
dep_bad = []
for t in tasks:
    for d in t['depends']:
        if d not in by_n: dep_bad.append('Task %d depends on unknown Task %d' % (t['n'], d))
for g in groups:
    for d in g['depends']:
        if d not in gids: dep_bad.append('%s depends on unknown %s' % (g['id'], d))
def find_cycle(nodes, edges, label):
    state = {}
    def visit(n, path):
        state[n] = 1
        for d in edges.get(n, []):
            if d not in nodes: continue
            if state.get(d) == 1:
                return ' -> '.join(label(x) for x in path[path.index(d):] + [d])
            if d not in state:
                r = visit(d, path + [d])
                if r: return r
        state[n] = 2
        return None
    for n in nodes:
        if n not in state:
            r = visit(n, [n])
            if r: return r
    return None
c = find_cycle(list(by_n), {n: t['depends'] for n, t in by_n.items()}, lambda x: 'Task %d' % x)
if c: dep_bad.append('Depends cycle: ' + c)
gdeps = {g['id']: g['depends'] for g in groups}
c = find_cycle(list(gids), gdeps, str)
if c: dep_bad.append('Depends cycle: ' + c)
# F3: a group's worktree starts from the feature branch plus the groups it depends on, so a task that depends on a
# task of another group needs its own group to depend (transitively) on that group, or it runs without that work
def gclosure(g):
    seen, stack = set(), list(gdeps.get(g, []))
    while stack:
        x = stack.pop()
        if x in seen: continue
        seen.add(x); stack.extend(gdeps.get(x, []))
    return seen
for n, t in sorted(by_n.items()):
    for d in t['depends']:
        dg = (by_n.get(d) or {}).get('group')
        if dg and t['group'] and dg != t['group'] and dg not in gclosure(t['group']):
            dep_bad.append('Task %d (%s) depends on Task %d (%s) but %s does not depend on %s' % (n, t['group'], d, dg, t['group'], dg))
row('dependencies', dep_bad, 'no cycles, no unknown dependencies')
# A precedes B when A is a transitive task ancestor of B, or B's group transitively depends on A's group.
def closure(start, edges, ok):
    seen, stack = set(), list(edges.get(start, []))
    while stack:
        x = stack.pop()
        if x in seen or not ok(x): continue
        seen.add(x); stack.extend(edges.get(x, []))
    return seen
tdeps = {n: t['depends'] for n, t in by_n.items()}
ordered = set()
for n, t in by_n.items():
    for a in closure(n, tdeps, lambda x: x in by_n): ordered.add((a, n))
    if t['group']:
        for ag in closure(t['group'], gdeps, lambda x: x in gids):
            for o in tasks:
                if o['group'] == ag: ordered.add((o['n'], n))
ov = []
ts = sorted(by_n)
for i, a in enumerate(ts):
    for b in ts[i + 1:]:
        if (a, b) in ordered or (b, a) in ordered: continue
        for f in by_n[a]['files']:
            if f in by_n[b]['files']:
                ov.append('file ownership overlap: %s in Task %d and Task %d' % (f, a, b))
row('file ownership', ov, 'tasks that can run together declare disjoint files')
big = []
for g in groups:
    files = {f for n in g['tasks'] for f in by_n[n]['files']}
    if len(files) > max_blast:
        big.append('%s declares %d files > autonomy.max-blast-radius=%d: split the group' % (g['id'], len(files), max_blast))
row('group blast radius', big, 'every group within autonomy.max-blast-radius=%d' % max_blast)
row('integration command', [] if m['integration'] else ['no **Integration:** line'], 'integration command declared')
PY
}

gate_plan() {
  local spec_path="$1"
  local reqs=() all_pass=1
  if [[ -f "$spec_path/intent.md" && -f "$spec_path/tasks.md" ]]; then
    reqs+=("$(_req "artifacts exist" 1 "intent.md + tasks.md present")")
  else
    reqs+=("$(_req "artifacts exist" 0 "intent.md and/or tasks.md missing under $spec_path")")
    all_pass=0
  fi
  if [[ -f "$spec_path/intent.md" ]]; then
    local criteria scenarios
    # Section parsing: a heading at any level opens, the next heading of any level
    # closes — so `### Constraints` bullets after `### Success Criteria` never count.
    criteria=$(awk 'tolower($0) ~ /^#+[ \t]*success criteria/ {f=1; next} f && /^#/ {f=0} f && /^- /{c++} END{print c+0}' "$spec_path/intent.md")
    scenarios=$(_count_lines_matching '^[[:space:]]*Scenario:' "$spec_path/intent.md")
    if [[ "$criteria" -gt 0 && "$scenarios" -ge "$criteria" ]]; then
      reqs+=("$(_req "criteria -> scenarios" 1 "$scenarios scenario(s) for $criteria success criterion/criteria")")
    else
      reqs+=("$(_req "criteria -> scenarios" 0 "$scenarios scenario(s) for $criteria success criterion/criteria — need >=1 scenario per criterion")")
      all_pass=0
    fi
    # Every criterion is explicitly tied to the scenario/evidence that proves it.
    local acc_out acc_rc
    acc_out="$(python3 "$ACCEPTANCE_PY" plan "$spec_path/intent.md" "$(_evidence_file plan)" 2>&1)"; acc_rc=$?
    if [[ "$acc_rc" -eq 0 ]]; then
      reqs+=("$(_req "criteria -> validation" 1 "$acc_out")")
    else
      reqs+=("$(_req "criteria -> validation" 0 "$acc_out")")
      all_pass=0
    fi
    # Each scenario is one fenced ```gherkin block — bare indented steps render as
    # one run-on paragraph in every markdown surface.
    local scen_total unfenced_raw unfenced_arr unfenced="" u
    scen_total=$(_count_lines_matching '^[[:space:]]*Scenario:' "$spec_path/intent.md")
    if [[ "$scen_total" -eq 0 ]]; then
      reqs+=("$(_req "scenarios in gherkin blocks" 1 "no scenarios — nothing to fence")")
    else
      unfenced_raw="$(_unfenced_scenarios "$spec_path/intent.md")"
      if [[ -n "$unfenced_raw" ]]; then
        IFS=$'\x1f' read -r -a unfenced_arr <<< "$unfenced_raw"
        for u in "${unfenced_arr[@]}"; do
          [[ -n "$u" ]] || continue
          [[ -n "$unfenced" ]] && unfenced+=" | "
          unfenced+="$u"
        done
      fi
      if [[ -z "$unfenced" ]]; then
        reqs+=("$(_req "scenarios in gherkin blocks" 1 "$scen_total scenario(s), all inside gherkin fences")")
      else
        reqs+=("$(_req "scenarios in gherkin blocks" 0 "Scenario: not inside a gherkin fence — $unfenced")")
        all_pass=0
      fi
    fi
  fi
  # Cross-repo code search: absence of the tool never fails; a missing record does.
  if [[ ! -f "$spec_path/plan.md" ]]; then
    reqs+=("$(_req "cross-repo search recorded" 1 "no plan.md — nothing to record yet")")
  else
    local cr_out; cr_out="$(_cross_repo_recorded "$spec_path/plan.md")"
    if [[ "$cr_out" == "ok" ]]; then
      reqs+=("$(_req "cross-repo search recorded" 1 "plan.md records the cross-repo search (or why none ran)")")
    else
      reqs+=("$(_req "cross-repo search recorded" 0 "$cr_out")")
      all_pass=0
    fi
  fi
  local complexity; complexity="$(cmd_state_get complexity "")"
  if [[ "$complexity" == "medium" || "$complexity" == "complex" ]]; then
    if [[ -f "$spec_path/plan.md" ]] && grep -qiE '^#+ .*blast radius' "$spec_path/plan.md"; then
      reqs+=("$(_req "blast radius documented" 1 "plan.md has a Blast Radius section ($complexity change)")")
    else
      reqs+=("$(_req "blast radius documented" 0 "plan.md missing a Blast Radius section — required for $complexity complexity")")
      all_pass=0
    fi
  fi
  # The tier the run records is the one its files record: a door reads it from their Complexity lines.
  if [[ -n "$complexity" ]]; then
    local tier_off; tier_off="$(_tier_lines "$spec_path" check "$complexity" | paste -sd';' - | sed 's/;/; /g')"
    if [[ -z "$tier_off" ]]; then
      reqs+=("$(_req "tier recorded" 1 "no Complexity line names another tier than the run's ($complexity)")")
    else
      reqs+=("$(_req "tier recorded" 0 "$tier_off, while the run records $complexity: temper state set complexity <tier> records one tier in the run and in those lines")")
      all_pass=0
    fi
  fi
  # Grouped Build (the default): the grouped requirement rows of the run's tasks.md
  if [[ -f "$spec_path/tasks.md" ]]; then
    local g_line g_ok
    while IFS= read -r g_line; do
      [[ -n "$g_line" ]] || continue
      reqs+=("$g_line")
      g_ok="$(python3 -I -c "import json,sys; print(1 if json.loads(sys.argv[1])['pass'] else 0)" "$g_line")"
      [[ "$g_ok" == "1" ]] || all_pass=0
    done <<<"$(_grouped_plan_reqs "$spec_path/tasks.md" "$(_cfg_get autonomy.max-blast-radius 15)")"
  fi
  local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

_earlier_build() { # _earlier_build <spec_path>: prints the commit of the spec folder's newest committed gate-ledger.json that
                   # records Build PASS (not skipped); exit 0 when no file of the plan changed since, exit 2 (the commit, a
                   # tab, and what changed) when one did, exit 1 (why) when no such ledger is committed
  python3 -I - "$1" "$(_grouped_parse "$1/tasks.md" 2>/dev/null)" <<'PY'
import json, subprocess, sys
spec = sys.argv[1].rstrip('/')
def git(*a):
    r = subprocess.run(['git', '--literal-pathspecs', '-c', 'core.quotePath=false'] + list(a), capture_output=True, text=True)
    return r.returncode, r.stdout
led = spec + '/gate-ledger.json'
rc, shas = git('log', '-n', '20', '--format=%H', '--', led)
shas = shas.split() if rc == 0 else []
if not shas:
    print('the spec folder holds no committed gate-ledger.json of an earlier run'); sys.exit(1)
def built(sha):
    # the ledger as that commit holds it records a Build PASS of its own (not a skip)
    rc, text = git('show', '%s:./%s' % (sha, led))
    try:
        d = json.loads(text) if rc == 0 else {}
    except ValueError:
        return False
    b = (d.get('gates') or {}).get('build') or {} if isinstance(d, dict) else {}
    return b.get('verdict') == 'PASS' and not any(isinstance(o, dict) and o.get('stage') == 'build' for o in d.get('overrides') or [])
# the newest ledger that does: a later door run that skipped Build (or a run left without one) hides no earlier Build PASS
sha = next((x for x in shas if built(x)), None)
if not sha:
    print('no committed gate-ledger.json of the spec folder records a Build PASS of its own'); sys.exit(1)
try:
    files = sorted({f for t in json.loads(sys.argv[2]).get('tasks', []) for f in t.get('files', [])})
except ValueError:
    files = []
if not files:
    print('tasks.md declares no files'); sys.exit(1)
rc, out = git('diff', '--name-only', sha, '--', *files)
if rc or out.strip():
    print('%s\tthe ledger committed in %s records Build PASS, but a file of the plan changed since: %s' % (
        sha, sha[:7], ', '.join(out.split()[:3]) or 'git diff failed'))
    sys.exit(2)
print(sha)
PY
}

gate_build() {
  local spec_path="$1"
  local reqs=() all_pass=1
  # A door into Review or Check walks Build in a run that built nothing: the Build PASS of the earlier run that built
  # the code counts, as its committed ledger records it, while no file of the plan changed since.
  case "$(cmd_state_get enter "")" in
    review|check)
      local before brc
      before="$(_earlier_build "$spec_path")"; brc=$?
      if [[ $brc -eq 0 ]]; then
        reqs+=("$(_req "built in an earlier run" 1 "the spec folder's gate-ledger.json, committed in ${before:0:7}, records Build PASS, and no file of the plan changed since")")
      elif [[ $brc -eq 2 ]]; then
        # the plan was built, and its code changed since: Run Build mends and checks that code (the fix pass)
        reqs+=("$(_req "built in an earlier run" 0 "${before#*$'\t'}")")
      fi
      if [[ $brc -ne 1 ]]; then
        echo "$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"${reqs[0]}")" "$(( brc == 0 ? 1 : 0 ))"
        return 0
      fi ;;
  esac
  local red_n green_n after_n
  red_n=$(_ev_count_matching build test red nonzero)
  green_n=$(_ev_count_matching build test green 0)
  # The order counts: a passing run recorded after a failing one (test first). GREEN rows that only come before
  # every RED row prove no test failed first.
  after_n="$(python3 -I -c "
import json, re, sys
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    rows = []
def test(r): return isinstance(r, dict) and re.search('test', r.get('claim') or '', re.I)
red = [i for i, r in enumerate(rows) if test(r) and r.get('phase') == 'red' and r.get('exit_code') not in (0, None)]
print(sum(1 for i, r in enumerate(rows) if red and i > red[0] and test(r) and r.get('phase') == 'green' and r.get('exit_code') == 0))
" "$(_evidence_file build)" 2>/dev/null || echo 0)"
  if [[ "$red_n" -gt 0 && "${after_n:-0}" -gt 0 ]]; then
    reqs+=("$(_req "RED then GREEN" 1 "$red_n failing-first run(s), $green_n passing run(s) recorded")")
  elif [[ "$red_n" -gt 0 && "$green_n" -gt 0 ]]; then
    reqs+=("$(_req "RED then GREEN" 0 "every passing run (GREEN) was recorded before the first failing run (RED); a test first fails, then passes")")
    all_pass=0
  else
    reqs+=("$(_req "RED then GREEN" 0 "need >=1 failing test run (RED) and >=1 passing run (GREEN); have red=$red_n green=$green_n")")
    all_pass=0
  fi
  if [[ -f "$spec_path/tasks.md" ]]; then
    local unchecked
    unchecked=$(_count_lines_matching '^[[:space:]]*- \[ \]' "$spec_path/tasks.md")
    if [[ "$unchecked" -eq 0 ]]; then
      reqs+=("$(_req "all tasks complete" 1 "no unchecked tasks in tasks.md")")
    else
      reqs+=("$(_req "all tasks complete" 0 "$unchecked unchecked task(s) remain in tasks.md")")
      all_pass=0
    fi
  fi
  # Checkpoint feedback: every `feedback #N` row the orchestrator recorded must be
  # answered by a `feedback-resolved` row — applied (detail optional) or declined
  # with a reason. A decline with no reason is not an answer.
  local fb_answered fb_detail
  fb_detail="$(python3 -I - "$(_evidence_file build)" <<'PY'
import json, re, sys, os
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    rows = []
fb = {m.group(1) for r in rows if r.get('phase') == 'feedback'
      for m in [re.search(r'feedback #(\d+)', r.get('claim') or '')] if m}
res = {m.group(1): r for r in rows if r.get('phase') == 'feedback-resolved'
       for m in [re.search(r'feedback #(\d+)', r.get('claim') or '')] if m}
if not fb:
    print('SKIP')
else:
    unanswered = []
    for n in sorted(fb, key=int):
        r = res.get(n)
        if r is None:
            unanswered.append('feedback #%s' % n)
        else:
            c = r.get('claim') or ''
            m = re.search(r'declined\s*[—-]\s*(.*)', c)
            if 'declined' in c and (not m or not m.group(1).strip()):
                unanswered.append('feedback #%s (declined with no reason)' % n)
    print(' | '.join(unanswered) if unanswered else 'OK')
PY
)"
  if [[ "$fb_detail" == "SKIP" ]]; then
    reqs+=("$(_req "checkpoint feedback answered" 1 "no feedback rows — nothing to answer")")
  elif [[ "$fb_detail" == "OK" ]]; then
    reqs+=("$(_req "checkpoint feedback answered" 1 "every feedback row answered (applied or declined with reason)")")
  else
    reqs+=("$(_req "checkpoint feedback answered" 0 "unanswered: $fb_detail")")
    all_pass=0
  fi
  # Build runs in groups: a run with a tasks.md is integrated by `temper integrate` (a /temper:fix run has none)
  if [[ -n "$spec_path" && -f "$spec_path/tasks.md" ]]; then
    local integ
    integ="$(python3 -I -c "
import json, sys
try:
    i = json.load(open(sys.argv[1])).get('integration') or {}
except Exception:
    i = {}
print('%s|%s' % (i.get('verdict', ''), i.get('reason', '')))" "$GROUPS_FILE")"
    if [[ "${integ%%|*}" == "PASS" ]]; then
      reqs+=("$(_req "integration" 1 "groups merged, suite and interfaces verified (temper integrate)")")
    elif [[ -z "${integ%%|*}" && -n "$(cmd_state_get built_before "")" ]]; then
      reqs+=("$(_req "integration" 1 "the groups were built and merged in an earlier run (its ledger, committed in $(cmd_state_get built_before "" | cut -c1-7)); this run's fix pass works on that code")")
    elif [[ -n "${integ%%|*}" ]]; then
      reqs+=("$(_req "integration" 0 "integration FAIL: ${integ#*|}")")
      all_pass=0
    else
      reqs+=("$(_req "integration" 0 "integration not run (temper integrate)")")
      all_pass=0
    fi
  fi
  local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

gate_design() {
  # v8.1: no longer vacuous. Design is still an optional stage with no
  # single-correct-output *quality* requirement — but when it RAN (design.md exists),
  # the one thing reference/design.md makes non-negotiable is checkable: an Areas of
  # Concern section, present even when it says none was flagged. A policy conflict
  # silently unflagged is exactly what an unattended design->build crossing must not
  # let through. design.md absent => stage was legitimately skipped => PASS.
  local spec_path="$1"
  local reqs=() all_pass=1
  if [[ ! -f "$spec_path/design.md" ]]; then
    reqs+=("$(_req "design artifact" 1 "design.md absent — stage skipped (trivial/simple, or phases.design: false)")")
  elif grep -qiE '^#+ .*areas of concern' "$spec_path/design.md"; then
    reqs+=("$(_req "concerns flagged" 1 "design.md has an Areas of Concern section ('None flagged — why' counts)")")
  else
    reqs+=("$(_req "concerns flagged" 0 "design.md has no Areas of Concern section — flag conflicts, or state 'None flagged — {why}'")")
    all_pass=0
  fi
  local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

_ev_open_findings() { # _ev_open_findings <stage> <comma-separated severities>
                      # -> \x1f-joined claims of unresolved findings at those severities
  local stage="$1" sev_csv="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo ""; return; }
  python3 -I -c "
import json, sys
file, sev_csv = sys.argv[1:3]
sevs = set(s for s in sev_csv.split(',') if s)
entries = json.load(open(file))
claims = [e.get('claim') or '(no claim)' for e in entries
          if e.get('severity') in sevs and not e.get('resolved') and not e.get('accepted')]
print('\x1f'.join(claims))
" "$file" "$sev_csv"
}

_ev_latest_claim_exit() { # _ev_latest_claim_exit <stage> <keyword-regex>
                          # -> "<exit_code>|<claim>" of the LAST row matching, or ""
  local stage="$1" keyword="$2"
  local file; file="$(_evidence_file "$stage")"
  [[ -f "$file" ]] || { echo ""; return; }
  python3 -I -c "
import json, sys, re
file, keyword = sys.argv[1:3]
entries = json.load(open(file))
hits = [e for e in entries if re.search(keyword, e.get('claim') or '', re.I)]
print(('%s|%s' % (hits[-1].get('exit_code'), hits[-1].get('claim') or '')) if hits else '')
" "$file" "$keyword"
}

_review_code() { # _review_code save|compare: the tracked files of the project (outside .temper and .claude) and HEAD as
                 # Review starts (save, into the run state), or the ones that differ from that since (compare: prints them)
  python3 -I - "$1" "$STATE_FILE" <<'PY'
import hashlib, json, os, subprocess, sys
mode, state = sys.argv[1:3]
def git(*a):
    r = subprocess.run(['git', '-c', 'core.quotePath=false', '-c', 'status.renames=false'] + list(a), capture_output=True)
    return r.stdout.decode('utf-8', 'replace') if r.returncode == 0 else ''
top = git('rev-parse', '--show-toplevel').strip()
pre = git('rev-parse', '--show-prefix').strip()
def mine(path):
    rel = path[len(pre):] if pre and path.startswith(pre) else path
    return None if rel.startswith(('.temper/', '.claude/')) or (pre and not path.startswith(pre)) else rel
def snap():
    files = {}
    for f in git('status', '--porcelain=v1', '-z', '-uno', '--', '.').split('\0'):
        if len(f) < 4:
            continue
        rel = mine(f[3:])
        if rel is None:
            continue
        try:
            files[rel] = hashlib.sha256(open(os.path.join(top, f[3:]), 'rb').read()).hexdigest()
        except OSError:
            files[rel] = 'DELETED'
    return {'head': git('rev-parse', 'HEAD').strip(), 'files': files}
try:
    d = json.load(open(state))
except Exception:
    sys.exit(0)
if mode == 'save':
    d['review_snapshot'] = snap()
    tmp = '%s.tmp.%d' % (state, os.getpid())
    with open(tmp, 'w') as f:
        json.dump(d, f, indent=2); f.write('\n')
    os.replace(tmp, state)
    sys.exit(0)
old = d.get('review_snapshot')
if not isinstance(old, dict):
    print('NONE'); sys.exit(0)
cur = snap()
a, b = old.get('files') or {}, cur['files']
changed = {k for k in b if b[k] != a.get(k)} | {k for k in a if k not in b}
if old.get('head') and cur['head'] and old.get('head') != cur['head']:
    changed |= {r for r in (mine(x) for x in git('diff', '--name-only', '--no-renames', old['head'], cur['head'], '--', '.').split('\n') if x) if r}
print(', '.join(sorted(changed)[:5]))
PY
}

gate_review() {
  local block_on sev_csv
  block_on="$(_cfg_get review.block-on critical)"
  sev_csv="$(printf '%s' "$block_on" | tr $'\x1f' ',')"
  local n; n=$(_ev_count_severity_in review "$sev_csv")
  local resolved; resolved=$(_ev_count_resolved_in review "$sev_csv")
  local resolved_note=""
  [[ "$resolved" -gt 0 ]] && resolved_note=", $resolved resolved in this run"
  local accepted; accepted=$(_ev_count_accepted_in review "$sev_csv")
  [[ "$accepted" -gt 0 ]] && resolved_note+=", $accepted accepted"
  local all_pass=1 reqs=()
  if [[ "$n" -eq 0 ]]; then
    reqs+=("$(_req "no blocking findings" 1 "0 open findings at severity [$sev_csv]$resolved_note")")
  else
    # Name every open blocking finding — a count tells the reader nothing.
    local open_raw open_arr open_names="" name
    open_raw="$(_ev_open_findings review "$sev_csv")"
    IFS=$'\x1f' read -r -a open_arr <<< "$open_raw"
    for name in "${open_arr[@]}"; do
      [[ -n "$name" ]] || continue
      [[ -n "$open_names" ]] && open_names+=" | "
      open_names+="$name"
    done
    reqs+=("$(_req "no blocking findings" 0 "$n open finding(s) at severity [$sev_csv]$resolved_note — $open_names")")
    all_pass=0
  fi
  # The Review brief records a completion row even when there are no findings —
  # otherwise an empty ledger is indistinguishable from a review that never ran.
  local completion; completion="$(_ev_latest_claim_exit review 'review completed')"
  if [[ -n "$completion" && "${completion%%|*}" == "0" ]]; then
    reqs+=("$(_req "review completed" 1 "${completion#*|}")")
  else
    reqs+=("$(_req "review completed" 0 "no review completion evidence — an empty findings ledger is not a review")")
    all_pass=0
  fi
  # Review writes no code (its brief; with the mod, a write outside the spec folder is refused): a change a Review agent
  # left in the project's tracked files, or a commit it made, fails the check; a probe it restores leaves none
  local touched; touched="$(_review_code compare)"
  if [[ "$touched" == "NONE" ]]; then
    :
  elif [[ -z "$touched" ]]; then
    reqs+=("$(_req "no code changed at Review" 1 "no tracked file of the project changed while Review ran")")
  else
    reqs+=("$(_req "no code changed at Review" 0 "Review changed $touched; Review writes no code: loop back to Build, where the fix pass tests a fix first")")
    all_pass=0
  fi
  local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

gate_check() {
  local spec_path="$1"
  local threshold; threshold="$(_cfg_get check.coverage-threshold 80)"
  local reqs=() all_pass=1
  # A test run: a passing row that names tests and is no scenario's trace (a scenario row names its test too, and is
  # what the scenarios row below reads)
  # Each test command counts by its latest run: a failing integration run beside a passing unit run is a failure.
  local tests_n tests_red; tests_n="$(python3 -I -c "
import json, re, sys
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    rows = []
runs = [r for r in rows if isinstance(r, dict) and not r.get('scenario') and isinstance(r.get('exit_code'), int)
        and re.search('test', r.get('claim') or '', re.I)]
last = {}
for r in runs:
    last[' '.join(str(r.get('claim')).lower().split())] = r
red = [k for k, r in last.items() if r.get('exit_code') != 0]
print('%d|%s' % (sum(1 for r in runs if r.get('exit_code') == 0), '; '.join(red)[:300]))" "$(_evidence_file check)" 2>/dev/null || echo 0)"
  tests_red="${tests_n#*|}"; tests_n="${tests_n%%|*}"; [[ "$tests_red" == "$tests_n" ]] && tests_red=""
  if [[ -n "$tests_red" ]]; then
    reqs+=("$(_req "tests pass" 0 "the latest run of a test command failed: $tests_red")")
    all_pass=0
  elif [[ "$tests_n" -gt 0 ]]; then
    reqs+=("$(_req "tests pass" 1 "$tests_n green test run(s) recorded")")
  else
    reqs+=("$(_req "tests pass" 0 "no passing test-run evidence recorded")")
    all_pass=0
  fi
  if [[ -f "$spec_path/intent.md" ]]; then
    local scenario_total scenario_covered
    scenario_total=$(_count_lines_matching '^[[:space:]]*Scenario:' "$spec_path/intent.md")
    scenario_covered=$(_ev_scenarios_covered check)
    if [[ "$scenario_total" -eq 0 ]]; then
      : # no scenarios in intent.md (e.g. no spec for this run) — nothing to require
    elif [[ "$scenario_covered" -ge "$scenario_total" ]]; then
      reqs+=("$(_req "scenarios traced to tests" 1 "$scenario_covered/$scenario_total scenario(s) covered")")
    else
      # Join with ' | ', not ',' — a scenario name may itself contain a comma, which
      # would make a comma-joined list ambiguous about where one name ends. IFS-based
      # array joining ("${arr[*]}") only honors IFS's FIRST character, not the whole
      # string, so a real multi-char separator needs an explicit loop.
      local missing_raw missing_arr missing="" name
      missing_raw="$(_intent_uncovered_scenarios "$spec_path/intent.md" check)"
      IFS=$'\x1f' read -r -a missing_arr <<< "$missing_raw"
      for name in "${missing_arr[@]}"; do
        [[ -n "$missing" ]] && missing+=" | "
        missing+="$name"
      done
      reqs+=("$(_req "scenarios traced to tests" 0 "$scenario_covered/$scenario_total covered — missing: $missing")")
      all_pass=0
    fi
  fi
  local cov_val; cov_val=$(_ev_last_value check coverage)
  # Both values cross as argv, never as Python source: the threshold comes from the
  # project config and the value from the ledger. A value that is not a number FAILs.
  if [[ -n "$cov_val" ]] && python3 -I -c "import sys; sys.exit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)" "$cov_val" "$threshold" 2>/dev/null; then
    reqs+=("$(_req "coverage >= threshold" 1 "$cov_val% >= $threshold% threshold")")
  else
    reqs+=("$(_req "coverage >= threshold" 0 "recorded coverage '${cov_val:-none}' vs threshold $threshold%")")
    all_pass=0
  fi
  if [[ -f "$spec_path/intent.md" ]]; then
    # Every criterion has explicit, SUPPORTED passing evidence — the same checker
    # gate plan used on the artifact's internal links, now against the ledger.
    local acc_out acc_rc
    acc_out="$(python3 "$ACCEPTANCE_PY" check "$spec_path/intent.md" "$(_evidence_file check)" 2>&1)"; acc_rc=$?
    if [[ "$acc_rc" -eq 0 ]]; then
      reqs+=("$(_req "acceptance evidence" 1 "$acc_out")")
    else
      reqs+=("$(_req "acceptance evidence" 0 "$acc_out")")
      all_pass=0
    fi
  fi
  local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

_stage_satisfied() { # _stage_satisfied <stage> -> 0 when gates.json says PASS or a human
                     # override covers the stage (the same standard the full loop applies)
  local verdict; verdict="$(_json_get_path "$GATES_FILE" "$1.verdict" "MISSING")"
  [[ "$verdict" == "PASS" ]] && return 0
  python3 -I -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = []
sys.exit(0 if any(o.get('stage') == sys.argv[2] for o in d) else 1)
" "$OVERRIDES_FILE" "$1" 2>/dev/null
}

_project_names() { # stdin: file names from the top of the repository (git diff, git status); stdout: each from the project folder
  python3 -I -c "
import os, subprocess, sys
top = subprocess.run(['git', 'rev-parse', '--show-toplevel'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode().strip()
for l in sys.stdin:
    n = l.rstrip('\n')
    if n:
        print(os.path.relpath(os.path.join(top, n)) if top else n)"
}

_glob_touch_match() { # _glob_touch_match <file> <pattern>  (a project pattern from autonomy.park-on-touch)
  # Proper pattern match, not a substring test: a pattern naming the auth folder at any
  # depth matches the `auth` path SEGMENT, never `auth` inside `oauth` or
  # `authenticator`; a star inside a segment (any .sql file in a migrations folder) is
  # honored. file + pattern cross as argv, never source.
  local file="$1" pattern="$2"
  python3 -I - "$file" "$pattern" <<'PY'
import re, sys
target, pat = sys.argv[1].lstrip("./"), sys.argv[2]
out, i, n = [], 0, len(pat)
while i < n:
    if pat[i:i+3] == "**/": out.append("(?:.*/)?"); i += 3
    elif pat[i:i+3] == "/**": out.append("(?:/.*)?"); i += 3
    elif pat[i:i+2] == "**": out.append(".*"); i += 2
    elif pat[i] == "*": out.append("[^/]*"); i += 1
    elif pat[i] == "?": out.append("[^/]"); i += 1
    else: out.append(re.escape(pat[i])); i += 1
sys.exit(0 if re.match("^" + "".join(out) + "$", target) else 1)
PY
}

gate_commit() {
  local reqs=() all_pass=1
  local run_mode; run_mode="$(cmd_state_get run_mode interactive)"

  # Artifact-only carve-out: a commit whose ENTIRE staged set lives under
  # .temper/specs/ is the committed-artifact chain doing its job — capturing an
  # intent draft, accepting a plan at its gate — and blocking it until build/review/
  # check have verdicts would make mid-run artifact commits impossible. Code commits
  # are untouched: one staged file outside .temper/specs/ and every gate below applies.
  local staged_all staged_specs
  # --no-renames: a file moved into the spec folder is a deletion where it was too, and that is no artifact
  staged_all=$(git -C "$REPO_ROOT" diff --cached --name-only --no-renames 2>/dev/null | grep -c .)
  # --relative names each staged file from the project folder (and leaves out one outside it), so a project below the
  # top of its repository has its spec folder at .temper/specs/ too
  staged_specs=$(git -C "$REPO_ROOT" diff --cached --name-only --no-renames --relative 2>/dev/null | grep -c '^\.temper/specs/')
  if [[ "${staged_all:-0}" -gt 0 && "$staged_all" -eq "${staged_specs:-0}" ]]; then
    reqs+=("$(_req "artifact-only commit" 1 "$staged_all staged file(s), all under .temper/specs/ — the artifact chain passes the fence; code commits still need every gate")")
    local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
    echo "$reqs_json" 1
    return
  fi

  # Degrade open with no active run: the docs say it, the trivial path relies on
  # it, and the pre-commit hook runs this gate on EVERY commit — demanding stage
  # verdicts from a repo that simply has a .temper/ directory blocked every
  # out-of-run commit.
  if [[ ! -f "$STATE_FILE" ]]; then
    reqs+=("$(_req "active run" 1 "no active run — nothing to gate")")
    local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
    echo "$reqs_json" 1
    return
  fi

  # Build-checkpoint carve-out (docs/decisions/0009): a per-task checkpoint
  # commit lands while next_stage is still build, when the full commit gate
  # would demand review/check verdicts that cannot exist yet. Only when the run
  # is a temper run on its own branch with every upstream gate Build owes
  # satisfied, and the last build test run is GREEN. The final completion commit
  # still faces every gate (next_stage has moved on by then).
  local ck_command ck_next ck_branch cur_branch
  ck_command="$(cmd_state_get command temper)"
  ck_next="$(cmd_state_get next_stage "")"
  ck_branch="$(cmd_state_get branch "")"
  cur_branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
  if [[ "$ck_next" == "build" && "$ck_command" == "temper" && -n "$ck_branch" \
        && "$cur_branch" == "$ck_branch" ]]; then
    local upstream_ok=true sp
    sp="$(cmd_state_get spec_path "")"
    _stage_satisfied plan || upstream_ok=false
    if [[ -n "$sp" && -f "$sp/intent.md" ]]; then _stage_satisfied intent || upstream_ok=false; fi
    if [[ -n "$sp" && -f "$sp/design.md" ]]; then _stage_satisfied design || upstream_ok=false; fi
    if [[ "$upstream_ok" == "true" ]]; then
      local last_green; last_green="$(python3 -I - "$(_evidence_file build)" <<'PY'
import json, sys
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    rows = []
hits = [r for r in rows if r.get('phase') == 'green' and 'test' in (r.get('claim') or '').lower()]
if hits:
    print('%s|%s' % (hits[-1].get('exit_code'), hits[-1].get('claim') or ''))
PY
)"
      if [[ -n "$last_green" && "${last_green%%|*}" == "0" ]]; then
        reqs+=("$(_req "build checkpoint commit" 1 "per-task checkpoint on $cur_branch; last GREEN test run: ${last_green#*|}")")
        local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
        echo "$reqs_json" 1
        return
      fi
      if [[ -n "$last_green" && "${last_green%%|*}" != "0" ]]; then
        reqs+=("$(_req "build checkpoint commit" 0 "last test run is RED (exit ${last_green%%|*}): ${last_green#*|}")")
        local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
        echo "$reqs_json" 0
        return 1
      fi
      # no test rows yet — fall through to the full commit gate
    fi
  fi

  # /temper:fix has no plan stage — RCA and Fix aren't gated through 'plan', so requiring
  # that verdict would permanently FAIL every fix commit (never computed). A stale "eval"
  # key from a pre-upgrade .temper/gates.json is simply never visited: this loop only
  # ever iterates stages_to_check below, which no longer names eval.
  local command stages_to_check
  command="$(cmd_state_get command temper)"
  if [[ "$command" == "fix" ]]; then
    stages_to_check="build review check"
  else
    stages_to_check="plan build review check"
    # Intent and design are artifact-conditional: each stage's gate must have run
    # (any verdict) exactly when its artifact exists. An intent nobody gated, or an
    # unflagged design.md, must not slide through the commit gate — while a trivial
    # run that produced neither artifact owes neither verdict.
    local spec_path_cond; spec_path_cond="$(cmd_state_get spec_path "")"
    if [[ -n "$spec_path_cond" ]]; then
      [[ -f "$spec_path_cond/intent.md" ]] && stages_to_check="intent $stages_to_check"
      [[ -f "$spec_path_cond/design.md" ]] && stages_to_check="${stages_to_check/plan build/plan design build}"
    fi
  fi
  for s in $stages_to_check; do
    local verdict; verdict="$(_json_get_path "$GATES_FILE" "$s.verdict" "MISSING")"
    if [[ "$verdict" == "PASS" ]]; then
      reqs+=("$(_req "$s gate" 1 "PASS")")
      continue
    fi
    local override; override="$(python3 -I -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = []
print('yes' if any(o.get('stage') == sys.argv[2] for o in d) else 'no')
" "$OVERRIDES_FILE" "$s" 2>/dev/null || echo no)"
    if [[ "$override" == "yes" ]]; then
      reqs+=("$(_req "$s gate" 1 "$verdict, overridden by human")")
    else
      reqs+=("$(_req "$s gate" 0 "$verdict, no override recorded")")
      all_pass=0
    fi
  done
  if [[ "$run_mode" == "autonomous" ]]; then
    local max_blast; max_blast="$(_cfg_get autonomy.max-blast-radius 15)"
    # Checkpoint commits land before Review/Check run, so a plain status diff
    # returns nothing. When the run recorded a base_sha, the changed set is
    # base_sha..HEAD plus still-uncommitted paths; without one, the working tree.
    local base_sha changed_n
    base_sha="$(cmd_state_get base_sha "")"
    if [[ -n "$base_sha" ]] && git -C "$REPO_ROOT" cat-file -e "$base_sha" 2>/dev/null; then
      changed_n=$( { git -C "$REPO_ROOT" diff --name-only "$base_sha" 2>/dev/null
                     git -C "$REPO_ROOT" status --porcelain 2>/dev/null | awk '{print $NF}'
                   } | sort -u | grep -c . )
    else
      changed_n=$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    fi
    if [[ -f "$(_spec_path "")/tasks.md" ]]; then
      # D-01: in grouped mode a group may legitimately exceed the count, so the row compares the
      # changed set (base_sha-relative plus uncommitted) with the union of declared files instead.
      local gspec; gspec="$(_spec_path "")"
      local gverdict
      gverdict="$( { if [[ -n "$base_sha" ]] && git -C "$REPO_ROOT" cat-file -e "$base_sha" 2>/dev/null; then
                       git -C "$REPO_ROOT" diff --name-only --no-renames "$base_sha" 2>/dev/null; fi
                     git -C "$REPO_ROOT" -c status.renames=false status --porcelain --untracked-files=all 2>/dev/null | cut -c4- | sed 's/.* -> //; s/^"//; s/"$//'
                   } | _project_names | sort -u | python3 -I -c "
import json, sys
plan = json.loads(sys.argv[1]); spec = sys.argv[2].rstrip('/')
declared = sorted({f for t in plan['tasks'] for f in t['files']})
def ok(p):
    if spec and (p == spec or p.startswith(spec + '/')): return True
    if p.startswith('.temper/') or p.startswith('.claude/worktrees/'): return True   # run state the CLI owns
    return any(p == d for d in declared)   # H4: exact paths
changed = [l.strip() for l in sys.stdin if l.strip()]
bad = [c for c in changed if not ok(c)]
if bad: print('FAIL changed outside declared files: ' + ', '.join(bad[:5]))
else: print('PASS %d changed, all declared' % len(changed))
" "$(_grouped_parse "$gspec/tasks.md")" "${gspec#"$REPO_ROOT"/}")"
      if [[ "$gverdict" == PASS* ]]; then
        reqs+=("$(_req "blast radius" 1 "${gverdict#PASS }")")
      else
        reqs+=("$(_req "blast radius" 0 "${gverdict#FAIL }")")
        all_pass=0
      fi
    elif [[ "$changed_n" -le "$max_blast" ]]; then
      reqs+=("$(_req "blast radius" 1 "$changed_n file(s) <= $max_blast")")
    else
      reqs+=("$(_req "blast radius" 0 "$changed_n file(s) exceeds autonomy.max-blast-radius=$max_blast")")
      all_pass=0
    fi
    local patterns; patterns="$(_cfg_get autonomy.park-on-touch "")"
    local touched=""
    if [[ -n "$patterns" ]]; then
      local pats=()
      IFS=$'\x1f' read -r -a pats <<< "$patterns"
      while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        for p in "${pats[@]}"; do
          if _glob_touch_match "$f" "$p"; then touched="$f matches $p"; fi
        done
      # The changed set the blast radius row reads: what changed since base_sha (grouped Build commits its work), and
      # what is still uncommitted; a rename by both its names, so a file moved out of a parked path still parks.
      done < <( { if [[ -n "$base_sha" ]] && git -C "$REPO_ROOT" cat-file -e "$base_sha" 2>/dev/null; then
                    git -C "$REPO_ROOT" -c core.quotePath=false diff --name-only --no-renames "$base_sha" 2>/dev/null; fi
                  git -C "$REPO_ROOT" -c core.quotePath=false -c status.renames=false status --porcelain 2>/dev/null | cut -c4- | sed 's/.* -> //'
                } | _project_names | sort -u)
    fi
    if [[ -z "$touched" ]]; then
      reqs+=("$(_req "park-on-touch paths" 1 "no changed file matches a park-on-touch pattern")")
    else
      reqs+=("$(_req "park-on-touch paths" 0 "$touched")")
      all_pass=0
    fi
  fi
  local reqs_json; reqs_json=$(python3 -I -c "import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin]))" <<<"$(printf '%s\n' "${reqs[@]}")")
  echo "$reqs_json" "$all_pass"
}

cmd_gate() {
  _state_migrate_legacy
  local stage="${1:-}"; shift || true
  local spec_path_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in --spec-path) spec_path_override="$2"; shift 2 ;; *) shift ;; esac
  done
  _ensure_dirs
  local ok=false
  for s in $STAGES; do [[ "$stage" == "$s" ]] && ok=true; done
  [[ "$ok" == "true" ]] || { echo "FAIL: usage: temper gate <intent|plan|design|build|review|check|commit>" >&2; return 1; }

  local spec_path; spec_path="$(_spec_path "$spec_path_override")"
  # A verdict of the active run is computed from the run's own spec folder. Another folder's (a draft /temper:intent
  # captures beside the run) is checked and printed, and recorded nowhere: it never stands for the run.
  local record=1 run_spec=""
  [[ -f "$STATE_FILE" ]] && run_spec="$(cmd_state_get spec_path "")"
  if [[ -n "$spec_path_override" && -n "$run_spec" ]] && ! _same_file "$spec_path_override" "$run_spec"; then
    record=0
  fi
  # A run whose state names its spec but lost spec_path was rewritten by something other than this CLI (an agent
  # hand-writing build-state.json); the gates would silently skip every spec-based row, so refuse instead
  if [[ -z "$spec_path" && -f "$STATE_FILE" && -n "$(cmd_state_get spec "")" ]]; then
    echo "FAIL: the run state has no spec_path (build-state.json was written by something other than the temper CLI)" >&2
    echo "      repair it: temper state set spec_path .temper/specs/$(cmd_state_get spec ""), then run the gate again" >&2
    return 1
  fi
  # intent and design treat an ABSENT artifact as a legitimate skip — which makes an
  # EMPTY spec path poisonous for them: with no state and no --spec-path, the gate
  # would test -f "/intent.md", find nothing, and record a vacuous PASS that never
  # looked at the real draft (and would silently pay a stage-marker debt). Refuse to
  # guess: no target => usage error, no verdict written.
  if [[ -z "$spec_path" && ( "$stage" == "intent" || "$stage" == "design" ) ]]; then
    echo "FAIL: no spec path — pass --spec-path <dir> or run 'temper state init' first" >&2
    echo "      (gate $stage treats a missing artifact as a legitimate skip, so it refuses to guess where to look)" >&2
    return 1
  fi
  local out reqs_json all_pass
  case "$stage" in
    intent) out=$(gate_intent "$spec_path") ;;
    plan) out=$(gate_plan "$spec_path") ;;
    design) out=$(gate_design "$spec_path") ;;
    build) out=$(gate_build "$spec_path") ;;
    review) out=$(gate_review) ;;
    check) out=$(gate_check "$spec_path") ;;
    commit) out=$(gate_commit) ;;
  esac
  if [[ -n "${out:-}" ]]; then
    reqs_json="${out% *}"
    all_pass="${out##* }"
  fi

  local verdict="FAIL"
  [[ "$all_pass" == "1" ]] && verdict="PASS"
  if [[ "$record" == "1" ]]; then
    _gate_write_verdict "$stage" "$verdict" "$reqs_json"
    # The walked Build of a door's run passed on the earlier run's ledger: a loop back to Build mends that code (the fix
    # pass), it does not build the plan again.
    if [[ "$stage" == "build" && -z "$(cmd_state_get built_before "")" ]]; then
      case "$(cmd_state_get enter "")" in
        review|check) local bb brc; bb="$(_earlier_build "$spec_path")"; brc=$?
          [[ $brc -ne 1 ]] && _json_set_path "$STATE_FILE" built_before "${bb%%$'\t'*}" '{}' >/dev/null ;;
      esac
    fi
    # Per-criterion status for the live view. Fail open: never changes the verdict.
    _status_write "$spec_path" >/dev/null 2>&1 || true
  fi

  echo "temper gate $stage -> $verdict"
  if [[ "$record" != "1" ]]; then
    echo "  (not recorded: a run of $run_spec is active, and this verdict is of $spec_path_override)"
    # The gate of a standalone /temper:intent ran: the debt its session owes (verify-stage-gate.sh) is paid.
    python3 -I -c "
import json, os, sys
try:
    if json.load(open(sys.argv[1])).get('stage') == sys.argv[2]:
        os.remove(sys.argv[1])
except Exception:
    pass" "$TEMPER_DIR/pending-stage.json" "$stage" 2>/dev/null || true
  fi
  python3 -I -c "
import json, sys
for r in json.loads(sys.argv[1]):
    mark = 'v' if r['pass'] else 'x'
    print(f\"  [{mark}] {r['name']} — {r['detail']}\")
" "$reqs_json"

  [[ "$verdict" == "PASS" ]] && return 0 || return 1
}

# ---------------------------------------------------------------------------
# status — per-criterion pass/open view of intent.md against the evidence ledger,
# written to .temper/status.json after every gate (the mods UI reads it; nothing
# here is a verdict — gates.json owns those).
# ---------------------------------------------------------------------------

_status_write() { # _status_write <spec-path> -> writes .temper/status.json, prints it
  local spec_path="$1" out
  [[ -n "$spec_path" && -f "$spec_path/intent.md" ]] || return 1
  out="$(python3 "$ACCEPTANCE_PY" status "$spec_path/intent.md" "$EVIDENCE_DIR")" || return 1
  printf '%s\n' "$out" > "$STATUS_FILE" || return 1
  printf '%s\n' "$out"
}

cmd_status() { # temper status [--json] [--spec-path P]
  _state_migrate_legacy
  local as_json=false spec_path_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) as_json=true; shift ;;
      --spec-path) spec_path_override="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  _ensure_dirs
  local spec_path; spec_path="$(_spec_path "$spec_path_override")"
  if [[ -z "$spec_path" || ! -f "$spec_path/intent.md" ]]; then
    echo "FAIL: no intent.md to report on — pass --spec-path <dir> or run 'temper state init' first" >&2
    return 1
  fi
  local out
  out="$(python3 "$ACCEPTANCE_PY" status "$spec_path/intent.md" "$EVIDENCE_DIR")" || { echo "FAIL: could not compute criteria status" >&2; return 1; }
  printf '%s\n' "$out" > "$STATUS_FILE" 2>/dev/null || true
  if [[ "$as_json" == "true" ]]; then
    printf '%s\n' "$out"
  else
    python3 -I -c "
import json, sys
for c in json.loads(sys.argv[1])['criteria']:
    ev = '; '.join(c['evidence']) if c['evidence'] else 'no evidence'
    print('  [%s] %s (%s) — %s' % ('v' if c['status'] == 'passed' else ' ', c['id'], c['priority'], ev))
" "$out"
  fi
}

# ---------------------------------------------------------------------------
# override
# ---------------------------------------------------------------------------

cmd_override() {
  local stage="${1:-}"; shift || true
  local reason=""
  while [[ $# -gt 0 ]]; do case "$1" in --reason) reason="$2"; shift 2 ;; *) shift ;; esac; done
  [[ -n "$stage" && -n "$reason" ]] || { echo "FAIL: usage: temper override <stage> --reason \"...\"" >&2; return 1; }
  _ensure_dirs
  [[ -f "$OVERRIDES_FILE" ]] || echo '[]' > "$OVERRIDES_FILE"
  # An override is a human decision — record WHO, not just why. git identity is the
  # best deterministic proxy available here; the confirm-override hook (guardrails pack)
  # additionally puts a human permission prompt between an agent and this command.
  local by name email
  name="$(git config user.name 2>/dev/null || true)"
  email="$(git config user.email 2>/dev/null || true)"
  by="$name"
  [[ -n "$email" ]] && by="${by:+$by }<$email>"
  [[ -n "$by" ]] || by="${USER:-unknown}"
  local entry
  entry=$(python3 -I -c "
import json, sys
print(json.dumps({'stage': sys.argv[1], 'reason': sys.argv[2], 'by': sys.argv[3], 'ts': sys.argv[4]}))
" "$stage" "$reason" "$by" "$(_now)")
  _json_append "$OVERRIDES_FILE" "$entry"
  echo "OK: override recorded for '$stage' by $by: $reason"
}

# ---------------------------------------------------------------------------
# intent accept|complete: the header of the run's intent.md, written by the CLI (ADR 0013).
# accept: **Status:** accepted plus **Accepted-by:** from git config (the person's Continue at the
# Intent gate is the acceptance). complete: **Status:** completed plus **Completed:** today.
# Idempotent: an accepted intent stays as it is.
# ---------------------------------------------------------------------------

cmd_intent() {
  local sub="${1:-}"
  case "$sub" in accept|complete) ;; *) echo "FAIL: usage: temper intent accept|complete" >&2; return 1 ;; esac
  local spec; spec="$(_spec_path "")"
  [[ -n "$spec" && -f "$spec/intent.md" ]] || { echo "FAIL: no intent.md for the active run" >&2; return 1; }
  local who; who="$(git config user.name 2>/dev/null || true)"
  local email; email="$(git config user.email 2>/dev/null || true)"
  [[ -n "$email" ]] && who="${who:+$who }<$email>"
  python3 -I - "$spec/intent.md" "$sub" "${who:-${USER:-unknown}}" "$(date -u +%Y-%m-%d)" <<'PY'
import os, re, sys
path, sub, who, day = sys.argv[1:5]
text = open(path, encoding='utf-8').read()
lines = text.split('\n')
idx = next((i for i, l in enumerate(lines) if re.match(r'^\*\*Status:\*\*', l)), None)
want = 'accepted' if sub == 'accept' else 'completed'
if idx is None:
    lines.insert(0, '**Status:** %s' % want)
    idx = 0
else:
    cur = re.sub(r'^\*\*Status:\*\*\s*', '', lines[idx]).strip().lower()
    if sub == 'accept' and cur in ('accepted', 'completed'):
        print('OK: intent.md is already %s' % cur)
        sys.exit(0)
    lines[idx] = '**Status:** %s' % want
key, value = ('Accepted-by', who) if sub == 'accept' else ('Completed', day)
if not any(re.match(r'^\*\*%s:\*\*' % re.escape(key), l) for l in lines):
    lines.insert(idx + 1, '**%s:** %s' % (key, value))
tmp = '%s.tmp.%d' % (path, os.getpid())
with open(tmp, 'w', encoding='utf-8') as f:
    f.write('\n'.join(lines))
os.replace(tmp, path)
print('OK: intent.md is %s' % want)
PY
}

# temper park --verdict SHIP-PENDING-COMMIT|PARKED-NEEDS-DECISION --reason "...": an armed run stops for the person
# (reference/autonomy.md). It writes .temper/autonomy-report.md, turns the run back to interactive and marks it
# parked, so `temper next` asks the gate it parked at.
cmd_park() {
  local verdict="" reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in --verdict) verdict="${2:-}"; shift 2 ;; --reason) reason="${2:-}"; shift 2 ;; *) shift ;; esac
  done
  case "$verdict" in SHIP-PENDING-COMMIT|PARKED-NEEDS-DECISION) ;; *) echo "FAIL: usage: temper park --verdict SHIP-PENDING-COMMIT|PARKED-NEEDS-DECISION --reason \"...\"" >&2; return 1 ;; esac
  [[ -f "$STATE_FILE" ]] || { echo "FAIL: no active state" >&2; return 1; }
  local stage branch
  stage="$(_json_get_path "$STATE_FILE" next_stage "")"
  branch="$(_json_get_path "$STATE_FILE" branch "")"
  _json_set_path "$STATE_FILE" run_mode interactive '{}' >/dev/null || return 1
  _json_set_path "$STATE_FILE" parked "$stage" '{}' >/dev/null || return 1
  _ensure_dirs
  {
    echo "# Autonomy report"
    echo
    echo "**Verdict:** $verdict"
    echo "**Parked at:** $stage"
    echo "**Reason:** ${reason:-none given}"
    echo "**Branch:** $branch"
    echo
    echo '```'
    cmd_report 2>/dev/null
    echo '```'
    echo
    echo "The run waits for you at the gate it parked at."
  } > "$TEMPER_DIR/autonomy-report.md"
  echo "OK: parked at $stage ($verdict); the report is in .temper/autonomy-report.md"
}

# The setup a project still lacks, as the calls that make it (each is idempotent): the config, the .temper
# scaffold, and the commit gate, which is in place when git's pre-commit hook is the kept Temper hook
# (temper-gate/pre-commit in the git folder), names this plugin's CLI, and is of this version (it gates every
# project the commit touches, reading a rename by both its names, and runs its Python isolated from the project's
# files). Prints one call per line.
_setup_calls() {
  [[ -f "$CONFIG_FILE" ]] || echo "mkdir -p .claude && cp $PLUGIN_ROOT/templates/temper.config.default .claude/temper.config"
  # the scaffold, and the run files kept out of git status (a run's end removes gates.json, so that file is no sign)
  { [[ -d "$TEMPER_DIR" ]] && _excludes_current; } || echo "$PLUGIN_ROOT/scripts/temper init"
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  local hdir hook; hdir="$(git rev-parse --git-path hooks 2>/dev/null)"; hook="$hdir/pre-commit"
  if [[ "$hook" != */temper-gate/pre-commit || ! -f "$hook" ]] \
     || [[ "$(sed -n 2p "$hook" 2>/dev/null)" != "# Temper native pre-commit hook"* ]] \
     || ! grep -qF "$PLUGIN_ROOT/scripts/temper" "$hook" 2>/dev/null \
     || ! grep -qF '"--cached", "--name-only", "--no-renames"' "$hook" 2>/dev/null \
     || ! grep -qF 'python3 -I ' "$hook" 2>/dev/null; then
    echo "bash $PLUGIN_ROOT/scripts/guards/install.sh"
  fi
}

# temper next [--json]: the next action of the run, computed (ADR 0013, docs/flow.md). Read only. flow.py reads the
# project's facts itself (the branch, HEAD, the spec folder's state, the changed files); the CLI adds the models and the
# setup calls, which only it knows.
cmd_next() {
  _state_migrate_legacy
  local models; models="$(cmd_model --all 2>/dev/null)"
  local setup; setup="$(_setup_calls)"
  local ctx
  ctx="$(python3 -I -c "
import json, sys
a = sys.argv[1:]
models = dict(l.split('=', 1) for l in a[3].splitlines() if '=' in l)
print(json.dumps({'plugin': a[0], 'cli': a[1], 'config_file': a[2], 'models': models,
                  'task_model': models.get('task', ''), 'escalation_model': models.get('task-escalation', ''),
                  'now': a[4], 'setup': [l for l in a[5].splitlines() if l.strip()]}))
" "$PLUGIN_ROOT" "$PLUGIN_ROOT/scripts/temper" "$CONFIG_FILE" "$models" "$(_now)" "$setup")" || return 1
  python3 "$SCRIPTS_DIR/flow.py" next --ctx "$ctx"
}

# .temper/view.json, the one file the mod reads (ADR 0013): written after every command that may change the run.
# Fail open: a view that cannot be written never changes what the command did.
_view_write() {
  [[ -d "$TEMPER_DIR" && ! -L "$TEMPER_DIR" ]] || return 0
  python3 "$SCRIPTS_DIR/flow.py" view --plugin "$PLUGIN_ROOT" --cli "$PLUGIN_ROOT/scripts/temper" \
    --config-file "$CONFIG_FILE" --now "$(_now)" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# report
# ---------------------------------------------------------------------------

cmd_report() {
  local as_json=false
  [[ "${1:-}" == "--json" ]] && as_json=true
  # The end of run report as one page to share (scripts/run_report.py), from the view as the run stands now. It is
  # written to the spec folder (report.html), so the commit carries it; -o OUT writes elsewhere, -o - prints it.
  if [[ "${1:-}" == "--html" ]]; then
    shift
    _view_write
    python3 "$SCRIPTS_DIR/run_report.py" render --view "$TEMPER_DIR/view.json" --root "$REPO_ROOT" --main "$(_usage_main)" "$@"
    return
  fi
  [[ -f "$GATES_FILE" ]] || echo '{}' > "$GATES_FILE"
  local usage_json; usage_json="$(_usage_json)"
  if [[ "$as_json" == "true" ]]; then
    if [[ -z "$usage_json" ]]; then
      cat "$GATES_FILE"
    else
      # gates.json as it is, plus a "usage" key only when usage rows exist
      python3 -I -c "
import json, sys
d = json.load(open(sys.argv[1]))
d['usage'] = json.loads(sys.argv[2])
print(json.dumps(d, indent=2))" "$GATES_FILE" "$usage_json"
    fi
    return
  fi
  # The two file paths cross as argv, never as Python source: the project path may hold a quote.
  python3 -I -c "
import json, sys
d = json.load(open(sys.argv[1]))
try:
    overrides = json.load(open(sys.argv[2]))
except Exception:
    overrides = []
accepted = [o for o in overrides if str(o.get('stage', '')).startswith('foreign-commit:')]
overridden = {o['stage'] for o in overrides if o not in accepted}
print('Stage    Verdict  Evidence')
print('-------  -------  --------')
for stage in ['intent', 'plan', 'design', 'build', 'review', 'check', 'commit']:
    g = d.get(stage)
    if not g:
        continue
    tag = g['verdict'] + (' (overridden)' if stage in overridden and g['verdict'] == 'FAIL' else '')
    print(f\"{stage:<8} {tag}\")
    for r in g.get('requirements', []):
        mark = 'v' if r['pass'] else 'x'
        print(f\"           [{mark}] {r['name']} — {r['detail']}\")
if overridden:
    print()
    print(f'{len(overridden)} gate(s) overridden by a human — see .temper/overrides.json')
if accepted:
    print()
    print('Agent commits kept by a human (group reopen --accept-foreign):')
    for o in accepted:
        _, grp, sha = (str(o['stage']).split(':', 2) + ['', ''])[:3]
        print('  %s in group %s, by %s: %s' % (sha[:7], grp, o.get('by', '?'), o.get('reason', '')))
" "$GATES_FILE" "$OVERRIDES_FILE"
  [[ -z "$usage_json" ]] || python3 -I -c "
import json, sys
u = json.loads(sys.argv[1])
m = json.loads(sys.argv[2]) if sys.argv[2] else None
def n(v): return '-' if v is None else str(v)
def tk(v): return '-' if v is None else format(v, ',')
def usd(v): return '-' if v is None else '\$%.2f' % v if v >= 0.995 else '\$%.4f' % v
seq = ['intent', 'rca', 'plan', 'design', 'build', 'task', 'fix', 'review', 'check']
in_run = lambda kv: (seq.index(kv[0]) if kv[0] in seq else len(seq), kv[0])
print()
print('Usage and estimated cost (tokens as billed, from each agent transcript; cost at the API list prices of %s)' % sys.argv[3])
w = max([10] + [len(k) for k in list(u['by_stage']) + list(u['by_model'])])   # a full model id is wider than a stage
print('  %-*s %6s %12s %12s %10s  %s' % (w, 'stage', 'rows', 'tokens', 'ms', 'cost', 'model'))
for k, v in sorted(u['by_stage'].items(), key=in_run):
    print('  %-*s %6d %12s %12s %10s  %s' % (w, k, v['rows'], tk(v['tokens']), n(v['ms']), usd(v.get('cost')), ', '.join(v.get('models') or []) or '-'))
print('  %-*s %6s %12s %12s %10s' % (w, 'model', 'rows', 'tokens', 'ms', 'cost'))
for k, v in u['by_model'].items():
    print('  %-*s %6d %12s %12s %10s' % (w, k, v['rows'], tk(v['tokens']), n(v['ms']), usd(v.get('cost'))))
t = u['total']
print('  %-*s %6d %12s %12s %10s' % (w, 'total', t['rows'], tk(t['tokens']), n(t['ms']), usd(t.get('cost'))))
if m:
    print('  main conversation since the run started: %s tokens in %d call(s), %s' % (tk(m['tokens']), m['calls'], usd(m['cost'] if not m['unpriced'] else None)))
    if t.get('cost') is not None and not m['unpriced']:
        print('  run total, the agents and the main conversation: %s' % usd(t['cost'] + m['cost']))
if t.get('unpriced'):
    print('  %d launch(es) have no cost: no transcript was found (the tokens are then the total Claude Code gave, the context' % t['unpriced'])
    print('  at the end), or a model they ran on has no price here.')
if t.get('output_estimated'):
    print('  An agent transcript records each reply before it streams: its output is taken from the reply text, and its')
    print('  thinking, billed as output, is not counted, so the cost of the agents can be low.')
print('  A Claude plan is not billed per token: this is what the run costs at API list prices.')" "$usage_json" "$(_usage_main)" "$(python3 -I "$SCRIPTS_DIR/usage_cost.py" prices 2>/dev/null)"
}

# Whole-flow usage (9.7.0, intent D-07). .temper/usage.json is a CLI-owned array of rows
# {stage, model, tokens, ms, task, group, ts}; a value that was not given is null. The grouped
# `task gate --tokens --ms` writes its row here too, and `group report` keeps reading groups.json
# attempts, so the two views never meet in one total: the usage totals count each launch once.
_usage_append() { # _usage_append <stage> <model> <tokens> <ms> <task> <group> [<the agent's transcript summary>]
  local row
  row="$(python3 -I -c "
import json, sys
a = sys.argv[1:]
def num(x): return int(x) if x.isdigit() else None
row = {'stage': a[0], 'model': a[1] or None, 'tokens': num(a[2]), 'ms': num(a[3]),
       'task': num(a[4]), 'group': a[5] or None, 'ts': a[6], 'source': 'notice' if num(a[2]) else 'none'}
try:
    s = json.loads(a[7]) if a[7] else None
except ValueError:
    s = None
if isinstance(s, dict) and s.get('calls'):
    # What the agent was billed for, from its own transcript; the time the notice gave, else the transcript's span.
    row.update({'tokens': s['tokens'], 'ms': num(a[3]) if num(a[3]) else s.get('ms'), 'source': 'transcript',
                'cost': s.get('cost') if not s.get('unpriced') else None, 'unpriced': s.get('unpriced') or [],
                'calls': s['calls'], 'served': s.get('served') or [], 'agent': s.get('agent'), 'session': s.get('session'),
                'parts': {k: s.get(k) for k in ('input', 'cache_write', 'cache_read', 'output')},
                'output_estimated': bool(s.get('output_estimated'))})
print(json.dumps(row))" "$1" "$2" "$3" "$4" "$5" "$6" "$(_now)" "${7:-}")" || return 1
  _ensure_dirs
  _json_append "$USAGE_FILE" "$row"
}

# _usage_from <agent> <tokens>: the summary of the agent's own transcript (one JSON line) when Claude Code's transcript of
# it is found. An agent named with no transcript and no total from Claude Code is one call too early (an agent run in the
# background sends its report before its completion notice, which carries the numbers): refused, nothing recorded.
_usage_from() {
  local agent="$1" tokens="$2"
  [[ -n "$agent" ]] || return 0
  python3 -I "$SCRIPTS_DIR/usage_cost.py" agent "$agent" 2>/dev/null && return 0
  [[ "$tokens" =~ ^[1-9][0-9]*$ || "$tokens" == "none" ]] && return 0
  echo "FAIL: no usage for agent $agent: its transcript was not found and no --tokens was given. The completion notice of an agent run in the background carries subagent_tokens and duration_ms: run this call when it arrives, with them (--tokens none --ms none only when it gave none). Nothing was recorded." >&2
  return 1
}

_usage_json() { # prints the usage summary as one JSON line, or nothing when no row was recorded
  [[ -f "$USAGE_FILE" ]] || return 0
  python3 -I - "$USAGE_FILE" <<'PY'
import json, sys
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    rows = []
rows = [r for r in rows if isinstance(r, dict)] if isinstance(rows, list) else []
if not rows:
    sys.exit(0)
def add(acc, r):
    acc['rows'] += 1
    for k in ('tokens', 'ms'):
        if isinstance(r.get(k), int):
            acc[k] = (acc[k] or 0) + r[k]
    # the cost at list prices of a row read from the agent's transcript; a row from a total has none
    c = r.get('cost')
    if isinstance(c, (int, float)) and not isinstance(c, bool):
        acc['cost'] = round((acc['cost'] or 0) + c, 6)
    else:
        acc['unpriced'] += 1
    acc['output_estimated'] = acc['output_estimated'] or bool(r.get('output_estimated'))
fresh = lambda: {'rows': 0, 'tokens': None, 'ms': None, 'cost': None, 'unpriced': 0, 'output_estimated': False}
by_stage, by_model, total = {}, {}, fresh()
for r in rows:
    st = by_stage.setdefault(r.get('stage') or 'unknown', fresh())
    add(st, r)
    # the models a stage's rows name (what the orchestrator launched it on)
    if r.get('model') and r.get('model') not in st.setdefault('models', []):
        st['models'].append(r.get('model'))
    add(by_model.setdefault(r.get('model') or 'unknown', fresh()), r)
    add(total, r)
print(json.dumps({'by_stage': by_stage, 'by_model': by_model, 'total': total}, sort_keys=True))
PY
}

# _usage_main: the main conversation's own calls since the run started, as one JSON line (nothing when none is known),
# from the session transcripts the run's agents were found in: the agents' transcripts sit below their session's.
_usage_main() {
  [[ -f "$USAGE_FILE" && -f "$STATE_FILE" ]] || return 0
  local since; since="$(_json_get_path "$STATE_FILE" started "")"
  [[ -n "$since" ]] || return 0
  python3 -I "$SCRIPTS_DIR/usage_cost.py" run "$USAGE_FILE" "$since" 2>/dev/null || true
}

cmd_usage() { # temper usage add --stage S [--model M] [--agent ID] [--tokens T] [--ms D] [--task N] [--group G]
  local sub="${1:-}"; shift || true
  if [[ "$sub" != "add" ]]; then
    echo "FAIL: usage: temper usage add --stage <intent|plan|design|build|review|check|rca|fix|task> [--model M] [--agent ID] [--tokens T] [--ms D] [--task N] [--group G]" >&2
    return 1
  fi
  local stage="" model="" tokens="" ms="" task="" group="" agent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage) stage="${2:-}"; shift 2 || true ;;
      --model) model="${2:-}"; shift 2 || true ;;
      --tokens) tokens="${2:-}"; shift 2 || true ;;
      --ms) ms="${2:-}"; shift 2 || true ;;
      --task) task="${2:-}"; shift 2 || true ;;
      --group) group="${2:-}"; shift 2 || true ;;
      --agent) agent="${2:-}"; shift 2 || true ;;
      *) echo "FAIL: unknown flag $1" >&2; return 1 ;;
    esac
  done
  case " $AGENT_STAGES task " in
    *" $stage "*) [[ -n "$stage" ]] || { echo "FAIL: --stage is required" >&2; return 1; } ;;
    *) echo "FAIL: --stage must be one of: $AGENT_STAGES task (got '$stage')" >&2; return 1 ;;
  esac
  local v
  for v in "$tokens" "$ms"; do
    [[ -z "$v" || "$v" == "none" || "$v" =~ ^[0-9]+$ ]] || { echo "FAIL: --tokens and --ms take whole numbers, or none (got '$v')" >&2; return 1; }
  done
  [[ -z "$task" || "$task" =~ ^[0-9]+$ ]] || { echo "FAIL: --task takes a whole number (got '$task')" >&2; return 1; }
  [[ -z "$group" || "$group" =~ ^G[0-9]+$ ]] || { echo "FAIL: --group takes G<n> (got '$group')" >&2; return 1; }
  local from; from="$(_usage_from "$agent" "$tokens")" || return 1
  _usage_append "$stage" "$model" "$tokens" "$ms" "$task" "$group" "$from" || return 1
  echo "OK: usage recorded ($stage${from:+, from the transcript of the agent})"
}

# ---------------------------------------------------------------------------
# metrics — deterministic metric ingestion for the bands monitor.
#
# `temper metrics append <series> <value>` appends one numeric point to
# <series>_history in .temper/metrics.json (creating file and array as needed) —
# the same CLI-owned bookkeeping discipline as `temper evidence add`, so the
# bands monitor reads a ledger the spine wrote, not prose-maintained state. Any
# appended series is band-able by name (`bands.metrics: [coverage, my_series]`).
# External sources (CI failure rate, post-deploy 5xx) enter the loop the same
# way: a pipeline step calls append, the scheduled bands check does the rest.
# ---------------------------------------------------------------------------

cmd_metrics() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    append)
      local series="${1:-}" value="${2:-}"
      [[ -n "$series" && -n "$value" ]] || { echo "FAIL: usage: temper metrics append <series> <value>" >&2; return 1; }
      [[ "$series" =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "FAIL: series must match [a-z][a-z0-9_-]* (got '$series')" >&2; return 1; }
      _ensure_dirs
      [[ -f "$METRICS_FILE" ]] || echo '{}' > "$METRICS_FILE"
      # value crosses the boundary as an argv element and is parsed by float() INSIDE
      # python — never interpolated into source (a metric value can be attacker-influenced:
      # a CI failure rate, a 5xx count fed from a pipeline step). A non-numeric value is a
      # clean exit 1, not code that runs.
      local out rc
      out=$(python3 -I - "$METRICS_FILE" "$series" "$value" <<'PY'
import json, sys
path, series, value = sys.argv[1:4]
try:
    v = float(value)
except ValueError:
    sys.stderr.write(f"FAIL: value must be numeric (got '{value}')\n")
    sys.exit(1)
try:
    d = json.load(open(path))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
# Same alias map `temper bands` uses (kept in sync): appending the friendly name
# `tests` must land in the SAME array bands reads for it (test_count_history), or a
# recorded point would never be banded. Any other name -> <name>_history.
ALIASES = {'coverage': 'coverage_history', 'tests': 'test_count_history'}
key = ALIASES.get(series) or (series if series.endswith('_history') else f"{series}_history")
arr = d.get(key)
if not isinstance(arr, list):
    arr = []
arr.append(int(v) if v.is_integer() else v)
d[key] = arr
with open(path, 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\n')
print(f"OK: {key} += {value} ({len(arr)} point(s))")
PY
)
      rc=$?
      echo "$out"
      return $rc
      ;;
    *) echo "FAIL: usage: temper metrics append <series> <value>" >&2; return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# bands — closing the loop (deterministic drift detection, no model).
#
# Watches the history arrays in .temper/metrics.json against control bands
# (rolling mean ± k·sigma over a window, plus a same-side-run drift rule).
# Detection is entirely deterministic — this subcommand never invokes a model,
# reads the network, or edits code. What a breach *triggers* is tiered in
# config (`bands:` in .claude/temper.config — log / diagnose / propose) and
# always lands in the normal pipeline: /temper:status renders the verdict, and
# a `propose`-tier breach is drafted into a `.temper/specs/<slug>/intent.md`
# for /temper to run — through every ordinary gate, never around them.
#
# Verdict: OK (nothing at 2sigma+), BREACH (>=1 metric at 2sigma+, exit 1),
# INSUFFICIENT-DATA (no metric has enough recorded points yet). A flat
# baseline (sigma = 0) treats any deviation as 3sigma — a perfectly stable
# series moving at all is out of band by definition. History points may be
# bare numbers or objects carrying a numeric `value`/`coverage`/`count`/`pct`.
# ---------------------------------------------------------------------------

cmd_bands() {
  _ensure_dirs
  local as_json=false
  [[ "${1:-}" == "--json" ]] && as_json=true
  local window min_points drift_run metrics t1 t2 t3
  window="$(_cfg_get bands.window 10)"
  min_points="$(_cfg_get bands.min-points 4)"
  drift_run="$(_cfg_get bands.drift-run 6)"
  metrics="$(_cfg_get bands.metrics "")"
  [[ -n "$metrics" ]] || metrics="coverage"$'\x1f'"tests"
  t1="$(_cfg_get bands.tiers.1sigma log)"
  t2="$(_cfg_get bands.tiers.2sigma diagnose)"
  t3="$(_cfg_get bands.tiers.3sigma propose)"
  local out rc
  out=$(python3 -I - "$METRICS_FILE" "$BANDS_FILE" "$window" "$min_points" "$drift_run" "$metrics" "$t1" "$t2" "$t3" "$(_now)" <<'PY'
import json, math, sys
metrics_path, out_path, window, min_points, drift_run, metrics_sep, t1, t2, t3, ts = sys.argv[1:11]
# Clamp config to sane floors, never crash on it (spine degradation contract): a
# non-integer or out-of-range window/min-points/drift-run falls back to its default
# rather than raising. window>=2 and min-points>=2 keep the baseline slice and the
# variance non-empty; drift-run>=2 keeps the run rule meaningful.
def _cfg_int(raw, default, floor):
    try:
        n = int(float(raw))
    except (ValueError, TypeError):
        return default
    return n if n >= floor else floor
window = _cfg_int(window, 10, 2)
min_points = _cfg_int(min_points, 4, 2)
drift_run = _cfg_int(drift_run, 6, 2)
# Two friendly aliases; beyond them, ANY <name>_history array in metrics.json is
# band-able by name — `temper metrics append <name> <value>` is how a series
# (including external ones: CI failure rate, 5xx counts) gets points.
ALIASES = {'coverage': 'coverage_history', 'tests': 'test_count_history'}
try:
    m = json.load(open(metrics_path))
    if not isinstance(m, dict):
        m = {}
except Exception:
    m = {}   # malformed metrics == absent; never a crash, never a breach (spine contract)

def numeric(v):
    if isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, dict):
        for k in ('value', 'coverage', 'count', 'pct'):
            if isinstance(v.get(k), (int, float)) and not isinstance(v.get(k), bool):
                return float(v[k])
    return None

tier_names = {0: 'ok', 1: '1sigma', 2: '2sigma', 3: '3sigma'}
actions = {'1sigma': t1, '2sigma': t2, '3sigma': t3}
results, lines, worst, any_data = {}, [], 0, False
for name in [s for s in metrics_sep.split('\x1f') if s]:
    key = ALIASES.get(name)
    if key is None:
        candidate = name if name.endswith('_history') else f"{name}_history"
        if isinstance(m.get(candidate), list):
            key = candidate
    if key is None:
        known = sorted(set(ALIASES) | {k[:-len('_history')] for k in m if k.endswith('_history') and isinstance(m.get(k), list)})
        lines.append(f"  [--] {name} — unknown metric (known: {', '.join(known)}); skipped")
        results[name] = {'tier': 'unknown-metric'}
        continue
    raw = m.get(key, [])
    series = [x for x in (numeric(v) for v in (raw if isinstance(raw, list) else [])) if x is not None]
    if len(series) < min_points:
        lines.append(f"  [--] {name} — insufficient data ({len(series)} point(s) recorded, need {min_points})")
        results[name] = {'tier': 'insufficient-data', 'points': len(series)}
        continue
    any_data = True
    latest = series[-1]
    base = series[max(0, len(series) - 1 - window):-1]
    mean = sum(base) / len(base)
    sigma = math.sqrt(sum((x - mean) ** 2 for x in base) / len(base))
    if sigma == 0:
        z = 0.0 if latest == mean else (3.0 if latest > mean else -3.0)
    else:
        z = (latest - mean) / sigma
    level = 3 if abs(z) >= 3 else 2 if abs(z) >= 2 else 1 if abs(z) >= 1 else 0
    run = series[-drift_run:]
    drift = len(run) >= drift_run and (all(p > mean for p in run) or all(p < mean for p in run))
    if drift and level < 2:
        level = 2
    tier = tier_names[level]
    action = actions.get(tier)
    worst = max(worst, level)
    line = (f"  [{tier if level else 'ok'}] {name} — latest {latest:g} vs baseline "
            f"{mean:.2f} ±{sigma:.2f} (z={z:+.2f}, window {len(base)})")
    if drift:
        line += f" [drift: {drift_run} consecutive same-side point(s)]"
    if level >= 1:
        line += f": action={action}"
    lines.append(line)
    results[name] = {'latest': latest, 'mean': round(mean, 4), 'sigma': round(sigma, 4),
                     'z': round(z, 4), 'tier': tier, 'drift': drift,
                     'action': action if level >= 1 else None, 'window': len(base)}
verdict = 'BREACH' if worst >= 2 else ('OK' if any_data else 'INSUFFICIENT-DATA')
with open(out_path, 'w') as f:
    json.dump({'verdict': verdict, 'metrics': results, 'ts': ts}, f, indent=2)
    f.write('\n')
print(f"temper bands -> {verdict}")
for l in lines:
    print(l)
if worst >= 2:
    print("A 2sigma+ breach is a closing-the-loop trigger: /temper:status renders it; a "
          "propose-tier breach is drafted as .temper/specs/<slug>/intent.md for /temper to run.")
sys.exit(1 if worst >= 2 else 0)
PY
)
  rc=$?
  if [[ "$as_json" == "true" ]]; then
    cat "$BANDS_FILE" 2>/dev/null || echo '{}'
  else
    echo "$out"
  fi
  return $rc
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

main() {
  _require_python
  local sub="${1:-}"; shift || true
  # Every subcommand that reads or writes the project's .temper folder is refused in a
  # folder inside the plugin folder, and in the plugin folder itself unless it is its own
  # git repository (developing Temper). `config` and `model` only read a config file and the
  # stage briefs, and the help text reads nothing, so the guard scripts that call them
  # keep working wherever they run.
  # The home folder is refused first (exit 1): it is never a project. A symlink on a path
  # the CLI writes or reads as run state is refused too (exit 3), for the same reason.
  case "$sub" in
    config|model|""|-h|--help) ;;
    *) _home_refuse || return 1
       _inside_plugin_refuse || return 1
       _unsafe_temper_refuse || return 3
       _config_pin ;;
  esac
  case "$sub" in
    init) cmd_init "$@" ;;
    state) cmd_state "$@" ;;
    evidence) cmd_evidence "$@" ;;
    gate) cmd_gate "$@" ;;
    model) cmd_model "$@" ;;
    override) cmd_override "$@" ;;
    report) cmd_report "$@" ;;
    status) cmd_status "$@" ;;
    bands) cmd_bands "$@" ;;
    metrics) cmd_metrics "$@" ;;
    config) cmd_config "$@" ;;
    schedule) cmd_schedule "$@" ;;
    group) cmd_group "$@" ;;
    task) cmd_task "$@" ;;
    integrate) cmd_integrate "$@" ;;
    usage) cmd_usage "$@" ;;
    next) cmd_next "$@" ;;
    intent) cmd_intent "$@" ;;
    park) cmd_park "$@" ;;
    ""|-h|--help)
      cat <<'EOF'
temper — the deterministic spine of the Temper plugin

Usage:
  temper init [--foreground-agents [status]]
  temper state <init|get|set|advance|loop|archive|clear> ...
  temper evidence <add|run|list|resolve|accept|clear> ...
  temper gate <intent|plan|design|build|review|check|commit> [--spec-path P]
  temper model <intent|plan|design|build|review|check|rca|fix> | --all
  temper override <stage> --reason "..."
  temper report [--json]
  temper status [--json] [--spec-path P]
  temper bands [--json]
  temper metrics append <series> <value>
  temper config get <dot.path> [default]
  temper model task | task-escalation   (grouped Build: the task agent's model and its escalation model)
  temper schedule [--json]        (grouped Build: the launchable tasks, one JSON line each)
  temper group <start|gate|reopen|continue> G<n>  (grouped Build: worktree, group verdict, Change or kept commits, the person's Continue)
  temper group report [--json]    (grouped Build: the measurement report)
  temper task <start|show|test|gate> N  (grouped Build: one task's lifecycle)
  temper integrate                (grouped Build: merge the passed groups, run the suite, check Interfaces)
  temper usage add --stage S [--model M] [--tokens T] [--ms D] [--task N] [--group G]  (whole-flow usage; shown by report)
  temper next [--json]            (what the run does next: a stage to run, a question to ask, or the commit; docs/flow.md)
  temper report --html [-o OUT]   (the end of run report as one page, to report.html in the spec folder)
  temper intent accept|complete   (the Status header of the run's intent.md)
  temper state redo <stage> [--reason R]   (run the stage the run is at again; its verdict goes)
  temper group continue G<n>      (the person's Continue at a group question)
  temper park --verdict V --reason R      (an armed run stops for the person)
EOF
      ;;
    *) echo "FAIL: unknown subcommand '$sub' (temper --help)" >&2; return 1 ;;
  esac
  local rc=$?
  # ADR 0013: every command that may change the run rewrites .temper/view.json
  case "$sub" in
    config|model|""|-h|--help|report|status|bands|metrics|schedule) ;;
    state) [[ "${1:-}" == "get" ]] || _view_write ;;
    evidence) [[ "${1:-}" == "list" ]] || _view_write ;;
    group) [[ "${1:-}" == "report" ]] || _view_write ;;
    task) [[ "${1:-}" == "show" ]] || _view_write ;;
    *) _view_write ;;
  esac
  return $rc
}

main "$@"
