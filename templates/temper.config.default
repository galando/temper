# Temper Configuration (v7)
#
# Everything with exactly one correct output — model routing, gate logic, state
# bookkeeping — lives in scripts/temper now, not here. This file holds only the
# decisions that are actually yours to make. Full reference: docs/getting-started.md

# Stack: auto-detect from project files. Override: spring-boot, react-ts,
# node-express, fastapi, go, rust
stack: auto

# Packs enforced during build/review (see docs/packs.md). Add a project pack under
# .claude/packs/<name>/rules.md and list it here.
packs: [quality, tdd, security, git, performance]

# MCP tool-first analysis: auto (use MCP tools when available, else heuristic) |
# heuristic-only | require. See docs/recommended-setup.md.
tools:
  mode: auto
  # External review engine: open-code-review (ocr CLI). When installed, OCR takes
  # over line-level defect detection in /temper:review. auto | off | require.
  ocr:
    mode: auto

review:
  block-on: [critical]        # severities that fail `temper gate review`

check:
  coverage-threshold: 80      # `temper gate check` requires recorded coverage >= this

# Model per stage. With this block absent (the default), each stage runs on the model
# declared in the plugin's agents/{stage}.md. Uncomment a key to override it — an alias
# (opus, sonnet, haiku) or a full model ID. This is a flat lookup, not the v6 routing
# table that v7 retired: resolution happens in `scripts/temper`, never in a prompt.
# `temper model --all` prints exactly what the orchestrator will launch each stage on.
# models:
#   plan: opus
#   design: opus
#   build: sonnet
#   review: sonnet
#   check: sonnet
#   rca: opus      # /temper:fix stages
#   fix: sonnet

# Standalone stage commands (/temper:plan, :design, :build, :review, :check) execute
# inline in your session by default — full mid-stage interactivity, but the stage's
# working context (reference doc, diff, pack rules) stays in your context window
# afterwards. `true` runs each in the same isolated agents/{stage}.md subprocess the
# unified /temper uses: only the summary box and gate verdict return to your session.
# /temper:intent stays inline either way — it's an interactive capture.
# stages:
#   subprocess: false

# Control bands — closing the loop (`temper bands`). A deterministic check of the
# history arrays in .temper/metrics.json against rolling mean ± k·sigma bands plus a
# same-side-run drift rule. Detection never involves a model; the response to a breach
# is tiered here and lands in the normal pipeline (/temper:status renders the verdict;
# a propose-tier breach is drafted as .temper/specs/<slug>/intent.md for /temper to
# run — through every ordinary gate, never around them). The block absent = these
# defaults; `temper bands` in CI or cron is the trigger layer, never a daemon.
# Any series fed via `temper metrics append <name> <value>` is band-able by name —
# including external ones (CI failure rate, post-deploy 5xx) appended by a pipeline step.
# bands:
#   window: 10            # rolling baseline: the last N points before the latest
#   min-points: 4         # fewer recorded points -> INSUFFICIENT-DATA, never a breach
#   drift-run: 6          # N consecutive same-side points counts as drift (>= 2sigma)
#   metrics: [coverage, tests]
#   tiers:
#     1sigma: log         # in the report only
#     2sigma: diagnose    # read-only diagnosis via /temper:status
#     3sigma: propose     # draft an intent.md into .temper/specs/ for /temper to run

# Edit-time protected paths (hooks pack: block-protected-paths.sh). Same **/segment/**
# shape as autonomy.park-on-touch, but enforced when the agent EDITS, in every mode —
# generated code, frozen legacy packages. Empty/absent = no-op.
# protect:
#   paths: ["**/src/gen/**", "**/v1/**"]

# Formatter run on each agent edit (hooks pack: run-formatter.sh). {file} is replaced
# with the edited path. Never blocks; absent = no-op.
# format:
#   cmd: "npx prettier --write {file}"

phases:
  design: true                 # design stage for medium/complex features (auto-skipped otherwise)

feedback:
  enabled: true                # allow Review->Build / Check->Build loops

loops:
  max-per-type: 2              # circuit breaker per feedback-loop type (enforced by `temper state loop`)

# ============================================================
# Autonomous Continuation — armed by a human at the PLAN GATE, never at
# invocation. /temper always runs Plan first and stops for human review.
# With this block absent or enabled: false, the plan gate offers only the
# ordinary stage-by-stage continuation.
#
# Hardcoded, not configurable (safety invariants, not preferences): autonomy
# NEVER commits, pushes, or merges; NEVER re-plans unattended; always requires a
# clean working tree before starting; always checkpoints a `wip:` commit after
# each green stage; always takes a single-run lock.
# ============================================================
autonomy:
  enabled: false
  max-blast-radius: 15         # `temper gate commit` parks if more files changed than this
  park-on-touch: ["**/auth/**", "**/payment/**", "**/billing/**"]
  budget:
    max-total-loops: 4
    max-stages: 12
